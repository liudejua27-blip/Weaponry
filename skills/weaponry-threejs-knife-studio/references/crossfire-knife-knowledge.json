      "uncertainty": "The hidden-side hook cross-section remains unknown."
    },
    {
      "claim_id": "material-zone-separation",
      "statement": "Red lacquer, antique gold, black wrap, and ruby accents need geometry or ID boundaries in addition to color contrast.",
      "classification": "design-prior",
      "confidence": "high",
      "source_refs": ["knife-design-language"],
      "permitted_use": "rank-candidate",
      "uncertainty": "Specific shader parameters require later rendering evidence."
    },
    {
      "claim_id": "wear-secondary-only",
      "statement": "Procedural edge wear and engraving masks are secondary readability layers and cannot repair an incorrect silhouette.",
      "classification": "design-prior",
      "confidence": "high",
      "source_refs": ["knife-design-language"],
      "permitted_use": "rank-candidate",
      "uncertainty": "Wear density and placement remain art-direction choices."
    },
    {
      "claim_id": "fixed-view-comparison",
      "statement": "All candidate comparisons retain the same handedness, camera, crop, allowed Part IDs, renderer cohort, and reference calibration.",
      "classification": "design-prior",
      "confidence": "high",
      "source_refs": ["objective-and-quality"],
      "permitted_use": "preserve-gap",
