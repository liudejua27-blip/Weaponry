      "classification": "design-prior",
      "confidence": "medium",
      "source_refs": ["dragonfang-authorized-reference"],
      "permitted_use": "provisional-geometry",
      "uncertainty": "Hidden guard anatomy is not recovered from the visible sheet."
    },
    {
      "claim_id": "segmented-grip-readability",
      "statement": "A curved grip can be represented by stable centerline segments, wrap bands, border rails, and a small repeated fastener set.",
      "classification": "design-prior",
      "confidence": "medium",
      "source_refs": ["dragonfang-authorized-reference"],
      "permitted_use": "provisional-geometry",
      "uncertainty": "Backside segmentation remains inferred."
    },
    {
      "claim_id": "hooked-pommel-cue",
      "statement": "A hooked pommel benefits from a distinct return curve and a separately addressable gem seat.",
      "classification": "design-prior",
      "confidence": "medium",
      "source_refs": ["dragonfang-authorized-reference"],
