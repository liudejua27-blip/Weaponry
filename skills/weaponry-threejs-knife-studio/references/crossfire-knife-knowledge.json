    },
    {
      "claim_id": "single-scope-correction",
      "statement": "A correction revision changes one declared semantic scope while frozen Part hashes remain unchanged.",
      "classification": "design-prior",
      "confidence": "high",
      "source_refs": ["objective-and-quality"],
      "permitted_use": "preserve-gap",
