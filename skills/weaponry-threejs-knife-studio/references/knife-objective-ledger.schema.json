{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KnifeObjectiveLedger@1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "ledger_id",
    "revision",
    "parent_ledger_sha256",
    "program_sha256",
    "baseline_candidate_sha256",
    "stage",
    "allowed_scope",
    "frozen_parts",
    "hypothesis",
    "objective_metrics",
    "regression_limits",
    "candidate_budget",
    "minimum_improvement",
    "plateau_limit",
    "evidence_sha256",
    "status",
    "canonical_sha256"
  ],
  "properties": {
    "schema_version": { "const": "KnifeObjectiveLedger@1" },
    "ledger_id": { "$ref": "#/$defs/id" },
    "revision": { "type": "integer", "minimum": 0 },
    "parent_ledger_sha256": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/fullSha" }] },
    "program_sha256": { "$ref": "#/$defs/fullSha" },
    "baseline_candidate_sha256": { "$ref": "#/$defs/fullSha" },
    "stage": { "enum": ["blockout", "structural", "form", "material", "surface", "lighting", "interaction", "optimization"] },
    "allowed_scope": { "type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "frozen_parts": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "hypothesis": { "type": "string", "minLength": 8, "maxLength": 300 },
    "objective_metrics": { "type": "array", "minItems": 1, "maxItems": 12, "uniqueItems": true, "items": { "$ref": "#/$defs/metric" } },
    "regression_limits": { "type": "array", "maxItems": 12, "uniqueItems": true, "items": { "$ref": "#/$defs/metric" } },
    "candidate_budget": { "type": "integer", "minimum": 1, "maximum": 32 },
    "minimum_improvement": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
    "plateau_limit": { "const": 2 },
    "evidence_sha256": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/$defs/fullSha" } },
    "status": { "enum": ["active", "accepted", "rejected", "plateau", "blocked", "budget-exhausted"] },
    "canonical_sha256": { "type": "string", "pattern": "^(?:[a-f0-9]{64})?$" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,63}$" },
    "fullSha": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "metric": {
      "enum": [
        "silhouette-iou",
        "boundary-f1",
        "symmetric-chamfer",
        "p95-contour-distance",
        "tip-landmark-error",
        "belly-depth-error",
        "thickness-continuity",
        "normal-continuity",
        "part-id-coverage",
        "material-id-coverage",
        "negative-space-error",
        "fps-occupancy",
        "blade-section-profile-continuity",
        "blade-curve-g1",
        "blade-tip-taper",
        "blade-extrema-headroom",
        "assembly-ratio-prior-score",
        "assembly-attachment-continuity",
        "assembly-material-readability",
        "assembly-complexity-efficiency"
      ]
    }
  }
}
