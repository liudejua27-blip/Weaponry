{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/cross-section-plan.schema.json",
  "title": "CrossSectionPlan",
  "description": "A bounded, reference-driven cross-section description for a fictional game or film visual asset.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "project_id",
    "scope",
    "nonfunctional_asset",
    "reference_view_set_sha256",
    "reference_view_ids",
    "coordinate_frame",
    "station_policy",
    "stations",
    "canonical_sha256"
  ],
  "properties": {
    "schema_version": {"const": "CrossSectionPlan@1"},
    "plan_id": {"$ref": "#/$defs/identifier"},
    "project_id": {"$ref": "#/$defs/identifier"},
    "scope": {"enum": ["fictional-game-asset", "fictional-film-visual-asset"]},
    "nonfunctional_asset": {"const": true},
    "reference_view_set_sha256": {"$ref": "#/$defs/sha256"},
    "reference_view_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/identifier"}
    },
    "coordinate_frame": {"$ref": "#/$defs/coordinate_frame"},
    "station_policy": {"$ref": "#/$defs/station_policy"},
    "stations": {
      "type": "array",
      "minItems": 2,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/station"}
    },
    "canonical_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "coordinate_scalar": {
      "type": "number",
      "minimum": -10,
      "maximum": 10
    },
    "profile_scalar": {
      "type": "number",
      "minimum": -5,
      "maximum": 5
    },
    "point2": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"$ref": "#/$defs/profile_scalar"}
    },
    "visibility": {
      "enum": ["observed", "inferred", "unknown"]
    },
    "coordinate_frame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "length_unit",
        "handedness",
        "up_axis",
        "longitudinal_axis",
        "section_plane",
        "axis_direction"
      ],
      "properties": {
        "length_unit": {"const": "meter"},
        "handedness": {"const": "right-handed"},
        "up_axis": {"const": "y"},
        "longitudinal_axis": {"const": "x"},
        "section_plane": {"const": "yz"},
        "axis_direction": {"const": "+x"}
      }
    },
    "station_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ordering",
        "closed_profiles",
        "equal_point_count",
        "point_order",
        "max_station_count",
        "max_points_per_station"
      ],
      "properties": {
        "ordering": {"const": "strictly-increasing-x"},
        "closed_profiles": {"const": true},
        "equal_point_count": {"type": "boolean"},
        "point_order": {"const": "counter-clockwise-viewed-from-positive-x"},
        "max_station_count": {"const": 16},
        "max_points_per_station": {"const": 64}
      }
    },
    "station": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "station_id",
        "position_m",
        "continuity_group_id",
        "closed",
        "points",
        "observation_status",
        "confidence",
        "source_view_ids"
      ],
      "properties": {
        "station_id": {"$ref": "#/$defs/identifier"},
        "position_m": {"$ref": "#/$defs/coordinate_scalar"},
        "continuity_group_id": {"$ref": "#/$defs/identifier"},
        "closed": {"const": true},
        "points": {
          "type": "array",
          "minItems": 3,
          "maxItems": 64,
          "items": {"$ref": "#/$defs/point2"}
        },
        "corner_indices": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 0, "maximum": 63}
        },
        "observation_status": {"$ref": "#/$defs/visibility"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "source_view_ids": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"observation_status": {"const": "unknown"}},
            "required": ["observation_status"]
          },
          "then": {"properties": {"confidence": {"const": 0}}}
        }
      ]
    }
  }
}
