{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/mechanical-animation-clip-v2-preview.schema.json",
  "title": "MechanicalAnimationClipPreview@2",
  "description": "A transient single scheduled tick from an immutable appearance-aware clip. It is read-only structural evidence and contains no persisted frame mesh or material artifact.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "project_id", "appearance_candidate_id", "appearance_candidate_state_sha256",
    "appearance_artifact_sha256", "appearance_artifact_readback_sha256", "appearance_artifact_readback_object_sha256",
    "source_geometry_candidate_id", "source_geometry_candidate_state_sha256", "source_geometry_artifact_sha256",
    "source_geometry_candidate_evidence_sha256", "clip_id", "clip_object_sha256", "clip_sha256",
    "rest_frame_sha256", "pose_action_sha256", "sample_time_ticks", "frame_sha256",
    "source_replay_worker_cohort_sha256", "appearance_transient_artifact_sha256",
    "appearance_transient_artifact_readback_sha256", "appearance_replay_worker_cohort_sha256",
    "appearance_program_sha256", "appearance_transient_program_sha256", "material_pack_manifest_sha256", "geometry_preservation_projection_sha256",
    "pose_geometry_preview", "geometry_materialization",
    "appearance_materialization", "runtime_write_performed", "persistent_user_data_touched",
    "quality_status", "visual_quality_status", "commercial_fps_quality_status", "human_review_status",
    "commercial_engine_status", "limitations", "canonical_sha256"
  ],
  "properties": {
    "schema_version": {"const": "MechanicalAnimationClipPreview@2"},
    "project_id": {"$ref": "#/$defs/id"},
    "appearance_candidate_id": {"$ref": "#/$defs/id"},
    "appearance_candidate_state_sha256": {"$ref": "#/$defs/sha256"},
    "appearance_artifact_sha256": {"$ref": "#/$defs/sha256"},
    "appearance_artifact_readback_sha256": {"$ref": "#/$defs/sha256"},
    "appearance_artifact_readback_object_sha256": {"$ref": "#/$defs/sha256"},
    "source_geometry_candidate_id": {"$ref": "#/$defs/id"},
    "source_geometry_candidate_state_sha256": {"$ref": "#/$defs/sha256"},
    "source_geometry_artifact_sha256": {"$ref": "#/$defs/sha256"},
    "source_geometry_candidate_evidence_sha256": {"$ref": "#/$defs/sha256"},
    "clip_id": {"$ref": "#/$defs/id"},
    "clip_object_sha256": {"$ref": "#/$defs/sha256"},
    "clip_sha256": {"$ref": "#/$defs/sha256"},
    "rest_frame_sha256": {"$ref": "#/$defs/sha256"},
    "pose_action_sha256": {"$ref": "#/$defs/sha256"},
    "sample_time_ticks": {"type": "integer", "minimum": 0, "maximum": 1000000},
    "frame_sha256": {"$ref": "#/$defs/sha256"},
    "source_replay_worker_cohort_sha256": {"$ref": "#/$defs/sha256"},
    "appearance_transient_artifact_sha256": {"$ref": "#/$defs/sha256"},
    "appearance_transient_artifact_readback_sha256": {"$ref": "#/$defs/sha256"},
    "appearance_replay_worker_cohort_sha256": {"$ref": "#/$defs/sha256"},
    "appearance_program_sha256": {"$ref": "#/$defs/sha256"},
    "appearance_transient_program_sha256": {"$ref": "#/$defs/sha256"},
    "material_pack_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "geometry_preservation_projection_sha256": {"$ref": "#/$defs/sha256"},
    "pose_geometry_preview": {"$ref": "https://forgecad.local/contracts/mechanical-pose-geometry-preview.schema.json"},
    "geometry_materialization": {"const": "transient-double-worker-glb-not-persisted"},
    "appearance_materialization": {"const": "transient-double-worker-appearance-not-persisted"},
    "runtime_write_performed": {"const": false},
    "persistent_user_data_touched": {"const": false},
    "quality_status": {"const": "structural_only"},
    "visual_quality_status": {"const": "NOT_PROVEN"},
    "commercial_fps_quality_status": {"const": "NOT_PROVEN"},
    "human_review_status": {"const": "NOT_RUN"},
    "commercial_engine_status": {"const": "NOT_RUN"},
    "limitations": {"const": ["rigid-parts-only-no-skinning-or-deformation", "single-scheduled-tick-per-preview-call", "transient-geometry-and-appearance-not-persisted", "no-ik-constraints-nla-fcurves-drivers-or-timeline", "not-blender-armature-animation-or-python-parity", "structural-replay-does-not-prove-visual-quality"]},
    "canonical_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
