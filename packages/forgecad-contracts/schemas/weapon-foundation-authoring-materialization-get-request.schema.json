{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/weapon-foundation-authoring-materialization-get-request.schema.json",
  "title": "WeaponFoundationAuthoringMaterializationGetRequest@1",
  "description": "Closed project-bound read key for one durable foundation AuthoringMesh V2 materialization. An optional descriptor hash is only a consistency check; this request cannot write or mutate state.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "project_id", "materialization_id", "writer_policy",
    "runtime_write_performed", "persistent_user_data_touched", "input_sha256"
  ],
  "properties": {
    "schema_version": {"const": "WeaponFoundationAuthoringMaterializationGetRequest@1"},
    "project_id": {"$ref": "#/$defs/id"},
    "materialization_id": {"$ref": "#/$defs/id"},
    "descriptor_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "writer_policy": {"const": "forgecad-runtime-only-state-writer@1"},
    "runtime_write_performed": {"const": false},
    "persistent_user_data_touched": {"const": false},
    "input_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
