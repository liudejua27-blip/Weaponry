    "calibration_policy": {"const": "runtime-derived-registered-camera-owner-to-reviewed-void-calibration@1"},
    "calibration_policy_sha256": {"$ref": "#/$defs/sha256"},
    "transform_policy": {"const": "runtime-derived-closed-part-id-review-region-transform@1"},
    "reviewed_void_policy": {"const": "reviewed-subtract-contour-intersection-with-candidate-silhouette@1"},
    "depth_policy": {"const": "registered-camera-owner-void-depth-evidence@1"},
    "depth_policy_sha256": {"$ref": "#/$defs/sha256"},
    "threshold_policy": {"const": "owner-reviewed-void-zero-intrusion-adjacency-thresholds@1"},
