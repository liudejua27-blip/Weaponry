    "eligible": {"type": "boolean"},
    "promotable": {"const": false},
    "quality_status": {"const": "NOT_PROVEN"},
    "depth_status": {"enum": ["OBSERVED", "UNKNOWN", "INVALID"]},
    "runtime_write_performed": {"const": false},
    "persistent_user_data_touched": {"const": false},
    "worker_started": {"const": false},
    "production_stage_advanced": {"const": false},
    "candidate_confirmed": {"const": false},
    "version_created": {"const": false},
    "export_performed": {"const": false},
    "request_sha256": {"$ref": "#/$defs/sha256"},
    "input_sha256": {"$ref": "#/$defs/sha256"},
    "canonicalization_policy": {"const": "canonical-json-sha256-excluding-canonical-sha256@1"},
    "canonical_sha256": {"$ref": "#/$defs/sha256"},
    "created_at": {"type": "string", "minLength": 1, "maxLength": 128}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "blocker_code": {"type": "string", "pattern": "^[A-Z0-9_]{1,128}$"},
    "view": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "project_id", "candidate_id", "candidate_state_sha256", "artifact_id",
        "artifact_sha256", "artifact_readback_sha256", "view_kind", "view_id", "reviewed_structure_id",
        "reference_id", "reference_sha256", "camera_hash", "camera_canonical_sha256", "camera_object_sha256",
        "render_set_object_sha256", "render_set_canonical_sha256", "render_set_view_id",
