        "derived_transform_kind", "identity_transform_unique", "eligible_transform_count", "transform_rank_tie",
        "expected_void_pixel_count", "owner_region_pixel_count", "owner_expected_void_overlap_pixel_count",
        "owner_expected_void_overlap_milli", "boundary_pixel_count", "owner_boundary_adjacency_pixel_count",
        "owner_boundary_adjacency_milli", "depth_valid_pixel_count", "depth_owner_sample_count",
        "depth_boundary_sample_count", "depth_invalid_sample_count", "depth_ordering_milli", "depth_status",
        "owner_void_status", "strict_owner_void_passed", "strict_depth_passed", "view_status", "view_passed",
        "blocker_codes", "quality_status", "canonical_sha256", "created_at"
      ],
      "properties": {
        "schema_version": {"const": "ProductionWeaponOwnerReviewedVoidCalibrationProjectionView@1"},
        "project_id": {"$ref": "#/$defs/id"},
        "candidate_id": {"$ref": "#/$defs/id"},
        "candidate_state_sha256": {"$ref": "#/$defs/sha256"},
        "artifact_id": {"$ref": "#/$defs/id"},
        "artifact_sha256": {"$ref": "#/$defs/sha256"},
        "artifact_readback_sha256": {"$ref": "#/$defs/sha256"},
        "view_kind": {"enum": ["left", "right", "rear-three-quarter"]},
        "view_id": {"$ref": "#/$defs/id"},
        "reviewed_structure_id": {"$ref": "#/$defs/id"},
        "reference_id": {"$ref": "#/$defs/id"},
        "reference_sha256": {"$ref": "#/$defs/sha256"},
        "camera_hash": {"$ref": "#/$defs/sha256"},
        "camera_canonical_sha256": {"$ref": "#/$defs/sha256"},
        "camera_object_sha256": {"$ref": "#/$defs/sha256"},
        "render_set_object_sha256": {"$ref": "#/$defs/sha256"},
        "render_set_canonical_sha256": {"$ref": "#/$defs/sha256"},
        "render_set_view_id": {"$ref": "#/$defs/id"},
        "form_art_view_receipt_object_sha256": {"$ref": "#/$defs/sha256"},
        "form_art_view_receipt_canonical_sha256": {"$ref": "#/$defs/sha256"},
        "baseline_view_receipt_object_sha256": {"$ref": "#/$defs/sha256"},
        "target_object_sha256": {"$ref": "#/$defs/sha256"},
        "target_canonical_sha256": {"$ref": "#/$defs/sha256"},
        "visual_structure_canonical_sha256": {"$ref": "#/$defs/sha256"},
        "silhouette_pass_object_sha256": {"$ref": "#/$defs/sha256"},
        "part_id_pass_object_sha256": {"$ref": "#/$defs/sha256"},
        "depth_pass_object_sha256": {"$ref": "#/$defs/sha256"},
        "owner_part_id": {"const": "rear-stock"},
        "derived_owner_region_sha256": {"$ref": "#/$defs/sha256"},
        "derived_reviewed_void_region_sha256": {"$ref": "#/$defs/sha256"},
        "derived_void_boundary_sha256": {"$ref": "#/$defs/sha256"},
        "registered_camera_lineage_verified": {"type": "boolean"},
        "derived_transform_kind": {"enum": ["identity", "horizontal-flip", "vertical-flip", "rotate-180"]},
        "identity_transform_unique": {"type": "boolean"},
        "eligible_transform_count": {"type": "integer", "minimum": 0, "maximum": 4},
        "transform_rank_tie": {"type": "boolean"},
        "expected_void_pixel_count": {"type": "integer", "minimum": 0},
        "owner_region_pixel_count": {"type": "integer", "minimum": 0},
        "owner_expected_void_overlap_pixel_count": {"type": "integer", "minimum": 0},
        "owner_expected_void_overlap_milli": {"type": "integer", "minimum": 0, "maximum": 1000},
        "boundary_pixel_count": {"type": "integer", "minimum": 0},
        "owner_boundary_adjacency_pixel_count": {"type": "integer", "minimum": 0},
        "owner_boundary_adjacency_milli": {"type": "integer", "minimum": 0, "maximum": 1000},
        "depth_valid_pixel_count": {"type": "integer", "minimum": 0},
        "depth_owner_sample_count": {"type": "integer", "minimum": 0},
        "depth_boundary_sample_count": {"type": "integer", "minimum": 0},
        "depth_invalid_sample_count": {"type": "integer", "minimum": 0},
        "depth_ordering_milli": {"type": "integer"},
        "depth_status": {"enum": ["OBSERVED", "UNKNOWN", "INVALID"]},
        "owner_void_status": {"enum": ["BOUND", "BLOCKED", "UNKNOWN"]},
        "strict_owner_void_passed": {"type": "boolean"},
        "strict_depth_passed": {"type": "boolean"},
        "view_status": {"enum": ["ELIGIBLE", "BLOCKED", "INVALID", "UNAVAILABLE"]},
        "view_passed": {"type": "boolean"},
        "blocker_codes": {
          "type": "array", "minItems": 0, "maxItems": 32, "uniqueItems": true,
          "items": {"$ref": "#/$defs/blocker_code"}
        },
        "quality_status": {"const": "NOT_PROVEN"},
        "canonical_sha256": {"$ref": "#/$defs/sha256"},
        "created_at": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    },
    "view_left": {
      "allOf": [
        {"$ref": "#/$defs/view"},
        {"properties": {"view_kind": {"const": "left"}, "reviewed_structure_id": {"const": "left.open-stock-void"}}}
      ]
    },
    "view_right": {
      "allOf": [
        {"$ref": "#/$defs/view"},
        {"properties": {"view_kind": {"const": "right"}, "reviewed_structure_id": {"const": "right.open-stock-void"}}}
      ]
    },
    "view_rear_three_quarter": {
      "allOf": [
        {"$ref": "#/$defs/view"},
        {"properties": {"view_kind": {"const": "rear-three-quarter"}, "reviewed_structure_id": {"const": "rear3q.open-stock-void"}}}
      ]
    }
  }
}
