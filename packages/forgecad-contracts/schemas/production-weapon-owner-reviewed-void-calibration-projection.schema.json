      "maxItems": 3,
      "uniqueItems": true,
      "prefixItems": [
        {"$ref": "#/$defs/view_left"},
        {"$ref": "#/$defs/view_right"},
        {"$ref": "#/$defs/view_rear_three_quarter"}
      ],
      "items": false
