{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/production-weapon-owner-reviewed-void-calibration-projection.schema.json",
  "title": "ProductionWeaponOwnerReviewedVoidCalibrationProjection@1",
  "description": "Runtime-derived, read-only owner-to-reviewed-void calibration. The caller supplies only opaque source references; Runtime derives rear-stock ownership, the reviewed void, the closed transform comparison and depth observations.",
