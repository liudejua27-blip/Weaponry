{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/authoring-mesh-durable-get-request.schema.json",
  "title": "AuthoringMeshDurableGetRequest",
  "additionalProperties": false,
  "properties": {
    "artifact_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]+$",
      "type": "string"
    },
    "artifact_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "candidate_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]+$",
      "type": "string"
    },
    "canonical_mesh_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]+$",
      "type": "string"
    },
    "canonical_mesh_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "input_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "persistent_user_data_touched": {
      "const": false
    },
    "project_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]+$",
      "type": "string"
    },
    "runtime_write_performed": {
      "const": false
    },
    "schema_version": {
      "const": "AuthoringMeshGetRequest@1"
    },
    "writer_policy": {
      "const": "forgecad-runtime-only-state-writer@1"
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "candidate_id",
    "canonical_mesh_id",
    "canonical_mesh_sha256",
    "artifact_id",
    "artifact_sha256",
    "writer_policy",
    "runtime_write_performed",
    "persistent_user_data_touched",
    "input_sha256"
  ],
  "type": "object"
}
