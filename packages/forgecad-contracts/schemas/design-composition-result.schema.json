{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/design-composition-result.schema.json",
  "title": "DesignCompositionResult",
  "description": "Runtime receipt for an ordered, replayable composition proposal made from bounded DesignActionRun results, with an optional hash-linked cumulative-program merge candidate.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "composition_id",
    "session_id",
    "project_id",
    "candidate_id",
    "requested_stage",
    "observation_sha256",
    "input_sha256",
    "job_id",
    "job_status",
    "job_progress",
    "status",
    "execution_mode",
    "steps",
    "action_runs",
    "completed_count",
    "next_action_index",
    "aggregate",
    "composition_proposal",
    "merge",
    "failure_recovery",
    "runtime_write",
    "persistent_user_data_touched",
    "canonical_sha256"
  ],
  "properties": {
    "schema_version": {"const": "DesignCompositionResult@1"},
    "composition_id": {"$ref": "https://forgecad.local/contracts/agentic-projection-primitives.schema.json#/$defs/identifier"},
    "session_id": {"$ref": "https://forgecad.local/contracts/agentic-projection-primitives.schema.json#/$defs/identifier"},
    "project_id": {"$ref": "https://forgecad.local/contracts/agentic-projection-primitives.schema.json#/$defs/identifier"},
    "candidate_id": {"$ref": "https://forgecad.local/contracts/agentic-projection-primitives.schema.json#/$defs/identifier"},
    "requested_stage": {"$ref": "https://forgecad.local/contracts/agentic-projection-primitives.schema.json#/$defs/stage"},
    "observation_sha256": {"$ref": "https://forgecad.local/contracts/agentic-projection-primitives.schema.json#/$defs/sha256"},
    "input_sha256": {"$ref": "https://forgecad.local/contracts/agentic-projection-primitives.schema.json#/$defs/sha256"},
    "job_id": {"$ref": "https://forgecad.local/contracts/agentic-projection-primitives.schema.json#/$defs/identifier"},
    "job_status": {"enum": ["running", "succeeded", "failed", "cancelled"]},
    "job_progress": {"type": "integer", "minimum": 0, "maximum": 100},
    "status": {"enum": ["reviewable", "blocked"]},
    "execution_mode": {"enum": ["ordered-independent-proposal", "ordered-independent-proposal-with-cumulative-merge"]},
    "steps": {
      "type": "array",
      "minItems": 2,
      "maxItems": 6,
      "items": {"$ref": "#/$defs/step"}
    },
    "action_runs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {"$ref": "https://forgecad.local/contracts/design-action-run.schema.json"}
    },
    "completed_count": {"type": "integer", "minimum": 1, "maximum": 6},
    "next_action_index": {
      "oneOf": [{"type": "null"}, {"type": "integer", "minimum": 0, "maximum": 5}]
    },
    "aggregate": {"$ref": "#/$defs/aggregate"},
    "composition_proposal": {"$ref": "#/$defs/composition_proposal"},
    "merge": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/merge"}
      ]
    },
    "failure_recovery": {"$ref": "#/$defs/failure_recovery"},
    "runtime_write": {"const": false},
    "persistent_user_data_touched": {"const": false},
    "canonical_sha256": {"$ref": "https://forgecad.local/contracts/agentic-projection-primitives.schema.json#/$defs/sha256"}
  },
  "$defs": {
    "nullable_sha256": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step_index", "run_id", "depends_on", "status", "quality_status", "action_run_sha256", "proposal_candidate_id", "proposal_candidate_state_sha256"],
      "properties": {
        "step_index": {"type": "integer", "minimum": 0, "maximum": 5},
        "run_id": {"$ref": "https://forgecad.local/contracts/agentic-projection-primitives.schema.json#/$defs/identifier"},
        "depends_on": {"type": "array", "maxItems": 1, "items": {"$ref": "https://forgecad.local/contracts/agentic-projection-primitives.schema.json#/$defs/identifier"}},
        "status": {"enum": ["not-run", "completed", "blocked", "failed"]},
        "quality_status": {"$ref": "https://forgecad.local/contracts/agentic-projection-primitives.schema.json#/$defs/quality_status"},
        "action_run_sha256": {"$ref": "#/$defs/nullable_sha256"},
        "proposal_candidate_id": {"$ref": "https://forgecad.local/contracts/agentic-projection-primitives.schema.json#/$defs/nullable_identifier"},
        "proposal_candidate_state_sha256": {"$ref": "#/$defs/nullable_sha256"}
      }
    },
    "aggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["quality_status", "strict_improvement", "non_regressing", "proposal_candidate_ids"],
      "properties": {
        "quality_status": {"$ref": "https://forgecad.local/contracts/agentic-projection-primitives.schema.json#/$defs/quality_status"},
        "strict_improvement": {"type": "boolean"},
        "non_regressing": {"type": "boolean"},
        "proposal_candidate_ids": {"type": "array", "maxItems": 6, "items": {"$ref": "https://forgecad.local/contracts/agentic-projection-primitives.schema.json#/$defs/identifier"}}
      }
    },
    "composition_proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "source_candidate_id", "proposal_candidate_ids", "merged_candidate_id", "confirm_allowed", "merge_status", "reason"],
      "properties": {
        "status": {"enum": ["reviewable", "blocked"]},
        "source_candidate_id": {"$ref": "https://forgecad.local/contracts/agentic-projection-primitives.schema.json#/$defs/identifier"},
        "proposal_candidate_ids": {"type": "array", "maxItems": 6, "items": {"$ref": "https://forgecad.local/contracts/agentic-projection-primitives.schema.json#/$defs/identifier"}},
        "merged_candidate_id": {"$ref": "https://forgecad.local/contracts/agentic-projection-primitives.schema.json#/$defs/nullable_identifier"},
        "confirm_allowed": {"const": false},
        "merge_status": {"enum": ["not-requested", "blocked", "prepared"]},
        "reason": {"$ref": "https://forgecad.local/contracts/agentic-projection-primitives.schema.json#/$defs/safe_text"}
      }
    },
    "merge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "mode",
        "steps",
        "final_step_index",
        "final_program_sha256",
        "merge_run_id",
        "merge_run_sha256",
        "merged_candidate_id",
        "merged_candidate_state_sha256",
        "quality_status",
        "strict_improvement",
        "non_regressing",
        "confirm_allowed",
        "source_candidate_unchanged",
        "reason"
      ],
      "properties": {
        "status": {"enum": ["blocked", "prepared"]},
        "mode": {"const": "cumulative-program"},
        "steps": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "items": {"$ref": "#/$defs/merge_step"}
        },
        "final_step_index": {"type": "integer", "minimum": 1, "maximum": 5},
        "final_program_sha256": {"$ref": "https://forgecad.local/contracts/agentic-projection-primitives.schema.json#/$defs/sha256"},
        "merge_run_id": {"$ref": "https://forgecad.local/contracts/agentic-projection-primitives.schema.json#/$defs/nullable_identifier"},
        "merge_run_sha256": {"$ref": "#/$defs/nullable_sha256"},
        "merged_candidate_id": {"$ref": "https://forgecad.local/contracts/agentic-projection-primitives.schema.json#/$defs/nullable_identifier"},
        "merged_candidate_state_sha256": {"$ref": "#/$defs/nullable_sha256"},
        "quality_status": {"$ref": "https://forgecad.local/contracts/agentic-projection-primitives.schema.json#/$defs/quality_status"},
        "strict_improvement": {"type": "boolean"},
        "non_regressing": {"type": "boolean"},
        "confirm_allowed": {"const": false},
        "source_candidate_unchanged": {"const": true},
        "reason": {"$ref": "https://forgecad.local/contracts/agentic-projection-primitives.schema.json#/$defs/safe_text"}
      }
    },
    "merge_step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step_index", "run_id", "parent_program_sha256", "program_sha256"],
      "properties": {
        "step_index": {"type": "integer", "minimum": 0, "maximum": 5},
        "run_id": {"$ref": "https://forgecad.local/contracts/agentic-projection-primitives.schema.json#/$defs/identifier"},
        "parent_program_sha256": {"$ref": "https://forgecad.local/contracts/agentic-projection-primitives.schema.json#/$defs/sha256"},
        "program_sha256": {"$ref": "https://forgecad.local/contracts/agentic-projection-primitives.schema.json#/$defs/sha256"}
      }
    },
    "failure_recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stopped_at_index", "retry_input_sha256", "source_candidate_unchanged", "replayable"],
      "properties": {
        "stopped_at_index": {"oneOf": [{"type": "null"}, {"type": "integer", "minimum": 0, "maximum": 5}]},
        "retry_input_sha256": {"$ref": "https://forgecad.local/contracts/agentic-projection-primitives.schema.json#/$defs/sha256"},
        "source_candidate_unchanged": {"const": true},
        "replayable": {"const": true}
      }
    }
  }
}
