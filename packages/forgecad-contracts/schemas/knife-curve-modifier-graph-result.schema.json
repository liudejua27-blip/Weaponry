    "recomputed_node_ids": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
    "reused_node_ids": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
    "evaluation_status": {"const": "curve-sampled-modifier-recompute-planned-no-mesh@1"},
    "evaluated_mesh_created": {"const": false},
    "geometry_artifact_created": {"const": false},
    "replayed": {"type": "boolean"},
    "deterministic_replay": {"const": true},
    "byte_exact_replay": {"const": true},
    "restart_hash_verified": {"type": "boolean"},
    "idempotency_key": {"$ref": "#/$defs/idempotency_key"},
