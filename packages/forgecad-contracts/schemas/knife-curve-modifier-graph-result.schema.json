    "visual_status": {"const": "NOT_RUN"},
    "human_status": {"const": "NOT_RUN"},
    "engine_status": {"const": "NOT_RUN"},
    "canonicalization_policy": {"const": "canonical-json-sha256-excluding-canonical-sha256@1"},
    "canonical_sha256": {"$ref": "#/$defs/sha256"}
  },
  "oneOf": [
    {"properties": {"operation": {"const": "knife_curve_modifier_graph_prepare"}, "request_kind": {"const": "prepare"}, "status": {"const": "prepared"}, "replayed": {"const": false}, "store_commit_status": {"const": "committed"}, "cas_commit_status": {"const": "committed"}, "runtime_write_performed": {"const": true}, "persistent_user_data_touched": {"const": true}}},
    {"properties": {"operation": {"const": "knife_curve_modifier_graph_prepare"}, "request_kind": {"const": "prepare"}, "status": {"const": "replayed"}, "replayed": {"const": true}, "store_commit_status": {"const": "not-touched"}, "cas_commit_status": {"const": "not-touched"}, "runtime_write_performed": {"const": false}, "persistent_user_data_touched": {"const": false}}},
    {"properties": {"operation": {"const": "knife_curve_modifier_graph_get"}, "request_kind": {"const": "get"}, "status": {"const": "found"}, "replayed": {"const": false}, "store_commit_status": {"const": "not-touched"}, "cas_commit_status": {"const": "not-touched"}, "runtime_write_performed": {"const": false}, "persistent_user_data_touched": {"const": false}}}
  ],
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "idempotency_key": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},
    "revision_index": {"type": "integer", "minimum": 0, "maximum": 1000000}
  }
