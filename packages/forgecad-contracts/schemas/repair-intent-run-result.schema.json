{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/repair-intent-run-result.schema.json",
  "title": "ForgeCAD RepairIntent Run Prepare Result",
  "description": "Runtime-owned bounded RepairIntent execution receipt. It creates only a separate review candidate and never confirms or mutates the source candidate.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "session_id",
    "candidate_id",
    "run_id",
    "intent_sha256",
    "intent_object_sha256",
    "input_sha256",
    "observation_sha256",
    "source_evidence_sha256",
    "reference_sha256",
    "status",
    "run_status",
    "quality_status",
    "action_run_sha256",
    "action_run",
    "proposal_candidate_id",
    "proposal_candidate_state_sha256",
    "prepared_object_sha256",
    "quality_report_id",
    "apply_status",
    "next_transaction",
    "confirm_allowed",
    "source_candidate_unchanged",
    "active_design_state_mutated",
    "runtime_write",
    "persistent_user_data_touched",
    "canonical_sha256"
  ],
  "properties": {
    "schema_version": {"const": "RepairIntentRunResult@1"},
    "project_id": {"$ref": "#/$defs/identifier"},
    "session_id": {"$ref": "#/$defs/identifier"},
    "candidate_id": {"$ref": "#/$defs/identifier"},
    "run_id": {"$ref": "#/$defs/identifier"},
    "intent_sha256": {"$ref": "#/$defs/sha256"},
    "intent_object_sha256": {"$ref": "#/$defs/sha256"},
    "input_sha256": {"$ref": "#/$defs/sha256"},
    "observation_sha256": {"$ref": "#/$defs/sha256"},
    "source_evidence_sha256": {"$ref": "#/$defs/sha256"},
    "reference_sha256": {"$ref": "#/$defs/sha256"},
    "status": {"enum": ["reviewable", "blocked"]},
    "run_status": {"enum": ["prepared", "running", "completed", "failed", "blocked"]},
    "quality_status": {"enum": ["PARTIAL_VISIBLE_VIEW_PASS", "QUALITY_TARGET_NOT_MET", "BLOCKED_REFERENCE_COVERAGE", "not-run", "unknown"]},
    "action_run_sha256": {"$ref": "#/$defs/sha256"},
    "action_run": {"type": "object"},
    "proposal_candidate_id": {"$ref": "#/$defs/nullable_identifier"},
    "proposal_candidate_state_sha256": {"$ref": "#/$defs/nullable_sha256"},
    "prepared_object_sha256": {"$ref": "#/$defs/nullable_sha256"},
    "quality_report_id": {"$ref": "#/$defs/nullable_sha256"},
    "apply_status": {"enum": ["ready_for_repair_apply_prepare", "blocked"]},
    "next_transaction": {"enum": ["repair_apply_prepare", "inspect_or_retry"]},
    "confirm_allowed": {"const": false},
    "source_candidate_unchanged": {"const": true},
    "active_design_state_mutated": {"const": false},
    "runtime_write": {"const": false},
    "persistent_user_data_touched": {"const": false},
    "canonical_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "nullable_identifier": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullable_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
  }
}
