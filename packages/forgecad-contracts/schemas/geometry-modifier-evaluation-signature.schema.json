{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/geometry-modifier-evaluation-signature.schema.json",
  "title": "GeometryModifierEvaluationSignature",
  "description": "A canonical, caller-round-trippable signature for one Runtime-owned modifier evaluation. It is not durable provenance or compiled geometry.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "representation_plan_sha256",
    "part_id",
    "material_zone_id",
    "solid",
    "source_input_sha256",
    "stack_definition_sha256",
    "evaluation_sha256",
    "output_sha256",
    "evaluation_policy_sha256",
    "operator_catalog_sha256",
    "catalog_cohort_sha256",
    "cache_key_sha256",
    "stages",
    "canonical_sha256"
  ],
  "properties": {
    "schema_version": {"const": "GeometryModifierEvaluationSignature@1"},
    "project_id": {"$ref": "#/$defs/identifier"},
    "representation_plan_sha256": {"$ref": "#/$defs/sha256"},
    "part_id": {"$ref": "#/$defs/identifier"},
    "material_zone_id": {"$ref": "#/$defs/identifier"},
    "solid": {"type": "boolean"},
    "source_input_sha256": {"$ref": "#/$defs/sha256"},
    "stack_definition_sha256": {"$ref": "#/$defs/sha256"},
    "evaluation_sha256": {"$ref": "#/$defs/sha256"},
    "output_sha256": {"$ref": "#/$defs/sha256"},
    "evaluation_policy_sha256": {"$ref": "#/$defs/sha256"},
    "operator_catalog_sha256": {"$ref": "#/$defs/sha256"},
    "catalog_cohort_sha256": {"$ref": "#/$defs/sha256"},
    "cache_key_sha256": {"$ref": "#/$defs/sha256"},
    "stages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {"$ref": "#/$defs/stage_signature"}
    },
    "canonical_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "operator_id": {
      "enum": [
        "forgecad.geometry.transform@2",
        "forgecad.geometry.mirror@1",
        "forgecad.geometry.array@1",
        "forgecad.geometry.bevel@1",
        "forgecad.geometry.normal-policy@1"
      ]
    },
    "stage_signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "order_index",
        "modifier_id",
        "enabled",
        "operator_id",
        "parameters_sha256",
        "definition_sha256",
        "input_evaluation_sha256",
        "output_evaluation_sha256",
        "stage_cache_key_sha256"
      ],
      "properties": {
        "order_index": {"type": "integer", "minimum": 0, "maximum": 7},
        "modifier_id": {"$ref": "#/$defs/identifier"},
        "enabled": {"type": "boolean"},
        "operator_id": {"$ref": "#/$defs/operator_id"},
        "parameters_sha256": {"$ref": "#/$defs/sha256"},
        "definition_sha256": {"$ref": "#/$defs/sha256"},
        "input_evaluation_sha256": {"$ref": "#/$defs/sha256"},
        "output_evaluation_sha256": {"$ref": "#/$defs/sha256"},
        "stage_cache_key_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
