{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/repair-apply-request.schema.json",
  "title": "ForgeCAD Repair Apply Prepare Request",
  "description": "Approval-gated, source-bound preparation of a Repair application. It creates only a CAS-backed apply intent; candidate/version mutation remains a separate confirmation transaction.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project_id",
    "session_id",
    "candidate_id",
    "proposal_candidate_id",
    "run_id",
    "source_candidate_state_sha256",
    "intent_sha256",
    "intent_object_sha256",
    "proposal_candidate_state_sha256",
    "prepared_object_id",
    "prepared_object_sha256",
    "quality_report_id",
    "cross_view_evidence_sha256",
    "base_version_id",
    "input_sha256",
    "approved",
    "approval_receipt_id",
    "approval_summary",
    "approval_expires_at",
    "approval_session_id",
    "idempotency_key"
  ],
  "properties": {
    "project_id": {"$ref": "#/$defs/identifier"},
    "session_id": {"$ref": "#/$defs/identifier"},
    "candidate_id": {"$ref": "#/$defs/identifier"},
    "proposal_candidate_id": {"$ref": "#/$defs/identifier"},
    "run_id": {"$ref": "#/$defs/identifier"},
    "source_candidate_state_sha256": {"$ref": "#/$defs/sha256"},
    "intent_sha256": {"$ref": "#/$defs/sha256"},
    "intent_object_sha256": {"$ref": "#/$defs/sha256"},
    "proposal_candidate_state_sha256": {"$ref": "#/$defs/sha256"},
    "prepared_object_id": {"$ref": "#/$defs/identifier"},
    "prepared_object_sha256": {"$ref": "#/$defs/sha256"},
    "quality_report_id": {"$ref": "#/$defs/identifier"},
    "cross_view_evidence_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "base_version_id": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "input_sha256": {"$ref": "#/$defs/sha256"},
    "approved": {"const": true},
    "approval_receipt_id": {"$ref": "#/$defs/identifier"},
    "approval_summary": {"type": "string", "minLength": 1, "maxLength": 512},
    "approval_expires_at": {"type": "string", "minLength": 1, "maxLength": 64},
    "approval_session_id": {"$ref": "#/$defs/identifier"},
    "idempotency_key": {"$ref": "#/$defs/identifier"}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
