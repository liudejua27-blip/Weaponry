{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/production-weapon-form-art-baseline-get-request.schema.json",
  "title": "ProductionWeaponFormArtBaselineGetRequest@1",
  "description": "Closed read-only lookup for one Runtime-owned fresh FormArt baseline. The full scope and idempotency binding are echoed so Runtime can fail closed on cross-candidate reads.",
  "type": "object", "additionalProperties": false,
  "required": [
    "schema_version", "operation", "baseline_id", "registration_lineage_id", "registration_lineage_canonical_sha256",
    "session_id", "project_id", "candidate_id", "candidate_state_sha256", "artifact_id", "artifact_sha256",
    "base_version_id", "idempotency_key", "max_response_bytes", "writer_policy", "canonicalization_policy",
    "runtime_write_performed", "persistent_user_data_touched", "input_sha256"
  ],
  "properties": {
    "schema_version": {"const": "ProductionWeaponFormArtBaselineGetRequest@1"},
    "operation": {"const": "forgecad.production.weapon.form-art-baseline-get@1"},
    "baseline_id": {"$ref": "#/$defs/id"},
    "registration_lineage_id": {"$ref": "#/$defs/id"},
    "registration_lineage_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "session_id": {"$ref": "#/$defs/id"},
    "project_id": {"$ref": "#/$defs/id"},
    "candidate_id": {"$ref": "#/$defs/id"},
    "candidate_state_sha256": {"$ref": "#/$defs/sha256"},
    "artifact_id": {"$ref": "#/$defs/id"},
    "artifact_sha256": {"$ref": "#/$defs/sha256"},
    "base_version_id": {"$ref": "#/$defs/nullable_id"},
    "idempotency_key": {"$ref": "#/$defs/id"},
    "max_response_bytes": {"const": 1048576},
    "writer_policy": {"const": "forgecad-runtime-only-state-writer@1"},
    "canonicalization_policy": {"const": "canonical-json-sha256-excluding-canonical-sha256@1"},
    "runtime_write_performed": {"const": false},
    "persistent_user_data_touched": {"const": false},
    "input_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullable_id": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"}
  }
}
