{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/hero-uv-durable-link.schema.json",
  "title": "HeroUvDurableLink@1",
  "description": "Runtime-owned immutable source-only link between one Low artifact/readback and one HeroUvLayout diagnostic CAS object.",
  "type": "object", "additionalProperties": false,
  "required": [
    "schema_version", "link_id", "project_id", "candidate_id", "candidate_state_sha256", "base_version_id",
    "source_low_artifact_id", "source_low_artifact_object_sha256", "source_low_artifact_sha256",
    "source_low_artifact_readback_object_sha256", "source_low_artifact_readback_sha256",
    "resolution", "padding_texels", "min_mip_level", "hard_edge_angle_deg", "stretch_threshold",
    "visibility_weights_sha256", "layout_object_sha256", "layout_canonical_sha256", "worker_build_cohort_sha256",
    "request_sha256", "input_sha256", "idempotency_key", "replay_count", "replay_byte_exact", "link_policy",
    "writer_policy", "materialization_status", "idempotency_policy", "source_only", "runtime_write_performed",
    "persistent_user_data_touched", "production_stage_advanced", "candidate_confirmed", "version_created",
    "export_performed", "quality_status", "visual_status", "human_status", "engine_status", "distribution_status",
    "canonicalization_policy", "canonical_sha256", "created_at"
  ],
  "properties": {
    "schema_version": {"const": "HeroUvDurableLink@1"}, "link_id": {"$ref": "#/$defs/id"},
    "project_id": {"$ref": "#/$defs/id"}, "candidate_id": {"$ref": "#/$defs/id"}, "candidate_state_sha256": {"$ref": "#/$defs/sha256"}, "base_version_id": {"$ref": "#/$defs/nullable_id"},
    "source_low_artifact_id": {"$ref": "#/$defs/id"}, "source_low_artifact_object_sha256": {"$ref": "#/$defs/sha256"}, "source_low_artifact_sha256": {"$ref": "#/$defs/sha256"},
    "source_low_artifact_readback_object_sha256": {"$ref": "#/$defs/sha256"}, "source_low_artifact_readback_sha256": {"$ref": "#/$defs/sha256"},
    "resolution": {"enum": [2048, 4096]}, "padding_texels": {"type": "integer", "minimum": 1, "maximum": 128}, "min_mip_level": {"type": "integer", "minimum": 0, "maximum": 12},
    "hard_edge_angle_deg": {"type": "number", "exclusiveMinimum": 0.1, "exclusiveMaximum": 89.9}, "stretch_threshold": {"type": "number", "minimum": 1, "maximum": 100},
    "visibility_weights_sha256": {"$ref": "#/$defs/sha256"}, "layout_object_sha256": {"$ref": "#/$defs/sha256"}, "layout_canonical_sha256": {"$ref": "#/$defs/sha256"}, "worker_build_cohort_sha256": {"$ref": "#/$defs/sha256"},
    "request_sha256": {"$ref": "#/$defs/sha256"}, "input_sha256": {"$ref": "#/$defs/sha256"}, "idempotency_key": {"$ref": "#/$defs/id"}, "replay_count": {"const": 2}, "replay_byte_exact": {"const": true},
    "link_policy": {"const": "low-artifact-to-hero-uv-layout-diagnostic@1"}, "writer_policy": {"const": "forgecad-runtime-only-state-writer@1"}, "materialization_status": {"const": "runtime-owned-durable-hero-uv-source-only@1"}, "idempotency_policy": {"const": "same-input-hash-replays-without-new-record@1"},
    "source_only": {"const": true}, "runtime_write_performed": {"const": true}, "persistent_user_data_touched": {"const": true}, "production_stage_advanced": {"const": false}, "candidate_confirmed": {"const": false}, "version_created": {"const": false}, "export_performed": {"const": false},
    "quality_status": {"const": "structural_only"}, "visual_status": {"const": "NOT_PROVEN"}, "human_status": {"const": "NOT_RUN"}, "engine_status": {"const": "NOT_RUN"}, "distribution_status": {"const": "NOT_RUN"},
    "canonicalization_policy": {"const": "canonical-json-sha256-excluding-canonical-sha256@1"}, "canonical_sha256": {"$ref": "#/$defs/sha256"}, "created_at": {"type": "string", "minLength": 1, "maxLength": 128}
  },
  "$defs": {"id": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,128}$"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "nullable_id": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9_.:-]{1,128}$"}}
}
