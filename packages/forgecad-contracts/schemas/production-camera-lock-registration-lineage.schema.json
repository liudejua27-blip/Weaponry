{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/production-camera-lock-registration-lineage.schema.json",
  "title": "ProductionCameraLockRegistrationLineage@1",
  "description": "A Runtime-owned immutable, promotable child row for one ProductionCameraLock@1. The row binds the parent lock, its candidate/reference scope, the Runtime-derived GeometryProgram@2, semantic landmark ordering, user-authored rear-three-quarter orientation and RegisteredCameraRigCalibration@2 by exact CAS object and canonical hashes. The success-only shape has no blocked diagnostic status; Runtime must reject a blocked orientation before this record is materialized.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registration_lineage_id",
    "camera_lock_id",
    "camera_lock_canonical_sha256",
    "camera_lock_receipt_object_sha256",
    "session_id",
    "project_id",
    "source_transition_id",
    "source_transition_sha256",
    "source_head_canonical_sha256",
    "candidate_id",
    "candidate_state_sha256",
    "artifact_id",
    "artifact_sha256",
    "reference_id",
    "reference_sha256",
    "reference_canvas_object_sha256",
    "reference_canvas_canonical_sha256",
    "design_spec_object_sha256",
    "design_spec_canonical_sha256",
    "subject_camera_rig_object_sha256",
    "subject_camera_rig_canonical_sha256",
    "geometry_program_object_sha256",
    "geometry_program_sha256",
    "semantic_landmark_ordering_object_sha256",
    "semantic_landmark_ordering_canonical_sha256",
    "authored_orientation_object_sha256",
    "authored_orientation_canonical_sha256",
    "authored_orientation_approval_receipt_object_sha256",
    "registered_rig_v2_object_sha256",
    "registered_rig_v2_canonical_sha256",
    "lineage_policy",
    "promotable",
    "input_sha256",
    "request_key_sha256",
    "receipt_object_sha256",
    "canonical_sha256",
    "created_at"
  ],
  "properties": {
    "schema_version": {"const": "ProductionCameraLockRegistrationLineage@1"},
    "registration_lineage_id": {"$ref": "#/$defs/id"},
    "camera_lock_id": {"$ref": "#/$defs/id"},
    "camera_lock_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "camera_lock_receipt_object_sha256": {"$ref": "#/$defs/sha256"},
    "session_id": {"$ref": "#/$defs/id"},
    "project_id": {"$ref": "#/$defs/id"},
    "source_transition_id": {"$ref": "#/$defs/id"},
    "source_transition_sha256": {"$ref": "#/$defs/sha256"},
    "source_head_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "candidate_id": {"$ref": "#/$defs/id"},
    "candidate_state_sha256": {"$ref": "#/$defs/sha256"},
    "artifact_id": {"$ref": "#/$defs/id"},
    "artifact_sha256": {"$ref": "#/$defs/sha256"},
    "reference_id": {"$ref": "#/$defs/id"},
    "reference_sha256": {"$ref": "#/$defs/sha256"},
    "reference_canvas_object_sha256": {"$ref": "#/$defs/sha256"},
    "reference_canvas_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "design_spec_object_sha256": {"$ref": "#/$defs/sha256"},
    "design_spec_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "subject_camera_rig_object_sha256": {"$ref": "#/$defs/sha256"},
    "subject_camera_rig_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "geometry_program_object_sha256": {"$ref": "#/$defs/sha256"},
    "geometry_program_sha256": {"$ref": "#/$defs/sha256"},
    "semantic_landmark_ordering_object_sha256": {"$ref": "#/$defs/sha256"},
    "semantic_landmark_ordering_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "authored_orientation_object_sha256": {"$ref": "#/$defs/sha256"},
    "authored_orientation_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "authored_orientation_approval_receipt_object_sha256": {"$ref": "#/$defs/sha256"},
    "registered_rig_v2_object_sha256": {"$ref": "#/$defs/sha256"},
    "registered_rig_v2_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "lineage_policy": {"const": "camera-lock-promotable-authored-orientation-lineage@1"},
    "promotable": {"const": true},
    "input_sha256": {"$ref": "#/$defs/sha256"},
    "request_key_sha256": {"$ref": "#/$defs/sha256"},
    "receipt_object_sha256": {"$ref": "#/$defs/sha256"},
    "canonical_sha256": {"$ref": "#/$defs/sha256"},
    "created_at": {"$ref": "#/$defs/timestamp"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullable_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "minLength": 1, "maxLength": 128}
  }
}
