    "height": {"const": 512},
    "passes": {"const": ["beauty", "silhouette", "depth", "normal", "ao", "part-id", "material-id", "wireframe", "uv-stretch"]},
    "pass_artifacts": {"type": "object", "additionalProperties": false, "required": ["beauty", "silhouette", "depth", "normal", "ao", "part-id", "material-id", "wireframe", "uv-stretch"], "properties": {"beauty": {"$ref": "#/$defs/pass"}, "silhouette": {"$ref": "#/$defs/pass"}, "depth": {"$ref": "#/$defs/pass"}, "normal": {"$ref": "#/$defs/pass"}, "ao": {"$ref": "#/$defs/pass"}, "part-id": {"$ref": "#/$defs/pass"}, "material-id": {"$ref": "#/$defs/pass"}, "wireframe": {"$ref": "#/$defs/pass"}, "uv-stretch": {"$ref": "#/$defs/pass"}}},
    "canonical_sha256": {"$ref": "common.schema.json#/$defs/sha256"}
  },
  "$defs": {
    "pass": {"type": "object", "additionalProperties": false, "required": ["sha256", "mime", "size_bytes", "width", "height", "channels", "color_space"], "properties": {"sha256": {"$ref": "common.schema.json#/$defs/sha256"}, "mime": {"const": "image/png"}, "size_bytes": {"type": "integer", "minimum": 1, "maximum": 4194304}, "width": {"const": 512}, "height": {"const": 512}, "channels": {"const": "rgba8"}, "color_space": {"enum": ["srgb", "data"]}}}
  }
}
