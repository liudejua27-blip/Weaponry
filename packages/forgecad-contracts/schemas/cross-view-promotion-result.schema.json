{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/cross-view-promotion-result.schema.json",
  "title": "ForgeCAD Cross-view Promotion Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "session_id",
    "source_candidate_id",
    "candidate_id",
    "bundle_sha256",
    "version_id",
    "snapshot_id",
    "approval_receipt_id",
    "request_sha256",
    "replayed"
  ],
  "properties": {
    "schema_version": {"const": "CrossViewPromotionResult@1"},
    "project_id": {"$ref": "#/$defs/identifier"},
    "session_id": {"$ref": "#/$defs/identifier"},
    "source_candidate_id": {"$ref": "#/$defs/identifier"},
    "candidate_id": {"$ref": "#/$defs/identifier"},
    "bundle_sha256": {"$ref": "#/$defs/sha256"},
    "version_id": {"$ref": "#/$defs/identifier"},
    "snapshot_id": {"$ref": "#/$defs/identifier"},
    "approval_receipt_id": {"$ref": "#/$defs/identifier"},
    "request_sha256": {"$ref": "#/$defs/sha256"},
    "replayed": {"type": "boolean"}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
