{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/knife-source-binding-prepare-request.schema.json",
  "title": "KnifeSourceBindingPrepareRequest@1",
  "description": "Closed prepare envelope for a Runtime-owned KnifeSourceBinding. The caller may propose only the hash-bound source lineage object; Runtime alone may persist it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "operation", "project_id", "source_binding",
    "idempotency_key", "max_response_bytes", "runtime_write_performed",
    "writer_policy", "canonicalization_policy", "input_sha256"
  ],
  "properties": {
    "schema_version": {"const": "KnifeSourceBindingPrepareRequest@1"},
    "operation": {"const": "knife_source_binding_prepare"},
    "project_id": {"$ref": "#/$defs/identifier"},
    "source_binding": {"$ref": "https://forgecad.local/contracts/knife-source-binding.schema.json"},
    "idempotency_key": {"$ref": "#/$defs/idempotency_key"},
    "max_response_bytes": {"const": 1048576},
    "runtime_write_performed": {"const": false},
    "writer_policy": {"const": "forgecad-runtime-only-state-writer@1"},
    "canonicalization_policy": {"const": "canonical-json-sha256-excluding-input-sha256@1"},
    "input_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "idempotency_key": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"}
  }
}
