{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/boolean-operand-lineage.schema.json",
  "title": "BooleanOperandLineage",
  "description": "A bounded structural projection of Manifold-evaluated Boolean triangle runs. Evaluated face IDs are not original authoring-face IDs and are not persisted in the current GLB.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "program_sha256", "operator_catalog_sha256", "boolean_node_id", "operation", "operands", "output_triangle_count", "lineage_run_count", "lineage_runs", "lineage_sha256", "lineage_kind", "materialization_status", "runtime_write_performed", "limitations", "canonical_sha256"],
  "properties": {
    "schema_version": {"const": "BooleanOperandLineage@1"},
    "program_sha256": {"$ref": "#/$defs/sha256"},
    "operator_catalog_sha256": {"$ref": "#/$defs/sha256"},
    "boolean_node_id": {"$ref": "#/$defs/identifier"},
    "operation": {"enum": ["union", "difference", "intersection"]},
    "operands": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {"$ref": "#/$defs/left_operand"},
        {"$ref": "#/$defs/right_operand"}
      ],
      "items": false
    },
    "output_triangle_count": {"type": "integer", "minimum": 1, "maximum": 250000},
    "lineage_run_count": {"type": "integer", "minimum": 1, "maximum": 4096},
    "lineage_runs": {"type": "array", "minItems": 1, "maxItems": 4096, "items": {"$ref": "#/$defs/lineage_run"}},
    "lineage_sha256": {"$ref": "#/$defs/sha256"},
    "lineage_kind": {"const": "evaluated-face-with-operand-run"},
    "materialization_status": {"const": "preview-only-not-persisted-in-glb"},
    "runtime_write_performed": {"const": false},
    "limitations": {"const": ["EVALUATED_FACE_ID_NOT_ORIGINAL_AUTHORING_FACE_ID", "FACE_IDS_NOT_STABLE_ACROSS_PROGRAM_CHANGE", "LINEAGE_NOT_PERSISTED_IN_CURRENT_GLB", "STRUCTURAL_LINEAGE_DOES_NOT_PROVE_VISUAL_QUALITY"]},
    "canonical_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,128}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_ids": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/identifier"}},
    "left_operand": {
      "type": "object", "additionalProperties": false,
      "required": ["operand", "node_id", "lineage_source_node_ids", "output_triangle_count"],
      "properties": {"operand": {"const": "left"}, "node_id": {"$ref": "#/$defs/identifier"}, "lineage_source_node_ids": {"$ref": "#/$defs/source_ids"}, "output_triangle_count": {"type": "integer", "minimum": 0, "maximum": 250000}}
    },
    "right_operand": {
      "type": "object", "additionalProperties": false,
      "required": ["operand", "node_id", "lineage_source_node_ids", "output_triangle_count"],
      "properties": {"operand": {"const": "right"}, "node_id": {"$ref": "#/$defs/identifier"}, "lineage_source_node_ids": {"$ref": "#/$defs/source_ids"}, "output_triangle_count": {"type": "integer", "minimum": 0, "maximum": 250000}}
    },
    "lineage_run": {
      "type": "object", "additionalProperties": false,
      "required": ["output_triangle_start", "output_triangle_count", "operand", "operand_node_id", "evaluated_face_id"],
      "properties": {
        "output_triangle_start": {"type": "integer", "minimum": 0, "maximum": 249999},
        "output_triangle_count": {"type": "integer", "minimum": 1, "maximum": 250000},
        "operand": {"enum": ["left", "right"]},
        "operand_node_id": {"$ref": "#/$defs/identifier"},
        "evaluated_face_id": {"type": "integer", "minimum": 0, "maximum": 4294967295}
      }
    }
  }
}
