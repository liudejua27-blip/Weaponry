{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/authoring-mesh-edit-prepare-request.schema.json",
  "title": "AuthoringMeshEditPrepareRequest",
  "description": "A closed Runtime-owned request that replays one bounded authoring mesh preview and stages its result as a candidate. It accepts no raw GeometryProgram, GLB, selection state, history blob, script, path or URL.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "source_candidate_id",
    "base_version_id",
    "preview_request",
    "expected_preview_canonical_sha256",
    "idempotency_key",
    "max_response_bytes",
    "input_sha256"
  ],
  "properties": {
    "schema_version": {"const": "AuthoringMeshEditPrepareRequest@1"},
    "project_id": {"$ref": "#/$defs/identifier"},
    "source_candidate_id": {"$ref": "#/$defs/identifier"},
    "base_version_id": {"$ref": "#/$defs/nullable_identifier"},
    "preview_request": {"$ref": "https://forgecad.local/contracts/authoring-mesh-edit-preview-request.schema.json"},
    "expected_preview_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "idempotency_key": {"$ref": "#/$defs/idempotency_key"},
    "max_response_bytes": {"const": 1048576},
    "input_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,128}$"},
    "nullable_identifier": {
      "type": ["string", "null"],
      "pattern": "^[A-Za-z0-9_.-]{1,128}$"
    },
    "idempotency_key": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
