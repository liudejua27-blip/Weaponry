{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/registered-camera-rig-calibration-v2.schema.json",
  "title": "RegisteredCameraRigCalibration@2",
  "description": "Additive commercial successor that binds RegisteredCameraRigCalibration@1 to source semantic ordering and a separately authorized rear-three-quarter board rotation plus camera orbit. Runtime must project stock/muzzle anchors through the final camera and prove the approved screen order and world-Y upright; diagnostic image transforms are never promotable.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registered_rig_v2_id",
    "project_id",
    "candidate_id",
    "candidate_state_sha256",
    "artifact_id",
    "artifact_sha256",
    "camera_lock_id",
    "camera_lock_canonical_sha256",
    "registered_rig_v1",
    "registered_rig_v1_canonical_sha256",
    "semantic_landmark_ordering",
    "semantic_landmark_ordering_object_sha256",
    "semantic_landmark_ordering_canonical_sha256",
    "rear_three_quarter_authored_orientation",
    "rear_three_quarter_authored_orientation_object_sha256",
    "rear_three_quarter_authored_orientation_canonical_sha256",
    "rear_three_quarter_semantic_orientation_proof",
    "renderer_views",
    "read_only",
    "runtime_write",
    "depth_status",
    "quality_status",
    "production_stage_advanced",
    "candidate_confirmed",
    "version_created",
    "export_performed",
    "canonical_sha256"
  ],
  "properties": {
    "schema_version": {"const": "RegisteredCameraRigCalibration@2"},
    "registered_rig_v2_id": {"$ref": "#/$defs/id"},
    "project_id": {"$ref": "#/$defs/id"},
    "candidate_id": {"$ref": "#/$defs/id"},
    "candidate_state_sha256": {"$ref": "#/$defs/sha256"},
    "artifact_id": {"$ref": "#/$defs/id"},
    "artifact_sha256": {"$ref": "#/$defs/sha256"},
    "camera_lock_id": {"$ref": "#/$defs/id"},
    "camera_lock_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "registered_rig_v1": {"$ref": "https://forgecad.local/contracts/registered-camera-rig-calibration.schema.json"},
    "registered_rig_v1_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "semantic_landmark_ordering": {"$ref": "https://forgecad.local/contracts/production-weapon-semantic-landmark-ordering.schema.json"},
    "semantic_landmark_ordering_object_sha256": {"$ref": "#/$defs/sha256"},
    "semantic_landmark_ordering_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "rear_three_quarter_authored_orientation": {"$ref": "https://forgecad.local/contracts/production-weapon-authored-view-orientation.schema.json"},
    "rear_three_quarter_authored_orientation_object_sha256": {"$ref": "#/$defs/sha256"},
    "rear_three_quarter_authored_orientation_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "rear_three_quarter_semantic_orientation_proof": {"$ref": "#/$defs/semantic_orientation_proof"},
    "renderer_views": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {"$ref": "#/$defs/registered_view"}
    },
    "read_only": {"const": true},
    "runtime_write": {"const": false},
    "depth_status": {"const": "UNKNOWN"},
    "quality_status": {"const": "NOT_EVALUATED"},
    "production_stage_advanced": {"const": false},
    "candidate_confirmed": {"const": false},
    "version_created": {"const": false},
    "export_performed": {"const": false},
    "canonical_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "semantic_orientation_proof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy", "camera_hash", "expected_subject_screen_order", "projected_subject_screen_order",
        "stock_minus_muzzle_screen_x_milli", "world_y_screen_up_dot_milli", "screen_up", "passed", "canonical_sha256"
      ],
      "properties": {
        "policy": {"const": "runtime-projected-stock-muzzle-screen-order-and-world-y-upright@1"},
        "camera_hash": {"$ref": "#/$defs/sha256"},
        "expected_subject_screen_order": {"enum": ["stock-left-muzzle-right", "muzzle-left-stock-right"]},
        "projected_subject_screen_order": {"enum": ["stock-left-muzzle-right", "muzzle-left-stock-right"]},
        "stock_minus_muzzle_screen_x_milli": {"type": "integer"},
        "world_y_screen_up_dot_milli": {"type": "integer", "minimum": 1, "maximum": 1000},
        "screen_up": {"const": "world-positive-y"},
        "passed": {"const": true},
        "canonical_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "registered_view": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "view_id",
        "kind",
        "registered_camera",
        "registered_camera_hash",
        "reference_view_id",
        "reference_view_spec_canonical_sha256",
        "authored_reference_rotation_degrees",
        "authored_subject_screen_order",
        "registered_camera_orbit_degrees",
        "orientation_authority",
        "authored_orientation_canonical_sha256",
        "semantic_view_ordering_canonical_sha256",
        "post_render_transform",
        "weight",
        "primary"
      ],
      "properties": {
        "view_id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["left", "right", "top", "bottom", "front", "back", "rear-three-quarter"]},
        "registered_camera": {"$ref": "https://forgecad.local/contracts/camera-calibration-v2.schema.json"},
        "registered_camera_hash": {"$ref": "#/$defs/sha256"},
        "reference_view_id": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
        "reference_view_spec_canonical_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "authored_reference_rotation_degrees": {"type": ["integer", "null"], "enum": [null, -180, -90, 0, 90, 180]},
        "authored_subject_screen_order": {"type": ["string", "null"], "enum": [null, "stock-left-muzzle-right", "muzzle-left-stock-right"]},
        "registered_camera_orbit_degrees": {"type": ["integer", "null"], "enum": [null, 0, 180]},
        "orientation_authority": {"enum": ["reference-view-spec", "authored-orientation-receipt", "camera-only"]},
        "authored_orientation_canonical_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "semantic_view_ordering_canonical_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "post_render_transform": {"const": "identity"},
        "weight": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "primary": {"type": "boolean"}
      }
    }
  }
}
