{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/game-weapon-animated-glb-socket-transform-projection.schema.json",
  "title": "GameWeaponAnimatedGlbSocketTransformProjection@1",
  "description": "A bounded Runtime-owned JSON projection that independently replays source and derived animated weapon GLB data into six socket local, parent-world and composed-world TRS samples. It is structural evidence only and is not visual, commercial-engine or functional weapon truth.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "projection_key_sha256", "project_id", "candidate_id",
    "candidate_state_sha256", "delivery_manifest_object_sha256", "source_artifact_sha256",
    "source_artifact_readback_sha256", "animated_artifact_sha256", "animated_artifact_readback_sha256",
    "animation_receipt_object_sha256", "animation_receipt_canonical_sha256",
    "animated_socket_materialization_key_sha256", "derived_animated_socket_artifact_sha256",
    "derived_animated_socket_artifact_readback_sha256", "derived_animated_socket_receipt_object_sha256",
    "derived_animated_socket_receipt_canonical_sha256", "anchor_set_object_sha256",
    "anchor_set_canonical_sha256", "animation_clip_id", "animation_clip_object_sha256",
    "animation_clip_canonical_sha256", "socket_node_id_encoding_sha256", "socket_node_inventory_sha256",
    "socket_roles_sha256", "socket_roles", "part_hierarchy_sha256", "part_hierarchy_policy",
    "transform_representation_policy", "sample_schedule_sha256", "sample_count", "sample_time_ticks",
    "frame_scope", "timebase_hz", "transform_projection_policy", "coordinate_system",
    "transform_convention", "float_quantization_policy", "input_sha256", "frames",
    "projection_status", "quality_status", "visual_quality_status", "commercial_fps_quality_status",
    "human_review_status", "commercial_engine_status", "runtime_write_performed",
    "restart_hash_verified", "candidate_confirmed", "version_created", "export_performed",
    "actual_engine_roundtrip", "production_stage_advanced", "limitations", "canonical_sha256",
    "created_at"
  ],
  "properties": {
    "schema_version": {"const": "GameWeaponAnimatedGlbSocketTransformProjection@1"},
    "projection_key_sha256": {"$ref": "#/$defs/sha256"},
    "project_id": {"$ref": "#/$defs/id"},
    "candidate_id": {"$ref": "#/$defs/id"},
    "candidate_state_sha256": {"$ref": "#/$defs/sha256"},
    "delivery_manifest_object_sha256": {"$ref": "#/$defs/sha256"},
    "source_artifact_sha256": {"$ref": "#/$defs/sha256"},
    "source_artifact_readback_sha256": {"$ref": "#/$defs/sha256"},
    "animated_artifact_sha256": {"$ref": "#/$defs/sha256"},
    "animated_artifact_readback_sha256": {"$ref": "#/$defs/sha256"},
    "animation_receipt_object_sha256": {"$ref": "#/$defs/sha256"},
    "animation_receipt_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "animated_socket_materialization_key_sha256": {"$ref": "#/$defs/sha256"},
    "derived_animated_socket_artifact_sha256": {"$ref": "#/$defs/sha256"},
    "derived_animated_socket_artifact_readback_sha256": {"$ref": "#/$defs/sha256"},
    "derived_animated_socket_receipt_object_sha256": {"$ref": "#/$defs/sha256"},
    "derived_animated_socket_receipt_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "anchor_set_object_sha256": {"$ref": "#/$defs/sha256"},
    "anchor_set_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "animation_clip_id": {"$ref": "#/$defs/id"},
    "animation_clip_object_sha256": {"$ref": "#/$defs/sha256"},
    "animation_clip_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "socket_node_id_encoding_sha256": {"$ref": "#/$defs/sha256"},
    "socket_node_inventory_sha256": {"$ref": "#/$defs/sha256"},
    "socket_roles_sha256": {"$ref": "#/$defs/sha256"},
    "socket_roles": {"const": ["weapon-root", "grip-primary", "muzzle-vfx", "magazine-well", "sight-primary", "energy-core-vfx"]},
    "part_hierarchy_sha256": {"$ref": "#/$defs/sha256"},
    "part_hierarchy_policy": {"const": "flat-identity-rest-part-hierarchy-only@1"},
    "transform_representation_policy": {"const": "trs-quaternion-no-matrix-no-shear@1"},
    "sample_schedule_sha256": {"$ref": "#/$defs/sha256"},
    "sample_count": {"type": "integer", "minimum": 1, "maximum": 16},
    "sample_time_ticks": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"type": "integer", "minimum": 0, "maximum": 1000000}},
    "frame_scope": {"const": "lod0-animation-frame-range-1-16@1"},
    "timebase_hz": {"const": 1000},
    "transform_projection_policy": {"const": "glb-animation-linear-nlerp-flat-part-hierarchy-composed-world-trs@1"},
    "coordinate_system": {"const": "forgecad-rh-y-up-m@1"},
    "transform_convention": {"const": "column-vector-parent-world-times-trs-quaternion-xyzw@1"},
    "float_quantization_policy": {"const": "f32-round-nearest-canonical-json@1"},
    "input_sha256": {"$ref": "#/$defs/sha256"},
    "frames": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/$defs/frame"}},
    "projection_status": {"const": "runtime-owned-durable-game-weapon-animated-glb-socket-transform-projection"},
    "quality_status": {"const": "structural_only"},
    "visual_quality_status": {"const": "NOT_PROVEN"},
    "commercial_fps_quality_status": {"const": "NOT_PROVEN"},
    "human_review_status": {"const": "NOT_RUN"},
    "commercial_engine_status": {"const": "NOT_RUN"},
    "runtime_write_performed": {"const": true},
    "restart_hash_verified": {"const": true},
    "candidate_confirmed": {"const": false},
    "version_created": {"const": false},
    "export_performed": {"const": false},
    "actual_engine_roundtrip": {"const": false},
    "production_stage_advanced": {"const": false},
    "limitations": {"const": ["flat-identity-rest-part-hierarchy-only", "nested-part-hierarchy-rejected", "nonidentity-rest-part-transform-rejected", "matrix-and-shear-rejected", "structural-transform-readback-only", "no-visual-quality-or-likeness-pass", "no-commercial-engine-roundtrip", "no-functional-weapon-semantics"]},
    "canonical_sha256": {"$ref": "#/$defs/sha256"},
    "created_at": {"$ref": "#/$defs/timestamp"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "minLength": 1, "maxLength": 64},
    "vec3": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number", "minimum": -1000.0, "maximum": 1000.0}},
    "quat": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number", "minimum": -1.0, "maximum": 1.0}},
    "pose": {
      "type": "object", "additionalProperties": false,
      "required": ["translation_m", "rotation_quat_xyzw", "scale_xyz"],
      "properties": {
        "translation_m": {"$ref": "#/$defs/vec3"},
        "rotation_quat_xyzw": {"$ref": "#/$defs/quat"},
        "scale_xyz": {"const": [1.0, 1.0, 1.0]}
      }
    },
    "socket_transform": {
      "type": "object", "additionalProperties": false,
      "required": ["socket_node_id", "anchor_id", "role", "node_index", "parent_node_index", "node_name", "parent_node_name", "node_kind", "parent_kind", "owner_part_id", "local_transform", "parent_world_transform", "composed_world_transform"],
      "properties": {
        "socket_node_id": {"$ref": "#/$defs/id"},
        "anchor_id": {"$ref": "#/$defs/id"},
        "role": {"enum": ["weapon-root", "grip-primary", "muzzle-vfx", "magazine-well", "sight-primary", "energy-core-vfx"]},
        "node_index": {"type": "integer", "minimum": 0, "maximum": 4095},
        "parent_node_index": {"type": "integer", "minimum": -1, "maximum": 4095},
        "node_name": {"$ref": "#/$defs/id"},
        "parent_node_name": {"type": ["string", "null"], "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},
        "node_kind": {"const": "empty"},
        "parent_kind": {"enum": ["synthetic-scene-root", "part-node"]},
        "owner_part_id": {"type": ["string", "null"], "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},
        "local_transform": {"$ref": "#/$defs/pose"},
        "parent_world_transform": {"$ref": "#/$defs/pose"},
        "composed_world_transform": {"$ref": "#/$defs/pose"}
      }
    },
    "frame": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "projection_key_sha256", "frame_index", "sample_time_ticks", "source_animation_sample_sha256", "derived_socket_sample_sha256", "socket_transform_inventory_sha256", "socket_transform_readback_sha256", "socket_transforms", "canonical_sha256", "created_at"],
      "properties": {
        "schema_version": {"const": "GameWeaponAnimatedGlbSocketTransformProjectionFrame@1"},
        "projection_key_sha256": {"$ref": "#/$defs/sha256"},
        "frame_index": {"type": "integer", "minimum": 0, "maximum": 15},
        "sample_time_ticks": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "source_animation_sample_sha256": {"$ref": "#/$defs/sha256"},
        "derived_socket_sample_sha256": {"$ref": "#/$defs/sha256"},
        "socket_transform_inventory_sha256": {"$ref": "#/$defs/sha256"},
        "socket_transform_readback_sha256": {"$ref": "#/$defs/sha256"},
        "socket_transforms": {"type": "array", "minItems": 6, "maxItems": 6, "uniqueItems": true, "items": {"$ref": "#/$defs/socket_transform"}},
        "canonical_sha256": {"$ref": "#/$defs/sha256"},
        "created_at": {"$ref": "#/$defs/timestamp"}
      }
    }
  }
}
