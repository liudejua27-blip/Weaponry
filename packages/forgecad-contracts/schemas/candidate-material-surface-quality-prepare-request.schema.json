{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/candidate-material-surface-quality-prepare-request.schema.json",
  "title": "CandidateMaterialSurfaceQualityPrepareRequest@1",
  "description": "Closed request for a Runtime-owned LOD0 structural material-surface quality receipt. Runtime must verify that source_candidate_id and output_candidate_id are distinct and that every supplied hash is durably bound before writing the report.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "material_surface_quality_id", "project_id",
    "source_candidate_id", "source_candidate_state_sha256", "source_artifact_id",
    "source_artifact_sha256", "source_artifact_readback_sha256",
    "source_artifact_readback_object_sha256", "source_geometry_candidate_evidence_sha256",
    "source_geometry_program_sha256", "source_topology_quality_id",
    "source_topology_quality_report_object_sha256", "source_topology_quality_canonical_sha256",
    "output_candidate_id", "output_candidate_state_sha256", "output_artifact_id",
    "output_artifact_sha256", "output_artifact_readback_sha256",
    "output_artifact_readback_object_sha256", "output_geometry_program_sha256",
    "appearance_source_lineage_sidecar_object_sha256", "appearance_source_lineage_canonical_sha256",
    "appearance_program_object_sha256", "appearance_program_sha256", "material_layer_stack_sha256",
    "material_pack_manifest_object_sha256", "material_pack_manifest_sha256",
    "material_pack_provenance_sha256", "texture_build_receipt_object_sha256",
    "texture_build_receipt_canonical_sha256", "candidate_surface_bake_receipt_object_sha256",
    "candidate_surface_bake_receipt_canonical_sha256", "uv_binding_sha256",
    "tangent_binding_sha256", "material_zone_inventory_sha256", "material_provenance_sha256",
    "lod_scope", "geometry_preservation_projection_sha256", "material_surface_quality_policy",
    "material_surface_quality_policy_sha256", "from_stage", "to_stage", "input_sha256",
    "idempotency_key"
  ],
  "properties": {
    "schema_version": {"const": "CandidateMaterialSurfaceQualityPrepareRequest@1"},
    "material_surface_quality_id": {"$ref": "#/$defs/id"},
    "project_id": {"$ref": "#/$defs/id"},
    "source_candidate_id": {"$ref": "#/$defs/id"},
    "source_candidate_state_sha256": {"$ref": "#/$defs/sha256"},
    "source_artifact_id": {"$ref": "#/$defs/id"},
    "source_artifact_sha256": {"$ref": "#/$defs/sha256"},
    "source_artifact_readback_sha256": {"$ref": "#/$defs/sha256"},
    "source_artifact_readback_object_sha256": {"$ref": "#/$defs/sha256"},
    "source_geometry_candidate_evidence_sha256": {"$ref": "#/$defs/sha256"},
    "source_geometry_program_sha256": {"$ref": "#/$defs/sha256"},
    "source_topology_quality_id": {"$ref": "#/$defs/id"},
    "source_topology_quality_report_object_sha256": {"$ref": "#/$defs/sha256"},
    "source_topology_quality_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "output_candidate_id": {"$ref": "#/$defs/id"},
    "output_candidate_state_sha256": {"$ref": "#/$defs/sha256"},
    "output_artifact_id": {"$ref": "#/$defs/id"},
    "output_artifact_sha256": {"$ref": "#/$defs/sha256"},
    "output_artifact_readback_sha256": {"$ref": "#/$defs/sha256"},
    "output_artifact_readback_object_sha256": {"$ref": "#/$defs/sha256"},
    "output_geometry_program_sha256": {"$ref": "#/$defs/sha256"},
    "appearance_source_lineage_sidecar_object_sha256": {"$ref": "#/$defs/sha256"},
    "appearance_source_lineage_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "appearance_program_object_sha256": {"$ref": "#/$defs/sha256"},
    "appearance_program_sha256": {"$ref": "#/$defs/sha256"},
    "material_layer_stack_sha256": {"$ref": "#/$defs/sha256"},
    "material_pack_manifest_object_sha256": {"$ref": "#/$defs/sha256"},
    "material_pack_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "material_pack_provenance_sha256": {"$ref": "#/$defs/sha256"},
    "texture_build_receipt_object_sha256": {"$ref": "#/$defs/sha256"},
    "texture_build_receipt_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "candidate_surface_bake_receipt_object_sha256": {"$ref": "#/$defs/sha256"},
    "candidate_surface_bake_receipt_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "uv_binding_sha256": {"$ref": "#/$defs/sha256"},
    "tangent_binding_sha256": {"$ref": "#/$defs/sha256"},
    "material_zone_inventory_sha256": {"$ref": "#/$defs/sha256"},
    "material_provenance_sha256": {"$ref": "#/$defs/sha256"},
    "lod_scope": {"const": "lod0-only@1"},
    "geometry_preservation_projection_sha256": {"$ref": "#/$defs/sha256"},
    "material_surface_quality_policy": {"const": "candidate-material-surface-structural-hard-gate@1"},
    "material_surface_quality_policy_sha256": {"$ref": "#/$defs/sha256"},
    "from_stage": {"const": "topology"},
    "to_stage": {"const": "material-surface"},
    "input_sha256": {"$ref": "#/$defs/sha256"},
    "idempotency_key": {"$ref": "#/$defs/id"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
