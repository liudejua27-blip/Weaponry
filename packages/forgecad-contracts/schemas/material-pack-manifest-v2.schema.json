{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://forgecad.local/contracts/material-pack-manifest-v2.schema.json",
  "title":"MaterialPackManifestV2",
  "type":"object","additionalProperties":false,
  "required":["schema_version","pack_id","version","publisher","status","license_spdx","source_assets","source_textures","textures","derived_outputs","texture_recipe","material_definitions","texture_sets","limits","canonical_sha256"],
  "properties":{
    "schema_version":{"const":"MaterialPackManifest@2"},
    "pack_id":{"const":"forgecad-fictional-energy-weapon-2k"},
    "version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "publisher":{"const":"forgecad-first-party"},
    "status":{"const":"development-only"},
    "license_spdx":{"const":"CC0-1.0"},
    "source_assets":{"type":"array","minItems":1,"maxItems":16,"items":{"type":"object","additionalProperties":false,"required":["asset_id","source_url","download_url","source_id","license_spdx","license_url","raw_archive_sha256","retrieved_at","derivation"],"properties":{"asset_id":{"type":"string","pattern":"^[A-Za-z0-9_.-]{1,128}$"},"source_url":{"type":"string","pattern":"^https://"},"download_url":{"type":"string","pattern":"^https://"},"source_id":{"type":"string","pattern":"^[A-Za-z0-9_.-]{1,128}$"},"license_spdx":{"const":"CC0-1.0"},"license_url":{"type":"string","pattern":"^https://"},"raw_archive_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"retrieved_at":{"type":"string","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},"derivation":{"type":"string","minLength":1,"maxLength":512}}}},
    "source_textures":{"type":"array","minItems":1,"maxItems":64,"items":{"$ref":"#/$defs/source_texture"}},
    "textures":{"type":"array","minItems":1,"maxItems":64,"items":{"$ref":"#/$defs/output_texture"}},
    "derived_outputs":{"type":"array","minItems":1,"maxItems":64,"items":{"$ref":"#/$defs/output_texture"}},
    "texture_recipe":{"type":"object","additionalProperties":false,"required":["recipe_id","algorithm","resolution","build_budget_ms","microdetail_policy","determinism","color_management","normal_convention","bake_status","external_uri","network_at_runtime"],"properties":{"recipe_id":{"const":"forgecad-first-party-catmullrom-semantic-microdetail-2k@1"},"algorithm":{"const":"catmullrom-plus-fixed-semantic-microdetail@1"},"resolution":{"const":2048},"build_budget_ms":{"const":120000},"microdetail_policy":{"const":"fixed-64px-integer-tile-semantic-perturbation@1"},"determinism":{"const":"fixed-integer-seeds-no-rng-no-time"},"color_management":{"const":"baseColor-sRGB-data-maps-linear"},"normal_convention":{"const":"OpenGL+Y"},"bake_status":{"const":"not-a-geometry-bake"},"external_uri":{"const":false},"network_at_runtime":{"const":false}}},
    "material_definitions":{"type":"array","minItems":1,"maxItems":64,"items":{"$ref":"material-definition.schema.json"}},
    "texture_sets":{"type":"array","minItems":1,"maxItems":32,"items":{"$ref":"texture-set.schema.json"}},
    "limits":{"type":"object","additionalProperties":false,"required":["max_texture_bytes","max_export_bytes","embedded_only","external_uri","output_resolution"],"properties":{"max_texture_bytes":{"const":67108864},"max_export_bytes":{"const":134217728},"embedded_only":{"const":true},"external_uri":{"const":false},"output_resolution":{"const":2048}}},
    "canonical_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}
  },
  "$defs":{
    "source_texture":{"type":"object","additionalProperties":false,"required":["source_pack_id","texture_id","sha256","semantic","color_space","normal_convention","width","height"],"properties":{"source_pack_id":{"const":"forgecad-fictional-energy-weapon"},"texture_id":{"type":"string","pattern":"^[A-Za-z0-9_.-]{1,128}$"},"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"semantic":{"enum":["baseColor","normal","roughness","metallic","ao","emissive"]},"color_space":{"enum":["sRGB","linear"]},"normal_convention":{"type":["string","null"],"enum":["OpenGL+Y",null]},"width":{"const":512},"height":{"const":512}}},
    "output_texture":{"type":"object","additionalProperties":false,"required":["texture_id","sha256","semantic","color_space","normal_convention","width","height","mime","storage"],"properties":{"texture_id":{"type":"string","pattern":"^[A-Za-z0-9_.-]{1,128}$"},"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"semantic":{"enum":["baseColor","normal","roughness","metallic","metallicRoughness","ao","emissive"]},"color_space":{"enum":["sRGB","linear"]},"normal_convention":{"type":["string","null"],"enum":["OpenGL+Y",null]},"width":{"const":2048},"height":{"const":2048},"mime":{"const":"image/png"},"storage":{"const":"runtime-derived-embedded"}}}
  }
}
