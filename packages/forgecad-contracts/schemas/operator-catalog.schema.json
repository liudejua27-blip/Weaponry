{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/operator-catalog.schema.json",
  "title": "OperatorCatalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "catalog_id",
    "geometry_program_schema_version",
    "operators",
    "canonical_sha256"
  ],
  "properties": {
    "schema_version": {"const": "OperatorCatalog@1"},
    "catalog_id": {"$ref": "#/$defs/identifier"},
    "geometry_program_schema_version": {"const": "GeometryProgram@2"},
    "operators": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {"$ref": "#/$defs/operator"}
    },
    "canonical_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]{1,128}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "operator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operator_id",
        "status",
        "input_arity",
        "output_kind",
        "parameter_schema",
        "part_output_required",
        "supported_shapes"
      ],
      "properties": {
        "operator_id": {"$ref": "#/$defs/identifier"},
        "status": {"enum": ["active", "unavailable"]},
        "input_arity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min", "max"],
          "properties": {
            "min": {"type": "integer", "minimum": 0, "maximum": 64},
            "max": {"type": "integer", "minimum": 0, "maximum": 64}
          }
        },
        "output_kind": {"const": "triangle-mesh"},
        "parameter_schema": {"$ref": "#/$defs/identifier"},
        "part_output_required": {"type": "boolean"},
        "supported_shapes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        }
      }
    }
  }
}
