{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/authoring-mesh-identity-lineage-v2-get-request.schema.json",
  "title": "AuthoringMeshIdentityLineageGetRequest@2",
  "description": "Closed read-only lookup for one immutable Runtime-owned AuthoringMeshIdentityLineage@1 entry. The request binds candidate/canonical object and payload hashes separately from the identity object and payload hashes.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "lineage_id", "revision_index", "candidate_id", "candidate_state_sha256", "canonical_mesh_id", "canonical_mesh_object_sha256", "canonical_mesh_sha256", "identity_lineage_object_sha256", "identity_lineage_sha256", "max_response_bytes", "writer_policy", "runtime_write_performed", "persistent_user_data_touched", "input_sha256"],
  "properties": {
    "schema_version": {"const": "AuthoringMeshIdentityLineageGetRequest@2"},
    "project_id": {"$ref": "#/$defs/identifier"},
    "lineage_id": {"$ref": "#/$defs/identifier"},
    "revision_index": {"type": "integer", "minimum": 0, "maximum": 1000000},
    "candidate_id": {"$ref": "#/$defs/identifier"},
    "candidate_state_sha256": {"$ref": "#/$defs/sha256"},
    "canonical_mesh_id": {"$ref": "#/$defs/identifier"},
    "canonical_mesh_object_sha256": {"$ref": "#/$defs/sha256"},
    "canonical_mesh_sha256": {"$ref": "#/$defs/sha256"},
    "identity_lineage_object_sha256": {"$ref": "#/$defs/sha256"},
    "identity_lineage_sha256": {"$ref": "#/$defs/sha256"},
    "max_response_bytes": {"const": 1048576},
    "writer_policy": {"const": "forgecad-runtime-only-state-writer@1"},
    "runtime_write_performed": {"const": false},
    "persistent_user_data_touched": {"const": false},
    "input_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,128}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
