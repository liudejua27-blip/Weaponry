{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/silhouette-target.schema.json",
  "title": "SilhouetteTarget",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "target_id",
    "reference_id",
    "reference_sha256",
    "mask_sha256",
    "width",
    "height",
    "coordinate_space",
    "source",
    "contour_points",
    "parts",
    "landmarks",
    "canonical_sha256"
  ],
  "properties": {
    "schema_version": {"const": "SilhouetteTarget@1"},
    "target_id": {"type": "string", "pattern": "^silhouette-target-[A-Za-z0-9_-]{8,80}$"},
    "reference_id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,128}$"},
    "reference_sha256": {"$ref": "#/$defs/sha256"},
    "mask_sha256": {"$ref": "#/$defs/sha256"},
    "width": {"const": 512},
    "height": {"const": 512},
    "coordinate_space": {"const": "normalized_reference_image"},
    "source": {"enum": ["automatic", "user_refined"]},
    "annotation_status": {"enum": ["unreviewed", "user_confirmed"]},
    "parent_target_sha256": {"$ref": "#/$defs/sha256"},
    "contour_points": {
      "type": "array",
      "minItems": 3,
      "maxItems": 512,
      "items": {"$ref": "#/$defs/point"}
    },
    "parts": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["part_id", "start_index", "end_index", "visibility"],
        "properties": {
          "part_id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,128}$"},
          "start_index": {"type": "integer", "minimum": 0, "maximum": 511},
          "end_index": {"type": "integer", "minimum": 0, "maximum": 511},
          "visibility": {"enum": ["observed", "inferred", "unknown"]},
          "region": {"$ref": "#/$defs/part_region"}
        }
      }
    },
    "visual_structure": {
      "$ref": "https://forgecad.local/contracts/reference-visual-structure.schema.json"
    },
    "landmarks": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["landmark_id", "x", "y", "visibility"],
        "properties": {
          "landmark_id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,128}$"},
          "x": {"type": "number", "minimum": 0, "maximum": 1},
          "y": {"type": "number", "minimum": 0, "maximum": 1},
          "visibility": {"enum": ["observed", "inferred", "unknown"]}
        }
      }
    },
    "canonical_sha256": {"$ref": "#/$defs/sha256"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"annotation_status": {"const": "unreviewed"}}
      },
      "then": {
        "properties": {
          "parts": {
            "items": {
              "properties": {"visibility": {"const": "unknown"}}
            }
          },
          "landmarks": {
            "items": {
              "properties": {"visibility": {"const": "unknown"}}
            }
          }
        }
      }
    },
    {
      "if": {
        "required": ["annotation_status"],
        "properties": {"annotation_status": {"const": "user_confirmed"}}
      },
      "then": {
        "properties": {
          "source": {"const": "user_refined"}
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "point": {
      "type": "array",
      "prefixItems": [
        {"type": "number", "minimum": 0, "maximum": 1},
        {"type": "number", "minimum": 0, "maximum": 1}
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "part_region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["region_id", "x", "y", "width", "height"],
      "properties": {
        "region_id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,128}$"},
        "x": {"type": "number", "minimum": 0, "maximum": 1},
        "y": {"type": "number", "minimum": 0, "maximum": 1},
        "width": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "height": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
      }
    }
  }
}
