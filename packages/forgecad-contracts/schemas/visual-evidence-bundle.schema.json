{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/visual-evidence-bundle.schema.json",
  "title": "VisualEvidenceBundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "bundle_id",
    "project_id",
    "candidate_id",
    "candidate_state_sha256",
    "artifact_sha256",
    "reference_id",
    "reference_sha256",
    "camera_hash",
    "render_set_sha256",
    "comparison_report_sha256",
    "quality_report_sha256",
    "stage",
    "quality_status",
    "passes",
    "pass_artifacts",
    "views",
    "selection",
    "metrics",
    "gate",
    "limitations",
    "canonical_sha256"
  ],
  "properties": {
    "schema_version": {"const": "VisualEvidenceBundle@1"},
    "bundle_id": {"$ref": "#/$defs/identifier"},
    "project_id": {"$ref": "#/$defs/identifier"},
    "candidate_id": {"$ref": "#/$defs/identifier"},
    "candidate_state_sha256": {"$ref": "#/$defs/sha256"},
    "artifact_sha256": {"$ref": "#/$defs/sha256"},
    "reference_id": {"$ref": "#/$defs/identifier"},
    "reference_sha256": {"$ref": "#/$defs/sha256"},
    "camera_hash": {"$ref": "#/$defs/sha256"},
    "render_set_sha256": {"$ref": "#/$defs/sha256"},
    "comparison_report_sha256": {"$ref": "#/$defs/sha256"},
    "quality_report_sha256": {"$ref": "#/$defs/sha256"},
    "stage": {"$ref": "#/$defs/stage"},
    "quality_status": {"$ref": "#/$defs/quality_status"},
    "passes": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/pass_name"}
    },
    "pass_artifacts": {"$ref": "#/$defs/pass_artifacts"},
    "views": {
      "type": "array",
      "minItems": 1,
      "maxItems": 9,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/view"}
    },
    "selection": {"$ref": "#/$defs/selection"},
    "metrics": {"$ref": "#/$defs/metrics"},
    "gate": {"$ref": "#/$defs/gate"},
    "limitations": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/safe_text"}
    },
    "canonical_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nullable_sha256": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "safe_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "not": {
        "anyOf": [
          {"pattern": "^[/\\\\]"},
          {"pattern": "^[A-Za-z]:[/\\\\]"},
          {"pattern": "^(file|data|https?|ftp)://"},
          {"pattern": "[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]\\s*[:=]"},
          {"pattern": "[Aa][Pp][Ii][-_]?[Kk][Ee][Yy]\\s*[:=]"},
          {"pattern": "[Ss][Ee][Cc][Rr][Ee][Tt]\\s*[:=]"},
          {"pattern": "[Bb][Ee][Aa][Rr][Ee][Rr]\\s+"},
          {"pattern": "[Tt][Oo][Kk][Ee][Nn]\\s*[:=]"}
        ]
      }
    },
    "stage": {
      "enum": [
        "reference-canvas",
        "primary-form",
        "secondary-structure",
        "tertiary-detail",
        "uv-pbr",
        "final-review"
      ]
    },
    "quality_status": {
      "enum": [
        "PARTIAL_VISIBLE_VIEW_PASS",
        "QUALITY_TARGET_NOT_MET",
        "BLOCKED_REFERENCE_COVERAGE",
        "not-run"
      ]
    },
    "pass_name": {
      "enum": ["beauty", "silhouette", "depth", "normal", "ao", "part-id", "material-id", "wireframe", "uv-stretch"]
    },
    "pass_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pass", "artifact_sha256", "mime", "width", "height", "channel_kind"],
      "properties": {
        "pass": {"$ref": "#/$defs/pass_name"},
        "artifact_sha256": {"$ref": "#/$defs/sha256"},
        "mime": {"const": "image/png"},
        "width": {"const": 512},
        "height": {"const": 512},
        "channel_kind": {"enum": ["color", "data", "mask", "id"]}
      }
    },
    "pass_artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["beauty", "silhouette", "depth", "normal", "ao", "part-id", "material-id", "wireframe", "uv-stretch"],
      "properties": {
        "beauty": {"$ref": "#/$defs/pass_artifact"},
        "silhouette": {"$ref": "#/$defs/pass_artifact"},
        "depth": {"$ref": "#/$defs/pass_artifact"},
        "normal": {"$ref": "#/$defs/pass_artifact"},
        "ao": {"$ref": "#/$defs/pass_artifact"},
        "part-id": {"$ref": "#/$defs/pass_artifact"},
        "material-id": {"$ref": "#/$defs/pass_artifact"},
        "wireframe": {"$ref": "#/$defs/pass_artifact"},
        "uv-stretch": {"$ref": "#/$defs/pass_artifact"}
      }
    },
    "view": {
      "type": "object",
      "additionalProperties": false,
      "required": ["view_id", "kind", "camera_hash", "render_set_sha256", "comparison_report_sha256", "visibility", "confidence"],
      "properties": {
        "view_id": {"$ref": "#/$defs/identifier"},
        "kind": {"enum": ["front", "back", "left", "right", "top", "perspective", "rear-three-quarter"]},
        "camera_hash": {"$ref": "#/$defs/sha256"},
        "render_set_sha256": {"$ref": "#/$defs/sha256"},
        "comparison_report_sha256": {"$ref": "#/$defs/sha256"},
        "visibility": {"enum": ["observed", "inferred", "unknown"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "allOf": [
        {
          "if": {
            "properties": {"visibility": {"const": "unknown"}},
            "required": ["visibility"]
          },
          "then": {"properties": {"confidence": {"const": 0}}}
        }
      ]
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["part_ids", "material_zone_ids", "isolation_mode", "selection_sha256"],
      "properties": {
        "part_ids": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        },
        "material_zone_ids": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        },
        "isolation_mode": {"enum": ["none", "part", "material-zone"]},
        "selection_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "metric_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "threshold", "visibility", "confidence", "evidence_sha256"],
      "properties": {
        "value": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "threshold": {"type": "number", "minimum": 0, "maximum": 1},
        "visibility": {"enum": ["observed", "inferred", "unknown"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence_sha256": {"$ref": "#/$defs/sha256"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"visibility": {"const": "unknown"}},
            "required": ["visibility"]
          },
          "then": {
            "properties": {
              "value": {"const": null},
              "confidence": {"const": 0}
            }
          }
        },
        {
          "if": {
            "properties": {"visibility": {"enum": ["observed", "inferred"]}},
            "required": ["visibility"]
          },
          "then": {"properties": {"value": {"type": "number"}}}
        }
      ]
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["silhouette_iou", "boundary_f1_4px", "bbox_edge_error", "centroid_error", "landmark_coverage", "landmark_nme", "region_median_iou", "critical_region_min_iou"],
      "properties": {
        "silhouette_iou": {"$ref": "#/$defs/metric_record"},
        "boundary_f1_4px": {"$ref": "#/$defs/metric_record"},
        "bbox_edge_error": {"$ref": "#/$defs/metric_record"},
        "centroid_error": {"$ref": "#/$defs/metric_record"},
        "landmark_coverage": {"$ref": "#/$defs/metric_record"},
        "landmark_nme": {"$ref": "#/$defs/metric_record"},
        "region_median_iou": {"$ref": "#/$defs/metric_record"},
        "critical_region_min_iou": {"$ref": "#/$defs/metric_record"}
      }
    },
    "gate_id": {
      "enum": [
        "reference-authorized",
        "reference-coverage",
        "primary-silhouette",
        "primary-proportion",
        "secondary-structure",
        "tertiary-detail",
        "visible-view",
        "uv-tangent-pbr",
        "multi-view-compare",
        "codex-typed-review",
        "human-review",
        "export-restart-hash",
        "360-reference-coverage"
      ]
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "status", "required_checks", "failed_checks", "evidence_hashes", "unlocks", "locks", "human_review_sha256", "export_restart_sha256"],
      "properties": {
        "stage": {"$ref": "#/$defs/stage"},
        "status": {"enum": ["pass", "fail", "unknown"]},
        "required_checks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 13,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/gate_id"}
        },
        "failed_checks": {
          "type": "array",
          "maxItems": 13,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/gate_id"}
        },
        "evidence_hashes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/sha256"}
        },
        "unlocks": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"enum": ["checkpoint", "rollback", "next-stage", "bounded-repair", "human-review", "export"]}
        },
        "locks": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"enum": ["tertiary-detail", "uv-pbr", "confirm", "export", "next-stage"]}
        },
        "human_review_sha256": {"$ref": "#/$defs/nullable_sha256"},
        "export_restart_sha256": {"$ref": "#/$defs/nullable_sha256"}
      }
    }
  }
}
