{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/authoring-mesh-prepare-result.schema.json",
  "title": "AuthoringMeshPrepareResult@1",
  "description": "Closed Runtime-owned durable prepare result. It returns canonical original source, evaluated sidecar and link readback while explicitly locking Stage advancement, confirmation, version creation and export.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "source_candidate_id",
    "source_candidate_state_sha256",
    "base_version_id",
    "canonical_mesh_id",
    "canonical_mesh_object_sha256",
    "canonical_mesh_sha256",
    "canonical_mesh",
    "artifact_id",
    "artifact_object_sha256",
    "artifact_sha256",
    "artifact_readback_object_sha256",
    "artifact_readback_sha256",
    "artifact",
    "link_id",
    "link_object_sha256",
    "durable_link",
    "source_program_object_sha256",
    "source_program_sha256",
    "source_lineage_sha256",
    "request_input_sha256",
    "idempotency_key",
    "replayed",
    "restart_hash_verified",
    "runtime_write_performed",
    "persistent_user_data_touched",
    "stage_advanced",
    "candidate_confirmed",
    "version_created",
    "export_performed",
    "quality_status",
    "limitations",
    "canonicalization_policy",
    "canonical_sha256"
  ],
  "properties": {
    "schema_version": {"const": "AuthoringMeshPrepareResult@1"},
    "project_id": {"$ref": "#/$defs/identifier"},
    "source_candidate_id": {"$ref": "#/$defs/identifier"},
    "source_candidate_state_sha256": {"$ref": "#/$defs/sha256"},
    "base_version_id": {"$ref": "#/$defs/nullable_identifier"},
    "canonical_mesh_id": {"$ref": "#/$defs/identifier"},
    "canonical_mesh_object_sha256": {"$ref": "#/$defs/sha256"},
    "canonical_mesh_sha256": {"$ref": "#/$defs/sha256"},
    "canonical_mesh": {"$ref": "https://forgecad.local/contracts/authoring-mesh-canonical.schema.json"},
    "artifact_id": {"$ref": "#/$defs/identifier"},
    "artifact_object_sha256": {"$ref": "#/$defs/sha256"},
    "artifact_sha256": {"$ref": "#/$defs/sha256"},
    "artifact_readback_object_sha256": {"$ref": "#/$defs/sha256"},
    "artifact_readback_sha256": {"$ref": "#/$defs/sha256"},
    "artifact": {"$ref": "https://forgecad.local/contracts/authoring-mesh-artifact.schema.json"},
    "link_id": {"$ref": "#/$defs/identifier"},
    "link_object_sha256": {"$ref": "#/$defs/sha256"},
    "durable_link": {"$ref": "https://forgecad.local/contracts/authoring-mesh-link.schema.json"},
    "source_program_object_sha256": {"$ref": "#/$defs/sha256"},
    "source_program_sha256": {"$ref": "#/$defs/sha256"},
    "source_lineage_sha256": {"$ref": "#/$defs/sha256"},
    "request_input_sha256": {"$ref": "#/$defs/sha256"},
    "idempotency_key": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},
    "replayed": {"type": "boolean"},
    "restart_hash_verified": {"type": "boolean"},
    "runtime_write_performed": {"const": true},
    "persistent_user_data_touched": {"const": true},
    "stage_advanced": {"const": false},
    "candidate_confirmed": {"const": false},
    "version_created": {"const": false},
    "export_performed": {"const": false},
    "quality_status": {"const": "structural_only"},
    "limitations": {
      "const": [
        "RUNTIME_SOLE_WRITER",
        "NO_STAGE_ADVANCEMENT",
        "NO_CANDIDATE_CONFIRM",
        "NO_VERSION_CREATED",
        "NO_EXPORT",
        "EVALUATED_IDENTITY_NON_BIJECTIVE",
        "CROSS_VERSION_STABILITY_NOT_PROVEN",
        "STRUCTURAL_ONLY_NOT_COMMERCIAL_QUALITY"
      ]
    },
    "canonicalization_policy": {"const": "canonical-json-sha256-excluding-canonical-sha256@1"},
    "canonical_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,128}$"},
    "nullable_identifier": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9_.:-]{1,128}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
