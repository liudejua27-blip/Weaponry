{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/authoring-mesh-identity-lineage-v2-prepare-request.schema.json",
  "title": "AuthoringMeshIdentityLineagePrepareRequest@2",
  "description": "Closed request for Runtime to derive one durable AuthoringMeshIdentityLineage@1 ledger entry from exact current AuthoringMesh and candidate/program/artifact/readback bindings. The caller supplies no identity elements, tombstones or correspondence; Runtime derives the ledger and preserves separate canonical object/payload hashes.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "source_candidate_id", "source_candidate_state_sha256", "base_version_id", "authoring_node_id", "part_id", "source_program_object_sha256", "source_program_sha256", "source_artifact_id", "source_artifact_object_sha256", "source_artifact_sha256", "source_artifact_readback_object_sha256", "source_artifact_readback_sha256", "source_lineage_sha256", "canonical_mesh_id", "canonical_mesh_object_sha256", "canonical_mesh_sha256", "genesis_source_mesh_sha256", "current_source_mesh_sha256", "parent_lineage_object_sha256", "parent_lineage_sha256", "operation_lineage_sha256", "expected_lineage_id", "expected_lineage_sha256", "idempotency_key", "max_response_bytes", "runtime_write_performed", "writer_policy", "canonicalization_policy", "input_sha256"],
  "properties": {
    "schema_version": {"const": "AuthoringMeshIdentityLineagePrepareRequest@2"},
    "project_id": {"$ref": "#/$defs/identifier"},
    "source_candidate_id": {"$ref": "#/$defs/identifier"},
    "source_candidate_state_sha256": {"$ref": "#/$defs/sha256"},
    "base_version_id": {"$ref": "#/$defs/nullable_identifier"},
    "authoring_node_id": {"$ref": "#/$defs/identifier"},
    "part_id": {"$ref": "#/$defs/identifier"},
    "source_program_object_sha256": {"$ref": "#/$defs/sha256"},
    "source_program_sha256": {"$ref": "#/$defs/sha256"},
    "source_artifact_id": {"$ref": "#/$defs/identifier"},
    "source_artifact_object_sha256": {"$ref": "#/$defs/sha256"},
    "source_artifact_sha256": {"$ref": "#/$defs/sha256"},
    "source_artifact_readback_object_sha256": {"$ref": "#/$defs/sha256"},
    "source_artifact_readback_sha256": {"$ref": "#/$defs/sha256"},
    "source_lineage_sha256": {"$ref": "#/$defs/sha256"},
    "canonical_mesh_id": {"$ref": "#/$defs/identifier"},
    "canonical_mesh_object_sha256": {"$ref": "#/$defs/sha256"},
    "canonical_mesh_sha256": {"$ref": "#/$defs/sha256"},
    "genesis_source_mesh_sha256": {"$ref": "#/$defs/sha256"},
    "current_source_mesh_sha256": {"$ref": "#/$defs/sha256"},
    "parent_lineage_object_sha256": {"$ref": "#/$defs/nullable_sha256"},
    "parent_lineage_sha256": {"$ref": "#/$defs/nullable_sha256"},
    "operation_lineage_sha256": {"$ref": "#/$defs/sha256"},
    "expected_lineage_id": {"$ref": "#/$defs/nullable_identifier"},
    "expected_lineage_sha256": {"$ref": "#/$defs/nullable_sha256"},
    "idempotency_key": {"$ref": "#/$defs/idempotency_key"},
    "max_response_bytes": {"const": 1048576},
    "runtime_write_performed": {"const": false},
    "writer_policy": {"const": "forgecad-runtime-only-state-writer@1"},
    "canonicalization_policy": {"const": "canonical-json-sha256-excluding-canonical-sha256@1"},
    "input_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,128}$"},
    "nullable_identifier": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9_.:-]{1,128}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullable_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "idempotency_key": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"}
  }
}
