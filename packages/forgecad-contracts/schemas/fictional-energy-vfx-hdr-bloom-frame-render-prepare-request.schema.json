{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://forgecad.local/contracts/fictional-energy-vfx-hdr-bloom-frame-render-prepare-request.schema.json",
  "title":"FictionalEnergyVfxHdrBloomFrameRenderPrepareRequest@1",
  "type":"object",
  "additionalProperties":false,
