    "project_id":{"type":"string","minLength":1,"maxLength":128,"pattern":"^[A-Za-z0-9._:-]+$"},
    "delivery_manifest_object_sha256":{"$ref":"common.schema.json#/$defs/sha256"},
    "vfx_profile_object_sha256":{"$ref":"common.schema.json#/$defs/sha256"},
    "base_frame_key_sha256":{"$ref":"common.schema.json#/$defs/sha256"},
    "bloom_profile":{"type":"object","additionalProperties":false,"required":["threshold","radius_px","intensity","hdr_clamp"],"properties":{"threshold":{"const":1.0},"radius_px":{"const":8},"intensity":{"const":4.0},"hdr_clamp":{"const":16.0}}},
    "bloom_policy":{"const":"lod0-hdr-emissive-source-two-pass-fixed-kernel-base-aov-byte-exact@1"},
