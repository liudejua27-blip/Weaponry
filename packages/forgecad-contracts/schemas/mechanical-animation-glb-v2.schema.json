    "binary_prefix_exact": {"const": true},
    "appearance_material_projection_exact": {"const": true},
    "material_pack_identity_exact": {"const": true},
    "no_skinning": {"const": true},
    "no_morph_targets": {"const": true},
    "validator_status": {"const": "strict-appearance-aware-rigid-gltf-animation-readback-pass"},
