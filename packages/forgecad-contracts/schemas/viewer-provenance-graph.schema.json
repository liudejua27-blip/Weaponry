{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/viewer-provenance-graph.schema.json",
  "title": "ViewerProvenanceGraph",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "read_only",
    "runtime_write_performed",
    "persistent_user_data_touched",
    "project_id",
    "candidate_id",
    "candidate_state_sha256",
    "artifact_id",
    "geometry_candidate_evidence_sha256",
    "max_nodes",
    "max_edges",
    "complete",
    "truncated",
    "branch_status",
    "omitted_kinds",
    "unknowns",
    "node_count",
    "edge_count",
    "nodes",
    "edges",
    "quality_status",
    "limitations",
    "canonical_sha256"
  ],
  "properties": {
    "schema_version": {"const": "ViewerProvenanceGraph@1"},
    "status": {"const": "Ready"},
    "read_only": {"const": true},
    "runtime_write_performed": {"const": false},
    "persistent_user_data_touched": {"const": false},
    "project_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "candidate_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "candidate_state_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "artifact_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "geometry_candidate_evidence_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "max_nodes": {"const": 64},
    "max_edges": {"const": 128},
    "complete": {"const": true},
    "truncated": {"const": false},
    "branch_status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["geometry", "visual", "animation"],
      "properties": {
        "geometry": {"const": "verified"},
        "visual": {"enum": ["verified", "unavailable"]},
        "animation": {"enum": ["verified", "unavailable"]}
      }
    },
    "omitted_kinds": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {"enum": ["modifier-apply-history", "boolean-preview-history", "subdivision-sidecar-history", "design-session-history"]}
    },
    "unknowns": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 128}
    },
    "node_count": {"type": "integer", "minimum": 7, "maximum": 64},
    "edge_count": {"type": "integer", "minimum": 6, "maximum": 128},
    "nodes": {
      "type": "array",
      "minItems": 7,
      "maxItems": 64,
      "items": {"$ref": "#/$defs/node"}
    },
    "edges": {
      "type": "array",
      "minItems": 6,
      "maxItems": 128,
      "items": {"$ref": "#/$defs/edge"}
    },
    "quality_status": {"const": "structural_only"},
    "limitations": {
      "const": [
        "read-only-candidate-bound-provenance-projection",
        "missing-optional-branches-are-explicitly-unavailable",
        "complete-or-fail-no-silent-truncation",
        "structural-evidence-does-not-prove-visual-quality",
        "hq-360-remains-blocked-without-complete-cross-view-evidence",
        "not-blender-dependency-graph-or-python-runtime-parity"
      ]
    },
    "canonical_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "$defs": {
    "nullable_sha256": {
      "anyOf": [
        {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        {"type": "null"}
      ]
    },
    "nullable_schema": {
      "anyOf": [
        {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}@[0-9]+$"},
        {"type": "null"}
      ]
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "kind",
        "label",
        "contract_schema",
        "object_sha256",
        "canonical_sha256",
        "status"
      ],
      "properties": {
        "node_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},
        "kind": {
          "enum": [
            "candidate",
            "geometry-evidence",
            "reference",
            "geometry-program",
            "operator-node",
            "artifact",
            "artifact-readback",
            "geometry-quality",
            "render-set",
            "render-pass",
            "comparison-report",
            "visual-quality",
            "mechanical-animation-clip"
          ]
        },
        "label": {"type": "string", "minLength": 1, "maxLength": 128},
        "contract_schema": {"$ref": "#/$defs/nullable_schema"},
        "object_sha256": {"$ref": "#/$defs/nullable_sha256"},
        "canonical_sha256": {"$ref": "#/$defs/nullable_sha256"},
        "status": {
          "enum": [
            "verified",
            "structural_only",
            "quality_target_not_met",
            "quality_passed",
            "not_run",
            "blocked",
            "unavailable"
          ]
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["edge_id", "from_node_id", "to_node_id", "relation"],
      "properties": {
        "edge_id": {"type": "string", "pattern": "^edge:[0-9]{1,4}$"},
        "from_node_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},
        "to_node_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},
        "relation": {
          "enum": [
            "binds",
            "contains",
            "feeds",
            "materializes",
            "readback",
            "evaluates",
            "references",
            "renders",
            "contains-pass",
            "compares",
            "summarizes",
            "animates"
          ]
        }
      }
    }
  }
}
