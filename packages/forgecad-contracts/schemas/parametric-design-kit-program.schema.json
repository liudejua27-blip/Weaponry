{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/parametric-design-kit-program.schema.json",
  "title": "ParametricDesignKitProgram",
  "description": "A Runtime-validated, non-persistent macro expansion. It is structural authoring evidence and must still pass geometry_prepare and visual gates.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kit_id",
    "project_id",
    "representation_plan_sha256",
    "part_id",
    "material_zone_id",
    "intent_sha256",
    "program_sha256",
    "geometry_program",
    "source_map",
    "validator_status",
    "quality_status",
    "limitations",
    "canonical_sha256"
  ],
  "properties": {
    "schema_version": {"const": "ParametricDesignKitProgram@1"},
    "kit_id": {
      "enum": [
        "forgecad.kit.housing@1",
        "forgecad.kit.panel@1",
        "forgecad.kit.vent@1",
        "forgecad.kit.channel@1",
        "forgecad.kit.energy-core@1",
        "forgecad.kit.joint@1",
        "forgecad.kit.sensor@1",
        "forgecad.kit.frame@1"
      ]
    },
    "project_id": {"$ref": "#/$defs/identifier"},
    "representation_plan_sha256": {"$ref": "#/$defs/sha256"},
    "part_id": {"$ref": "#/$defs/identifier"},
    "material_zone_id": {"$ref": "#/$defs/identifier"},
    "intent_sha256": {"$ref": "#/$defs/sha256"},
    "program_sha256": {"$ref": "#/$defs/sha256"},
    "geometry_program": {"type": "object"},
    "source_map": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["part_id", "node_id", "operator_id", "material_zone_id", "parameter_ids"],
        "properties": {
          "part_id": {"$ref": "#/$defs/identifier"},
          "node_id": {"$ref": "#/$defs/identifier"},
          "operator_id": {"$ref": "#/$defs/operator_id"},
          "material_zone_id": {"$ref": "#/$defs/identifier"},
          "parameter_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "uniqueItems": true,
            "items": {"$ref": "#/$defs/identifier"}
          }
        }
      }
    },
    "validator_status": {"const": "passed"},
    "quality_status": {"const": "structural_only"},
    "limitations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 256}
    },
    "canonical_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "operator_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
