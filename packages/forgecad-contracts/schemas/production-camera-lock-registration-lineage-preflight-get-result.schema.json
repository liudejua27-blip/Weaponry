{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/production-camera-lock-registration-lineage-preflight-get-result.schema.json",
  "title": "ProductionCameraLockRegistrationLineagePreflightGetResult@1",
  "description": "Closed zero-write authority result. A durable promotable child is the only source that can mark the orientation user-approved; diagnostic inference remains non-promotable.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operation",
    "preflight_id",
    "registration_lineage_id",
    "session_id",
    "project_id",
    "candidate_id",
    "candidate_state_sha256",
    "camera_lock_id",
    "camera_lock_canonical_sha256",
    "parent_camera_lock_status",
    "parent_camera_lock_receipt_object_sha256",
    "durable_lineage_status",
    "existing_promotable_lineage_present",
    "user_approved_orientation_present",
    "user_approved_orientation_source",
    "diagnostic_inferred_orientation_present",
    "diagnostic_inferred_rotation_degrees",
    "diagnostic_orientation_source",
    "orientation_authority_status",
    "ready_for_promotable_lineage",
    "blocking_reasons",
    "policy",
    "writer_policy",
    "runtime_write",
    "persistent_user_data_touched",
    "worker_started",
    "production_stage_advanced",
    "candidate_confirmed",
    "version_created",
    "export_performed",
    "restart_hash_verified",
    "readiness_sha256"
  ],
  "properties": {
    "schema_version": {"const": "ProductionCameraLockRegistrationLineagePreflightGetResult@1"},
    "operation": {"const": "forgecad.production.camera-lock-registration-lineage-preflight-get@1"},
    "preflight_id": {"$ref": "#/$defs/id"},
    "registration_lineage_id": {"$ref": "#/$defs/id"},
    "session_id": {"$ref": "#/$defs/id"},
    "project_id": {"$ref": "#/$defs/id"},
    "candidate_id": {"$ref": "#/$defs/id"},
    "candidate_state_sha256": {"$ref": "#/$defs/sha256"},
    "camera_lock_id": {"$ref": "#/$defs/id"},
    "camera_lock_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "parent_camera_lock_status": {"enum": ["VALID", "MISSING", "INVALID", "UNAVAILABLE"]},
    "parent_camera_lock_receipt_object_sha256": {"$ref": "#/$defs/nullable_sha256"},
    "durable_lineage_status": {"enum": ["NOT_CREATED", "EXISTING_PROMOTABLE", "EXISTING_BLOCKED", "STORE_UNAVAILABLE"]},
    "existing_promotable_lineage_present": {"type": "boolean"},
    "user_approved_orientation_present": {"type": "boolean"},
    "user_approved_orientation_source": {"type": "string", "enum": ["none", "durable-lineage-orientation-approval"]},
    "diagnostic_inferred_orientation_present": {"const": true},
    "diagnostic_inferred_rotation_degrees": {"type": "integer", "enum": [-180, -90, 0, 90, 180]},
    "diagnostic_orientation_source": {"const": "diagnostic-transform-discovery"},
    "orientation_authority_status": {"enum": ["BLOCKED_USER_APPROVAL_REQUIRED", "USER_APPROVED_DURABLE_LINEAGE"]},
    "ready_for_promotable_lineage": {"type": "boolean"},
    "blocking_reasons": {"type": "array", "items": {"type": "string"}},
    "policy": {"const": "camera-lock-user-authority-preflight@1"},
    "writer_policy": {"const": "forgecad-runtime-only-state-writer@1"},
    "runtime_write": {"const": false},
    "persistent_user_data_touched": {"const": false},
    "worker_started": {"const": false},
    "production_stage_advanced": {"const": false},
    "candidate_confirmed": {"const": false},
    "version_created": {"const": false},
    "export_performed": {"const": false},
    "restart_hash_verified": {"const": false},
    "readiness_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullable_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
  }
}
