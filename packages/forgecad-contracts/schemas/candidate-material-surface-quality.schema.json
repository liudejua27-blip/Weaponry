{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/candidate-material-surface-quality.schema.json",
  "title": "CandidateMaterialSurfaceQuality@1",
  "description": "A Runtime-owned structural material-surface receipt binding one passing topology source candidate to one distinct derived appearance candidate. Runtime must reject equal source/output candidate IDs. The receipt proves only LOD0 geometry preservation, offline 2K PBR provenance, UV/tangent/material bindings and strict readback; visual, artistic, human and commercial-engine quality remain unproven or not run.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "material_surface_quality_id", "project_id",
    "source_candidate_id", "source_candidate_state_sha256", "source_artifact_id",
    "source_artifact_sha256", "source_artifact_readback_sha256",
    "source_artifact_readback_object_sha256", "source_geometry_candidate_evidence_sha256",
    "source_geometry_program_sha256", "source_topology_quality_id",
    "source_topology_quality_report_object_sha256", "source_topology_quality_canonical_sha256",
    "output_candidate_id", "output_candidate_state_sha256", "output_artifact_id",
    "output_artifact_sha256", "output_artifact_readback_sha256",
    "output_artifact_readback_object_sha256", "output_geometry_program_sha256",
    "appearance_source_lineage_sidecar_object_sha256", "appearance_source_lineage_canonical_sha256",
    "appearance_program_object_sha256", "appearance_program_sha256", "material_layer_stack_sha256",
    "material_pack_id", "material_pack_version", "material_pack_license_spdx",
    "material_pack_manifest_object_sha256", "material_pack_manifest_sha256",
    "material_pack_provenance_sha256", "texture_build_receipt_object_sha256",
    "texture_build_receipt_canonical_sha256", "candidate_surface_bake_receipt_object_sha256",
    "candidate_surface_bake_receipt_canonical_sha256", "uv_binding_sha256",
    "tangent_binding_sha256", "material_zone_inventory_sha256", "material_provenance_sha256",
    "lod_scope", "source_output_candidate_binding_status", "geometry_preservation_projection_sha256",
    "geometry_preservation_status", "material_surface_quality_policy",
    "material_surface_quality_policy_sha256", "from_stage", "to_stage", "hard_gate",
    "validator_status", "hard_gate_passed", "visual_quality_status", "artistic_quality_status",
    "human_review_status", "commercial_fps_quality_status", "commercial_engine_status",
    "materialization_status", "quality_status", "runtime_write_performed",
    "production_stage_advanced", "candidate_confirmed", "version_created", "export_performed",
    "request_sha256", "input_sha256", "canonical_sha256", "created_at"
  ],
  "properties": {
    "schema_version": {"const": "CandidateMaterialSurfaceQuality@1"},
    "material_surface_quality_id": {"$ref": "#/$defs/id"},
    "project_id": {"$ref": "#/$defs/id"},
    "source_candidate_id": {"$ref": "#/$defs/id"},
    "source_candidate_state_sha256": {"$ref": "#/$defs/sha256"},
    "source_artifact_id": {"$ref": "#/$defs/id"},
    "source_artifact_sha256": {"$ref": "#/$defs/sha256"},
    "source_artifact_readback_sha256": {"$ref": "#/$defs/sha256"},
    "source_artifact_readback_object_sha256": {"$ref": "#/$defs/sha256"},
    "source_geometry_candidate_evidence_sha256": {"$ref": "#/$defs/sha256"},
    "source_geometry_program_sha256": {"$ref": "#/$defs/sha256"},
    "source_topology_quality_id": {"$ref": "#/$defs/id"},
    "source_topology_quality_report_object_sha256": {"$ref": "#/$defs/sha256"},
    "source_topology_quality_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "output_candidate_id": {"$ref": "#/$defs/id"},
    "output_candidate_state_sha256": {"$ref": "#/$defs/sha256"},
    "output_artifact_id": {"$ref": "#/$defs/id"},
    "output_artifact_sha256": {"$ref": "#/$defs/sha256"},
    "output_artifact_readback_sha256": {"$ref": "#/$defs/sha256"},
    "output_artifact_readback_object_sha256": {"$ref": "#/$defs/sha256"},
    "output_geometry_program_sha256": {"$ref": "#/$defs/sha256"},
    "appearance_source_lineage_sidecar_object_sha256": {"$ref": "#/$defs/sha256"},
    "appearance_source_lineage_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "appearance_program_object_sha256": {"$ref": "#/$defs/sha256"},
    "appearance_program_sha256": {"$ref": "#/$defs/sha256"},
    "material_layer_stack_sha256": {"$ref": "#/$defs/sha256"},
    "material_pack_id": {"const": "forgecad-fictional-energy-weapon-2k"},
    "material_pack_version": {"const": "1.0.0"},
    "material_pack_license_spdx": {"const": "CC0-1.0"},
    "material_pack_manifest_object_sha256": {"$ref": "#/$defs/sha256"},
    "material_pack_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "material_pack_provenance_sha256": {"$ref": "#/$defs/sha256"},
    "texture_build_receipt_object_sha256": {"$ref": "#/$defs/sha256"},
    "texture_build_receipt_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "candidate_surface_bake_receipt_object_sha256": {"$ref": "#/$defs/sha256"},
    "candidate_surface_bake_receipt_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "uv_binding_sha256": {"$ref": "#/$defs/sha256"},
    "tangent_binding_sha256": {"$ref": "#/$defs/sha256"},
    "material_zone_inventory_sha256": {"$ref": "#/$defs/sha256"},
    "material_provenance_sha256": {"$ref": "#/$defs/sha256"},
    "lod_scope": {"const": "lod0-only@1"},
    "source_output_candidate_binding_status": {"const": "distinct-candidates-verified"},
    "geometry_preservation_projection_sha256": {"$ref": "#/$defs/sha256"},
    "geometry_preservation_status": {"const": "source-output-renderable-geometry-byte-exact"},
    "material_surface_quality_policy": {"const": "candidate-material-surface-structural-hard-gate@1"},
    "material_surface_quality_policy_sha256": {"$ref": "#/$defs/sha256"},
    "from_stage": {"const": "topology"},
    "to_stage": {"const": "material-surface"},
    "hard_gate": {"$ref": "#/$defs/hard_gate"},
    "validator_status": {"enum": ["passed", "failed"]},
    "hard_gate_passed": {"type": "boolean"},
    "visual_quality_status": {"const": "NOT_PROVEN"},
    "artistic_quality_status": {"const": "NOT_PROVEN"},
    "human_review_status": {"const": "NOT_RUN"},
    "commercial_fps_quality_status": {"const": "NOT_PROVEN"},
    "commercial_engine_status": {"const": "NOT_RUN"},
    "materialization_status": {"const": "runtime-owned-durable-candidate-material-surface-quality"},
    "quality_status": {"const": "structural_only"},
    "runtime_write_performed": {"const": true},
    "production_stage_advanced": {"const": false},
    "candidate_confirmed": {"const": false},
    "version_created": {"const": false},
    "export_performed": {"const": false},
    "request_sha256": {"$ref": "#/$defs/sha256"},
    "input_sha256": {"$ref": "#/$defs/sha256"},
    "canonical_sha256": {"$ref": "#/$defs/sha256"},
    "created_at": {"type": "string", "minLength": 1, "maxLength": 128}
  },
  "allOf": [
    {
      "if": {"properties": {"hard_gate_passed": {"const": true}}, "required": ["hard_gate_passed"]},
      "then": {"properties": {"validator_status": {"const": "passed"}, "hard_gate": {"$ref": "#/$defs/passing_hard_gate"}}}
    },
    {
      "if": {"properties": {"validator_status": {"const": "passed"}}, "required": ["validator_status"]},
      "then": {"properties": {"hard_gate_passed": {"const": true}, "hard_gate": {"$ref": "#/$defs/passing_hard_gate"}}}
    }
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "hard_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "distinct_candidates", "source_topology_quality", "source_artifact_readback",
        "output_artifact_readback", "geometry_preserved", "appearance_source_lineage",
        "material_pack_2k", "texture_build_v2", "surface_bake_v1", "uv_integrity",
        "tangent_integrity", "material_provenance"
      ],
      "properties": {
        "distinct_candidates": {"type": "boolean"},
        "source_topology_quality": {"type": "boolean"},
        "source_artifact_readback": {"type": "boolean"},
        "output_artifact_readback": {"type": "boolean"},
        "geometry_preserved": {"type": "boolean"},
        "appearance_source_lineage": {"type": "boolean"},
        "material_pack_2k": {"type": "boolean"},
        "texture_build_v2": {"type": "boolean"},
        "surface_bake_v1": {"type": "boolean"},
        "uv_integrity": {"type": "boolean"},
        "tangent_integrity": {"type": "boolean"},
        "material_provenance": {"type": "boolean"}
      }
    },
    "passing_hard_gate": {
      "allOf": [
        {"$ref": "#/$defs/hard_gate"},
        {"properties": {
          "distinct_candidates": {"const": true},
          "source_topology_quality": {"const": true},
          "source_artifact_readback": {"const": true},
          "output_artifact_readback": {"const": true},
          "geometry_preserved": {"const": true},
          "appearance_source_lineage": {"const": true},
          "material_pack_2k": {"const": true},
          "texture_build_v2": {"const": true},
          "surface_bake_v1": {"const": true},
          "uv_integrity": {"const": true},
          "tangent_integrity": {"const": true},
          "material_provenance": {"const": true}
        }}
      ]
    }
  }
}
