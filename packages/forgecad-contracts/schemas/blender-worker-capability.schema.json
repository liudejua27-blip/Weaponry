{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/blender-worker-capability.schema.json",
  "title": "BlenderWorkerCapability@1",
  "description": "Closed, read-only projection of the fixed Blender headless Worker evaluation capability. This record is approved-for-evaluation only and never promotes a candidate, stage, version, or export.",
  "$comment": "ADR-0028: all evaluation gates and hashes are explicit. A capability is available only when every gate is passed and every required hash is present; otherwise it is unavailable.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "capability_id",
    "worker_id",
    "worker_kind",
    "source_identity",
    "source_revision",
    "adoption_status",
    "capability_status",
    "binary_status",
    "binary_sha256",
    "recipe_id",
    "recipe_version",
    "recipe_status",
    "recipe_sha256",
    "python_bundle_status",
    "python_bundle_sha256",
    "license_name",
    "license_spdx",
    "license_status",
    "license_file_sha256",
    "license_full_text_sha256",
    "sandbox_status",
    "sandbox_sha256",
    "determinism_status",
    "determinism_sha256",
    "package_gate_status",
    "package_sha256",
    "read_only",
    "runtime_write_performed",
    "worker_invoked",
    "candidate_generated",
    "production_stage_advanced",
    "candidate_confirmed",
    "version_created",
    "export_performed",
    "limitations",
    "canonical_sha256"
  ],
  "properties": {
    "schema_version": {"const": "BlenderWorkerCapability@1"},
    "capability_id": {"const": "blender-headless-worker-evaluation"},
    "worker_id": {"const": "blender"},
    "worker_kind": {"const": "tool/worker"},
    "source_identity": {"const": "official-reference-only-research"},
    "source_revision": {"const": "72ccdd6e96ca119a1ffa3372559cc5654343b477"},
    "adoption_status": {"const": "approved-for-evaluation"},
    "capability_status": {"enum": ["unavailable", "available"]},
    "binary_status": {"$ref": "#/$defs/gate_status"},
    "binary_sha256": {"$ref": "#/$defs/nullable_sha256"},
    "recipe_id": {"$ref": "#/$defs/nullable_id"},
    "recipe_version": {"$ref": "#/$defs/nullable_version"},
    "recipe_status": {"$ref": "#/$defs/gate_status"},
    "recipe_sha256": {"$ref": "#/$defs/nullable_sha256"},
    "python_bundle_status": {"$ref": "#/$defs/gate_status"},
    "python_bundle_sha256": {"$ref": "#/$defs/nullable_sha256"},
    "license_name": {"const": "GNU General Public License version 2 or later"},
    "license_spdx": {"const": "GPL-2.0-or-later"},
    "license_status": {"$ref": "#/$defs/gate_status"},
    "license_file_sha256": {"$ref": "#/$defs/nullable_sha256"},
    "license_full_text_sha256": {"$ref": "#/$defs/nullable_sha256"},
    "sandbox_status": {"$ref": "#/$defs/gate_status"},
    "sandbox_sha256": {"$ref": "#/$defs/nullable_sha256"},
    "determinism_status": {"$ref": "#/$defs/gate_status"},
    "determinism_sha256": {"$ref": "#/$defs/nullable_sha256"},
    "package_gate_status": {"$ref": "#/$defs/gate_status"},
    "package_sha256": {"$ref": "#/$defs/nullable_sha256"},
    "read_only": {"const": true},
    "runtime_write_performed": {"const": false},
    "worker_invoked": {"const": false},
    "candidate_generated": {"const": false},
    "production_stage_advanced": {"const": false},
    "candidate_confirmed": {"const": false},
    "version_created": {"const": false},
    "export_performed": {"const": false},
    "limitations": {
      "type": "array",
      "minItems": 0,
      "maxItems": 32,
      "items": {"$ref": "#/$defs/safe_text"}
    },
    "canonical_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "nullable_id": {
      "anyOf": [
        {"type": "null"},
        {"$ref": "#/$defs/id"}
      ]
    },
    "version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
    },
    "nullable_version": {
      "anyOf": [
        {"type": "null"},
        {"$ref": "#/$defs/version"}
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nullable_sha256": {
      "anyOf": [
        {"type": "null"},
        {"$ref": "#/$defs/sha256"}
      ]
    },
    "gate_status": {
      "enum": ["not-run", "pending", "passed", "failed", "blocked"]
    },
    "safe_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"capability_status": {"const": "available"}},
        "required": ["capability_status"]
      },
      "then": {
        "properties": {
          "binary_status": {"const": "passed"},
          "binary_sha256": {"$ref": "#/$defs/sha256"},
          "recipe_status": {"const": "passed"},
          "recipe_sha256": {"$ref": "#/$defs/sha256"},
          "python_bundle_status": {"const": "passed"},
          "python_bundle_sha256": {"$ref": "#/$defs/sha256"},
          "license_status": {"const": "passed"},
          "license_file_sha256": {"$ref": "#/$defs/sha256"},
          "license_full_text_sha256": {"$ref": "#/$defs/sha256"},
          "sandbox_status": {"const": "passed"},
          "sandbox_sha256": {"$ref": "#/$defs/sha256"},
          "determinism_status": {"const": "passed"},
          "determinism_sha256": {"$ref": "#/$defs/sha256"},
          "package_gate_status": {"const": "passed"},
          "package_sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    {
      "if": {
        "allOf": [
          {"properties": {"binary_status": {"const": "passed"}}, "required": ["binary_status"]},
          {"properties": {"recipe_status": {"const": "passed"}}, "required": ["recipe_status"]},
          {"properties": {"python_bundle_status": {"const": "passed"}}, "required": ["python_bundle_status"]},
          {"properties": {"license_status": {"const": "passed"}}, "required": ["license_status"]},
          {"properties": {"sandbox_status": {"const": "passed"}}, "required": ["sandbox_status"]},
          {"properties": {"determinism_status": {"const": "passed"}}, "required": ["determinism_status"]},
          {"properties": {"package_gate_status": {"const": "passed"}}, "required": ["package_gate_status"]},
          {"properties": {"binary_sha256": {"$ref": "#/$defs/sha256"}}, "required": ["binary_sha256"]},
          {"properties": {"recipe_sha256": {"$ref": "#/$defs/sha256"}}, "required": ["recipe_sha256"]},
          {"properties": {"python_bundle_sha256": {"$ref": "#/$defs/sha256"}}, "required": ["python_bundle_sha256"]},
          {"properties": {"license_file_sha256": {"$ref": "#/$defs/sha256"}}, "required": ["license_file_sha256"]},
          {"properties": {"license_full_text_sha256": {"$ref": "#/$defs/sha256"}}, "required": ["license_full_text_sha256"]},
          {"properties": {"sandbox_sha256": {"$ref": "#/$defs/sha256"}}, "required": ["sandbox_sha256"]},
          {"properties": {"determinism_sha256": {"$ref": "#/$defs/sha256"}}, "required": ["determinism_sha256"]},
          {"properties": {"package_sha256": {"$ref": "#/$defs/sha256"}}, "required": ["package_sha256"]}
        ]
      },
      "then": {
        "properties": {"capability_status": {"const": "available"}}
      }
    },
    {
      "if": {
        "anyOf": [
          {"properties": {"binary_status": {"enum": ["not-run", "pending", "failed", "blocked"]}}, "required": ["binary_status"]},
          {"properties": {"recipe_status": {"enum": ["not-run", "pending", "failed", "blocked"]}}, "required": ["recipe_status"]},
          {"properties": {"python_bundle_status": {"enum": ["not-run", "pending", "failed", "blocked"]}}, "required": ["python_bundle_status"]},
          {"properties": {"license_status": {"enum": ["not-run", "pending", "failed", "blocked"]}}, "required": ["license_status"]},
          {"properties": {"sandbox_status": {"enum": ["not-run", "pending", "failed", "blocked"]}}, "required": ["sandbox_status"]},
          {"properties": {"determinism_status": {"enum": ["not-run", "pending", "failed", "blocked"]}}, "required": ["determinism_status"]},
          {"properties": {"package_gate_status": {"enum": ["not-run", "pending", "failed", "blocked"]}}, "required": ["package_gate_status"]},
          {"properties": {"binary_sha256": {"type": "null"}}, "required": ["binary_sha256"]},
          {"properties": {"recipe_sha256": {"type": "null"}}, "required": ["recipe_sha256"]},
          {"properties": {"python_bundle_sha256": {"type": "null"}}, "required": ["python_bundle_sha256"]},
          {"properties": {"license_file_sha256": {"type": "null"}}, "required": ["license_file_sha256"]},
          {"properties": {"license_full_text_sha256": {"type": "null"}}, "required": ["license_full_text_sha256"]},
          {"properties": {"sandbox_sha256": {"type": "null"}}, "required": ["sandbox_sha256"]},
          {"properties": {"determinism_sha256": {"type": "null"}}, "required": ["determinism_sha256"]},
          {"properties": {"package_sha256": {"type": "null"}}, "required": ["package_sha256"]}
        ]
      },
      "then": {
        "properties": {"capability_status": {"const": "unavailable"}}
      }
    }
  ]
}
