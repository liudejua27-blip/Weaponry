{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/geometry-modifier-apply-result-v2.schema.json",
  "title": "GeometryModifierApplyResultV2",
  "description": "Runtime-owned immutable CAS sidecar for a candidate-bound single-Part selectable-edge bevel. It is structural lineage evidence only and does not prove visual quality.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "source_candidate_id",
    "source_candidate_canonical_sha256",
    "new_candidate_id",
    "base_version_id",
    "source_artifact_sha256",
    "source_artifact_readback_sha256",
    "source_geometry_candidate_evidence_sha256",
    "source_geometry_program_sha256",
    "source_operator_catalog_sha256",
    "source_readback_config_sha256",
    "source_part_id",
    "source_terminal_node_id",
    "source_authoring_topology_sha256",
    "source_edge_id",
    "derived_artifact_sha256",
    "derived_artifact_readback_sha256",
    "derived_geometry_candidate_evidence_sha256",
    "derived_geometry_program_sha256",
    "derived_program_object_sha256",
    "derived_terminal_node_id",
    "preserved_part_ids",
    "modifier_apply_request_sha256",
    "modifier_evaluation_canonical_sha256",
    "modifier_stack_definition_sha256",
    "modifier_evaluation_sha256",
    "modifier_output_sha256",
    "bevel_parameters_sha256",
    "non_target_part_bindings_sha256",
    "source_worker_build_cohort_sha256",
    "derived_worker_build_cohort_sha256",
    "materialization_status",
    "runtime_write_performed",
    "quality_status",
    "limitations",
    "canonical_sha256"
  ],
  "properties": {
    "schema_version": {"const": "GeometryModifierApplyResult@2"},
    "project_id": {"$ref": "#/$defs/identifier"},
    "source_candidate_id": {"$ref": "#/$defs/identifier"},
    "source_candidate_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "new_candidate_id": {"$ref": "#/$defs/identifier"},
    "base_version_id": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/identifier"}
      ]
    },
    "source_artifact_sha256": {"$ref": "#/$defs/sha256"},
    "source_artifact_readback_sha256": {"$ref": "#/$defs/sha256"},
    "source_geometry_candidate_evidence_sha256": {"$ref": "#/$defs/sha256"},
    "source_geometry_program_sha256": {"$ref": "#/$defs/sha256"},
    "source_operator_catalog_sha256": {"$ref": "#/$defs/sha256"},
    "source_readback_config_sha256": {"$ref": "#/$defs/sha256"},
    "source_part_id": {"$ref": "#/$defs/identifier"},
    "source_terminal_node_id": {"$ref": "#/$defs/identifier"},
    "source_authoring_topology_sha256": {"$ref": "#/$defs/sha256"},
    "source_edge_id": {"$ref": "#/$defs/identifier"},
    "derived_artifact_sha256": {"$ref": "#/$defs/sha256"},
    "derived_artifact_readback_sha256": {"$ref": "#/$defs/sha256"},
    "derived_geometry_candidate_evidence_sha256": {"$ref": "#/$defs/sha256"},
    "derived_geometry_program_sha256": {"$ref": "#/$defs/sha256"},
    "derived_program_object_sha256": {"$ref": "#/$defs/sha256"},
    "derived_terminal_node_id": {"$ref": "#/$defs/identifier"},
    "preserved_part_ids": {
      "type": "array",
      "minItems": 0,
      "maxItems": 512,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/identifier"}
    },
    "modifier_apply_request_sha256": {"$ref": "#/$defs/sha256"},
    "modifier_evaluation_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "modifier_stack_definition_sha256": {"$ref": "#/$defs/sha256"},
    "modifier_evaluation_sha256": {"$ref": "#/$defs/sha256"},
    "modifier_output_sha256": {"$ref": "#/$defs/sha256"},
    "bevel_parameters_sha256": {"$ref": "#/$defs/sha256"},
    "non_target_part_bindings_sha256": {"$ref": "#/$defs/sha256"},
    "source_worker_build_cohort_sha256": {"$ref": "#/$defs/sha256"},
    "derived_worker_build_cohort_sha256": {"$ref": "#/$defs/sha256"},
    "materialization_status": {"const": "runtime-owned-immutable-cas-sidecar"},
    "runtime_write_performed": {"const": true},
    "quality_status": {"const": "structural_only"},
    "limitations": {
      "type": "array",
      "minItems": 4,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 256}
    },
    "canonical_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,128}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
