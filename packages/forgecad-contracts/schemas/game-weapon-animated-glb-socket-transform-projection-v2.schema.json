{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/game-weapon-animated-glb-socket-transform-projection-v2.schema.json",
  "title": "GameWeaponAnimatedGlbSocketTransformProjection@2",
  "description": "Runtime-owned, appearance-candidate-bound structural projection of one MechanicalAnimationGlb@2 and one AnimatedSocket@2. It replays at most sixteen samples and exposes six fixed visual-only socket nodes as local, parent-world and composed-world TRS plus column-major matrices. It does not prove visual quality, commercial FPS quality, human review or engine round-trip.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "projection_key_sha256", "project_id", "appearance_candidate_id",
    "appearance_candidate_state_sha256", "appearance_delivery_manifest_object_sha256",
    "appearance_artifact_sha256", "appearance_artifact_readback_sha256", "animation_clip_id",
    "animation_clip_object_sha256", "animation_clip_canonical_sha256", "animation_glb_key_sha256",
    "animated_artifact_sha256", "animated_artifact_readback_sha256", "animation_receipt_object_sha256",
    "animation_receipt_canonical_sha256", "animated_socket_materialization_key_sha256",
    "derived_animated_socket_artifact_sha256", "derived_animated_socket_artifact_readback_sha256",
    "derived_animated_socket_receipt_object_sha256", "derived_animated_socket_receipt_canonical_sha256",
    "anchor_set_object_sha256", "anchor_set_canonical_sha256", "socket_node_id_encoding_sha256",
    "socket_node_inventory_sha256", "socket_roles_sha256", "socket_roles", "part_hierarchy_sha256",
    "part_hierarchy_policy", "transform_representation_policy", "sampling_policy_sha256",
    "sample_schedule_sha256", "sample_count",
    "sample_time_ticks", "frame_scope", "timebase_hz", "transform_projection_policy",
    "coordinate_system", "transform_convention", "float_quantization_policy", "input_sha256",
    "frames", "projection_status", "quality_status", "visual_quality_status",
    "commercial_fps_quality_status", "human_review_status", "commercial_engine_status",
    "runtime_write_performed", "restart_hash_verified", "candidate_confirmed", "version_created",
    "export_performed", "actual_engine_roundtrip", "production_stage_advanced", "limitations",
    "canonical_sha256", "created_at"
  ],
  "properties": {
    "schema_version": {"const": "GameWeaponAnimatedGlbSocketTransformProjection@2"},
    "projection_key_sha256": {"$ref": "#/$defs/sha256"},
    "project_id": {"$ref": "#/$defs/id"},
    "appearance_candidate_id": {"$ref": "#/$defs/id"},
    "appearance_candidate_state_sha256": {"$ref": "#/$defs/sha256"},
    "appearance_delivery_manifest_object_sha256": {"$ref": "#/$defs/sha256"},
    "appearance_artifact_sha256": {"$ref": "#/$defs/sha256"},
    "appearance_artifact_readback_sha256": {"$ref": "#/$defs/sha256"},
    "animation_clip_id": {"$ref": "#/$defs/id"},
    "animation_clip_object_sha256": {"$ref": "#/$defs/sha256"},
    "animation_clip_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "animation_glb_key_sha256": {"$ref": "#/$defs/sha256"},
    "animated_artifact_sha256": {"$ref": "#/$defs/sha256"},
    "animated_artifact_readback_sha256": {"$ref": "#/$defs/sha256"},
    "animation_receipt_object_sha256": {"$ref": "#/$defs/sha256"},
    "animation_receipt_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "animated_socket_materialization_key_sha256": {"$ref": "#/$defs/sha256"},
    "derived_animated_socket_artifact_sha256": {"$ref": "#/$defs/sha256"},
    "derived_animated_socket_artifact_readback_sha256": {"$ref": "#/$defs/sha256"},
    "derived_animated_socket_receipt_object_sha256": {"$ref": "#/$defs/sha256"},
    "derived_animated_socket_receipt_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "anchor_set_object_sha256": {"$ref": "#/$defs/sha256"},
    "anchor_set_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "socket_node_id_encoding_sha256": {"$ref": "#/$defs/sha256"},
    "socket_node_inventory_sha256": {"$ref": "#/$defs/sha256"},
    "socket_roles_sha256": {"$ref": "#/$defs/sha256"},
    "socket_roles": {"const": ["weapon-root", "grip-primary", "muzzle-vfx", "magazine-well", "sight-primary", "energy-core-vfx"]},
    "part_hierarchy_sha256": {"$ref": "#/$defs/sha256"},
    "part_hierarchy_policy": {"const": "flat-identity-rest-part-hierarchy-only@2"},
    "transform_representation_policy": {"const": "trs-quaternion-no-shear-plus-column-major-matrix@2"},
    "sampling_policy_sha256": {"$ref": "#/$defs/sha256"},
    "sample_schedule_sha256": {"$ref": "#/$defs/sha256"},
    "sample_count": {"type": "integer", "minimum": 1, "maximum": 16},
    "sample_time_ticks": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"type": "integer", "minimum": 0, "maximum": 1000000}},
    "frame_scope": {"const": "lod0-animation-frame-range-1-16@2"},
    "timebase_hz": {"const": 1000},
    "transform_projection_policy": {"const": "glb-animation-linear-nlerp-flat-part-hierarchy-composed-world-trs-matrix@2"},
    "coordinate_system": {"const": "forgecad-rh-y-up-m@1"},
    "transform_convention": {"const": "column-vector-parent-world-times-trs-quaternion-xyzw@1"},
    "float_quantization_policy": {"const": "f32-round-nearest-canonical-json@1"},
    "input_sha256": {"$ref": "#/$defs/sha256"},
    "frames": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/$defs/frame"}},
    "projection_status": {"const": "runtime-owned-durable-game-weapon-animated-glb-socket-transform-projection-v2"},
    "quality_status": {"const": "structural_only"},
    "visual_quality_status": {"const": "NOT_PROVEN"},
    "commercial_fps_quality_status": {"const": "NOT_PROVEN"},
    "human_review_status": {"const": "NOT_RUN"},
    "commercial_engine_status": {"const": "NOT_RUN"},
    "runtime_write_performed": {"const": true},
    "restart_hash_verified": {"const": true},
    "candidate_confirmed": {"const": false},
    "version_created": {"const": false},
    "export_performed": {"const": false},
    "actual_engine_roundtrip": {"const": false},
    "production_stage_advanced": {"const": false},
    "limitations": {"const": [
      "appearance-candidate-bound-mechanical-animation-glb-v2-and-animated-socket-v2",
      "parent-clip-sample-exact-or-bounded-sixteen-samples",
      "flat-identity-rest-part-hierarchy-only",
      "nested-part-hierarchy-rejected",
      "matrix-and-shear-rejected",
      "structural-transform-readback-only",
      "no-visual-quality-or-likeness-pass",
      "no-commercial-engine-roundtrip",
      "no-functional-weapon-semantics"
    ]},
    "canonical_sha256": {"$ref": "#/$defs/sha256"},
    "created_at": {"$ref": "#/$defs/timestamp"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "minLength": 1, "maxLength": 64},
    "vec3": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number", "minimum": -1000.0, "maximum": 1000.0}},
    "quat": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number", "minimum": -1.0, "maximum": 1.0}},
    "matrix4x4": {"type": "array", "minItems": 16, "maxItems": 16, "items": {"type": "number", "minimum": -1000000.0, "maximum": 1000000.0}},
    "pose": {
      "type": "object", "additionalProperties": false,
      "required": ["translation_m", "rotation_quat_xyzw", "scale_xyz"],
      "properties": {
        "translation_m": {"$ref": "#/$defs/vec3"},
        "rotation_quat_xyzw": {"$ref": "#/$defs/quat"},
        "scale_xyz": {"const": [1.0, 1.0, 1.0]}
      }
    },
    "socket_transform": {
      "type": "object", "additionalProperties": false,
      "required": [
        "socket_node_id", "anchor_id", "role", "node_index", "parent_node_index", "node_name",
        "parent_node_name", "node_kind", "parent_kind", "owner_part_id", "local_transform",
        "parent_world_transform", "composed_world_transform", "local_matrix_4x4",
        "parent_world_matrix_4x4", "composed_world_matrix_4x4"
      ],
      "properties": {
        "socket_node_id": {"$ref": "#/$defs/id"},
        "anchor_id": {"$ref": "#/$defs/id"},
        "role": {"enum": ["weapon-root", "grip-primary", "muzzle-vfx", "magazine-well", "sight-primary", "energy-core-vfx"]},
        "node_index": {"type": "integer", "minimum": 0, "maximum": 4095},
        "parent_node_index": {"type": "integer", "minimum": -1, "maximum": 4095},
        "node_name": {"$ref": "#/$defs/id"},
        "parent_node_name": {"type": ["string", "null"], "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},
        "node_kind": {"const": "empty"},
        "parent_kind": {"enum": ["synthetic-scene-root", "part-node"]},
        "owner_part_id": {"type": ["string", "null"], "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},
        "local_transform": {"$ref": "#/$defs/pose"},
        "parent_world_transform": {"$ref": "#/$defs/pose"},
        "composed_world_transform": {"$ref": "#/$defs/pose"},
        "local_matrix_4x4": {"$ref": "#/$defs/matrix4x4"},
        "parent_world_matrix_4x4": {"$ref": "#/$defs/matrix4x4"},
        "composed_world_matrix_4x4": {"$ref": "#/$defs/matrix4x4"}
      }
    },
    "frame": {
      "type": "object", "additionalProperties": false,
      "required": [
        "schema_version", "projection_key_sha256", "frame_index", "sample_time_ticks",
        "source_animation_sample_sha256", "derived_socket_sample_sha256",
        "socket_transform_inventory_sha256", "socket_transform_readback_sha256",
        "projection_frame_canonical_sha256", "socket_transforms", "canonical_sha256", "created_at"
      ],
      "properties": {
        "schema_version": {"const": "GameWeaponAnimatedGlbSocketTransformProjectionFrame@2"},
        "projection_key_sha256": {"$ref": "#/$defs/sha256"},
        "frame_index": {"type": "integer", "minimum": 0, "maximum": 15},
        "sample_time_ticks": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "source_animation_sample_sha256": {"$ref": "#/$defs/sha256"},
        "derived_socket_sample_sha256": {"$ref": "#/$defs/sha256"},
        "socket_transform_inventory_sha256": {"$ref": "#/$defs/sha256"},
        "socket_transform_readback_sha256": {"$ref": "#/$defs/sha256"},
        "projection_frame_canonical_sha256": {"$ref": "#/$defs/sha256"},
        "socket_transforms": {"type": "array", "minItems": 6, "maxItems": 6, "uniqueItems": true, "items": {"$ref": "#/$defs/socket_transform"}},
        "canonical_sha256": {"$ref": "#/$defs/sha256"},
        "created_at": {"$ref": "#/$defs/timestamp"}
      }
    }
  }
}
