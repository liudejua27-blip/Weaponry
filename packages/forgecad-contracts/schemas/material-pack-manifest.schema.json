{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://forgecad.local/contracts/material-pack-manifest.schema.json",
  "title":"MaterialPackManifest",
  "type":"object","additionalProperties":false,
  "required":["schema_version","pack_id","version","publisher","status","license_spdx","source_assets","textures","material_definitions","texture_sets","limits","canonical_sha256"],
  "properties":{
    "schema_version":{"const":"MaterialPackManifest@1"},
    "pack_id":{"type":"string","pattern":"^[A-Za-z0-9_.-]{1,128}$"},
    "version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "publisher":{"const":"forgecad-first-party"},
    "status":{"enum":["development-only","accepted"]},
    "license_spdx":{"const":"CC0-1.0"},
    "source_assets":{"type":"array","minItems":1,"maxItems":16,"items":{"type":"object","additionalProperties":false,"required":["asset_id","source_url","download_url","source_id","license_spdx","license_url","raw_archive_sha256","retrieved_at","derivation"],"properties":{"asset_id":{"type":"string","pattern":"^[A-Za-z0-9_.-]{1,128}$"},"source_url":{"type":"string","pattern":"^https://"},"download_url":{"type":"string","pattern":"^https://"},"source_id":{"type":"string","pattern":"^[A-Za-z0-9_.-]{1,128}$"},"license_spdx":{"const":"CC0-1.0"},"license_url":{"type":"string","pattern":"^https://"},"raw_archive_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"retrieved_at":{"type":"string","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},"derivation":{"type":"string","minLength":1,"maxLength":512}}}},
    "textures":{"type":"array","minItems":1,"maxItems":64,"items":{"$ref":"texture-set.schema.json#/$defs/texture"}},
    "material_definitions":{"type":"array","minItems":1,"maxItems":64,"items":{"$ref":"material-definition.schema.json"}},
    "texture_sets":{"type":"array","minItems":1,"maxItems":32,"items":{"$ref":"texture-set.schema.json"}},
    "limits":{"type":"object","additionalProperties":false,"required":["max_texture_bytes","max_export_bytes","embedded_only","external_uri"],"properties":{"max_texture_bytes":{"type":"integer","const":67108864},"max_export_bytes":{"type":"integer","const":134217728},"embedded_only":{"const":true},"external_uri":{"const":false}}},
    "canonical_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}
  }
}
