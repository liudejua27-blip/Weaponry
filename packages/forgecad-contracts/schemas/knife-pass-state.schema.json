{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/knife-pass-state.schema.json",
  "title": "KnifePassState@1",
  "description": "Closed, hash-bound state for one bounded Knife production pass. The Main object is canonicalized without embedding its own object hash; Runtime and CAS envelopes carry that external object hash.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "pass_id", "parent_pass_id", "parent_pass_sha256", "project_id", "stage",
    "source_binding_id", "source_binding_sha256", "source_binding_object_sha256",
    "intent_bundle_id", "intent_bundle_sha256", "intent_bundle_object_sha256",
    "brief_id", "brief_sha256", "brief_object_sha256",
    "reference_id", "reference_object_sha256", "reference_evidence_sha256",
    "source_candidate_id", "source_candidate_state_sha256",
    "baseline_candidate_id", "baseline_candidate_state_sha256", "baseline_artifact_sha256",
    "baseline_geometry_program_sha256", "baseline_geometry_program_object_sha256",
    "baseline_artifact_readback_object_sha256", "baseline_representation_plan_sha256",
    "attempt_candidate_id", "attempt_candidate_state_sha256", "attempt_artifact_sha256",
    "attempt_geometry_program_sha256", "attempt_geometry_program_object_sha256",
    "attempt_artifact_readback_object_sha256", "attempt_representation_plan_sha256",
    "authoring_mesh_id", "authoring_mesh_lineage_id", "authoring_mesh_revision_id",
    "authoring_mesh_revision_index", "authoring_mesh_revision_sha256",
    "authoring_mesh_revision_object_sha256", "authoring_mesh_identity_sha256",
    "authoring_mesh_sha256",
    "modifier_graph_id", "modifier_graph_sha256",
    "evaluated_mesh_id", "evaluated_mesh_sha256",
    "high_artifact_id", "high_artifact_sha256",
    "fixed_view", "camera_set_sha256",
    "render_set_id", "render_set_sha256", "render_set_object_sha256",
    "reference_comparison_id", "reference_comparison_sha256", "reference_comparison_object_sha256",
    "quality_report_id", "quality_report_sha256", "quality_report_object_sha256",
    "evidence_bundle_sha256",
    "hard_gate_status", "visual_gate_status", "quality_status", "high_status",
    "human_status", "engine_status", "unknowns", "unlocked_successor",
    "high_mesh_created", "high_stage_unlocked", "production_stage_advanced",
    "candidate_confirmed", "version_created", "export_performed",
    "canonicalization_policy", "canonical_sha256", "created_at"
  ],
  "properties": {
    "schema_version": {"const": "KnifePassState@1"},
    "pass_id": {"$ref": "#/$defs/identifier"},
    "parent_pass_id": {"$ref": "#/$defs/nullable_identifier"},
    "parent_pass_sha256": {"$ref": "#/$defs/nullable_sha256"},
    "project_id": {"$ref": "#/$defs/identifier"},
    "stage": {"enum": ["camera-lock", "silhouette-blockout", "structural-form", "secondary-form", "high-geometry"]},
    "source_binding_id": {"$ref": "#/$defs/identifier"},
    "source_binding_sha256": {"$ref": "#/$defs/sha256"},
    "source_binding_object_sha256": {"$ref": "#/$defs/sha256"},
    "intent_bundle_id": {"$ref": "#/$defs/identifier"},
    "intent_bundle_sha256": {"$ref": "#/$defs/sha256"},
    "intent_bundle_object_sha256": {"$ref": "#/$defs/sha256"},
    "brief_id": {"$ref": "#/$defs/identifier"},
    "brief_sha256": {"$ref": "#/$defs/sha256"},
    "brief_object_sha256": {"$ref": "#/$defs/sha256"},
    "reference_id": {"$ref": "#/$defs/identifier"},
    "reference_object_sha256": {"$ref": "#/$defs/sha256"},
    "reference_evidence_sha256": {"$ref": "#/$defs/sha256"},
    "source_candidate_id": {"$ref": "#/$defs/identifier"},
    "source_candidate_state_sha256": {"$ref": "#/$defs/sha256"},
    "baseline_candidate_id": {"$ref": "#/$defs/identifier"},
    "baseline_candidate_state_sha256": {"$ref": "#/$defs/sha256"},
    "baseline_artifact_sha256": {"$ref": "#/$defs/sha256"},
    "baseline_geometry_program_sha256": {"$ref": "#/$defs/sha256"},
    "baseline_geometry_program_object_sha256": {"$ref": "#/$defs/sha256"},
    "baseline_artifact_readback_object_sha256": {"$ref": "#/$defs/sha256"},
    "baseline_representation_plan_sha256": {"$ref": "#/$defs/sha256"},
    "attempt_candidate_id": {"$ref": "#/$defs/identifier"},
    "attempt_candidate_state_sha256": {"$ref": "#/$defs/sha256"},
    "attempt_artifact_sha256": {"$ref": "#/$defs/sha256"},
    "attempt_geometry_program_sha256": {"$ref": "#/$defs/sha256"},
    "attempt_geometry_program_object_sha256": {"$ref": "#/$defs/sha256"},
    "attempt_artifact_readback_object_sha256": {"$ref": "#/$defs/sha256"},
    "attempt_representation_plan_sha256": {"$ref": "#/$defs/sha256"},
    "authoring_mesh_id": {"$ref": "#/$defs/identifier"},
    "authoring_mesh_lineage_id": {"$ref": "#/$defs/identifier"},
    "authoring_mesh_revision_id": {"$ref": "#/$defs/identifier"},
    "authoring_mesh_revision_index": {"$ref": "#/$defs/revision_index"},
    "authoring_mesh_revision_sha256": {"$ref": "#/$defs/sha256"},
    "authoring_mesh_revision_object_sha256": {"$ref": "#/$defs/sha256"},
    "authoring_mesh_identity_sha256": {"$ref": "#/$defs/sha256"},
    "authoring_mesh_sha256": {"$ref": "#/$defs/sha256"},
    "modifier_graph_id": {"$ref": "#/$defs/nullable_identifier"},
    "modifier_graph_sha256": {"$ref": "#/$defs/nullable_sha256"},
    "evaluated_mesh_id": {"$ref": "#/$defs/nullable_identifier"},
    "evaluated_mesh_sha256": {"$ref": "#/$defs/nullable_sha256"},
    "high_artifact_id": {"$ref": "#/$defs/nullable_identifier"},
    "high_artifact_sha256": {"$ref": "#/$defs/nullable_sha256"},
    "fixed_view": {"$ref": "#/$defs/fixed_view"},
    "camera_set_sha256": {"$ref": "#/$defs/sha256"},
    "render_set_id": {"$ref": "#/$defs/identifier"},
    "render_set_sha256": {"$ref": "#/$defs/sha256"},
    "render_set_object_sha256": {"$ref": "#/$defs/sha256"},
    "reference_comparison_id": {"$ref": "#/$defs/identifier"},
    "reference_comparison_sha256": {"$ref": "#/$defs/sha256"},
    "reference_comparison_object_sha256": {"$ref": "#/$defs/sha256"},
    "quality_report_id": {"$ref": "#/$defs/identifier"},
    "quality_report_sha256": {"$ref": "#/$defs/sha256"},
    "quality_report_object_sha256": {"$ref": "#/$defs/sha256"},
    "evidence_bundle_sha256": {"$ref": "#/$defs/sha256"},
    "hard_gate_status": {"enum": ["NOT_RUN", "BLOCKED", "FAIL", "PASS_SOURCE_STRUCTURAL"]},
    "visual_gate_status": {"enum": ["NOT_RUN", "QUALITY_TARGET_NOT_MET", "BLOCKED_REFERENCE_COVERAGE"]},
    "quality_status": {"enum": ["NOT_RUN", "QUALITY_TARGET_NOT_MET", "BLOCKED_REFERENCE_COVERAGE"]},
    "high_status": {"enum": ["NOT_RUN", "BLOCKED"]},
    "human_status": {"const": "NOT_RUN"},
    "engine_status": {"const": "NOT_RUN"},
    "unknowns": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/unknown"}
    },
    "unlocked_successor": {"enum": ["none", "silhouette-blockout", "structural-form", "secondary-form", "high-geometry"]},
    "high_mesh_created": {"const": false},
    "high_stage_unlocked": {"const": false},
    "production_stage_advanced": {"const": false},
    "candidate_confirmed": {"const": false},
    "version_created": {"const": false},
    "export_performed": {"const": false},
    "canonicalization_policy": {"const": "canonical-json-sha256-excluding-canonical-sha256@1"},
    "canonical_sha256": {"$ref": "#/$defs/sha256"},
    "created_at": {"type": "string", "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "nullable_identifier": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullable_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "revision_index": {"type": "integer", "minimum": 0, "maximum": 1000000},
    "safe_text": {"type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^[^\\u0000-\\u001f\\u007f]*$"},
    "fixed_view": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "view_id", "view_kind", "comparison_role", "reference_required", "camera_id",
        "camera_sha256", "reference_view_id", "reference_view_sha256", "fixed_view_policy"
      ],
      "properties": {
        "view_id": {"$ref": "#/$defs/identifier"},
        "view_kind": {"enum": ["front", "back", "left", "right", "front-three-quarter", "rear-three-quarter", "top", "bottom", "fps-inspect"]},
        "comparison_role": {"const": "primary-reference"},
        "reference_required": {"const": true},
        "camera_id": {"$ref": "#/$defs/identifier"},
        "camera_sha256": {"$ref": "#/$defs/sha256"},
        "reference_view_id": {"$ref": "#/$defs/identifier"},
        "reference_view_sha256": {"$ref": "#/$defs/sha256"},
        "fixed_view_policy": {"const": "single-runtime-bound-primary-reference-view@1"}
      }
    },
    "unknown": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unknown_id", "category", "view_kind", "description", "impact", "status"],
      "properties": {
        "unknown_id": {"$ref": "#/$defs/identifier"},
        "category": {"enum": ["reference-coverage", "silhouette", "proportion", "material", "topology", "lineage"]},
        "view_kind": {"enum": ["front", "back", "left", "right", "front-three-quarter", "rear-three-quarter", "top", "bottom", "fps-inspect"]},
        "description": {"$ref": "#/$defs/safe_text"},
        "impact": {"const": "blocking"},
        "status": {"const": "open"}
      }
    }
  }
}
