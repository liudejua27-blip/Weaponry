{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/production-stage-head-v2.schema.json",
  "title": "ProductionStageHead@2",
  "description": "A Runtime-owned structural production head that binds a passed topology root candidate to a distinct passed material-surface output candidate. Invalid or failed quality input is rejected before any write; this record is not a confirmation, version, export or visual/commercial quality receipt.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "session_id",
    "project_id",
    "root_candidate_id",
    "root_candidate_role",
    "root_candidate_state_sha256",
    "source_artifact_id",
    "root_artifact_sha256",
    "root_stage",
    "previous_head_candidate_id",
    "previous_head_candidate_role",
    "previous_head_candidate_state_sha256",
    "previous_head_artifact_id",
    "previous_head_artifact_sha256",
    "previous_head_stage",
    "head_candidate_id",
    "head_candidate_role",
    "head_candidate_state_sha256",
    "output_artifact_id",
    "head_artifact_sha256",
    "head_stage",
    "topology_quality_id",
    "topology_quality_status",
    "topology_quality_report_object_sha256",
    "topology_quality_canonical_sha256",
    "material_surface_quality_id",
    "material_surface_quality_status",
    "material_surface_quality_report_object_sha256",
    "material_surface_quality_canonical_sha256",
    "reference_id",
    "reference_sha256",
    "camera_hash",
    "evidence_sha256",
    "approval_receipt_id",
    "approval_session_id",
    "approval_expires_at",
    "approval_summary_sha256",
    "candidate_binding_status",
    "quality_status",
    "visual_quality_status",
    "commercial_fps_quality_status",
    "candidate_confirmed",
    "version_created",
    "export_performed",
    "head_transition_id",
    "head_transition_sha256",
    "parent_topology_transition_id",
    "parent_topology_transition_sha256",
    "parent_topology_transition_schema_version",
    "materialization_status",
    "canonical_sha256",
    "updated_at"
  ],
  "properties": {
    "schema_version": {"const": "ProductionStageHead@2"},
    "session_id": {"$ref": "#/$defs/id"},
    "project_id": {"$ref": "#/$defs/id"},
    "root_candidate_id": {"$ref": "#/$defs/id"},
    "root_candidate_role": {"const": "topology-source"},
    "root_candidate_state_sha256": {"$ref": "#/$defs/sha256"},
    "source_artifact_id": {"$ref": "#/$defs/id"},
    "root_artifact_sha256": {"$ref": "#/$defs/sha256"},
    "root_stage": {"const": "topology"},
    "previous_head_candidate_id": {"$ref": "#/$defs/id"},
    "previous_head_candidate_role": {"const": "topology-source"},
    "previous_head_candidate_state_sha256": {"$ref": "#/$defs/sha256"},
    "previous_head_artifact_id": {"$ref": "#/$defs/id"},
    "previous_head_artifact_sha256": {"$ref": "#/$defs/sha256"},
    "previous_head_stage": {"const": "topology"},
    "head_candidate_id": {"$ref": "#/$defs/id"},
    "head_candidate_role": {"const": "material-surface-output"},
    "head_candidate_state_sha256": {"$ref": "#/$defs/sha256"},
    "output_artifact_id": {"$ref": "#/$defs/id"},
    "head_artifact_sha256": {"$ref": "#/$defs/sha256"},
    "head_stage": {"const": "material-surface"},
    "topology_quality_id": {"$ref": "#/$defs/id"},
    "topology_quality_status": {"const": "passed"},
    "topology_quality_report_object_sha256": {"$ref": "#/$defs/sha256"},
    "topology_quality_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "material_surface_quality_id": {"$ref": "#/$defs/id"},
    "material_surface_quality_status": {"const": "passed"},
    "material_surface_quality_report_object_sha256": {"$ref": "#/$defs/sha256"},
    "material_surface_quality_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "reference_id": {"$ref": "#/$defs/id"},
    "reference_sha256": {"$ref": "#/$defs/sha256"},
    "camera_hash": {"$ref": "#/$defs/sha256"},
    "evidence_sha256": {"$ref": "#/$defs/sha256"},
    "approval_receipt_id": {"$ref": "#/$defs/id"},
    "approval_session_id": {"$ref": "#/$defs/id"},
    "approval_expires_at": {"type": "string", "pattern": "^[0-9]{1,10}$"},
    "approval_summary_sha256": {"$ref": "#/$defs/sha256"},
    "candidate_binding_status": {"const": "distinct-root-topology-to-material-surface-head"},
    "quality_status": {"const": "structural_only"},
    "visual_quality_status": {"const": "NOT_PROVEN"},
    "commercial_fps_quality_status": {"const": "NOT_PROVEN"},
    "candidate_confirmed": {"const": false},
    "version_created": {"const": false},
    "export_performed": {"const": false},
    "head_transition_id": {"$ref": "#/$defs/id"},
    "head_transition_sha256": {"$ref": "#/$defs/sha256"},
    "parent_topology_transition_id": {"$ref": "#/$defs/id"},
    "parent_topology_transition_sha256": {"$ref": "#/$defs/sha256"},
    "parent_topology_transition_schema_version": {"const": "ProductionStageTransition@1"},
    "materialization_status": {"const": "runtime-owned-durable-production-stage-head-v2"},
    "canonical_sha256": {"$ref": "#/$defs/sha256"},
    "updated_at": {"$ref": "#/$defs/timestamp"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "minLength": 1, "maxLength": 128}
  }
}
