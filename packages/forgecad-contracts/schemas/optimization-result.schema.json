{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/optimization-result.schema.json",
  "title": "ForgeCAD Optimization Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "job_id", "intent_sha256", "status", "baseline_loss", "best_loss", "non_regressing", "strict_improvement", "best_evaluation_id", "best_program_sha256", "best_program_object_sha256", "best_artifact_sha256", "evaluations_count", "fidelity_counts", "evaluation_object_sha256s", "checkpoint_sequence", "next_stage", "search_strategy", "candidate_program_object_sha256s", "candidate_artifact_object_sha256s", "proposal_status", "blocked_reasons", "canonical_sha256"],
  "properties": {
    "schema_version": {"const": "OptimizationResult@1"},
    "job_id": {"$ref": "#/$defs/id"},
    "intent_sha256": {"$ref": "#/$defs/sha256"},
    "evaluation_objective_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "promotion_policy": {"enum": ["legacy-multi-objective-v1", "silhouette-evaluation-objective-v1"]},
    "promotion_status": {"enum": ["not-ready", "ready", "blocked", "blocked_global_or_part_objective"]},
    "status": {"enum": ["running", "succeeded", "failed", "cancelled"]},
    "baseline_loss": {"type": "number", "minimum": 0, "maximum": 1000000},
    "best_loss": {"type": "number", "minimum": 0, "maximum": 1000000},
    "non_regressing": {"type": "boolean"},
    "strict_improvement": {"type": "boolean"},
    "best_evaluation_id": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "best_evaluation_fidelity": {"type": ["string", "null"], "enum": ["coarse", "mid", "final", null]},
    "best_program_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "best_program_object_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "best_artifact_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "proposal_program_object_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "proposal_artifact_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "evaluations_count": {"type": "integer", "minimum": 0, "maximum": 64},
    "fidelity_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coarse", "mid", "final"],
      "properties": {
        "coarse": {"type": "integer", "minimum": 0, "maximum": 48},
        "mid": {"type": "integer", "minimum": 0, "maximum": 8},
      "final": {"type": "integer", "minimum": 0, "maximum": 3}
      }
    },
    "evaluation_object_sha256s": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/sha256"}},
    "checkpoint_sequence": {"type": "integer", "minimum": 0, "maximum": 64},
    "next_stage": {"enum": ["coarse", "mid", "final", "done"]},
    "search_strategy": {"const": "seed-then-adaptive-trust-region-v5-surface-control-groups-final-top-k-plus-baseline"},
    "candidate_program_object_sha256s": {"type": "array", "minItems": 1, "maxItems": 48, "items": {"$ref": "#/$defs/sha256"}},
    "candidate_artifact_object_sha256s": {"type": "array", "minItems": 1, "maxItems": 48, "items": {"$ref": "#/$defs/sha256"}},
    "proposal_status": {"enum": ["not-ready", "proposed", "blocked-no-improvement", "blocked-invalid"]},
    "blocked_reasons": {"type": "array", "maxItems": 16, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
    "canonical_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
