{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/production-camera-lock-registration-lineage-prepare-result.schema.json",
  "title": "ProductionCameraLockRegistrationLineagePrepareResult@1",
  "description": "Closed Runtime-owned result for one persisted CameraLock child lineage. All object/canonical hashes are Runtime-derived and the nested success-only lineage is promotable only when its authored orientation was approved; a blocked diagnostic cannot be serialized as this result. Preparation never advances a production stage, confirms a candidate, creates a version or exports.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operation",
    "registration_lineage_id",
    "registration_lineage",
    "session_id",
    "project_id",
    "camera_lock_id",
    "camera_lock_canonical_sha256",
    "camera_lock_receipt_object_sha256",
    "candidate_id",
    "candidate_state_sha256",
    "artifact_id",
    "artifact_sha256",
    "geometry_program_object_sha256",
    "geometry_program_sha256",
    "semantic_landmark_ordering_id",
    "semantic_landmark_ordering_object_sha256",
    "semantic_landmark_ordering_canonical_sha256",
    "authored_orientation_id",
    "authored_orientation_object_sha256",
    "authored_orientation_canonical_sha256",
    "authored_orientation_approval_receipt_object_sha256",
    "authored_orientation_status",
    "registered_rig_v2_id",
    "registered_rig_v2_object_sha256",
    "registered_rig_v2_canonical_sha256",
    "lineage_policy",
    "promotable",
    "request_sha256",
    "request_input_sha256",
    "input_sha256",
    "request_key_sha256",
    "receipt_object_sha256",
    "idempotency_key",
    "replayed",
    "restart_hash_verified",
    "writer_policy",
    "runtime_write_performed",
    "persistent_user_data_touched",
    "production_stage_advanced",
    "candidate_confirmed",
    "version_created",
    "export_performed",
    "quality_status",
    "depth_status",
    "canonicalization_policy",
    "canonical_sha256"
  ],
  "properties": {
    "schema_version": {"const": "ProductionCameraLockRegistrationLineagePrepareResult@1"},
    "operation": {"const": "forgecad.production.camera-lock-registration-lineage-prepare@1"},
    "registration_lineage_id": {"$ref": "#/$defs/id"},
    "registration_lineage": {"$ref": "https://forgecad.local/contracts/production-camera-lock-registration-lineage.schema.json"},
    "session_id": {"$ref": "#/$defs/id"},
    "project_id": {"$ref": "#/$defs/id"},
    "camera_lock_id": {"$ref": "#/$defs/id"},
    "camera_lock_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "camera_lock_receipt_object_sha256": {"$ref": "#/$defs/sha256"},
    "candidate_id": {"$ref": "#/$defs/id"},
    "candidate_state_sha256": {"$ref": "#/$defs/sha256"},
    "artifact_id": {"$ref": "#/$defs/id"},
    "artifact_sha256": {"$ref": "#/$defs/sha256"},
    "geometry_program_object_sha256": {"$ref": "#/$defs/sha256"},
    "geometry_program_sha256": {"$ref": "#/$defs/sha256"},
    "semantic_landmark_ordering_id": {"$ref": "#/$defs/id"},
    "semantic_landmark_ordering_object_sha256": {"$ref": "#/$defs/sha256"},
    "semantic_landmark_ordering_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "authored_orientation_id": {"$ref": "#/$defs/id"},
    "authored_orientation_object_sha256": {"$ref": "#/$defs/sha256"},
    "authored_orientation_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "authored_orientation_approval_receipt_object_sha256": {"$ref": "#/$defs/sha256"},
    "authored_orientation_status": {"const": "APPROVED_AUTHORED_REFERENCE_ORIENTATION"},
    "registered_rig_v2_id": {"$ref": "#/$defs/id"},
    "registered_rig_v2_object_sha256": {"$ref": "#/$defs/sha256"},
    "registered_rig_v2_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "lineage_policy": {"const": "camera-lock-promotable-authored-orientation-lineage@1"},
    "promotable": {"const": true},
    "request_sha256": {"$ref": "#/$defs/sha256"},
    "request_input_sha256": {"$ref": "#/$defs/sha256"},
    "input_sha256": {"$ref": "#/$defs/sha256"},
    "request_key_sha256": {"$ref": "#/$defs/sha256"},
    "receipt_object_sha256": {"$ref": "#/$defs/sha256"},
    "idempotency_key": {"$ref": "#/$defs/id"},
    "replayed": {"type": "boolean"},
    "restart_hash_verified": {"const": true},
    "writer_policy": {"const": "forgecad-runtime-only-state-writer@1"},
    "runtime_write_performed": {"const": true},
    "persistent_user_data_touched": {"const": true},
    "production_stage_advanced": {"const": false},
    "candidate_confirmed": {"const": false},
    "version_created": {"const": false},
    "export_performed": {"const": false},
    "quality_status": {"const": "structural_only"},
    "depth_status": {"const": "UNKNOWN"},
    "canonicalization_policy": {"const": "canonical-json-sha256-excluding-canonical-sha256@1"},
    "canonical_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullable_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
  }
}
