    "source_material_surface_quality_report_object_sha256", "source_material_surface_quality_canonical_sha256",
    "candidate_id", "candidate_state_sha256", "artifact_id", "artifact_sha256",
    "delivery_manifest_object_sha256", "anchor_set_object_sha256", "anchor_set_canonical_sha256",
    "animation_clip_id", "animation_clip_object_sha256", "animation_clip_sha256",
    "animated_socket_materialization_key_sha256", "animated_artifact_sha256",
    "animation_receipt_object_sha256", "animation_receipt_canonical_sha256",
    "derived_animated_socket_artifact_sha256", "animated_socket_receipt_object_sha256",
    "vfx_profile_object_sha256", "vfx_profile_canonical_sha256", "vfx_sequence_key_sha256",
    "vfx_sequence_canonical_sha256", "vfx_frame_key_sha256", "vfx_frame_canonical_sha256",
    "vfx_bloom_key_sha256", "vfx_bloom_canonical_sha256", "vfx_particle_key_sha256",
    "vfx_particle_canonical_sha256", "vfx_trail_key_sha256", "vfx_trail_canonical_sha256",
    "vfx_trail_bloom_key_sha256", "vfx_trail_bloom_canonical_sha256",
    "particle_history_key_sha256s", "sample_request_sha256", "camera_object_sha256",
    "camera_identity_sha256", "render_profile_sha256", "render_worker_build_cohort_sha256",
    "animation_vfx_scope", "animation_vfx_policy", "animation_vfx_policy_sha256",
    "from_stage", "to_stage", "input_sha256", "idempotency_key"
  ],
  "properties": {
    "schema_version": {"const": "CandidateAnimationVfxQualityPrepareRequest@1"},
    "animation_vfx_quality_id": {"$ref": "#/$defs/id"}, "project_id": {"$ref": "#/$defs/id"},
    "source_material_surface_transition_id": {"$ref": "#/$defs/id"},
    "source_material_surface_transition_sha256": {"$ref": "#/$defs/sha256"},
    "source_material_surface_head_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "source_material_surface_quality_id": {"$ref": "#/$defs/id"},
    "source_material_surface_quality_report_object_sha256": {"$ref": "#/$defs/sha256"},
    "source_material_surface_quality_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "candidate_id": {"$ref": "#/$defs/id"}, "candidate_state_sha256": {"$ref": "#/$defs/sha256"},
    "artifact_id": {"$ref": "#/$defs/id"}, "artifact_sha256": {"$ref": "#/$defs/sha256"},
    "delivery_manifest_object_sha256": {"$ref": "#/$defs/sha256"},
    "anchor_set_object_sha256": {"$ref": "#/$defs/sha256"}, "anchor_set_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "animation_clip_id": {"$ref": "#/$defs/id"}, "animation_clip_object_sha256": {"$ref": "#/$defs/sha256"}, "animation_clip_sha256": {"$ref": "#/$defs/sha256"},
    "animated_socket_materialization_key_sha256": {"$ref": "#/$defs/sha256"}, "animated_artifact_sha256": {"$ref": "#/$defs/sha256"},
    "animation_receipt_object_sha256": {"$ref": "#/$defs/sha256"}, "animation_receipt_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "derived_animated_socket_artifact_sha256": {"$ref": "#/$defs/sha256"}, "animated_socket_receipt_object_sha256": {"$ref": "#/$defs/sha256"},
    "vfx_profile_object_sha256": {"$ref": "#/$defs/sha256"}, "vfx_profile_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "vfx_sequence_key_sha256": {"$ref": "#/$defs/sha256"}, "vfx_sequence_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "vfx_frame_key_sha256": {"$ref": "#/$defs/sha256"}, "vfx_frame_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "vfx_bloom_key_sha256": {"$ref": "#/$defs/sha256"}, "vfx_bloom_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "vfx_particle_key_sha256": {"$ref": "#/$defs/sha256"}, "vfx_particle_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "vfx_trail_key_sha256": {"$ref": "#/$defs/sha256"}, "vfx_trail_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "vfx_trail_bloom_key_sha256": {"$ref": "#/$defs/sha256"}, "vfx_trail_bloom_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "particle_history_key_sha256s": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": {"$ref": "#/$defs/sha256"}},
    "sample_request_sha256": {"$ref": "#/$defs/sha256"}, "camera_object_sha256": {"$ref": "#/$defs/sha256"},
    "camera_identity_sha256": {"$ref": "#/$defs/sha256"}, "render_profile_sha256": {"$ref": "#/$defs/sha256"},
    "render_worker_build_cohort_sha256": {"$ref": "#/$defs/sha256"},
    "animation_vfx_scope": {"const": "lod0-rigid-animation-full-vfx-stack-single-frame@1"},
    "animation_vfx_policy": {"const": "candidate-animation-vfx-structural-hard-gate@1"},
    "animation_vfx_policy_sha256": {"$ref": "#/$defs/sha256"},
    "from_stage": {"const": "material-surface"}, "to_stage": {"const": "animation-vfx"},
    "input_sha256": {"$ref": "#/$defs/sha256"}, "idempotency_key": {"$ref": "#/$defs/id"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
