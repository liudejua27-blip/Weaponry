{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/fictional-energy-rifle-profile.schema.json",
  "title": "FictionalEnergyRifleProfile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "project_id",
    "scope",
    "nonfunctional_asset",
    "subject_coordinate_frame_sha256",
    "operator_catalog_sha256",
    "representation_plan_sha256",
    "style_language",
    "reference_policy",
    "macro_intents",
    "quality_contract",
    "canonical_sha256"
  ],
  "properties": {
    "schema_version": {"const": "FictionalEnergyRifleProfile@1"},
    "profile_id": {"$ref": "#/$defs/id"},
    "project_id": {"$ref": "#/$defs/id"},
    "scope": {"const": "fictional-game-asset"},
    "nonfunctional_asset": {"const": true},
    "subject_coordinate_frame_sha256": {"$ref": "#/$defs/sha256"},
    "operator_catalog_sha256": {"$ref": "#/$defs/sha256"},
    "representation_plan_sha256": {"$ref": "#/$defs/sha256"},
    "style_language": {"$ref": "#/$defs/style_language"},
    "reference_policy": {"$ref": "#/$defs/reference_policy"},
    "macro_intents": {
      "type": "array",
      "minItems": 3,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/macro_intent"}
    },
    "quality_contract": {"$ref": "#/$defs/quality_contract"},
    "canonical_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "vector3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"type": "number"}
    },
    "safe_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "not": {
        "anyOf": [
          {"pattern": "^[/\\\\]"},
          {"pattern": "^[A-Za-z]:[/\\\\]"},
          {"pattern": "^(file|data|https?|ftp)://"},
          {"pattern": "[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]\\s*[:=]"},
          {"pattern": "[Aa][Pp][Ii][-_]?[Kk][Ee][Yy]\\s*[:=]"},
          {"pattern": "[Tt][Oo][Kk][Ee][Nn]\\s*[:=]"}
        ]
      }
    },
    "style_language": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "silhouette",
        "surface_language",
        "shell_material_id",
        "dark_material_id",
        "accent_material_id",
        "accent_placement",
        "detail_density"
      ],
      "properties": {
        "silhouette": {
          "enum": ["long-forward", "compact-forward", "triangular-spine"]
        },
        "surface_language": {
          "enum": ["layered-hard-surface", "clean-panel-ridge", "inset-energy-channel"]
        },
        "shell_material_id": {
          "enum": ["white-dielectric-clearcoat", "dark-painted-metal", "black-anodized-metal"]
        },
        "dark_material_id": {
          "enum": ["dark-painted-metal", "black-anodized-metal", "engineering-plastic"]
        },
        "accent_material_id": {
          "const": "warm-orange-emissive"
        },
        "accent_placement": {
          "enum": ["receiver-core-and-channel", "receiver-core-only", "channel-only"]
        },
        "detail_density": {
          "enum": ["primary", "secondary", "tertiary"]
        }
      }
    },
    "reference_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference_state",
        "unseen_regions",
        "hq_360_status",
        "quality_claim_allowed",
        "visual_match_claim_allowed",
        "requires_user_approval_before_geometry_prepare"
      ],
      "properties": {
        "reference_state": {
          "enum": ["original-brief", "authorized-reference-cas-bound", "authorized-reference-partial"]
        },
        "unseen_regions": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        },
        "hq_360_status": {"const": "BLOCKED_REFERENCE_COVERAGE"},
        "quality_claim_allowed": {"const": false},
        "visual_match_claim_allowed": {"const": false},
        "requires_user_approval_before_geometry_prepare": {"const": true}
      }
    },
    "quality_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strict_glb_readback",
        "joint_multiview_compare",
        "pbr_after_silhouette_gate",
        "human_review_required",
        "confirm_export_requires_user",
        "max_primary_form_rounds",
        "max_macro_requests"
      ],
      "properties": {
        "strict_glb_readback": {"const": true},
        "joint_multiview_compare": {"const": true},
        "pbr_after_silhouette_gate": {"const": true},
        "human_review_required": {"const": true},
        "confirm_export_requires_user": {"const": true},
        "max_primary_form_rounds": {"type": "integer", "minimum": 1, "maximum": 5},
        "max_macro_requests": {"const": 12}
      }
    },
    "panel_intent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["size_m", "thickness_m", "bevel_m", "position_m", "rotation_rad"],
      "properties": {
        "size_m": {"$ref": "#/$defs/vector3"},
        "thickness_m": {"type": "number", "exclusiveMinimum": 0, "maximum": 10},
        "bevel_m": {"type": "number", "minimum": 0, "maximum": 5},
        "position_m": {"$ref": "#/$defs/vector3"},
        "rotation_rad": {"$ref": "#/$defs/vector3"}
      }
    },
    "vent_intent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width_m", "height_m", "depth_m", "slot_count", "slot_width_m", "slot_spacing_m", "position_m", "rotation_rad"],
      "properties": {
        "width_m": {"type": "number", "exclusiveMinimum": 0, "maximum": 10},
        "height_m": {"type": "number", "exclusiveMinimum": 0, "maximum": 10},
        "depth_m": {"type": "number", "exclusiveMinimum": 0, "maximum": 10},
        "slot_count": {"type": "integer", "minimum": 1, "maximum": 32},
        "slot_width_m": {"type": "number", "exclusiveMinimum": 0, "maximum": 10},
        "slot_spacing_m": {"type": "number", "minimum": 0, "maximum": 10},
        "position_m": {"$ref": "#/$defs/vector3"},
        "rotation_rad": {"$ref": "#/$defs/vector3"}
      }
    },
    "channel_intent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stations", "path_frame", "floor_width_ratio", "edge_bevel_m", "start_transition_m", "end_transition_m", "transition_segments", "position_m", "rotation_rad"],
      "properties": {
        "stations": {
          "type": "array",
          "minItems": 2,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["point_m", "width_m", "depth_m"],
            "properties": {
              "point_m": {"$ref": "#/$defs/vector3"},
              "width_m": {"type": "number", "exclusiveMinimum": 0, "maximum": 10},
              "depth_m": {"type": "number", "exclusiveMinimum": 0, "maximum": 10}
            }
          }
        },
        "path_frame": {"const": "planar-xy-z-up@1"},
        "floor_width_ratio": {"type": "number", "exclusiveMinimum": 0.1, "maximum": 0.8},
        "edge_bevel_m": {"type": "number", "minimum": 0, "maximum": 5},
        "start_transition_m": {"type": "number", "minimum": 0, "maximum": 5},
        "end_transition_m": {"type": "number", "minimum": 0, "maximum": 5},
        "transition_segments": {"type": "integer", "minimum": 1, "maximum": 4},
        "position_m": {"$ref": "#/$defs/vector3"},
        "rotation_rad": {"$ref": "#/$defs/vector3"}
      }
    },
    "joint_intent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["radius_m", "depth_m", "ring_count", "ring_spacing_m", "radial_segments", "position_m", "rotation_rad"],
      "properties": {
        "radius_m": {"type": "number", "exclusiveMinimum": 0, "maximum": 5},
        "depth_m": {"type": "number", "exclusiveMinimum": 0, "maximum": 10},
        "ring_count": {"type": "integer", "minimum": 1, "maximum": 16},
        "ring_spacing_m": {"type": "number", "minimum": 0, "maximum": 10},
        "radial_segments": {"type": "integer", "minimum": 8, "maximum": 64},
        "position_m": {"$ref": "#/$defs/vector3"},
        "rotation_rad": {"$ref": "#/$defs/vector3"}
      }
    },
    "energy_core_intent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "outer_radius_m", "inner_radius_m", "depth_m", "radial_segments", "position_m", "rotation_rad"],
      "properties": {
        "component": {"enum": ["guard-ring", "mechanical-ring", "emitter-core", "mechanical-backplate"]},
        "outer_radius_m": {"type": "number", "exclusiveMinimum": 0, "maximum": 5},
        "inner_radius_m": {"type": "number", "minimum": 0, "maximum": 5},
        "depth_m": {"type": "number", "exclusiveMinimum": 0, "maximum": 10},
        "radial_segments": {"type": "integer", "minimum": 12, "maximum": 64},
        "position_m": {"$ref": "#/$defs/vector3"},
        "rotation_rad": {"$ref": "#/$defs/vector3"}
      },
      "allOf": [
        {
          "if": {"properties": {"component": {"enum": ["guard-ring", "mechanical-ring"]}}, "required": ["component"]},
          "then": {"properties": {"inner_radius_m": {"type": "number", "exclusiveMinimum": 0.00001, "maximum": 5}}}
        },
        {
          "if": {"properties": {"component": {"enum": ["emitter-core", "mechanical-backplate"]}}, "required": ["component"]},
          "then": {"properties": {"inner_radius_m": {"const": 0}}}
        }
      ]
    },
    "sensor_intent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["radius_m", "height_m", "radial_segments", "position_m", "rotation_rad"],
      "properties": {
        "radius_m": {"type": "number", "exclusiveMinimum": 0, "maximum": 5},
        "height_m": {"type": "number", "exclusiveMinimum": 0, "maximum": 10},
        "radial_segments": {"type": "integer", "minimum": 8, "maximum": 64},
        "position_m": {"$ref": "#/$defs/vector3"},
        "rotation_rad": {"$ref": "#/$defs/vector3"}
      }
    },
    "macro_intent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "part_id",
        "kit_id",
        "operator_id",
        "material_zone_id",
        "stage",
        "visibility",
        "symmetry",
        "intent"
      ],
      "properties": {
        "part_id": {"$ref": "#/$defs/id"},
        "kit_id": {
          "enum": [
            "forgecad.kit.housing@1",
            "forgecad.kit.panel@1",
            "forgecad.kit.vent@1",
            "forgecad.kit.channel@1",
            "forgecad.kit.energy-core@1",
            "forgecad.kit.joint@1",
            "forgecad.kit.sensor@1",
            "forgecad.kit.frame@1"
          ]
        },
        "operator_id": {
          "enum": [
            "forgecad.geometry.panel@1",
            "forgecad.geometry.vent-array@1",
            "forgecad.geometry.vent-array@2",
            "forgecad.geometry.recessed-channel@1",
            "forgecad.geometry.energy-core@1",
            "forgecad.geometry.joint-stack@1",
            "forgecad.geometry.primitive@2"
          ]
        },
        "material_zone_id": {"$ref": "#/$defs/id"},
        "stage": {"enum": ["primary-form", "secondary-structure", "tertiary-detail"]},
        "visibility": {"enum": ["observed", "inferred", "unknown"]},
        "symmetry": {"enum": ["independent", "mirror-left-right", "paired"]},
        "intent": {"type": "object"}
      },
      "allOf": [
        {
          "if": {"properties": {"kit_id": {"enum": ["forgecad.kit.housing@1", "forgecad.kit.panel@1", "forgecad.kit.frame@1"]}}, "required": ["kit_id"]},
          "then": {"properties": {"intent": {"$ref": "#/$defs/panel_intent"}}}
        },
        {
          "if": {"properties": {"kit_id": {"const": "forgecad.kit.vent@1"}}, "required": ["kit_id"]},
          "then": {"properties": {"intent": {"$ref": "#/$defs/vent_intent"}}}
        },
        {
          "if": {"properties": {"kit_id": {"const": "forgecad.kit.channel@1"}}, "required": ["kit_id"]},
          "then": {"properties": {"intent": {"$ref": "#/$defs/channel_intent"}}}
        },
        {
          "if": {"properties": {"kit_id": {"const": "forgecad.kit.joint@1"}}, "required": ["kit_id"]},
          "then": {"properties": {"intent": {"$ref": "#/$defs/joint_intent"}}}
        },
        {
          "if": {"properties": {"kit_id": {"const": "forgecad.kit.energy-core@1"}}, "required": ["kit_id"]},
          "then": {"properties": {"intent": {"$ref": "#/$defs/energy_core_intent"}}}
        },
        {
          "if": {"properties": {"kit_id": {"const": "forgecad.kit.sensor@1"}}, "required": ["kit_id"]},
          "then": {"properties": {"intent": {"$ref": "#/$defs/sensor_intent"}}}
        }
      ]
    }
  }
}
