{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/production-weapon-form-quality.schema.json",
  "title": "ProductionWeaponFormQuality@1",
  "description": "An immutable, candidate-bound structural receipt for one of the three FPS weapon form edges. CrossViewEvidenceBundle@1 is the parent of all six reviewed-view RenderSet, ReferenceComparisonReport, QualityReport, metric and no-regression hashes; this record stores only an exact parent binding and stage-specific Part-ID, negative-space and line-flow projections. It never carries image bytes, renders, advances ProductionStage@3, confirms a candidate, creates a version or exports.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "form_quality_id", "session_id", "project_id", "form_stage",
    "source_stage", "target_stage", "camera_calibrated_head_transition_id",
    "camera_calibrated_head_transition_sha256", "camera_calibrated_head_canonical_sha256",
    "camera_calibrated_head_candidate_id", "camera_calibrated_head_candidate_state_sha256",
    "camera_calibrated_head_artifact_id", "camera_calibrated_head_artifact_sha256",
    "camera_calibrated_head_stage", "candidate_id", "candidate_state_sha256", "artifact_id",
    "artifact_sha256", "reference_id", "reference_sha256", "reference_canvas_object_sha256",
    "reference_canvas_canonical_sha256", "design_spec_object_sha256", "design_spec_canonical_sha256",
    "camera_lock_id", "camera_lock_canonical_sha256", "camera_rig_object_sha256",
    "camera_rig_canonical_sha256", "camera_lock_receipt_object_sha256",
    "camera_lock_source_transition_id", "camera_lock_source_transition_sha256",
    "camera_lock_source_head_canonical_sha256", "reviewed_reference_view_kinds",
    "fixed_camera_view_kinds", "cross_view_evidence_object_sha256",
    "cross_view_evidence_canonical_sha256", "cross_view_evidence_view_kinds",
    "form_evidence_object_sha256", "form_evidence_canonical_sha256",
    "form_view_evaluations", "previous_form_quality_id",
    "previous_form_quality_report_object_sha256", "previous_form_quality_canonical_sha256",
    "form_quality_policy", "form_quality_policy_sha256", "threshold_policy",
    "threshold_policy_sha256", "layer_status", "hard_gate", "hard_gate_passed",
    "form_gate", "form_gate_passed", "validator_status", "structural_status",
    "visual_status", "human_status", "engine_status", "distribution_status",
    "quality_status", "runtime_write_performed", "production_stage_advanced",
    "candidate_confirmed", "version_created", "export_performed", "request_sha256",
    "input_sha256", "receipt_object_sha256", "canonical_sha256", "created_at"
  ],
  "properties": {
    "schema_version": {"const": "ProductionWeaponFormQuality@1"},
    "form_quality_id": {"$ref": "#/$defs/id"},
    "session_id": {"$ref": "#/$defs/id"},
    "project_id": {"$ref": "#/$defs/id"},
    "form_stage": {"enum": ["blockout", "primary", "secondary"]},
    "source_stage": {"$ref": "#/$defs/stage"},
    "target_stage": {"$ref": "#/$defs/stage"},
    "camera_calibrated_head_transition_id": {"$ref": "#/$defs/id"},
    "camera_calibrated_head_transition_sha256": {"$ref": "#/$defs/sha256"},
    "camera_calibrated_head_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "camera_calibrated_head_candidate_id": {"$ref": "#/$defs/id"},
    "camera_calibrated_head_candidate_state_sha256": {"$ref": "#/$defs/sha256"},
    "camera_calibrated_head_artifact_id": {"$ref": "#/$defs/id"},
    "camera_calibrated_head_artifact_sha256": {"$ref": "#/$defs/sha256"},
    "camera_calibrated_head_stage": {"const": "camera-calibrated"},
    "candidate_id": {"$ref": "#/$defs/id"},
    "candidate_state_sha256": {"$ref": "#/$defs/sha256"},
    "artifact_id": {"$ref": "#/$defs/id"},
    "artifact_sha256": {"$ref": "#/$defs/sha256"},
    "reference_id": {"$ref": "#/$defs/id"},
    "reference_sha256": {"$ref": "#/$defs/sha256"},
    "reference_canvas_object_sha256": {"$ref": "#/$defs/sha256"},
    "reference_canvas_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "design_spec_object_sha256": {"$ref": "#/$defs/sha256"},
    "design_spec_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "camera_lock_id": {"$ref": "#/$defs/id"},
    "camera_lock_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "camera_rig_object_sha256": {"$ref": "#/$defs/sha256"},
    "camera_rig_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "camera_lock_receipt_object_sha256": {"$ref": "#/$defs/sha256"},
    "camera_lock_source_transition_id": {"$ref": "#/$defs/id"},
    "camera_lock_source_transition_sha256": {"$ref": "#/$defs/sha256"},
    "camera_lock_source_head_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "reviewed_reference_view_kinds": {"const": ["front", "back", "left", "right", "top", "rear-three-quarter"]},
    "fixed_camera_view_kinds": {"const": ["front", "back", "left", "right", "top", "bottom", "rear-three-quarter"]},
    "cross_view_evidence_object_sha256": {"$ref": "#/$defs/sha256"},
    "cross_view_evidence_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "cross_view_evidence_view_kinds": {"const": ["front", "back", "left", "right", "top", "rear-three-quarter"]},
    "form_evidence_object_sha256": {"$ref": "#/$defs/sha256"},
    "form_evidence_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "form_view_evaluations": {
      "type": "array", "minItems": 6, "maxItems": 6, "uniqueItems": true,
      "prefixItems": [
        {"$ref": "#/$defs/form_view_front"},
        {"$ref": "#/$defs/form_view_back"},
        {"$ref": "#/$defs/form_view_left"},
        {"$ref": "#/$defs/form_view_right"},
        {"$ref": "#/$defs/form_view_top"},
        {"$ref": "#/$defs/form_view_rear_three_quarter"}
      ],
      "items": false
    },
    "previous_form_quality_id": {"$ref": "#/$defs/nullable_id"},
    "previous_form_quality_report_object_sha256": {"$ref": "#/$defs/nullable_sha256"},
    "previous_form_quality_canonical_sha256": {"$ref": "#/$defs/nullable_sha256"},
    "form_quality_policy": {"const": "production-weapon-form-quality-six-view-no-regression@1"},
    "form_quality_policy_sha256": {"$ref": "#/$defs/sha256"},
    "threshold_policy": {"const": "production-weapon-form-view-thresholds@1"},
    "threshold_policy_sha256": {"$ref": "#/$defs/sha256"},
    "layer_status": {"enum": ["NOT_RUN", "BLOCKED", "QUALITY_TARGET_NOT_MET", "PASS_STAGE_VISUAL"]},
    "hard_gate": {"$ref": "#/$defs/hard_gate"},
    "hard_gate_passed": {"type": "boolean"},
    "form_gate": {"$ref": "#/$defs/form_gate"},
    "form_gate_passed": {"type": "boolean"},
    "validator_status": {"enum": ["passed", "failed"]},
    "structural_status": {"enum": ["NOT_RUN", "BLOCKED", "PASS_SOURCE_STRUCTURAL"]},
    "visual_status": {"enum": ["NOT_RUN", "BLOCKED", "QUALITY_TARGET_NOT_MET", "PASS_STAGE_VISUAL"]},
    "human_status": {"enum": ["NOT_RUN", "BLOCKED", "REJECTED", "PASS_HUMAN_ART_REVIEW"]},
    "engine_status": {"enum": ["NOT_RUN", "BLOCKED", "FAILED", "PASS_ENGINE_VALIDATION"]},
    "distribution_status": {"enum": ["NOT_RUN", "BLOCKED", "FAILED", "PASS_DISTRIBUTION"]},
    "quality_status": {"const": "structural_only"},
    "runtime_write_performed": {"const": true},
    "production_stage_advanced": {"const": false},
    "candidate_confirmed": {"const": false},
    "version_created": {"const": false},
    "export_performed": {"const": false},
    "request_sha256": {"$ref": "#/$defs/sha256"},
    "input_sha256": {"$ref": "#/$defs/sha256"},
    "receipt_object_sha256": {"$ref": "#/$defs/sha256"},
    "canonical_sha256": {"$ref": "#/$defs/sha256"},
    "created_at": {"$ref": "#/$defs/timestamp"}
  },
  "allOf": [
    {
      "if": {"properties": {"form_stage": {"const": "blockout"}}, "required": ["form_stage"]},
      "then": {
        "properties": {
          "source_stage": {"const": "camera-calibrated"},
          "target_stage": {"const": "blockout-reviewed"},
          "previous_form_quality_id": {"type": "null"},
          "previous_form_quality_report_object_sha256": {"type": "null"},
          "previous_form_quality_canonical_sha256": {"type": "null"}
        }
      }
    },
    {
      "if": {"properties": {"form_stage": {"const": "primary"}}, "required": ["form_stage"]},
      "then": {
        "properties": {
          "source_stage": {"const": "blockout-reviewed"},
          "target_stage": {"const": "primary-form-approved"},
          "previous_form_quality_id": {"$ref": "#/$defs/id"},
          "previous_form_quality_report_object_sha256": {"$ref": "#/$defs/sha256"},
          "previous_form_quality_canonical_sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    {
      "if": {"properties": {"form_stage": {"const": "secondary"}}, "required": ["form_stage"]},
      "then": {
        "properties": {
          "source_stage": {"const": "primary-form-approved"},
          "target_stage": {"const": "secondary-form-approved"},
          "previous_form_quality_id": {"$ref": "#/$defs/id"},
          "previous_form_quality_report_object_sha256": {"$ref": "#/$defs/sha256"},
          "previous_form_quality_canonical_sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    {
      "if": {"properties": {"hard_gate_passed": {"const": true}}, "required": ["hard_gate_passed"]},
      "then": {
        "properties": {
          "validator_status": {"const": "passed"},
          "hard_gate": {"$ref": "#/$defs/passing_hard_gate"}
        }
      }
    },
    {
      "if": {"properties": {"validator_status": {"const": "passed"}}, "required": ["validator_status"]},
      "then": {
        "properties": {
          "hard_gate_passed": {"const": true},
          "hard_gate": {"$ref": "#/$defs/passing_hard_gate"}
        }
      }
    },
    {
      "if": {"properties": {"form_gate_passed": {"const": true}}, "required": ["form_gate_passed"]},
      "then": {
        "properties": {
          "form_gate": {"$ref": "#/$defs/passing_form_gate"},
          "hard_gate_passed": {"const": true},
          "visual_status": {"const": "PASS_STAGE_VISUAL"},
          "layer_status": {"const": "PASS_STAGE_VISUAL"}
        }
      }
    }
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullable_id": {"oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
    "nullable_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "timestamp": {"type": "string", "minLength": 1, "maxLength": 128},
    "stage": {"enum": [
      "reference-intake", "reference-coverage-reviewed", "camera-calibrated",
      "blockout-reviewed", "primary-form-approved", "secondary-form-approved",
      "high-poly-approved", "low-poly-approved", "uv-approved", "cage-approved",
      "bake-approved", "material-approved", "rig-socket-approved", "animation-approved",
      "vfx-approved", "lod-collision-approved", "hero-art-review-approved",
      "engine-validated", "export-confirmed"
    ]},
    "evidence_binding": {
      "type": "object", "additionalProperties": false,
      "required": ["source_kind", "source_object_sha256", "evidence_object_sha256", "status"],
      "properties": {
        "source_kind": {"enum": ["cross-view-evidence-bundle", "design-spec", "not-proven"]},
        "source_object_sha256": {"$ref": "#/$defs/nullable_sha256"},
        "evidence_object_sha256": {"$ref": "#/$defs/nullable_sha256"},
        "status": {"enum": ["PASS", "QUALITY_TARGET_NOT_MET", "NOT_PROVEN", "BLOCKED"]}
      },
      "allOf": [
        {
          "if": {"properties": {"source_kind": {"const": "not-proven"}}, "required": ["source_kind"]},
          "then": {
            "properties": {
              "source_object_sha256": {"type": "null"},
              "evidence_object_sha256": {"type": "null"},
              "status": {"const": "NOT_PROVEN"}
            }
          }
        },
        {
          "if": {"properties": {"source_kind": {"enum": ["cross-view-evidence-bundle", "design-spec"]}}, "required": ["source_kind"]},
          "then": {
            "properties": {
              "source_object_sha256": {"$ref": "#/$defs/sha256"},
              "evidence_object_sha256": {"$ref": "#/$defs/sha256"}
            }
          }
        }
      ]
    },
    "part_id_evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["source", "expected_part_ids", "observed_part_ids", "missing_part_ids", "unexpected_part_ids", "coverage_milli"],
      "properties": {
        "source": {"$ref": "#/$defs/evidence_binding"},
        "expected_part_ids": {"type": "array", "minItems": 0, "maxItems": 512, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "observed_part_ids": {"type": "array", "minItems": 0, "maxItems": 512, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "missing_part_ids": {"type": "array", "minItems": 0, "maxItems": 512, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "unexpected_part_ids": {"type": "array", "minItems": 0, "maxItems": 512, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "coverage_milli": {"type": "integer", "minimum": 0, "maximum": 1000}
      }
    },
    "negative_space_evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["source", "expected_count", "observed_count", "missing_count", "sealed_count", "coverage_milli"],
      "properties": {
        "source": {"$ref": "#/$defs/evidence_binding"},
        "expected_count": {"type": "integer", "minimum": 0, "maximum": 512},
        "observed_count": {"type": "integer", "minimum": 0, "maximum": 512},
        "missing_count": {"type": "integer", "minimum": 0, "maximum": 512},
        "sealed_count": {"type": "integer", "minimum": 0, "maximum": 512},
        "coverage_milli": {"type": "integer", "minimum": 0, "maximum": 1000}
      }
    },
    "line_flow_evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["source", "expected_count", "observed_count", "coverage_milli", "continuity_milli", "deviation_milli"],
      "properties": {
        "source": {"$ref": "#/$defs/evidence_binding"},
        "expected_count": {"type": "integer", "minimum": 0, "maximum": 512},
        "observed_count": {"type": "integer", "minimum": 0, "maximum": 512},
        "coverage_milli": {"type": "integer", "minimum": 0, "maximum": 1000},
        "continuity_milli": {"type": "integer", "minimum": 0, "maximum": 1000},
        "deviation_milli": {"type": "integer", "minimum": 0, "maximum": 100000}
      }
    },
    "no_regression": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "metrics_not_regressed", "part_id_not_regressed", "negative_space_not_regressed", "line_flow_not_regressed"],
      "properties": {
        "status": {"enum": ["NOT_APPLICABLE", "NOT_PROVEN", "PASS", "FAILED"]},
        "metrics_not_regressed": {"type": "boolean"},
        "part_id_not_regressed": {"type": "boolean"},
        "negative_space_not_regressed": {"type": "boolean"},
        "line_flow_not_regressed": {"type": "boolean"}
      }
    },
    "form_view": {
      "type": "object", "additionalProperties": false,
      "required": ["view_kind", "view_id", "part_id_evidence", "negative_space_evidence", "line_flow_evidence", "no_regression"],
      "properties": {
        "view_kind": {"enum": ["front", "back", "left", "right", "top", "rear-three-quarter"]},
        "view_id": {"$ref": "#/$defs/id"},
        "part_id_evidence": {"$ref": "#/$defs/part_id_evidence"},
        "negative_space_evidence": {"$ref": "#/$defs/negative_space_evidence"},
        "line_flow_evidence": {"$ref": "#/$defs/line_flow_evidence"},
        "no_regression": {"$ref": "#/$defs/no_regression"}
      }
    },
    "form_view_front": {"allOf": [{"$ref": "#/$defs/form_view"}, {"properties": {"view_kind": {"const": "front"}}}]},
    "form_view_back": {"allOf": [{"$ref": "#/$defs/form_view"}, {"properties": {"view_kind": {"const": "back"}}}]},
    "form_view_left": {"allOf": [{"$ref": "#/$defs/form_view"}, {"properties": {"view_kind": {"const": "left"}}}]},
    "form_view_right": {"allOf": [{"$ref": "#/$defs/form_view"}, {"properties": {"view_kind": {"const": "right"}}}]},
    "form_view_top": {"allOf": [{"$ref": "#/$defs/form_view"}, {"properties": {"view_kind": {"const": "top"}}}]},
    "form_view_rear_three_quarter": {"allOf": [{"$ref": "#/$defs/form_view"}, {"properties": {"view_kind": {"const": "rear-three-quarter"}}}]},
    "hard_gate": {
      "type": "object", "additionalProperties": false,
      "required": ["stage_head_binding", "camera_lock_binding", "same_candidate_artifact", "reviewed_reference_views", "fixed_camera_views", "cross_view_evidence_binding", "form_view_evaluations", "part_id_evidence", "negative_space_evidence", "line_flow_evidence", "threshold_policy_binding"],
      "properties": {
        "stage_head_binding": {"type": "boolean"},
        "camera_lock_binding": {"type": "boolean"},
        "same_candidate_artifact": {"type": "boolean"},
        "reviewed_reference_views": {"type": "boolean"},
        "fixed_camera_views": {"type": "boolean"},
        "cross_view_evidence_binding": {"type": "boolean"},
        "form_view_evaluations": {"type": "boolean"},
        "part_id_evidence": {"type": "boolean"},
        "negative_space_evidence": {"type": "boolean"},
        "line_flow_evidence": {"type": "boolean"},
        "threshold_policy_binding": {"type": "boolean"}
      }
    },
    "passing_hard_gate": {
      "allOf": [
        {"$ref": "#/$defs/hard_gate"},
        {"properties": {
          "stage_head_binding": {"const": true}, "camera_lock_binding": {"const": true},
          "same_candidate_artifact": {"const": true}, "reviewed_reference_views": {"const": true},
          "fixed_camera_views": {"const": true}, "cross_view_evidence_binding": {"const": true},
          "form_view_evaluations": {"const": true}, "part_id_evidence": {"const": true},
          "negative_space_evidence": {"const": true}, "line_flow_evidence": {"const": true},
          "threshold_policy_binding": {"const": true}
        }}
      ]
    },
    "form_gate": {
      "type": "object", "additionalProperties": false,
      "required": ["layer_status", "all_view_thresholds", "all_view_no_regression", "previous_form_quality_binding"],
      "properties": {
        "layer_status": {"enum": ["NOT_RUN", "BLOCKED", "QUALITY_TARGET_NOT_MET", "PASS_STAGE_VISUAL"]},
        "all_view_thresholds": {"type": "boolean"},
        "all_view_no_regression": {"type": "boolean"},
        "previous_form_quality_binding": {"type": "boolean"}
      }
    },
    "passing_form_gate": {
      "allOf": [
        {"$ref": "#/$defs/form_gate"},
        {"properties": {
          "layer_status": {"const": "PASS_STAGE_VISUAL"},
          "all_view_thresholds": {"const": true},
          "all_view_no_regression": {"const": true},
          "previous_form_quality_binding": {"const": true}
        }}
      ]
    }
  }
}
