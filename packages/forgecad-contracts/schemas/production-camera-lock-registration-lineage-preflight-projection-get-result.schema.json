{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/production-camera-lock-registration-lineage-preflight-projection-get-result.schema.json",
  "title": "ProductionCameraLockRegistrationLineagePreflightProjectionGetResult@1",
  "description": "Zero-write Runtime-derived semantic-camera projection for user review. Projection readiness is not user approval and does not create a promotable lineage.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "operation", "preflight_id", "registration_lineage_id", "session_id",
    "project_id", "candidate_id", "candidate_state_sha256", "camera_lock_id",
    "camera_lock_canonical_sha256", "parent_camera_lock_status",
    "parent_camera_lock_receipt_object_sha256", "proposed_board_rotation_degrees",
    "proposed_subject_screen_order", "derived_camera_orbit_degrees", "derived_camera_hash",
    "derived_camera_canonical_sha256", "upright_proof", "projection_status",
    "projection_input_sha256", "projection_ready_for_user_review", "existing_lineage_status",
    "existing_promotable_lineage_present", "existing_lineage_matches_proposal",
    "orientation_authority_status", "ready_for_promotable_lineage", "blocking_reasons",
    "policy", "writer_policy", "runtime_write", "persistent_user_data_touched", "worker_started",
    "production_stage_advanced", "candidate_confirmed", "version_created", "export_performed",
    "readiness_sha256"
  ],
  "properties": {
    "schema_version": {"const": "ProductionCameraLockRegistrationLineagePreflightProjectionGetResult@1"},
    "operation": {"const": "forgecad.production.camera-lock-registration-lineage-preflight-projection-get@1"},
    "preflight_id": {"$ref": "#/$defs/id"},
    "registration_lineage_id": {"$ref": "#/$defs/id"},
    "session_id": {"$ref": "#/$defs/id"},
    "project_id": {"$ref": "#/$defs/id"},
    "candidate_id": {"$ref": "#/$defs/id"},
    "candidate_state_sha256": {"$ref": "#/$defs/sha256"},
    "camera_lock_id": {"$ref": "#/$defs/id"},
    "camera_lock_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "parent_camera_lock_status": {"enum": ["VALID", "MISSING", "INVALID", "UNAVAILABLE"]},
    "parent_camera_lock_receipt_object_sha256": {"$ref": "#/$defs/nullable_sha256"},
    "proposed_board_rotation_degrees": {"type": "integer", "enum": [-180, -90, 0, 90, 180]},
    "proposed_subject_screen_order": {"enum": ["stock-left-muzzle-right", "muzzle-left-stock-right"]},
    "derived_camera_orbit_degrees": {"type": ["integer", "null"], "enum": [null, 0, 180]},
    "derived_camera_hash": {"$ref": "#/$defs/nullable_sha256"},
    "derived_camera_canonical_sha256": {"$ref": "#/$defs/nullable_sha256"},
    "upright_proof": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/proof"}]},
    "projection_status": {"enum": ["READY", "BLOCKED", "UNAVAILABLE", "INVALID"]},
    "projection_input_sha256": {"$ref": "#/$defs/nullable_sha256"},
    "projection_ready_for_user_review": {"type": "boolean"},
    "existing_lineage_status": {"enum": ["NOT_CREATED", "EXISTING_MATCHING", "EXISTING_PROPOSAL_MISMATCH", "EXISTING_INVALID", "STORE_UNAVAILABLE"]},
    "existing_promotable_lineage_present": {"type": "boolean"},
    "existing_lineage_matches_proposal": {"type": "boolean"},
    "orientation_authority_status": {"enum": ["BLOCKED_USER_APPROVAL_REQUIRED", "USER_APPROVED_MATCHING_DURABLE_LINEAGE", "EXISTING_DURABLE_LINEAGE_PROPOSAL_MISMATCH", "EXISTING_DURABLE_LINEAGE_INVALID"]},
    "ready_for_promotable_lineage": {"type": "boolean"},
    "blocking_reasons": {"type": "array", "items": {"type": "string"}},
    "policy": {"const": "runtime-derived-semantic-camera-preflight-projection@1"},
    "writer_policy": {"const": "forgecad-runtime-only-state-writer@1"},
    "runtime_write": {"const": false},
    "persistent_user_data_touched": {"const": false},
    "worker_started": {"const": false},
    "production_stage_advanced": {"const": false},
    "candidate_confirmed": {"const": false},
    "version_created": {"const": false},
    "export_performed": {"const": false},
    "readiness_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullable_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "camera_hash", "expected_subject_screen_order", "projected_subject_screen_order", "stock_minus_muzzle_screen_x_milli", "world_y_screen_up_dot_milli", "screen_up", "passed", "canonical_sha256"],
      "properties": {
        "policy": {"const": "runtime-projected-stock-muzzle-screen-order-and-world-y-upright@1"},
        "camera_hash": {"$ref": "#/$defs/sha256"},
        "expected_subject_screen_order": {"enum": ["stock-left-muzzle-right", "muzzle-left-stock-right"]},
        "projected_subject_screen_order": {"enum": ["stock-left-muzzle-right", "muzzle-left-stock-right"]},
        "stock_minus_muzzle_screen_x_milli": {"type": "integer"},
        "world_y_screen_up_dot_milli": {"type": "integer"},
        "screen_up": {"const": "world-positive-y"},
        "passed": {"type": "boolean"},
        "canonical_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
