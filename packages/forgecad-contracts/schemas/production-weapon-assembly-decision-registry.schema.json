{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/production-weapon-assembly-decision-registry.schema.json",
  "title": "ProductionWeaponAssemblyDecisionRegistry@1",
  "description": "Closed five-group assembly vocabulary for a read-only FPS weapon art-decision proposal. It binds the live OperatorCatalog but does not compile geometry or authorize a Worker.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry_id",
    "profile_id",
    "operator_catalog_sha256",
    "registry_policy",
    "groups",
    "canonical_sha256"
  ],
  "properties": {
    "schema_version": {"const": "ProductionWeaponAssemblyDecisionRegistry@1"},
    "registry_id": {"$ref": "#/$defs/id"},
    "profile_id": {"const": "fps-weapon-form-assembly@1"},
    "operator_catalog_sha256": {"$ref": "#/$defs/sha256"},
    "registry_policy": {"const": "fps-weapon-closed-assembly-form-decision-registry@1"},
    "groups": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": false,
      "prefixItems": [
        {"$ref": "#/$defs/group"},
        {"$ref": "#/$defs/group"},
        {"$ref": "#/$defs/group"},
        {"$ref": "#/$defs/group"},
        {"$ref": "#/$defs/group"}
      ],
      "allOf": [
        {"contains": {"type": "object", "properties": {"group_id": {"const": "receiver-envelope"}}}},
        {"contains": {"type": "object", "properties": {"group_id": {"const": "muzzle-axis"}}}},
        {"contains": {"type": "object", "properties": {"group_id": {"const": "stock-open-frame"}}}},
        {"contains": {"type": "object", "properties": {"group_id": {"const": "trigger-void"}}}},
        {"contains": {"type": "object", "properties": {"group_id": {"const": "rail-spine"}}}}
      ]
    },
    "canonical_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "group_id",
        "intent_kind",
        "part_ids",
        "source_node_ids",
        "parameter_ids",
        "allowed_operator_ids",
        "coupling_mode",
        "invariants",
        "affected_view_kinds",
        "priority"
      ],
      "properties": {
        "group_id": {
          "enum": [
            "receiver-envelope",
            "muzzle-axis",
            "stock-open-frame",
            "trigger-void",
            "rail-spine"
          ]
        },
        "intent_kind": {
          "enum": [
            "receiver-envelope",
            "muzzle-axis",
            "stock-open-frame",
            "trigger-void",
            "rail-spine"
          ]
        },
        "part_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        },
        "source_node_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        },
        "parameter_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        },
        "allowed_operator_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "enum": [
              "forgecad.geometry.primitive@2",
              "forgecad.geometry.profile-extrude@1",
              "forgecad.geometry.profile-loft@1",
              "forgecad.geometry.profile-loft@2",
              "forgecad.geometry.multi-loop-profile-loft@1",
              "forgecad.geometry.longitudinal-section-loft@1",
              "forgecad.geometry.subd-cage@1",
              "forgecad.geometry.subd-cage@2",
              "forgecad.geometry.authoring-mesh@1",
              "forgecad.geometry.surface-patch@1",
              "forgecad.geometry.surface-shell@1",
              "forgecad.geometry.revolve@1",
              "forgecad.geometry.tube-sweep@1",
              "forgecad.geometry.transform@2",
              "forgecad.geometry.mirror@1",
              "forgecad.geometry.array@1",
              "forgecad.geometry.bevel@1",
              "forgecad.geometry.bevel@2",
              "forgecad.geometry.normal-policy@1",
              "forgecad.geometry.panel@1",
              "forgecad.geometry.panel@2",
              "forgecad.geometry.vent-array@1",
              "forgecad.geometry.vent-array@2",
              "forgecad.geometry.recessed-channel@1",
              "forgecad.geometry.energy-core@1",
              "forgecad.geometry.joint-stack@1",
              "forgecad.geometry.part-output@1",
              "forgecad.geometry.boolean@1"
            ]
          }
        },
        "coupling_mode": {
          "enum": ["independent", "linked", "mirror"]
        },
        "invariants": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "enum": [
              "shared-axis",
              "coaxial",
              "mirror-symmetric",
              "clearance-min",
              "enclosed-void",
              "continuous-spine"
            ]
          }
        },
        "affected_view_kinds": {
          "const": ["front", "back", "left", "right", "top", "rear-three-quarter"]
        },
        "priority": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        }
      }
    }
  }
}
