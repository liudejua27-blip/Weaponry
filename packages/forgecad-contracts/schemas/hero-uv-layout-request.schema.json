{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/hero-uv-layout-request.schema.json",
  "title": "HeroUvLayoutRequest@1",
  "description": "Closed first-party Worker request for bounded Hero UV diagnostics. Runtime supplies the admitted Low GLB bytes; the Worker does not write CAS, SQLite, candidates or stages.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "low_artifact_sha256", "low_glb_base64", "resolution",
    "padding_texels", "min_mip_level", "hard_edge_angle_deg", "stretch_threshold",
    "visibility_weights", "canonical_sha256"
  ],
  "properties": {
    "schema_version": {"const": "HeroUvLayoutRequest@1"},
    "low_artifact_sha256": {"$ref": "#/$defs/sha256"},
    "low_glb_base64": {"type": "string", "minLength": 1, "maxLength": 44739244},
    "resolution": {"enum": [2048, 4096]},
    "padding_texels": {"type": "integer", "minimum": 1, "maximum": 128},
    "min_mip_level": {"type": "integer", "minimum": 0, "maximum": 12},
    "hard_edge_angle_deg": {"type": "number", "exclusiveMinimum": 0.1, "exclusiveMaximum": 89.9},
    "stretch_threshold": {"type": "number", "minimum": 1, "maximum": 100},
    "visibility_weights": {
      "type": "array", "minItems": 1, "maxItems": 4096, "uniqueItems": true,
      "items": {"$ref": "#/$defs/visibility_weight"}
    },
    "canonical_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,128}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "visibility_weight": {
      "type": "object", "additionalProperties": false,
      "required": ["part_id", "first_person", "world", "hidden"],
      "properties": {
        "part_id": {"$ref": "#/$defs/id"},
        "first_person": {"type": "number", "minimum": 0, "maximum": 1},
        "world": {"type": "number", "minimum": 0, "maximum": 1},
        "hidden": {"type": "number", "minimum": 0, "maximum": 1}
      }
    }
  }
}
