{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/authoring-mesh-artifact.schema.json",
  "title": "AuthoringMeshArtifact@1",
  "description": "Runtime-owned durable sidecar for an original AuthoringMesh. It records the evaluated artifact/readback references without treating them as the authoring source or as a one-to-one correspondence. Its CAS object hash is intentionally carried only by the outer result/link to avoid a self-referential payload hash.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_id",
    "project_id",
    "candidate_id",
    "candidate_state_sha256",
    "base_version_id",
    "authoring_node_id",
    "part_id",
    "canonical_mesh_id",
    "canonical_mesh_object_sha256",
    "canonical_mesh_sha256",
    "source_program_object_sha256",
    "source_program_sha256",
    "evaluated_artifact_object_sha256",
    "evaluated_artifact_sha256",
    "evaluated_artifact_readback_object_sha256",
    "evaluated_artifact_readback_sha256",
    "correspondence_policy",
    "artifact_kind",
    "storage_policy",
    "writer_policy",
    "replay_policy",
    "runtime_write_performed",
    "persistent_user_data_touched",
    "stage_advanced",
    "candidate_confirmed",
    "version_created",
    "export_performed",
    "quality_status",
    "canonicalization_policy",
    "canonical_sha256"
  ],
  "properties": {
    "schema_version": {"const": "AuthoringMeshArtifact@1"},
    "artifact_id": {"$ref": "#/$defs/identifier"},
    "project_id": {"$ref": "#/$defs/identifier"},
    "candidate_id": {"$ref": "#/$defs/identifier"},
    "candidate_state_sha256": {"$ref": "#/$defs/sha256"},
    "base_version_id": {"$ref": "#/$defs/nullable_identifier"},
    "authoring_node_id": {"$ref": "#/$defs/identifier"},
    "part_id": {"$ref": "#/$defs/identifier"},
    "canonical_mesh_id": {"$ref": "#/$defs/identifier"},
    "canonical_mesh_object_sha256": {"$ref": "#/$defs/sha256"},
    "canonical_mesh_sha256": {"$ref": "#/$defs/sha256"},
    "source_program_object_sha256": {"$ref": "#/$defs/sha256"},
    "source_program_sha256": {"$ref": "#/$defs/sha256"},
    "evaluated_artifact_object_sha256": {"$ref": "#/$defs/sha256"},
    "evaluated_artifact_sha256": {"$ref": "#/$defs/sha256"},
    "evaluated_artifact_readback_object_sha256": {"$ref": "#/$defs/sha256"},
    "evaluated_artifact_readback_sha256": {"$ref": "#/$defs/sha256"},
    "correspondence_policy": {"const": "non-bijective-derived-only@1"},
    "artifact_kind": {"const": "runtime-owned-authoring-mesh-evaluated-sidecar@1"},
    "storage_policy": {"const": "runtime-owned-cas-sidecar-no-authoring-source-reversal@1"},
    "writer_policy": {"const": "forgecad-runtime-only-state-writer@1"},
    "replay_policy": {"const": "same-candidate-program-artifact-readback-binding-required@1"},
    "runtime_write_performed": {"const": true},
    "persistent_user_data_touched": {"const": true},
    "stage_advanced": {"const": false},
    "candidate_confirmed": {"const": false},
    "version_created": {"const": false},
    "export_performed": {"const": false},
    "quality_status": {"const": "structural_only"},
    "canonicalization_policy": {"const": "canonical-json-sha256-excluding-canonical-sha256@1"},
    "canonical_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,128}$"},
    "nullable_identifier": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9_.:-]{1,128}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
