{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/weaponry-knife-production-brief-get-request.schema.json",
  "title": "WeaponryKnifeProductionBriefGetRequest@1",
  "description": "Closed read-only exact lookup for one immutable knife production brief. Both semantic and CAS object hashes are required, so an older or ambiguous brief cannot be substituted.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "operation", "project_id", "reference_id",
    "reference_object_sha256", "reference_evidence_sha256", "brief_id", "brief_sha256",
    "brief_object_sha256", "max_response_bytes", "runtime_write_performed",
    "persistent_user_data_touched", "writer_policy", "canonicalization_policy",
    "input_sha256"
  ],
  "properties": {
    "schema_version": {"const": "WeaponryKnifeProductionBriefGetRequest@1"},
    "operation": {"const": "weaponry_knife_production_brief_get"},
    "project_id": {"$ref": "#/$defs/id"},
    "reference_id": {"$ref": "#/$defs/id"},
    "reference_object_sha256": {"$ref": "#/$defs/sha256"},
    "reference_evidence_sha256": {"$ref": "#/$defs/sha256"},
    "brief_id": {"$ref": "#/$defs/id"},
    "brief_sha256": {"$ref": "#/$defs/sha256"},
    "brief_object_sha256": {"$ref": "#/$defs/sha256"},
    "max_response_bytes": {"const": 1048576},
    "runtime_write_performed": {"const": false},
    "persistent_user_data_touched": {"const": false},
    "writer_policy": {"const": "forgecad-runtime-only-state-writer@1"},
    "canonicalization_policy": {"const": "canonical-json-sha256-excluding-input-sha256@1"},
    "input_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
