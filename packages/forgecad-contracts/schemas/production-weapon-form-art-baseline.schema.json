{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/production-weapon-form-art-baseline.schema.json",
  "title": "ProductionWeaponFormArtBaseline@1",
  "description": "Runtime-owned immutable fresh same-cohort six-view FormArt baseline. It binds an approved registration lineage and RegisteredCameraRigCalibration@2, carries hash-only view evidence, and remains evidence-only with no quality or Stage promotion.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "baseline_id", "registration_lineage_id", "registration_lineage_canonical_sha256",
    "registration_lineage_receipt_object_sha256", "registered_rig_v2_id", "registered_rig_v2_object_sha256",
    "registered_rig_v2_canonical_sha256", "session_id", "project_id", "candidate_id", "candidate_state_sha256",
    "artifact_id", "artifact_sha256", "base_version_id", "view_kinds", "views", "runtime_build_cohort_sha256",
    "baseline_policy", "materialization_status", "historical_form_art_reused", "worker_started",
    "worker_cohort_verified", "quality_status", "visual_status", "human_status", "engine_status",
    "distribution_status", "promotion_eligible", "runtime_write_performed", "persistent_user_data_touched",
    "production_stage_advanced", "candidate_confirmed", "version_created", "export_performed", "request_sha256",
    "input_sha256", "idempotency_key", "idempotency_policy", "writer_policy", "receipt_object_sha256",
    "canonicalization_policy", "canonical_sha256", "created_at"
  ],
  "properties": {
    "schema_version": {"const": "ProductionWeaponFormArtBaseline@1"},
    "baseline_id": {"$ref": "#/$defs/id"},
    "registration_lineage_id": {"$ref": "#/$defs/id"},
    "registration_lineage_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "registration_lineage_receipt_object_sha256": {"$ref": "#/$defs/sha256"},
    "registered_rig_v2_id": {"$ref": "#/$defs/id"},
    "registered_rig_v2_object_sha256": {"$ref": "#/$defs/sha256"},
    "registered_rig_v2_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "session_id": {"$ref": "#/$defs/id"},
    "project_id": {"$ref": "#/$defs/id"},
    "candidate_id": {"$ref": "#/$defs/id"},
    "candidate_state_sha256": {"$ref": "#/$defs/sha256"},
    "artifact_id": {"$ref": "#/$defs/id"},
    "artifact_sha256": {"$ref": "#/$defs/sha256"},
    "base_version_id": {"$ref": "#/$defs/nullable_id"},
    "view_kinds": {"const": ["front", "back", "left", "right", "top", "rear-three-quarter"]},
    "views": {
      "type": "array", "minItems": 6, "maxItems": 6, "items": false,
      "prefixItems": [
        {"allOf": [{"$ref": "#/$defs/view"}, {"properties": {"view_kind": {"const": "front"}}}]},
        {"allOf": [{"$ref": "#/$defs/view"}, {"properties": {"view_kind": {"const": "back"}}}]},
        {"allOf": [{"$ref": "#/$defs/view"}, {"properties": {"view_kind": {"const": "left"}}}]},
        {"allOf": [{"$ref": "#/$defs/view"}, {"properties": {"view_kind": {"const": "right"}}}]},
        {"allOf": [{"$ref": "#/$defs/view"}, {"properties": {"view_kind": {"const": "top"}}}]},
        {"allOf": [{"$ref": "#/$defs/view"}, {"properties": {"view_kind": {"const": "rear-three-quarter"}}}]}
      ]
    },
    "runtime_build_cohort_sha256": {"$ref": "#/$defs/sha256"},
    "baseline_policy": {"const": "fresh-same-cohort-form-art-baseline-registration-lineage-rig-v2@1"},
    "materialization_status": {"const": "runtime-owned-durable-form-art-baseline@1"},
    "historical_form_art_reused": {"const": false},
    "worker_started": {"const": true},
    "worker_cohort_verified": {"const": true},
    "quality_status": {"const": "NOT_PROVEN"},
    "visual_status": {"const": "NOT_PROVEN"},
    "human_status": {"const": "NOT_RUN"},
    "engine_status": {"const": "NOT_RUN"},
    "distribution_status": {"const": "NOT_RUN"},
    "promotion_eligible": {"const": false},
    "runtime_write_performed": {"const": true},
    "persistent_user_data_touched": {"const": true},
    "production_stage_advanced": {"const": false},
    "candidate_confirmed": {"const": false},
    "version_created": {"const": false},
    "export_performed": {"const": false},
    "request_sha256": {"$ref": "#/$defs/sha256"},
    "input_sha256": {"$ref": "#/$defs/sha256"},
    "idempotency_key": {"$ref": "#/$defs/id"},
    "idempotency_policy": {"const": "same-input-hash-replays-without-new-record@1"},
    "writer_policy": {"const": "forgecad-runtime-only-state-writer@1"},
    "receipt_object_sha256": {"$ref": "#/$defs/sha256"},
    "canonicalization_policy": {"const": "canonical-json-sha256-excluding-canonical-sha256@1"},
    "canonical_sha256": {"$ref": "#/$defs/sha256"},
    "created_at": {"$ref": "#/$defs/timestamp"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullable_id": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "timestamp": {"type": "string", "minLength": 1, "maxLength": 128},
    "view": {
      "type": "object", "additionalProperties": false,
      "required": [
        "schema_version", "view_kind", "view_id", "reference_id", "reference_sha256", "camera_hash",
        "camera_canonical_sha256", "camera_object_sha256", "render_set_id", "render_set_object_sha256", "render_set_canonical_sha256",
        "render_set_view_id", "pass_artifact_object_sha256", "reference_mask_object_sha256",
        "comparison_report_object_sha256", "quality_report_object_sha256", "render_worker_build_cohort_sha256", "quality_status", "receipt_object_sha256",
        "canonical_sha256", "created_at"
      ],
      "properties": {
        "schema_version": {"const": "ProductionWeaponFormArtBaselineView@1"},
        "view_kind": {"enum": ["front", "back", "left", "right", "top", "rear-three-quarter"]},
        "view_id": {"$ref": "#/$defs/id"},
        "reference_id": {"$ref": "#/$defs/id"},
        "reference_sha256": {"$ref": "#/$defs/sha256"},
        "camera_hash": {"$ref": "#/$defs/sha256"},
        "camera_canonical_sha256": {"$ref": "#/$defs/sha256"},
        "camera_object_sha256": {"$ref": "#/$defs/sha256"},
        "render_set_id": {"$ref": "#/$defs/id"},
        "render_set_object_sha256": {"$ref": "#/$defs/sha256"},
        "render_set_canonical_sha256": {"$ref": "#/$defs/sha256"},
        "render_set_view_id": {"$ref": "#/$defs/id"},
        "pass_artifact_object_sha256": {
          "type": "array", "minItems": 9, "maxItems": 9,
          "items": {"$ref": "#/$defs/sha256"}
        },
        "reference_mask_object_sha256": {"$ref": "#/$defs/sha256"},
        "comparison_report_object_sha256": {"$ref": "#/$defs/sha256"},
        "quality_report_object_sha256": {"$ref": "#/$defs/sha256"},
        "render_worker_build_cohort_sha256": {"$ref": "#/$defs/sha256"},
        "quality_status": {"const": "NOT_PROVEN"},
        "receipt_object_sha256": {"$ref": "#/$defs/sha256"},
        "canonical_sha256": {"$ref": "#/$defs/sha256"},
        "created_at": {"$ref": "#/$defs/timestamp"}
      }
    }
  }
}
