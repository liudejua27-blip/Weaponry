{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/authoring-mesh-prepare-request.schema.json",
  "title": "AuthoringMeshPrepareRequest@1",
  "description": "Closed request for Runtime to derive and durably materialize an original AuthoringMesh from existing candidate/program/artifact/readback evidence. The caller supplies no raw mesh, evaluated identity, Stage, approval, version or export instruction.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "source_candidate_id",
    "source_candidate_state_sha256",
    "base_version_id",
    "authoring_node_id",
    "part_id",
    "source_program_object_sha256",
    "source_program_sha256",
    "source_artifact_id",
    "source_artifact_object_sha256",
    "source_artifact_sha256",
    "source_artifact_readback_object_sha256",
    "source_artifact_readback_sha256",
    "source_lineage_sha256",
    "expected_canonical_mesh_sha256",
    "idempotency_key",
    "max_response_bytes",
    "runtime_write_performed",
    "writer_policy",
    "canonicalization_policy",
    "input_sha256"
  ],
  "properties": {
    "schema_version": {"const": "AuthoringMeshPrepareRequest@1"},
    "project_id": {"$ref": "#/$defs/identifier"},
    "source_candidate_id": {"$ref": "#/$defs/identifier"},
    "source_candidate_state_sha256": {"$ref": "#/$defs/sha256"},
    "base_version_id": {"$ref": "#/$defs/nullable_identifier"},
    "authoring_node_id": {"$ref": "#/$defs/identifier"},
    "part_id": {"$ref": "#/$defs/identifier"},
    "source_program_object_sha256": {"$ref": "#/$defs/sha256"},
    "source_program_sha256": {"$ref": "#/$defs/sha256"},
    "source_artifact_id": {"$ref": "#/$defs/identifier"},
    "source_artifact_object_sha256": {"$ref": "#/$defs/sha256"},
    "source_artifact_sha256": {"$ref": "#/$defs/sha256"},
    "source_artifact_readback_object_sha256": {"$ref": "#/$defs/sha256"},
    "source_artifact_readback_sha256": {"$ref": "#/$defs/sha256"},
    "source_lineage_sha256": {"$ref": "#/$defs/sha256"},
    "expected_canonical_mesh_sha256": {"$ref": "#/$defs/sha256"},
    "idempotency_key": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},
    "max_response_bytes": {"const": 1048576},
    "runtime_write_performed": {"const": false},
    "writer_policy": {"const": "forgecad-runtime-only-state-writer@1"},
    "canonicalization_policy": {"const": "canonical-json-sha256-excluding-canonical-sha256@1"},
    "input_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,128}$"},
    "nullable_identifier": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9_.:-]{1,128}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
