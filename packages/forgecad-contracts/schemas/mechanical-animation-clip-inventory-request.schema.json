{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/mechanical-animation-clip-inventory-request.schema.json",
  "title": "MechanicalAnimationClipInventoryRequest",
  "description": "Closed request for the bounded read-only Viewer inventory of immutable candidate clips.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "candidate_id", "artifact_id", "max_clips", "canonical_sha256"],
  "properties": {
    "schema_version": {"const": "MechanicalAnimationClipInventoryRequest@1"},
    "project_id": {"$ref": "#/$defs/identifier"},
    "candidate_id": {"$ref": "#/$defs/identifier"},
    "artifact_id": {"$ref": "#/$defs/sha256"},
    "max_clips": {"const": 16},
    "canonical_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
