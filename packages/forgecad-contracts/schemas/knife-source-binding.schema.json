{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/knife-source-binding.schema.json",
  "title": "KnifeSourceBinding@1",
  "description": "Closed Runtime-owned lineage binding from an eligible KnifeReferenceIntentBundle through its exact brief, reference and quality contract to one source candidate and AuthoringMesh revision. This is source lineage only; it does not create High geometry or prove visual, human, engine or commercial quality.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "source_binding_id", "project_id", "binding_status",
    "authoring_eligibility", "intent_bundle_id", "intent_bundle_sha256",
    "intent_bundle_object_sha256", "brief_id", "brief_sha256",
    "brief_object_sha256", "reference_id", "reference_object_sha256",
    "reference_evidence_sha256", "quality_contract_id",
    "quality_contract_sha256", "quality_contract_object_sha256",
    "source_candidate_id", "source_candidate_state_sha256", "authoring_mesh_id",
    "authoring_mesh_lineage_id", "authoring_mesh_revision_id",
    "authoring_mesh_revision_index", "authoring_mesh_revision_sha256",
    "authoring_mesh_revision_object_sha256", "authoring_mesh_identity_sha256",
    "downstream_binding_requirements", "high_mesh_created", "high_stage_unlocked",
    "production_stage_advanced", "candidate_confirmed", "version_created",
    "export_performed", "quality_status", "visual_status", "human_status",
    "engine_status", "binding_policy", "canonicalization_policy",
    "canonical_sha256", "created_at"
  ],
  "properties": {
    "schema_version": {"const": "KnifeSourceBinding@1"},
    "source_binding_id": {"$ref": "#/$defs/identifier"},
    "project_id": {"$ref": "#/$defs/identifier"},
    "binding_status": {"const": "runtime-bound"},
    "authoring_eligibility": {"const": "ELIGIBLE"},
    "intent_bundle_id": {"$ref": "#/$defs/identifier"},
    "intent_bundle_sha256": {"$ref": "#/$defs/sha256"},
    "intent_bundle_object_sha256": {"$ref": "#/$defs/sha256"},
    "brief_id": {"$ref": "#/$defs/identifier"},
    "brief_sha256": {"$ref": "#/$defs/sha256"},
    "brief_object_sha256": {"$ref": "#/$defs/sha256"},
    "reference_id": {"$ref": "#/$defs/identifier"},
    "reference_object_sha256": {"$ref": "#/$defs/sha256"},
    "reference_evidence_sha256": {"$ref": "#/$defs/sha256"},
    "quality_contract_id": {"$ref": "#/$defs/identifier"},
    "quality_contract_sha256": {"$ref": "#/$defs/sha256"},
    "quality_contract_object_sha256": {"$ref": "#/$defs/sha256"},
    "source_candidate_id": {"$ref": "#/$defs/identifier"},
    "source_candidate_state_sha256": {"$ref": "#/$defs/sha256"},
    "authoring_mesh_id": {"$ref": "#/$defs/identifier"},
    "authoring_mesh_lineage_id": {"$ref": "#/$defs/identifier"},
    "authoring_mesh_revision_id": {"$ref": "#/$defs/identifier"},
    "authoring_mesh_revision_index": {"$ref": "#/$defs/revision_index"},
    "authoring_mesh_revision_sha256": {"$ref": "#/$defs/sha256"},
    "authoring_mesh_revision_object_sha256": {"$ref": "#/$defs/sha256"},
    "authoring_mesh_identity_sha256": {"$ref": "#/$defs/sha256"},
    "downstream_binding_requirements": {"$ref": "#/$defs/downstream_binding_requirements"},
    "high_mesh_created": {"const": false},
    "high_stage_unlocked": {"const": false},
    "production_stage_advanced": {"const": false},
    "candidate_confirmed": {"const": false},
    "version_created": {"const": false},
    "export_performed": {"const": false},
    "quality_status": {"const": "source_binding_only"},
    "visual_status": {"const": "NOT_RUN"},
    "human_status": {"const": "NOT_RUN"},
    "engine_status": {"const": "NOT_RUN"},
    "binding_policy": {"const": "intent-brief-reference-quality-to-authoring-mesh-exact@1"},
    "canonicalization_policy": {"const": "canonical-json-sha256-excluding-canonical-sha256@1"},
    "canonical_sha256": {"$ref": "#/$defs/sha256"},
    "created_at": {"$ref": "#/$defs/timestamp"}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "revision_index": {"type": "integer", "minimum": 0, "maximum": 1000000},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"},
    "downstream_binding_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["curve_modifier_graph", "curve_evaluated_mesh", "high", "render"],
      "properties": {
        "curve_modifier_graph": {"const": "must-inherit-source-binding-sha256@1"},
        "curve_evaluated_mesh": {"const": "must-inherit-source-binding-sha256@1"},
        "high": {"const": "must-inherit-source-binding-sha256@1"},
        "render": {"const": "must-inherit-source-binding-sha256@1"}
      }
    }
  }
}
