{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/multi-loop-profile-loft-program-v1.schema.json",
  "title": "MultiLoopProfileLoftProgramV1",
  "description": "A Runtime-owned read-only expansion into the fixed multi-loop-profile-loft@1 Worker operator. It is structural-only and does not claim visual, PBR, G1/G2, or user approval completion.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operator_id",
    "lowered_operator_id",
    "project_id",
    "feature_id",
    "part_id",
    "material_zone_id",
    "cross_section_plan_sha256",
    "continuity_policy",
    "geometry_program",
    "program_sha256",
    "source_map",
    "validator_status",
    "quality_status",
    "runtime_write_performed",
    "user_approval_required",
    "limitations",
    "canonical_sha256"
  ],
  "properties": {
    "schema_version": {"const": "MultiLoopProfileLoftProgram@1"},
    "operator_id": {"const": "forgecad.geometry.multi-loop-profile-loft@1"},
    "lowered_operator_id": {"const": "forgecad.geometry.multi-loop-profile-loft@1"},
    "project_id": {"$ref": "#/$defs/identifier"},
    "feature_id": {"$ref": "#/$defs/identifier"},
    "part_id": {"$ref": "#/$defs/identifier"},
    "material_zone_id": {"$ref": "#/$defs/identifier"},
    "cross_section_plan_sha256": {"$ref": "#/$defs/sha256"},
    "continuity_policy": {"$ref": "#/$defs/continuity_policy"},
    "geometry_program": {"$ref": "#/$defs/geometry_program"},
    "program_sha256": {"$ref": "#/$defs/sha256"},
    "source_map": {"$ref": "#/$defs/source_map"},
    "validator_status": {"const": "passed"},
    "quality_status": {"const": "structural_only"},
    "runtime_write_performed": {"const": false},
    "user_approval_required": {"const": true},
    "limitations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 256}
    },
    "canonical_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "coordinate_scalar": {
      "type": "number",
      "minimum": -10,
      "maximum": 10
    },
    "profile_scalar": {
      "type": "number",
      "minimum": -5,
      "maximum": 5
    },
    "point2": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"$ref": "#/$defs/profile_scalar"}
    },
    "corner_indices": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 0, "maximum": 63}
    },
    "points": {
      "type": "array",
      "minItems": 3,
      "maxItems": 64,
      "items": {"$ref": "#/$defs/point2"}
    },
    "outer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["points"],
      "properties": {
        "points": {"$ref": "#/$defs/points"},
        "corner_indices": {"$ref": "#/$defs/corner_indices"}
      }
    },
    "hole": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hole_id", "points"],
      "properties": {
        "hole_id": {"$ref": "#/$defs/identifier"},
        "points": {"$ref": "#/$defs/points"},
        "corner_indices": {"$ref": "#/$defs/corner_indices"}
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component_id", "outer", "holes"],
      "properties": {
        "component_id": {"$ref": "#/$defs/identifier"},
        "outer": {"$ref": "#/$defs/outer"},
        "holes": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/hole"}
        }
      }
    },
    "station": {
      "type": "object",
      "additionalProperties": false,
      "required": ["station_id", "station_m", "components"],
      "properties": {
        "station_id": {"$ref": "#/$defs/identifier"},
        "station_m": {"$ref": "#/$defs/coordinate_scalar"},
        "components": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {"$ref": "#/$defs/component"}
        }
      }
    },
    "multi_loop_profile_loft_parameters": {
      "$ref": "https://forgecad.local/contracts/geometry-program-v2.schema.json#/$defs/multi_loop_profile_loft_parameters"
    },
    "geometry_program": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "project_id",
        "representation_plan_sha256",
        "operator_catalog_sha256",
        "units",
        "budgets",
        "nodes",
        "part_outputs",
        "canonical_sha256"
      ],
      "properties": {
        "schema_version": {"const": "GeometryProgram@2"},
        "project_id": {"$ref": "#/$defs/identifier"},
        "representation_plan_sha256": {"$ref": "#/$defs/sha256"},
        "operator_catalog_sha256": {"$ref": "#/$defs/sha256"},
        "units": {
          "type": "object",
          "additionalProperties": false,
          "required": ["length", "angle", "coordinate_system"],
          "properties": {
            "length": {"const": "meter"},
            "angle": {"const": "radian"},
            "coordinate_system": {"const": "right-handed-y-up"}
          }
        },
        "budgets": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_nodes", "max_triangles", "max_glb_bytes", "max_worker_memory_bytes", "max_runtime_ms"],
          "properties": {
            "max_nodes": {"type": "integer", "minimum": 1, "maximum": 512},
            "max_triangles": {"type": "integer", "minimum": 1, "maximum": 250000},
            "max_glb_bytes": {"type": "integer", "minimum": 1, "maximum": 67108864},
            "max_worker_memory_bytes": {"type": "integer", "minimum": 1, "maximum": 536870912},
            "max_runtime_ms": {"type": "integer", "minimum": 1, "maximum": 10000}
          }
        },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 512,
          "items": {
            "$ref": "https://forgecad.local/contracts/geometry-program-v2.schema.json#/$defs/geometry_node"
          }
        },
        "part_outputs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 512,
          "items": {
            "$ref": "https://forgecad.local/contracts/geometry-program-v2.schema.json#/$defs/part_output"
          }
        },
        "canonical_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "source_map": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "feature_id",
        "part_id",
        "material_zone_id",
        "station_ids",
        "component_ids",
        "hole_ids",
        "operator_id",
        "lowered_operator_id",
        "realized_surface_continuity"
      ],
      "properties": {
        "feature_id": {"$ref": "#/$defs/identifier"},
        "part_id": {"$ref": "#/$defs/identifier"},
        "material_zone_id": {"$ref": "#/$defs/identifier"},
        "station_ids": {
          "type": "array",
          "minItems": 2,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        },
        "component_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        },
        "hole_ids": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        },
        "operator_id": {"const": "forgecad.geometry.multi-loop-profile-loft@1"},
        "lowered_operator_id": {"const": "forgecad.geometry.multi-loop-profile-loft@1"},
        "realized_surface_continuity": {"const": "g0-only"}
      }
    },
    "continuity_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_id",
        "surface_continuity",
        "profile_point_correspondence",
        "station_interpolation",
        "interpolation_rings",
        "resample_points",
        "preserve_corners",
        "endpoint_caps",
        "hole_policy",
        "shared_boundary_policy"
      ],
      "properties": {
        "policy_id": {"const": "multi-loop-profile-loft-continuity@1"},
        "surface_continuity": {"const": "g0-only"},
        "profile_point_correspondence": {"const": "canonical-phase-arc-length"},
        "station_interpolation": {"enum": ["linear", "catmull-rom-position-only"]},
        "interpolation_rings": {"type": "integer", "minimum": 0, "maximum": 16},
        "resample_points": {"type": "integer", "minimum": 4, "maximum": 64},
        "preserve_corners": {"type": "boolean"},
        "endpoint_caps": {"const": "closed-solid-boolean"},
        "hole_policy": {"const": "manifold-difference"},
        "shared_boundary_policy": {"const": "none"}
      }
    }
  }
}
