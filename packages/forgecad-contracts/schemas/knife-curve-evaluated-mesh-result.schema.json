{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/knife-curve-evaluated-mesh-result.schema.json",
  "title": "KnifeCurveEvaluatedMeshResult@1",
  "description": "Closed result for a deterministic bounded knife curve sweep-loft evaluation. It creates only a disposable EvaluatedMesh binding; no editable geometry artifact, High, UV, Bake, visual, human or engine result is implied.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "operation", "request_kind", "status", "project_id",
    "source_candidate_id", "source_candidate_state_sha256", "source_authoring_mesh_id",
    "source_authoring_mesh_lineage_id", "source_authoring_mesh_revision_id",
    "source_authoring_mesh_revision_index", "source_authoring_mesh_revision_sha256",
    "source_authoring_mesh_identity_sha256", "source_modifier_graph_id",
    "source_modifier_graph_sha256", "curve_set_semantic_sha256",
    "sample_set_semantic_sha256", "modifier_graph_semantic_sha256",
    "dependency_graph_semantic_sha256", "recompute_plan_semantic_sha256",
    "curve_graph_lookup_key_sha256", "evaluated_mesh_lookup_key_sha256",
    "evaluation_plan", "evaluation_plan_object_sha256",
    "evaluation_plan_semantic_sha256", "evaluated_mesh_id",
    "evaluated_mesh_object_sha256", "evaluated_mesh_semantic_sha256",
    "evaluated_mesh_identity_sha256", "evaluated_mesh_link_sha256",
    "vertex_count", "triangle_count", "closed_two_manifold",
    "zero_degenerate_triangles", "mesh_readback_status", "evaluation_status",
    "evaluated_mesh_created", "geometry_artifact_created", "replayed",
    "deterministic_replay", "byte_exact_replay", "restart_hash_verified",
    "idempotency_key", "atomicity_status", "store_commit_status",
    "cas_commit_status", "runtime_write_performed", "persistent_user_data_touched",
    "partial_result_exposed", "stage_advanced", "candidate_confirmed",
    "version_created", "export_performed", "quality_status", "high_status",
    "uv_status", "bake_status", "visual_status", "human_status", "engine_status",
    "canonicalization_policy", "canonical_sha256"
  ],
  "properties": {
    "schema_version": {"const": "KnifeCurveEvaluatedMeshResult@1"},
    "operation": {"enum": ["knife_curve_evaluated_mesh_prepare", "knife_curve_evaluated_mesh_get"]},
    "request_kind": {"enum": ["prepare", "get"]},
    "status": {"enum": ["prepared", "replayed", "found"]},
    "project_id": {"$ref": "#/$defs/identifier"},
    "source_candidate_id": {"$ref": "#/$defs/identifier"},
    "source_candidate_state_sha256": {"$ref": "#/$defs/sha256"},
    "source_authoring_mesh_id": {"$ref": "#/$defs/identifier"},
    "source_authoring_mesh_lineage_id": {"$ref": "#/$defs/identifier"},
    "source_authoring_mesh_revision_id": {"$ref": "#/$defs/identifier"},
    "source_authoring_mesh_revision_index": {"$ref": "#/$defs/revision_index"},
    "source_authoring_mesh_revision_sha256": {"$ref": "#/$defs/sha256"},
    "source_authoring_mesh_identity_sha256": {"$ref": "#/$defs/sha256"},
    "source_modifier_graph_id": {"$ref": "#/$defs/identifier"},
    "source_modifier_graph_sha256": {"$ref": "#/$defs/sha256"},
    "curve_set_semantic_sha256": {"$ref": "#/$defs/sha256"},
    "sample_set_semantic_sha256": {"$ref": "#/$defs/sha256"},
    "modifier_graph_semantic_sha256": {"$ref": "#/$defs/sha256"},
    "dependency_graph_semantic_sha256": {"$ref": "#/$defs/sha256"},
    "recompute_plan_semantic_sha256": {"$ref": "#/$defs/sha256"},
    "curve_graph_lookup_key_sha256": {"$ref": "#/$defs/sha256"},
    "evaluated_mesh_lookup_key_sha256": {"$ref": "#/$defs/sha256"},
    "evaluation_plan": {"$ref": "#/$defs/knife_blade_profile_sweep_loft_plan"},
    "evaluation_plan_object_sha256": {"$ref": "#/$defs/sha256"},
    "evaluation_plan_semantic_sha256": {"$ref": "#/$defs/sha256"},
    "evaluated_mesh_id": {"$ref": "#/$defs/identifier"},
    "evaluated_mesh_object_sha256": {"$ref": "#/$defs/sha256"},
    "evaluated_mesh_semantic_sha256": {"$ref": "#/$defs/sha256"},
    "evaluated_mesh_identity_sha256": {"$ref": "#/$defs/sha256"},
    "evaluated_mesh_link_sha256": {"$ref": "#/$defs/sha256"},
    "vertex_count": {"type": "integer", "minimum": 1, "maximum": 2000000},
    "triangle_count": {"type": "integer", "minimum": 1, "maximum": 4000000},
    "closed_two_manifold": {"const": true},
    "zero_degenerate_triangles": {"const": true},
    "mesh_readback_status": {"const": "strict-evaluated-mesh-readback@1"},
    "evaluation_status": {"const": "curve-sweep-loft-evaluated-mesh-created-no-geometry-artifact@1"},
    "evaluated_mesh_created": {"const": true},
    "geometry_artifact_created": {"const": false},
    "replayed": {"type": "boolean"},
    "deterministic_replay": {"const": true},
    "byte_exact_replay": {"const": true},
    "restart_hash_verified": {"type": "boolean"},
    "idempotency_key": {"$ref": "#/$defs/idempotency_key"},
    "atomicity_status": {"enum": ["committed", "not-touched"]},
    "store_commit_status": {"enum": ["committed", "not-touched"]},
    "cas_commit_status": {"enum": ["committed", "not-touched"]},
    "runtime_write_performed": {"type": "boolean"},
    "persistent_user_data_touched": {"type": "boolean"},
    "partial_result_exposed": {"const": false},
    "stage_advanced": {"const": false},
    "candidate_confirmed": {"const": false},
    "version_created": {"const": false},
    "export_performed": {"const": false},
    "quality_status": {"const": "structural_only"},
    "high_status": {"const": "NOT_RUN"},
    "uv_status": {"const": "NOT_RUN"},
    "bake_status": {"const": "NOT_RUN"},
    "visual_status": {"const": "NOT_RUN"},
    "human_status": {"const": "NOT_RUN"},
    "engine_status": {"const": "NOT_RUN"},
    "canonicalization_policy": {"const": "canonical-json-sha256-excluding-canonical-sha256@1"},
    "canonical_sha256": {"$ref": "#/$defs/sha256"}
  },
  "oneOf": [
    {
      "properties": {
        "operation": {"const": "knife_curve_evaluated_mesh_prepare"},
        "request_kind": {"const": "prepare"},
        "status": {"const": "prepared"},
        "replayed": {"const": false},
        "atomicity_status": {"const": "committed"},
        "store_commit_status": {"const": "committed"},
        "cas_commit_status": {"const": "committed"},
        "runtime_write_performed": {"const": true},
        "persistent_user_data_touched": {"const": true}
      }
    },
    {
      "properties": {
        "operation": {"const": "knife_curve_evaluated_mesh_prepare"},
        "request_kind": {"const": "prepare"},
        "status": {"const": "replayed"},
        "replayed": {"const": true},
        "atomicity_status": {"const": "not-touched"},
        "store_commit_status": {"const": "not-touched"},
        "cas_commit_status": {"const": "not-touched"},
        "runtime_write_performed": {"const": false},
        "persistent_user_data_touched": {"const": false}
      }
    },
    {
      "properties": {
        "operation": {"const": "knife_curve_evaluated_mesh_get"},
        "request_kind": {"const": "get"},
        "status": {"const": "found"},
        "replayed": {"const": false},
        "atomicity_status": {"const": "not-touched"},
        "store_commit_status": {"const": "not-touched"},
        "cas_commit_status": {"const": "not-touched"},
        "runtime_write_performed": {"const": false},
        "persistent_user_data_touched": {"const": false}
      }
    }
  ],
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "idempotency_key": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},
    "revision_index": {"type": "integer", "minimum": 0, "maximum": 1000000},
    "thickness_m": {"type": "number", "exclusiveMinimum": 0.0001, "maximum": 0.25},
    "knife_blade_profile_sweep_loft_plan": {
      "title": "KnifeBladeProfileSweepLoftPlan@1",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "evaluation_id", "spine_curve_id", "spine_curve_sha256",
        "edge_curve_id", "edge_curve_sha256", "station_count", "thickness_axis",
        "thickness_m", "root_cap", "tip_cap", "stable_triangulation",
        "stable_lineage_policy", "canonical_sha256"
      ],
      "properties": {
        "schema_version": {"const": "KnifeBladeProfileSweepLoftPlan@1"},
        "evaluation_id": {"$ref": "#/$defs/identifier"},
        "spine_curve_id": {"$ref": "#/$defs/identifier"},
        "spine_curve_sha256": {"$ref": "#/$defs/sha256"},
        "edge_curve_id": {"$ref": "#/$defs/identifier"},
        "edge_curve_sha256": {"$ref": "#/$defs/sha256"},
        "station_count": {"const": 32},
        "thickness_axis": {"enum": ["local_normal", "world_x", "world_y", "world_z"]},
        "thickness_m": {"$ref": "#/$defs/thickness_m"},
        "root_cap": {"const": true},
        "tip_cap": {"const": true},
        "stable_triangulation": {"const": "station-ring-fixed-diagonal@1"},
        "stable_lineage_policy": {"const": "source-curve-modifier-graph-evaluated-mesh@1"},
        "canonical_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
