{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/authoring-mesh-link.schema.json",
  "title": "AuthoringMeshLink@1",
  "description": "Runtime-owned durable index joining one canonical original AuthoringMesh, its evaluated sidecar and the exact candidate/program/artifact/readback lineage. The link is not a Stage, approval, version or export record.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "link_id",
    "project_id",
    "candidate_id",
    "candidate_state_sha256",
    "base_version_id",
    "canonical_mesh_id",
    "canonical_mesh_object_sha256",
    "canonical_mesh_sha256",
    "artifact_id",
    "artifact_object_sha256",
    "artifact_sha256",
    "artifact_readback_object_sha256",
    "artifact_readback_sha256",
    "source_program_object_sha256",
    "source_program_sha256",
    "link_policy",
    "writer_policy",
    "materialization_status",
    "idempotency_policy",
    "runtime_write_performed",
    "persistent_user_data_touched",
    "stage_advanced",
    "candidate_confirmed",
    "version_created",
    "export_performed",
    "quality_status",
    "canonicalization_policy",
    "canonical_sha256"
  ],
  "properties": {
    "schema_version": {"const": "AuthoringMeshLink@1"},
    "link_id": {"$ref": "#/$defs/identifier"},
    "project_id": {"$ref": "#/$defs/identifier"},
    "candidate_id": {"$ref": "#/$defs/identifier"},
    "candidate_state_sha256": {"$ref": "#/$defs/sha256"},
    "base_version_id": {"$ref": "#/$defs/nullable_identifier"},
    "canonical_mesh_id": {"$ref": "#/$defs/identifier"},
    "canonical_mesh_object_sha256": {"$ref": "#/$defs/sha256"},
    "canonical_mesh_sha256": {"$ref": "#/$defs/sha256"},
    "artifact_id": {"$ref": "#/$defs/identifier"},
    "artifact_object_sha256": {"$ref": "#/$defs/sha256"},
    "artifact_sha256": {"$ref": "#/$defs/sha256"},
    "artifact_readback_object_sha256": {"$ref": "#/$defs/sha256"},
    "artifact_readback_sha256": {"$ref": "#/$defs/sha256"},
    "source_program_object_sha256": {"$ref": "#/$defs/sha256"},
    "source_program_sha256": {"$ref": "#/$defs/sha256"},
    "link_policy": {"const": "canonical-original-plus-evaluated-sidecar-exact-lineage@1"},
    "writer_policy": {"const": "forgecad-runtime-only-state-writer@1"},
    "materialization_status": {"const": "runtime-owned-durable-authoring-mesh-link@1"},
    "idempotency_policy": {"const": "same-input-hash-replays-without-new-record@1"},
    "runtime_write_performed": {"const": true},
    "persistent_user_data_touched": {"const": true},
    "stage_advanced": {"const": false},
    "candidate_confirmed": {"const": false},
    "version_created": {"const": false},
    "export_performed": {"const": false},
    "quality_status": {"const": "structural_only"},
    "canonicalization_policy": {"const": "canonical-json-sha256-excluding-canonical-sha256@1"},
    "canonical_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,128}$"},
    "nullable_identifier": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9_.:-]{1,128}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
