{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/blender-task-request.schema.json",
  "title": "BlenderTaskRequest@1",
  "description": "Closed payload for the future blender.render_fixed@1 evaluation operation. The operation is selected by a fixed Runtime envelope, not by this payload.",
  "x-operation": "blender.render_fixed@1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "project_id", "candidate_id", "source_candidate_sha256",
    "recipe_id", "recipe_version", "recipe_sha256", "python_bundle_sha256",
    "input_objects", "camera_profile_sha256", "material_profile_sha256", "budgets",
    "network_policy", "filesystem_policy", "script_policy", "output_policy",
    "canonical_sha256"
  ],
  "properties": {
    "schema_version": {"const": "BlenderTaskRequest@1"},
    "project_id": {"$ref": "#/$defs/id"},
    "candidate_id": {"$ref": "#/$defs/id"},
    "source_candidate_sha256": {"$ref": "#/$defs/sha256"},
    "recipe_id": {"const": "forgecad-blender-render-fixed@1"},
    "recipe_version": {"const": "1.0.0"},
    "recipe_sha256": {"$ref": "#/$defs/sha256"},
    "python_bundle_sha256": {"$ref": "#/$defs/sha256"},
    "input_objects": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/$defs/input_object"}},
    "camera_profile_sha256": {"$ref": "#/$defs/sha256"},
    "material_profile_sha256": {"$ref": "#/$defs/sha256"},
    "budgets": {"$ref": "#/$defs/budgets"},
    "network_policy": {"const": "disabled"},
    "filesystem_policy": {"const": "runtime_scratch_only"},
    "script_policy": {"const": "frozen_bundle_only"},
    "output_policy": {"const": "runtime_cas_after_readback"},
    "canonical_sha256": {
      "$ref": "#/$defs/sha256",
      "description": "SHA-256 of the canonical UTF-8 JSON object formed from every request field except canonical_sha256, with object keys recursively sorted lexicographically, arrays kept in contract order, and no insignificant whitespace. bytes_base64 is hashed as its exact bounded transport string."
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,128}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "input_object": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "sha256", "canonical_sha256", "byte_size", "mime", "bytes_base64"],
      "properties": {
        "kind": {"enum": ["glb", "reference_image", "material_profile"]},
        "sha256": {"$ref": "#/$defs/sha256"},
        "canonical_sha256": {"$ref": "#/$defs/sha256"},
        "byte_size": {"type": "integer", "minimum": 1, "maximum": 100663296},
        "mime": {"enum": ["model/gltf-binary", "image/png", "image/jpeg", "application/json"]},
        "bytes_base64": {"type": "string", "minLength": 1, "maxLength": 100663296, "contentEncoding": "base64"}
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_runtime_ms", "max_cpu_seconds", "max_memory_bytes", "max_gpu_bytes",
        "max_input_bytes", "max_output_bytes", "max_triangles", "max_texture_bytes",
        "max_stdout_bytes", "max_stderr_bytes"
      ],
      "properties": {
        "max_runtime_ms": {"type": "integer", "minimum": 1, "maximum": 120000},
        "max_cpu_seconds": {"type": "integer", "minimum": 1, "maximum": 120},
        "max_memory_bytes": {"type": "integer", "minimum": 1, "maximum": 536870912},
        "max_gpu_bytes": {"const": 0},
        "max_input_bytes": {"type": "integer", "minimum": 1, "maximum": 100663296},
        "max_output_bytes": {"type": "integer", "minimum": 1, "maximum": 100663296},
        "max_triangles": {"type": "integer", "minimum": 1, "maximum": 250000},
        "max_texture_bytes": {"type": "integer", "minimum": 1, "maximum": 67108864},
        "max_stdout_bytes": {"type": "integer", "minimum": 1, "maximum": 100663296},
        "max_stderr_bytes": {"type": "integer", "minimum": 1, "maximum": 65536}
      }
    }
  }
}
