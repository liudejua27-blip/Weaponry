{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/design-session.schema.json",
  "title": "DesignSession",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "session_id",
    "project_id",
    "design_spec_id",
    "design_spec_sha256",
    "reference_canvas_id",
    "reference_canvas_sha256",
    "candidate_id",
    "candidate_state_sha256",
    "reference_id",
    "reference_sha256",
    "camera_hash",
    "evidence_sha256",
    "observation_sha256",
    "current_version_id",
    "current_version_sha256",
    "current_stage",
    "quality_status",
    "status",
    "stage_gate",
    "current_checkpoint_id",
    "current_checkpoint_sha256",
    "checkpoint_ids",
    "next_actions",
    "rollback",
    "created_at",
    "updated_at",
    "canonical_sha256"
  ],
  "properties": {
    "schema_version": {"const": "DesignSession@1"},
    "session_id": {"$ref": "#/$defs/identifier"},
    "project_id": {"$ref": "#/$defs/identifier"},
    "design_spec_id": {"$ref": "#/$defs/identifier"},
    "design_spec_sha256": {"$ref": "#/$defs/sha256"},
    "reference_canvas_id": {"$ref": "#/$defs/identifier"},
    "reference_canvas_sha256": {"$ref": "#/$defs/sha256"},
    "candidate_id": {"$ref": "#/$defs/identifier"},
    "candidate_state_sha256": {"$ref": "#/$defs/sha256"},
    "reference_id": {"$ref": "#/$defs/identifier"},
    "reference_sha256": {"$ref": "#/$defs/sha256"},
    "camera_hash": {"$ref": "#/$defs/sha256"},
    "evidence_sha256": {"$ref": "#/$defs/sha256"},
    "observation_sha256": {"$ref": "#/$defs/sha256"},
    "current_version_id": {"$ref": "#/$defs/nullable_identifier"},
    "current_version_sha256": {"$ref": "#/$defs/nullable_sha256"},
    "current_stage": {"$ref": "#/$defs/stage"},
    "quality_status": {"$ref": "#/$defs/quality_status"},
    "status": {"enum": ["active", "blocked", "awaiting-review", "completed", "rolled-back", "cancelled"]},
    "stage_gate": {"$ref": "#/$defs/stage_gate"},
    "current_checkpoint_id": {"$ref": "#/$defs/nullable_identifier"},
    "current_checkpoint_sha256": {"$ref": "#/$defs/nullable_sha256"},
    "checkpoint_ids": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/identifier"}
    },
    "next_actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/action"}
    },
    "rollback": {"$ref": "#/$defs/rollback"},
    "created_at": {"$ref": "#/$defs/timestamp"},
    "updated_at": {"$ref": "#/$defs/timestamp"},
    "canonical_sha256": {"$ref": "#/$defs/sha256"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"current_checkpoint_id": {"const": null}},
        "required": ["current_checkpoint_id"]
      },
      "then": {"properties": {"current_checkpoint_sha256": {"const": null}}},
      "else": {"properties": {"current_checkpoint_sha256": {"$ref": "#/$defs/sha256"}}}
    },
    {
      "if": {
        "properties": {"current_version_id": {"const": null}},
        "required": ["current_version_id"]
      },
      "then": {"properties": {"current_version_sha256": {"const": null}}},
      "else": {"properties": {"current_version_sha256": {"$ref": "#/$defs/sha256"}}}
    },
    {
      "if": {
        "properties": {"quality_status": {"enum": ["QUALITY_TARGET_NOT_MET", "BLOCKED_REFERENCE_COVERAGE", "not-run"]}},
        "required": ["quality_status"]
      },
      "then": {
        "properties": {
          "rollback": {"properties": {"runtime_confirm_allowed": {"const": false}}}
        }
      }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nullable_identifier": {
      "type": ["string", "null"],
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "nullable_sha256": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    },
    "safe_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "not": {
        "anyOf": [
          {"pattern": "^[/\\\\]"},
          {"pattern": "^[A-Za-z]:[/\\\\]"},
          {"pattern": "^(file|data|https?|ftp)://"},
          {"pattern": "[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]\\s*[:=]"},
          {"pattern": "[Aa][Pp][Ii][-_]?[Kk][Ee][Yy]\\s*[:=]"},
          {"pattern": "[Ss][Ee][Cc][Rr][Ee][Tt]\\s*[:=]"},
          {"pattern": "[Bb][Ee][Aa][Rr][Ee][Rr]\\s+"},
          {"pattern": "[Tt][Oo][Kk][Ee][Nn]\\s*[:=]"}
        ]
      }
    },
    "nullable_safe_text": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/safe_text"}]
    },
    "stage": {
      "enum": [
        "reference-canvas",
        "primary-form",
        "secondary-structure",
        "tertiary-detail",
        "uv-pbr",
        "final-review"
      ]
    },
    "quality_status": {
      "enum": [
        "PARTIAL_VISIBLE_VIEW_PASS",
        "QUALITY_TARGET_NOT_MET",
        "BLOCKED_REFERENCE_COVERAGE",
        "not-run"
      ]
    },
    "gate_id": {
      "enum": [
        "reference-authorized",
        "reference-coverage",
        "primary-silhouette",
        "primary-proportion",
        "secondary-structure",
        "tertiary-detail",
        "visible-view",
        "uv-tangent-pbr",
        "multi-view-compare",
        "codex-typed-review",
        "human-review",
        "export-restart-hash",
        "360-reference-coverage"
      ]
    },
    "action_kind": {
      "enum": [
        "reference-import",
        "coverage-annotation",
        "mark-unknown",
        "primary-blockout",
        "primary-form-adjustment",
        "secondary-structure",
        "tertiary-detail",
        "material-zone",
        "uv-pbr",
        "final-review",
        "request-reference",
        "bounded-repair",
        "checkpoint",
        "rollback",
        "human-review",
        "export",
        "confirm",
        "next-stage"
      ]
    },
    "stage_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "status", "required_checks", "failed_checks", "evidence_hashes", "unlocks", "locks"],
      "properties": {
        "stage": {"$ref": "#/$defs/stage"},
        "status": {"enum": ["pass", "fail", "unknown"]},
        "required_checks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 13,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/gate_id"}
        },
        "failed_checks": {
          "type": "array",
          "maxItems": 13,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/gate_id"}
        },
        "evidence_hashes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/sha256"}
        },
        "unlocks": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/action_kind"}
        },
        "locks": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/action_kind"}
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action_id", "stage", "action_kind", "scope_kind", "target_id", "evidence_sha256", "bounded", "description"],
      "properties": {
        "action_id": {"$ref": "#/$defs/identifier"},
        "stage": {"$ref": "#/$defs/stage"},
        "action_kind": {"$ref": "#/$defs/action_kind"},
        "scope_kind": {"enum": ["session", "part", "material-zone", "reference"]},
        "target_id": {"$ref": "#/$defs/nullable_identifier"},
        "evidence_sha256": {"$ref": "#/$defs/sha256"},
        "bounded": {"const": true},
        "description": {"$ref": "#/$defs/safe_text"}
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relation",
        "target_checkpoint_id",
        "target_checkpoint_sha256",
        "target_version_id",
        "target_version_sha256",
        "reason",
        "runtime_confirm_allowed"
      ],
      "properties": {
        "relation": {"enum": ["none", "requested", "applied"]},
        "target_checkpoint_id": {"$ref": "#/$defs/nullable_identifier"},
        "target_checkpoint_sha256": {"$ref": "#/$defs/nullable_sha256"},
        "target_version_id": {"$ref": "#/$defs/nullable_identifier"},
        "target_version_sha256": {"$ref": "#/$defs/nullable_sha256"},
        "reason": {"$ref": "#/$defs/nullable_safe_text"},
        "runtime_confirm_allowed": {"const": false}
      },
      "allOf": [
        {
          "if": {
            "properties": {"relation": {"const": "none"}},
            "required": ["relation"]
          },
          "then": {
            "properties": {
              "target_checkpoint_id": {"const": null},
              "target_checkpoint_sha256": {"const": null},
              "target_version_id": {"const": null},
              "target_version_sha256": {"const": null},
              "reason": {"const": null}
            }
          }
        },
        {
          "if": {
            "properties": {"relation": {"enum": ["requested", "applied"]}},
            "required": ["relation"]
          },
          "then": {
            "anyOf": [
              {"required": ["target_checkpoint_id"], "properties": {"target_checkpoint_id": {"type": "string"}}},
              {"required": ["target_version_id"], "properties": {"target_version_id": {"type": "string"}}}
            ]
          }
        },
        {
          "if": {
            "properties": {"target_checkpoint_id": {"const": null}},
            "required": ["target_checkpoint_id"]
          },
          "then": {"properties": {"target_checkpoint_sha256": {"const": null}}},
          "else": {"properties": {"target_checkpoint_sha256": {"$ref": "#/$defs/sha256"}}}
        },
        {
          "if": {
            "properties": {"target_version_id": {"const": null}},
            "required": ["target_version_id"]
          },
          "then": {"properties": {"target_version_sha256": {"const": null}}},
          "else": {"properties": {"target_version_sha256": {"$ref": "#/$defs/sha256"}}}
        }
      ]
    }
  }
}
