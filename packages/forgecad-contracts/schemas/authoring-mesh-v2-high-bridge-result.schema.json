    "high_status", "quality_status", "visual_status", "human_status", "engine_status", "high_mesh_created",
    "high_stage_unlocked", "production_stage_advanced", "candidate_confirmed", "version_created",
    "export_performed", "writer_policy", "canonicalization_policy", "canonical_sha256"
