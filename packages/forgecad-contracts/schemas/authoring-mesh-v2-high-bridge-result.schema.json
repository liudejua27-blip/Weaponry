            "request_kind": {"const": "prepare"},
            "status": {"const": "replayed"}
          },
          "required": ["operation", "request_kind", "status"]
        },
        {
          "properties": {
            "operation": {"const": "authoring_mesh_v2_high_bridge_get"},
            "request_kind": {"const": "get"},
            "status": {"const": "found"}
          },
          "required": ["operation", "request_kind", "status"]
        }
      ]
    },
    {
      "if": {"properties": {"status": {"const": "prepared"}}, "required": ["status"]},
      "then": {
        "properties": {
          "request_kind": {"const": "prepare"},
          "replayed": {"const": false},
          "idempotency_key": {"$ref": "#/$defs/identifier"},
          "store_effect": {"const": "inserted"},
          "cas_effect": {"const": "inserted"},
          "atomicity_status": {"const": "committed"},
          "store_commit_status": {"const": "committed"},
          "cas_commit_status": {"const": "committed"},
          "runtime_write_performed": {"const": true},
          "persistent_user_data_touched": {"const": true}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "replayed"}}, "required": ["status"]},
      "then": {
        "properties": {
          "operation": {"const": "authoring_mesh_v2_high_bridge_prepare"},
          "request_kind": {"const": "prepare"},
          "replayed": {"const": true},
          "idempotency_key": {"const": null},
          "store_effect": {"const": "not-touched"},
          "cas_effect": {"const": "not-touched"},
          "atomicity_status": {"const": "not-touched"},
          "store_commit_status": {"const": "not-touched"},
          "cas_commit_status": {"const": "not-touched"},
          "runtime_write_performed": {"const": false},
          "persistent_user_data_touched": {"const": false}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "found"}}, "required": ["status"]},
      "then": {
        "properties": {
          "operation": {"const": "authoring_mesh_v2_high_bridge_get"},
          "request_kind": {"const": "get"},
          "replayed": {"const": false},
          "idempotency_key": {"const": null},
          "store_effect": {"const": "not-touched"},
          "cas_effect": {"const": "not-touched"},
          "atomicity_status": {"const": "not-touched"},
          "store_commit_status": {"const": "not-touched"},
          "cas_commit_status": {"const": "not-touched"},
          "runtime_write_performed": {"const": false},
          "persistent_user_data_touched": {"const": false}
        }
      }
    }
