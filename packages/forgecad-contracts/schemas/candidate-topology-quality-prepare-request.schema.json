{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/candidate-topology-quality-prepare-request.schema.json",
  "title": "CandidateTopologyQualityPrepareRequest@1",
  "description": "Closed request to evaluate all renderable Parts of one exact gray-model candidate. The ordered snapshot list must cover the ordered Part list; Runtime validates array lengths and Part inventory contents.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "topology_quality_id", "project_id", "candidate_id",
    "candidate_state_sha256", "artifact_id", "artifact_sha256",
    "artifact_readback_sha256", "artifact_readback_object_sha256",
    "geometry_candidate_evidence_sha256", "geometry_program_sha256",
    "geometry_program_object_sha256", "operator_catalog_sha256",
    "readback_config_sha256", "part_inventory_sha256", "part_ids",
    "part_topology_snapshot_sha256s", "authoring_topology_status",
    "part_authoring_topology_sha256s", "topology_quality_policy",
    "topology_quality_policy_sha256", "from_stage", "to_stage", "input_sha256",
    "idempotency_key"
  ],
  "properties": {
    "schema_version": {"const": "CandidateTopologyQualityPrepareRequest@1"},
    "topology_quality_id": {"$ref": "#/$defs/id"},
    "project_id": {"$ref": "#/$defs/id"},
    "candidate_id": {"$ref": "#/$defs/id"},
    "candidate_state_sha256": {"$ref": "#/$defs/sha256"},
    "artifact_id": {"$ref": "#/$defs/id"},
    "artifact_sha256": {"$ref": "#/$defs/sha256"},
    "artifact_readback_sha256": {"$ref": "#/$defs/sha256"},
    "artifact_readback_object_sha256": {"$ref": "#/$defs/sha256"},
    "geometry_candidate_evidence_sha256": {"$ref": "#/$defs/sha256"},
    "geometry_program_sha256": {"$ref": "#/$defs/sha256"},
    "geometry_program_object_sha256": {"$ref": "#/$defs/sha256"},
    "operator_catalog_sha256": {"$ref": "#/$defs/sha256"},
    "readback_config_sha256": {"$ref": "#/$defs/sha256"},
    "part_inventory_sha256": {"$ref": "#/$defs/sha256"},
    "part_ids": {"$ref": "#/$defs/id_list"},
    "part_topology_snapshot_sha256s": {"$ref": "#/$defs/sha256_list"},
    "authoring_topology_status": {"enum": ["complete", "partial", "not-available"]},
    "part_authoring_topology_sha256s": {"$ref": "#/$defs/nullable_sha256_list"},
    "topology_quality_policy": {"const": "candidate-topology-hard-gate@1"},
    "topology_quality_policy_sha256": {"$ref": "#/$defs/sha256"},
    "from_stage": {"const": "gray-model"},
    "to_stage": {"const": "topology"},
    "input_sha256": {"$ref": "#/$defs/sha256"},
    "idempotency_key": {"$ref": "#/$defs/id"}
  },
  "allOf": [
    {
      "if": {"properties": {"authoring_topology_status": {"const": "complete"}}, "required": ["authoring_topology_status"]},
      "then": {"properties": {"part_authoring_topology_sha256s": {"$ref": "#/$defs/complete_sha256_list"}}}
    },
    {
      "if": {"properties": {"authoring_topology_status": {"const": "not-available"}}, "required": ["authoring_topology_status"]},
      "then": {"properties": {"part_authoring_topology_sha256s": {"$ref": "#/$defs/null_sha256_list"}}}
    }
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "id_list": {
      "type": "array", "minItems": 1, "maxItems": 512, "uniqueItems": true,
      "items": {"$ref": "#/$defs/id"}
    },
    "sha256_list": {
      "type": "array", "minItems": 1, "maxItems": 512, "uniqueItems": true,
      "items": {"$ref": "#/$defs/sha256"}
    },
    "nullable_sha256_list": {
      "type": "array", "minItems": 1, "maxItems": 512,
      "items": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
    },
    "complete_sha256_list": {
      "type": "array", "minItems": 1, "maxItems": 512,
      "items": {"$ref": "#/$defs/sha256"}
    },
    "null_sha256_list": {
      "type": "array", "minItems": 1, "maxItems": 512,
      "items": {"type": "null"}
    }
  }
}
