{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/candidate-animation-vfx-quality-v2.schema.json",
  "title": "CandidateAnimationVfxQuality@2",
  "description": "Additive Runtime-owned structural animation/VFX receipt. It binds the exact material-surface head and quality record to the durable FictionalEnergyVfxAnimatedSocketAttachment@3 parent lineage and its complete ordered fifteen-frame set. Base, bloom, particle, trail, trail-bloom, camera and worker predicates are derived from that Attachment@3 get and are not caller-supplied V1 sidecar keys. The owned V2 report object hash is intentionally absent from this public record.",
  "type": "object",
  "additionalProperties": false,
  "required": [
