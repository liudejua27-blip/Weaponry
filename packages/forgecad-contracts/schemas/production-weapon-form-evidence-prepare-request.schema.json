{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/production-weapon-form-evidence-prepare-request.schema.json",
  "title": "ProductionWeaponFormEvidencePrepareRequest@1",
  "description": "Closed prepare request for Runtime-owned six-view typed evidence. It binds existing candidate/artifact/reference/camera/RenderSet inputs; it does not accept geometry, image bytes, quality PASS, stage transition or confirmation fields.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "form_evidence_id", "session_id", "project_id", "candidate_id",
    "candidate_state_sha256", "artifact_id", "artifact_sha256", "reference_canvas_object_sha256",
    "reference_canvas_canonical_sha256", "design_spec_object_sha256", "design_spec_canonical_sha256",
    "camera_lock_id", "camera_lock_canonical_sha256", "camera_rig_object_sha256",
    "camera_rig_canonical_sha256", "camera_lock_receipt_object_sha256",
    "camera_lock_source_transition_id", "camera_lock_source_transition_sha256",
    "camera_lock_source_head_canonical_sha256", "view_kinds", "views", "evidence_policy",
    "evidence_policy_sha256", "input_sha256", "idempotency_key"
  ],
  "properties": {
    "schema_version": {"const": "ProductionWeaponFormEvidencePrepareRequest@1"},
    "form_evidence_id": {"$ref": "#/$defs/id"},
    "session_id": {"$ref": "#/$defs/id"},
    "project_id": {"$ref": "#/$defs/id"},
    "candidate_id": {"$ref": "#/$defs/id"},
    "candidate_state_sha256": {"$ref": "#/$defs/sha256"},
    "artifact_id": {"$ref": "#/$defs/id"},
    "artifact_sha256": {"$ref": "#/$defs/sha256"},
    "reference_canvas_object_sha256": {"$ref": "#/$defs/sha256"},
    "reference_canvas_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "design_spec_object_sha256": {"$ref": "#/$defs/sha256"},
    "design_spec_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "camera_lock_id": {"$ref": "#/$defs/id"},
    "camera_lock_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "camera_rig_object_sha256": {"$ref": "#/$defs/sha256"},
    "camera_rig_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "camera_lock_receipt_object_sha256": {"$ref": "#/$defs/sha256"},
    "camera_lock_source_transition_id": {"$ref": "#/$defs/id"},
    "camera_lock_source_transition_sha256": {"$ref": "#/$defs/sha256"},
    "camera_lock_source_head_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "view_kinds": {"const": ["front", "back", "left", "right", "top", "rear-three-quarter"]},
    "views": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "prefixItems": [
        {"$ref": "#/$defs/view_input_front"},
        {"$ref": "#/$defs/view_input_back"},
        {"$ref": "#/$defs/view_input_left"},
        {"$ref": "#/$defs/view_input_right"},
        {"$ref": "#/$defs/view_input_top"},
        {"$ref": "#/$defs/view_input_rear_three_quarter"}
      ],
      "items": false
    },
    "evidence_policy": {"const": "production-weapon-form-evidence-six-view-typed-observation@1"},
    "evidence_policy_sha256": {"$ref": "#/$defs/sha256"},
    "input_sha256": {"$ref": "#/$defs/sha256"},
    "idempotency_key": {"$ref": "#/$defs/id"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "view_input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["view_kind", "view_id", "reference_id", "reference_sha256", "camera_hash", "camera_canonical_sha256", "render_set_object_sha256", "render_set_canonical_sha256", "render_set_view_id"],
      "properties": {
        "view_kind": {"enum": ["front", "back", "left", "right", "top", "rear-three-quarter"]},
        "view_id": {"$ref": "#/$defs/id"},
        "reference_id": {"$ref": "#/$defs/id"},
        "reference_sha256": {"$ref": "#/$defs/sha256"},
        "camera_hash": {"$ref": "#/$defs/sha256"},
        "camera_canonical_sha256": {"$ref": "#/$defs/sha256"},
        "render_set_object_sha256": {"$ref": "#/$defs/sha256"},
        "render_set_canonical_sha256": {"$ref": "#/$defs/sha256"},
        "render_set_view_id": {"$ref": "#/$defs/id"}
      }
    },
    "view_input_front": {"allOf": [{"$ref": "#/$defs/view_input"}, {"properties": {"view_kind": {"const": "front"}}}]},
    "view_input_back": {"allOf": [{"$ref": "#/$defs/view_input"}, {"properties": {"view_kind": {"const": "back"}}}]},
    "view_input_left": {"allOf": [{"$ref": "#/$defs/view_input"}, {"properties": {"view_kind": {"const": "left"}}}]},
    "view_input_right": {"allOf": [{"$ref": "#/$defs/view_input"}, {"properties": {"view_kind": {"const": "right"}}}]},
    "view_input_top": {"allOf": [{"$ref": "#/$defs/view_input"}, {"properties": {"view_kind": {"const": "top"}}}]},
    "view_input_rear_three_quarter": {"allOf": [{"$ref": "#/$defs/view_input"}, {"properties": {"view_kind": {"const": "rear-three-quarter"}}}]}
  }
}
