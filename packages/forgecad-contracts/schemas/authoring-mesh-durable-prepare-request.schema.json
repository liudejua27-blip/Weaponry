{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/authoring-mesh-durable-prepare-request.schema.json",
  "title": "AuthoringMeshDurablePrepareRequest",
  "additionalProperties": false,
  "properties": {
    "authoring_node_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]+$",
      "type": "string"
    },
    "base_version_id": {
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$",
      "type": [
        "string",
        "null"
      ]
    },
    "canonicalization_policy": {
      "const": "canonical-json-sha256-excluding-canonical-sha256@1"
    },
    "expected_canonical_mesh_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "idempotency_key": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "type": "string"
    },
    "input_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "max_response_bytes": {
      "const": 1048576
    },
    "part_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]+$",
      "type": "string"
    },
    "project_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]+$",
      "type": "string"
    },
    "runtime_write_performed": {
      "const": false
    },
    "schema_version": {
      "const": "AuthoringMeshPrepareRequest@1"
    },
    "source_artifact_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]+$",
      "type": "string"
    },
    "source_artifact_object_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "source_artifact_readback_object_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "source_artifact_readback_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "source_artifact_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "source_candidate_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]+$",
      "type": "string"
    },
    "source_candidate_state_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "source_lineage_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "source_program_object_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "source_program_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "writer_policy": {
      "const": "forgecad-runtime-only-state-writer@1"
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "source_candidate_id",
    "source_candidate_state_sha256",
    "base_version_id",
    "authoring_node_id",
    "part_id",
    "source_program_object_sha256",
    "source_program_sha256",
    "source_artifact_id",
    "source_artifact_object_sha256",
    "source_artifact_sha256",
    "source_artifact_readback_object_sha256",
    "source_artifact_readback_sha256",
    "source_lineage_sha256",
    "expected_canonical_mesh_sha256",
    "idempotency_key",
    "max_response_bytes",
    "runtime_write_performed",
    "writer_policy",
    "canonicalization_policy",
    "input_sha256"
  ],
  "type": "object"
}
