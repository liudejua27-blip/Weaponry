{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://forgecad.local/contracts/texture-set.schema.json",
  "title":"TextureSet",
  "type":"object","additionalProperties":false,
  "required":["texture_set_id","base_color_texture_id","normal_texture_id","roughness_texture_id","metallic_texture_id","ao_texture_id"],
  "properties":{
    "texture_set_id":{"type":"string","pattern":"^[A-Za-z0-9_.-]{1,128}$"},
    "base_color_texture_id":{"type":["string","null"],"pattern":"^[A-Za-z0-9_.-]{1,128}$"},
    "normal_texture_id":{"type":["string","null"],"pattern":"^[A-Za-z0-9_.-]{1,128}$"},
    "roughness_texture_id":{"type":["string","null"],"pattern":"^[A-Za-z0-9_.-]{1,128}$"},
    "metallic_texture_id":{"type":["string","null"],"pattern":"^[A-Za-z0-9_.-]{1,128}$"},
    "ao_texture_id":{"type":["string","null"],"pattern":"^[A-Za-z0-9_.-]{1,128}$"}
  },
  "$defs":{
    "texture":{"type":"object","additionalProperties":false,"required":["texture_id","file","sha256","semantic","color_space","normal_convention","width","height"],"properties":{"texture_id":{"type":"string","pattern":"^[A-Za-z0-9_.-]{1,128}$"},"file":{"type":"string","pattern":"^textures/[A-Za-z0-9_.-]+\\.png$"},"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"semantic":{"enum":["baseColor","normal","roughness","metallic","ao","emissive"]},"color_space":{"enum":["sRGB","linear"]},"normal_convention":{"type":["string","null"],"enum":["OpenGL+Y",null]},"width":{"type":"integer","minimum":1,"maximum":2048},"height":{"type":"integer","minimum":1,"maximum":2048}}}
  }
}
