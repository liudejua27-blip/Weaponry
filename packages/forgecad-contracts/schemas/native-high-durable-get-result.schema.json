{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/native-high-durable-get-result.schema.json",
  "title": "NativeHighDurableGetResult@1",
  "description": "Closed restart-verified read-only Native High durable readback. It repeats the exact stable-ID source, DetailGraph, HighMeshArtifact and GLB/CAS bindings without mutating Runtime state or promoting a production candidate.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "operation", "project_id", "candidate_id", "candidate_state_sha256", "base_version_id",
    "source_authoring_mesh", "source_authoring_mesh_object_sha256", "source_authoring_mesh_sha256",
    "detail_graph", "detail_graph_object_sha256", "detail_graph_canonical_sha256", "artifact",
    "artifact_id", "artifact_object_sha256", "artifact_sha256", "artifact_readback_object_sha256", "artifact_readback_sha256",
    "glb_object_sha256", "glb_sha256", "glb_readback_object_sha256", "glb_readback_sha256",
    "high_worker_algorithm_sha256", "high_worker_build_cohort_sha256", "replay_count", "replay_byte_exact",
    "request_sha256", "request_input_sha256", "idempotency_key", "replayed", "restart_hash_verified",
    "link_id", "link_object_sha256", "durable_link", "source_only", "writer_policy", "runtime_write_performed",
    "persistent_user_data_touched", "production_stage_advanced", "candidate_confirmed", "version_created",
    "export_performed", "quality_status", "limitations", "canonicalization_policy", "canonical_sha256"
  ],
  "properties": {
    "schema_version": {"const": "NativeHighDurableGetResult@1"},
    "operation": {"const": "forgecad.production.native-high-durable-get@1"},
    "project_id": {"$ref": "#/$defs/id"},
    "candidate_id": {"$ref": "#/$defs/id"},
    "candidate_state_sha256": {"$ref": "#/$defs/sha256"},
    "base_version_id": {"$ref": "#/$defs/nullable_id"},
    "source_authoring_mesh": {"$ref": "https://forgecad.local/contracts/authoring-mesh-canonical.schema.json"},
    "source_authoring_mesh_object_sha256": {"$ref": "#/$defs/sha256"},
    "source_authoring_mesh_sha256": {"$ref": "#/$defs/sha256"},
    "detail_graph": {"$ref": "#/$defs/detail_graph"},
    "detail_graph_object_sha256": {"$ref": "#/$defs/sha256"},
    "detail_graph_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "artifact": {"$ref": "https://forgecad.local/contracts/high-mesh-artifact.schema.json"},
    "artifact_id": {"$ref": "#/$defs/id"},
    "artifact_object_sha256": {"$ref": "#/$defs/sha256"},
    "artifact_sha256": {"$ref": "#/$defs/sha256"},
    "artifact_readback_object_sha256": {"$ref": "#/$defs/sha256"},
    "artifact_readback_sha256": {"$ref": "#/$defs/sha256"},
    "glb_object_sha256": {"$ref": "#/$defs/sha256"},
    "glb_sha256": {"$ref": "#/$defs/sha256"},
    "glb_readback_object_sha256": {"$ref": "#/$defs/sha256"},
    "glb_readback_sha256": {"$ref": "#/$defs/sha256"},
    "high_worker_algorithm_sha256": {"$ref": "#/$defs/sha256"},
    "high_worker_build_cohort_sha256": {"$ref": "#/$defs/sha256"},
    "replay_count": {"const": 2},
    "replay_byte_exact": {"const": true},
    "request_sha256": {"$ref": "#/$defs/sha256"},
    "request_input_sha256": {"$ref": "#/$defs/sha256"},
    "idempotency_key": {"$ref": "#/$defs/id"},
    "replayed": {"const": true},
    "restart_hash_verified": {"const": true},
    "link_id": {"$ref": "#/$defs/id"},
    "link_object_sha256": {"$ref": "#/$defs/sha256"},
    "durable_link": {"$ref": "https://forgecad.local/contracts/native-high-durable-link.schema.json"},
    "source_only": {"const": true},
    "writer_policy": {"const": "forgecad-runtime-only-state-writer@1"},
    "runtime_write_performed": {"const": false},
    "persistent_user_data_touched": {"const": false},
    "production_stage_advanced": {"const": false},
    "candidate_confirmed": {"const": false},
    "version_created": {"const": false},
    "export_performed": {"const": false},
    "quality_status": {"const": "structural_only"},
    "limitations": {"const": ["RUNTIME_SOLE_WRITER", "NO_STAGE_ADVANCEMENT", "NO_CANDIDATE_CONFIRM", "NO_VERSION_CREATED", "NO_EXPORT", "SOURCE_ONLY_NOT_PRODUCTION_WEAPON_HIGH", "STRUCTURAL_ONLY_NOT_COMMERCIAL_QUALITY"]},
    "canonicalization_policy": {"const": "canonical-json-sha256-excluding-canonical-sha256@1"},
    "canonical_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,128}$"},
    "nullable_id": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9_.:-]{1,128}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "detail_node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_id", "kind", "parent_part_id"],
      "properties": {
        "node_id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["support_loop", "crease", "floating_detail"]},
        "parent_part_id": {"$ref": "#/$defs/id"},
        "parent_node_id": {"$ref": "#/$defs/id"},
        "source_edge": {"$ref": "#/$defs/id"},
        "width_m": {"type": "number", "exclusiveMinimum": 0, "maximum": 0.25},
        "count": {"type": "integer", "minimum": 1, "maximum": 3},
        "sharpness": {"type": "number", "minimum": 0, "maximum": 10},
        "center_m": {"$ref": "#/$defs/vector3"},
        "size_m": {"$ref": "#/$defs/vector3"}
      }
    },
    "detail_graph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "nodes"],
      "properties": {
        "schema_version": {"const": "DetailGraph@1"},
        "nodes": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/$defs/detail_node"}}
      }
    },
    "vector3": {
      "type": "array",
      "prefixItems": [{"type": "number"}, {"type": "number"}, {"type": "number"}],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    }
  }
}
