{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/production-weapon-form-art-composite-proposal-store-record.schema.json",
  "title": "ProductionWeaponFormArtCompositeProposalStoreRecord@1",
  "description": "Immutable Runtime/Store index for a cumulative review candidate. It proves original/current/final lineage but never represents approval, Stage advancement, confirmation, versioning, export or commercial quality.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "project_id", "proposal_id", "session_id", "idempotency_key",
    "plan_object_sha256", "plan_canonical_sha256",
    "current_base_candidate_id", "current_base_candidate_state_sha256", "current_base_artifact_sha256",
    "current_base_geometry_program_sha256", "current_base_geometry_program_object_sha256",
    "current_base_proposal_evidence_receipt_object_sha256",
    "composed_geometry_program_sha256", "composed_geometry_program_object_sha256",
    "proposal_candidate_id", "proposal_candidate_state_sha256", "proposal_artifact_sha256",
    "proposal_artifact_readback_object_sha256", "proposal_artifact_readback_sha256",
    "receipt_object_sha256", "request_sha256", "input_sha256", "status", "quality_status",
    "candidate_confirm_allowed", "secondary_form_approved", "production_stage_advanced",
    "candidate_confirmed", "version_created", "export_performed", "canonical_sha256", "created_at"
  ],
  "properties": {
    "schema_version": {"const": "ProductionWeaponFormArtCompositeProposalStoreRecord@1"},
    "project_id": {"$ref": "common.schema.json#/$defs/identifier"},
    "proposal_id": {"$ref": "common.schema.json#/$defs/identifier"},
    "session_id": {"$ref": "common.schema.json#/$defs/identifier"},
    "idempotency_key": {"$ref": "common.schema.json#/$defs/identifier"},
    "plan_object_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "plan_canonical_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "current_base_candidate_id": {"$ref": "common.schema.json#/$defs/identifier"},
    "current_base_candidate_state_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "current_base_artifact_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "current_base_geometry_program_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "current_base_geometry_program_object_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "current_base_proposal_evidence_receipt_object_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "composed_geometry_program_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "composed_geometry_program_object_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "proposal_candidate_id": {"$ref": "common.schema.json#/$defs/identifier"},
    "proposal_candidate_state_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "proposal_artifact_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "proposal_artifact_readback_object_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "proposal_artifact_readback_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "cross_view_evidence_bundle_sha256": {"oneOf": [{"$ref": "common.schema.json#/$defs/sha256"}, {"type": "null"}]},
    "proposal_form_art_evidence_receipt_object_sha256": {"oneOf": [{"$ref": "common.schema.json#/$defs/sha256"}, {"type": "null"}]},
    "receipt_object_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "request_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "input_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "status": {"const": "PREPARED_REVIEWABLE_CANDIDATE_AWAITING_SIX_VIEW"},
    "quality_status": {"const": "QUALITY_TARGET_NOT_MET"},
    "candidate_confirm_allowed": {"const": false},
    "secondary_form_approved": {"const": "NOT_CREATED"},
    "production_stage_advanced": {"const": false},
    "candidate_confirmed": {"const": false},
    "version_created": {"const": false},
    "export_performed": {"const": false},
    "canonical_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "created_at": {"type": "string", "minLength": 1, "maxLength": 64}
  }
}
