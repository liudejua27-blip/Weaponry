{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/fps-presentation-package-v2-component-binding.schema.json",
  "title": "FpsPresentationPackageV2ComponentBinding@1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","component_role","source_asset_id","source_asset_sha256","source_asset_role","materialization_id","materialization_descriptor_object_sha256","materialization_descriptor_sha256","foundation_package_object_sha256","socket_map_object_sha256","rig_map_object_sha256","part_ids","part_revision_object_sha256s","part_revision_summary_sha256","part_count","vertex_count","face_count","editable_authoring_mesh_v2","canonical_sha256"],
  "properties": {
    "schema_version": {"const":"FpsPresentationPackageV2ComponentBinding@1"},
    "component_role": {"enum":["weapon","first-person-arms","animation-source"]},
    "source_asset_id": {"enum":["pichuliru-weapon-west","wrad-arms","lightning-low-pbr"]},
    "source_asset_sha256": {"$ref":"#/$defs/sha"},
    "source_asset_role": {"enum":["rigged-weapon-semantic-source","first-person-armature-source","high-low-bake-pbr-animation-benchmark"]},
    "materialization_id": {"$ref":"#/$defs/id"},
    "materialization_descriptor_object_sha256": {"$ref":"#/$defs/sha"},
    "materialization_descriptor_sha256": {"$ref":"#/$defs/sha"},
    "foundation_package_object_sha256": {"$ref":"#/$defs/sha"},
    "socket_map_object_sha256": {"$ref":"#/$defs/sha"},
    "rig_map_object_sha256": {"$ref":"#/$defs/sha"},
    "part_ids": {"type":"array","minItems":1,"maxItems":128,"uniqueItems":true,"items":{"$ref":"#/$defs/id"}},
    "part_revision_object_sha256s": {"type":"array","minItems":1,"maxItems":128,"uniqueItems":true,"items":{"$ref":"#/$defs/sha"}},
    "part_revision_summary_sha256": {"$ref":"#/$defs/sha"},
    "part_count": {"type":"integer","minimum":1,"maximum":128},
    "vertex_count": {"type":"integer","minimum":1},
    "face_count": {"type":"integer","minimum":1},
    "editable_authoring_mesh_v2": {"const":true},
    "canonical_sha256": {"$ref":"#/$defs/sha"}
  },
  "$defs": {
    "id":{"type":"string","minLength":1,"maxLength":128,"pattern":"^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},
    "sha":{"type":"string","pattern":"^[0-9a-f]{64}$"}
  }
}
