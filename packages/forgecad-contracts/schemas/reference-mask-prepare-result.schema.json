{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/reference-mask-prepare-result.schema.json",
  "title": "ReferenceMaskPrepareResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "reference_id", "target_sha256", "mask_sha256", "target", "canonical_sha256"],
  "properties": {
    "schema_version": {"const": "ReferenceMaskPrepareResult@1"},
    "project_id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,128}$"},
    "reference_id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,128}$"},
    "target_sha256": {"$ref": "#/$defs/sha256"},
    "mask_sha256": {"$ref": "#/$defs/sha256"},
    "target": {"$ref": "https://forgecad.local/contracts/silhouette-target.schema.json"},
    "canonical_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
