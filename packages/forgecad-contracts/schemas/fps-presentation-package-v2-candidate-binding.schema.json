{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/fps-presentation-package-v2-candidate-binding.schema.json",
  "title": "FpsPresentationPackageV2CandidateBinding@1",
  "description": "Runtime-derived binding from one editable FPS presentation package to one reviewable weapon candidate. The binding is structural-only and never confirms, versions or exports the candidate.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "project_id", "package_id", "package_object_sha256", "package_sha256",
    "weapon_materialization_id", "weapon_materialization_descriptor_sha256", "weapon_part_id",
    "weapon_material_zone_id", "weapon_authoring_mesh_revision_id",
    "weapon_authoring_mesh_revision_object_sha256", "weapon_authoring_mesh_revision_sha256",
    "candidate_id", "candidate_state_sha256", "candidate_state", "candidate_artifact_sha256",
    "geometry_program_object_sha256", "geometry_program_sha256", "geometry_candidate_evidence_sha256",
    "geometry_integrity_status", "form_stage", "secondary_form_approved", "formal_high_status",
    "quality_status", "visual_review_status", "engine_validation_status", "human_review_status",
    "promotion_eligible", "candidate_confirmed", "version_created", "export_performed", "policy",
    "canonicalization_policy", "canonical_sha256"
  ],
  "properties": {
    "schema_version": {"const": "FpsPresentationPackageV2CandidateBinding@1"},
    "project_id": {"$ref": "#/$defs/id"},
    "package_id": {"$ref": "#/$defs/id"},
    "package_object_sha256": {"$ref": "#/$defs/sha256"},
    "package_sha256": {"$ref": "#/$defs/sha256"},
    "weapon_materialization_id": {"$ref": "#/$defs/id"},
    "weapon_materialization_descriptor_sha256": {"$ref": "#/$defs/sha256"},
    "weapon_part_id": {"$ref": "#/$defs/id"},
    "weapon_material_zone_id": {"$ref": "#/$defs/id"},
    "weapon_authoring_mesh_revision_id": {"$ref": "#/$defs/id"},
    "weapon_authoring_mesh_revision_object_sha256": {"$ref": "#/$defs/sha256"},
    "weapon_authoring_mesh_revision_sha256": {"$ref": "#/$defs/sha256"},
    "candidate_id": {"$ref": "#/$defs/id"},
    "candidate_state_sha256": {"$ref": "#/$defs/sha256"},
    "candidate_state": {"const": "reviewable"},
    "candidate_artifact_sha256": {"$ref": "#/$defs/sha256"},
    "geometry_program_object_sha256": {"$ref": "#/$defs/sha256"},
    "geometry_program_sha256": {"$ref": "#/$defs/sha256"},
    "geometry_candidate_evidence_sha256": {"$ref": "#/$defs/sha256"},
    "geometry_integrity_status": {"const": "PASS_SOURCE_STRUCTURAL"},
    "form_stage": {"const": "candidate-reviewable"},
    "secondary_form_approved": {"const": false},
    "formal_high_status": {"const": "BLOCKED_SECONDARY_FORM_APPROVAL"},
    "quality_status": {"const": "structural_only"},
    "visual_review_status": {"const": "NOT_RUN"},
    "engine_validation_status": {"const": "NOT_RUN"},
    "human_review_status": {"const": "NOT_RUN"},
    "promotion_eligible": {"const": false},
    "candidate_confirmed": {"const": false},
    "version_created": {"const": false},
    "export_performed": {"const": false},
    "policy": {"const": "runtime-derived-package-weapon-authoring-mesh-reviewable-candidate@1"},
    "canonicalization_policy": {"const": "canonical-json-sha256-excluding-canonical-sha256@1"},
    "canonical_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
