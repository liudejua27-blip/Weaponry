{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/session-create-or-resume-request.schema.json",
  "title": "SessionCreateOrResumeRequest",
  "description": "Create or resume one approval-gated Runtime-owned design session.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "session_id",
    "project_id",
    "candidate_id",
    "idempotency_key",
    "approved",
    "approval_receipt_id",
    "approval_summary"
  ],
  "properties": {
    "project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "candidate_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "session_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "reference_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "design_spec_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "reference_canvas_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "camera_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evidence_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "authoring_context": {
      "type": "object",
      "required": [
        "reference_canvas",
        "design_spec"
      ],
      "properties": {
        "reference_canvas": {
          "type": "object",
          "maxProperties": 16
        },
        "design_spec": {
          "type": "object",
          "maxProperties": 16
        }
      },
      "additionalProperties": false
    },
    "approved": {
      "const": true
    },
    "approval_receipt_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "approval_summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "approval_expires_at": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    }
  }
}
