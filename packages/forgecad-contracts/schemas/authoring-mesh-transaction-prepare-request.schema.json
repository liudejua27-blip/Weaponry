{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/authoring-mesh-transaction-prepare-request.schema.json",
  "title": "AuthoringMeshTransactionPrepareRequest@1",
  "description": "Closed durable Runtime request for one bounded AuthoringMeshTransaction@1. This envelope deliberately carries no candidate, source, approval, evidence, raw topology, mesh buffers, script, path or promotion state; those concerns remain in their owning contracts and in the later confirm flow.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "transaction",
    "idempotency_key",
    "max_response_bytes",
    "runtime_write_performed",
    "writer_policy",
    "canonicalization_policy",
    "input_sha256"
  ],
  "properties": {
    "schema_version": {"const": "AuthoringMeshTransactionPrepareRequest@1"},
    "project_id": {"$ref": "#/$defs/identifier"},
    "transaction": {"$ref": "https://forgecad.local/contracts/authoring-mesh-transaction.schema.json"},
    "idempotency_key": {"$ref": "#/$defs/idempotency_key"},
    "max_response_bytes": {"const": 1048576},
    "runtime_write_performed": {"const": false},
    "writer_policy": {"const": "forgecad-runtime-only-state-writer@1"},
    "canonicalization_policy": {"const": "canonical-json-sha256-excluding-canonical-sha256@1"},
    "input_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "idempotency_key": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
