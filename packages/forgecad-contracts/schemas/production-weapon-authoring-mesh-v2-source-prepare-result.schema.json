{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/production-weapon-authoring-mesh-v2-source-prepare-result.schema.json",
  "title": "ProductionWeaponAuthoringMeshV2SourcePrepareResult@1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "candidate_id",
    "candidate_state_sha256",
    "geometry_program_sha256",
    "artifact_sha256",
    "artifact_readback_sha256",
    "part_id",
    "source_node_id",
    "source_operator_id",
    "source_parameters_sha256",
    "source_position_m",
    "source_rotation_rad",
    "material_zone_id",
    "solid",
    "source_binding_sha256",
    "mesh_id",
    "lineage_id",
    "revision_id",
    "revision_sha256",
    "revision_object_sha256",
    "authoring_mesh_v2",
    "request_input_sha256",
    "idempotency_key",
    "runtime_write_performed",
    "persistent_user_data_touched",
    "stage_advanced",
    "candidate_confirmed",
    "version_created",
    "export_performed",
    "quality_status",
    "limitations",
    "canonical_sha256"
  ],
  "properties": {
    "schema_version": {"const": "ProductionWeaponAuthoringMeshV2SourcePrepareResult@1"},
    "project_id": {"$ref": "#/$defs/identifier"},
    "candidate_id": {"$ref": "#/$defs/identifier"},
    "candidate_state_sha256": {"$ref": "#/$defs/sha256"},
    "geometry_program_sha256": {"$ref": "#/$defs/sha256"},
    "artifact_sha256": {"$ref": "#/$defs/sha256"},
    "artifact_readback_sha256": {"$ref": "#/$defs/sha256"},
    "part_id": {"$ref": "#/$defs/identifier"},
    "source_node_id": {"$ref": "#/$defs/identifier"},
    "source_operator_id": {
      "enum": ["forgecad.geometry.primitive@2", "forgecad.geometry.profile-extrude@1"]
    },
    "source_parameters_sha256": {"$ref": "#/$defs/sha256"},
    "source_position_m": {"$ref": "#/$defs/vector3"},
    "source_rotation_rad": {"$ref": "#/$defs/vector3"},
    "material_zone_id": {"$ref": "#/$defs/identifier"},
    "solid": {"type": "boolean"},
    "source_binding_sha256": {"$ref": "#/$defs/sha256"},
    "mesh_id": {"$ref": "#/$defs/identifier"},
    "lineage_id": {"$ref": "#/$defs/identifier"},
    "revision_id": {"$ref": "#/$defs/identifier"},
    "revision_sha256": {"$ref": "#/$defs/sha256"},
    "revision_object_sha256": {"$ref": "#/$defs/sha256"},
    "authoring_mesh_v2": {"$ref": "#/$defs/authoring_mesh_v2_result"},
    "request_input_sha256": {"$ref": "#/$defs/sha256"},
    "idempotency_key": {"$ref": "#/$defs/identifier"},
    "runtime_write_performed": {"const": true},
    "persistent_user_data_touched": {"const": true},
    "stage_advanced": {"const": false},
    "candidate_confirmed": {"const": false},
    "version_created": {"const": false},
    "export_performed": {"const": false},
    "quality_status": {"const": "structural_source_bound_not_visually_evaluated"},
    "limitations": {"$ref": "#/$defs/limitations"},
    "canonical_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "vector3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"type": "number", "minimum": -10.0, "maximum": 10.0}
    },
    "limitations": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "enum": [
          "REAL_CANDIDATE_SOURCE_BOUND",
          "PROFILE_EXTRUDE_OR_PRIMITIVE_SOURCE",
          "NO_ART_EDIT_APPLIED",
          "NO_STAGE_ADVANCEMENT",
          "NO_VISUAL_QUALITY_CLAIM"
        ]
      }
    },
    "authoring_mesh_v2_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "project_id",
        "mesh_id",
        "lineage_id",
        "revision_id",
        "revision_index",
        "parent_revision_ids",
        "revision_sha256",
        "revision_object_sha256",
        "operation",
        "revision",
        "durable_record",
        "request_input_sha256",
        "idempotency_key",
        "replayed",
        "restart_hash_verified",
        "runtime_write_performed",
        "persistent_user_data_touched",
        "stage_advanced",
        "candidate_confirmed",
        "version_created",
        "export_performed",
        "quality_status",
        "limitations",
        "canonicalization_policy",
        "canonical_sha256"
      ],
      "properties": {
        "schema_version": {"const": "AuthoringMeshV2DurableResult@1"},
        "project_id": {"$ref": "#/$defs/identifier"},
        "mesh_id": {"$ref": "#/$defs/identifier"},
        "lineage_id": {"$ref": "#/$defs/identifier"},
        "revision_id": {"$ref": "#/$defs/identifier"},
        "revision_index": {"const": 0},
        "parent_revision_ids": {"type": "array", "maxItems": 0},
        "revision_sha256": {"$ref": "#/$defs/sha256"},
        "revision_object_sha256": {"$ref": "#/$defs/sha256"},
        "operation": {"const": "genesis"},
        "revision": {"type": "object"},
        "durable_record": {"type": "object"},
        "request_input_sha256": {"$ref": "#/$defs/sha256"},
        "idempotency_key": {"$ref": "#/$defs/identifier"},
        "replayed": {"type": "boolean"},
        "restart_hash_verified": {"type": "boolean"},
        "runtime_write_performed": {"type": "boolean"},
        "persistent_user_data_touched": {"type": "boolean"},
        "stage_advanced": {"const": false},
        "candidate_confirmed": {"const": false},
        "version_created": {"const": false},
        "export_performed": {"const": false},
        "quality_status": {"const": "structural_only"},
        "limitations": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"type": "string"}},
        "canonicalization_policy": {"const": "canonical-json-sha256-excluding-canonical-sha256@1"},
        "canonical_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
