{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/game-weapon-animated-glb-socket-transform-projection-v2-prepare-request.schema.json",
  "title": "GameWeaponAnimatedGlbSocketTransformProjectionPrepareRequest@2",
  "description": "Closed explicit-write request for an appearance-candidate-bound animated GLB socket transform projection. The request binds the exact Clip@2, MechanicalAnimationGlb@2, AnimatedSocket@2 and AnchorSet inputs and carries a bounded sample schedule.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "projection_key_sha256", "project_id", "appearance_candidate_id",
    "appearance_candidate_state_sha256", "appearance_delivery_manifest_object_sha256",
    "appearance_artifact_sha256", "appearance_artifact_readback_sha256", "animation_clip_id",
    "animation_clip_object_sha256", "animation_clip_canonical_sha256", "animation_glb_key_sha256",
    "animated_artifact_sha256", "animated_artifact_readback_sha256", "animation_receipt_object_sha256",
    "animation_receipt_canonical_sha256", "animated_socket_materialization_key_sha256",
    "derived_animated_socket_artifact_sha256", "derived_animated_socket_artifact_readback_sha256",
    "derived_animated_socket_receipt_object_sha256", "derived_animated_socket_receipt_canonical_sha256",
    "anchor_set_object_sha256", "anchor_set_canonical_sha256", "socket_node_id_encoding_sha256",
    "socket_node_inventory_sha256", "socket_roles_sha256", "socket_roles", "part_hierarchy_sha256",
    "part_hierarchy_policy", "transform_representation_policy", "sampling_policy_sha256",
    "sample_schedule_sha256", "sample_count",
    "sample_time_ticks", "frame_scope", "timebase_hz", "transform_projection_policy",
    "coordinate_system", "transform_convention", "float_quantization_policy", "input_sha256",
    "idempotency_key"
  ],
  "properties": {
    "schema_version": {"const": "GameWeaponAnimatedGlbSocketTransformProjectionPrepareRequest@2"},
    "projection_key_sha256": {"$ref": "#/$defs/sha256"},
    "project_id": {"$ref": "#/$defs/id"},
    "appearance_candidate_id": {"$ref": "#/$defs/id"},
    "appearance_candidate_state_sha256": {"$ref": "#/$defs/sha256"},
    "appearance_delivery_manifest_object_sha256": {"$ref": "#/$defs/sha256"},
    "appearance_artifact_sha256": {"$ref": "#/$defs/sha256"},
    "appearance_artifact_readback_sha256": {"$ref": "#/$defs/sha256"},
    "animation_clip_id": {"$ref": "#/$defs/id"},
    "animation_clip_object_sha256": {"$ref": "#/$defs/sha256"},
    "animation_clip_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "animation_glb_key_sha256": {"$ref": "#/$defs/sha256"},
    "animated_artifact_sha256": {"$ref": "#/$defs/sha256"},
    "animated_artifact_readback_sha256": {"$ref": "#/$defs/sha256"},
    "animation_receipt_object_sha256": {"$ref": "#/$defs/sha256"},
    "animation_receipt_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "animated_socket_materialization_key_sha256": {"$ref": "#/$defs/sha256"},
    "derived_animated_socket_artifact_sha256": {"$ref": "#/$defs/sha256"},
    "derived_animated_socket_artifact_readback_sha256": {"$ref": "#/$defs/sha256"},
    "derived_animated_socket_receipt_object_sha256": {"$ref": "#/$defs/sha256"},
    "derived_animated_socket_receipt_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "anchor_set_object_sha256": {"$ref": "#/$defs/sha256"},
    "anchor_set_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "socket_node_id_encoding_sha256": {"$ref": "#/$defs/sha256"},
    "socket_node_inventory_sha256": {"$ref": "#/$defs/sha256"},
    "socket_roles_sha256": {"$ref": "#/$defs/sha256"},
    "socket_roles": {"const": ["weapon-root", "grip-primary", "muzzle-vfx", "magazine-well", "sight-primary", "energy-core-vfx"]},
    "part_hierarchy_sha256": {"$ref": "#/$defs/sha256"},
    "part_hierarchy_policy": {"const": "flat-identity-rest-part-hierarchy-only@2"},
    "transform_representation_policy": {"const": "trs-quaternion-no-shear-plus-column-major-matrix@2"},
    "sampling_policy_sha256": {"$ref": "#/$defs/sha256"},
    "sample_schedule_sha256": {"$ref": "#/$defs/sha256"},
    "sample_count": {"type": "integer", "minimum": 1, "maximum": 16},
    "sample_time_ticks": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"type": "integer", "minimum": 0, "maximum": 1000000}},
    "frame_scope": {"const": "lod0-animation-frame-range-1-16@2"},
    "timebase_hz": {"const": 1000},
    "transform_projection_policy": {"const": "glb-animation-linear-nlerp-flat-part-hierarchy-composed-world-trs-matrix@2"},
    "coordinate_system": {"const": "forgecad-rh-y-up-m@1"},
    "transform_convention": {"const": "column-vector-parent-world-times-trs-quaternion-xyzw@1"},
    "float_quantization_policy": {"const": "f32-round-nearest-canonical-json@1"},
    "input_sha256": {"$ref": "#/$defs/sha256"},
    "idempotency_key": {"$ref": "#/$defs/id"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
