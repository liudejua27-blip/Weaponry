{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/design-action-optimization-proposal-prepare-result.schema.json",
  "title": "ForgeCAD ActionRun-bound Optimization Proposal Prepare Result",
  "description": "A Runtime-owned, source-preserving bridge from a completed CADFit OptimizationJob to a separately reviewable candidate and explicit single-view visual evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "session_id",
    "candidate_id",
    "run_id",
    "job_id",
    "proposal_job_id",
    "view_spec_sha256",
    "status",
    "reason_code",
    "optimizer_result_sha256",
    "optimizer_proposal_status",
    "baseline_loss",
    "best_loss",
    "strict_improvement",
    "non_regressing",
    "source_candidate_state_sha256",
    "source_artifact_sha256",
    "proposal_candidate_id",
    "proposal_candidate_state_sha256",
    "proposal_program_sha256",
    "proposal_program_object_sha256",
    "proposal_artifact_sha256",
    "render_set_object_sha256",
    "comparison_report_object_sha256",
    "quality_report_id",
    "quality_report_object_sha256",
    "visual_status",
    "visual_gate_passed",
    "confirm_allowed",
    "repair_apply_status",
    "source_candidate_unchanged",
    "persistent_user_data_touched",
    "version_created",
    "canonical_sha256"
  ],
  "properties": {
    "schema_version": {"const": "OptimizationProposalPrepareResult@1"},
    "project_id": {"$ref": "#/$defs/id"},
    "session_id": {"$ref": "#/$defs/id"},
    "candidate_id": {"$ref": "#/$defs/id"},
    "run_id": {"$ref": "#/$defs/id"},
    "job_id": {"$ref": "#/$defs/id"},
    "proposal_job_id": {"$ref": "#/$defs/id"},
    "view_spec_sha256": {"$ref": "#/$defs/sha256"},
    "status": {"enum": ["not-ready", "blocked", "proposed"]},
    "reason_code": {"$ref": "#/$defs/id"},
    "optimizer_result_sha256": {"$ref": "#/$defs/nullable_sha256"},
    "optimizer_proposal_status": {
      "type": ["string", "null"],
      "enum": ["not-ready", "proposed", "blocked-no-improvement", "blocked-invalid", null]
    },
    "baseline_loss": {"type": ["number", "null"], "minimum": 0, "maximum": 1000000},
    "best_loss": {"type": ["number", "null"], "minimum": 0, "maximum": 1000000},
    "strict_improvement": {"type": "boolean"},
    "non_regressing": {"type": "boolean"},
    "source_candidate_state_sha256": {"$ref": "#/$defs/sha256"},
    "source_artifact_sha256": {"$ref": "#/$defs/nullable_sha256"},
    "proposal_candidate_id": {"$ref": "#/$defs/nullable_id"},
    "proposal_candidate_state_sha256": {"$ref": "#/$defs/nullable_sha256"},
    "proposal_program_sha256": {"$ref": "#/$defs/nullable_sha256"},
    "proposal_program_object_sha256": {"$ref": "#/$defs/nullable_sha256"},
    "proposal_artifact_sha256": {"$ref": "#/$defs/nullable_sha256"},
    "render_set_object_sha256": {"$ref": "#/$defs/nullable_sha256"},
    "comparison_report_object_sha256": {"$ref": "#/$defs/nullable_sha256"},
    "quality_report_id": {"$ref": "#/$defs/nullable_id"},
    "quality_report_object_sha256": {"$ref": "#/$defs/nullable_sha256"},
    "visual_status": {"enum": ["NOT_RUN", "QUALITY_TARGET_NOT_MET", "PARTIAL_VISIBLE_VIEW_PASS"]},
    "visual_gate_passed": {"type": "boolean"},
    "confirm_allowed": {"const": false},
    "repair_apply_status": {
      "enum": [
        "not-ready",
        "blocked-no-improvement",
        "blocked-optimizer-state",
        "blocked-quality-gate",
        "blocked-action-run-proposal-boundary"
      ]
    },
    "source_candidate_unchanged": {"const": true},
    "persistent_user_data_touched": {"const": false},
    "version_created": {"const": false},
    "canonical_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "nullable_id": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullable_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
  }
}
