{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/render-set-v2.schema.json",
  "title": "RenderSetV2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "render_set_id", "view_id", "candidate_id", "artifact_sha256", "program_sha256", "reference_id", "camera_hash", "camera_object_sha256", "renderer_hash", "render_profile", "render_profile_sha256", "aov_definition_sha256", "color_pipeline_sha256", "id_palette_definition_sha256", "render_worker_build_cohort_sha256", "render_worker_binding_status", "width", "height", "passes", "pass_artifacts", "canonical_sha256"],
  "properties": {
    "schema_version": {"const": "RenderSet@2"},
    "render_set_id": {"$ref": "#/$defs/identifier"},
    "view_id": {"$ref": "#/$defs/identifier"},
    "candidate_id": {"$ref": "#/$defs/identifier"},
    "artifact_sha256": {"$ref": "#/$defs/sha256"},
    "program_sha256": {"$ref": "#/$defs/sha256"},
    "reference_id": {"$ref": "#/$defs/identifier"},
    "camera_hash": {"$ref": "#/$defs/sha256"},
    "camera_object_sha256": {"$ref": "#/$defs/sha256"},
    "renderer_hash": {"$ref": "#/$defs/sha256"},
    "render_profile": {"$ref": "https://forgecad.local/contracts/render-profile.schema.json"},
    "render_profile_sha256": {"$ref": "#/$defs/sha256"},
    "aov_definition_sha256": {"$ref": "#/$defs/sha256"},
    "color_pipeline_sha256": {"$ref": "#/$defs/sha256"},
    "id_palette_definition_sha256": {"$ref": "#/$defs/sha256"},
    "render_worker_build_cohort_sha256": {"$ref": "#/$defs/nullable_sha256"},
    "render_worker_binding_status": {"enum": ["same_cohort_verified", "cohort_unavailable"]},
    "width": {"const": 512},
    "height": {"const": 512},
    "passes": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "prefixItems": [
        {"const": "beauty"},
        {"const": "silhouette"},
        {"const": "depth"},
        {"const": "normal"},
        {"const": "ao"},
        {"const": "part-id"},
        {"const": "material-id"},
        {"const": "wireframe"},
        {"const": "uv-stretch"}
      ],
      "items": false
    },
    "pass_artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["beauty", "silhouette", "depth", "normal", "ao", "part-id", "material-id", "wireframe", "uv-stretch"],
      "properties": {
        "beauty": {"allOf": [{"$ref": "#/$defs/pass_artifact"}, {"properties": {"color_space": {"const": "srgb"}}}]},
        "silhouette": {"allOf": [{"$ref": "#/$defs/pass_artifact"}, {"properties": {"color_space": {"const": "data"}}}]},
        "depth": {"allOf": [{"$ref": "#/$defs/pass_artifact"}, {"properties": {"color_space": {"const": "data"}}}]},
        "normal": {"allOf": [{"$ref": "#/$defs/pass_artifact"}, {"properties": {"color_space": {"const": "data"}}}]},
        "ao": {"allOf": [{"$ref": "#/$defs/pass_artifact"}, {"properties": {"color_space": {"const": "data"}}}]},
        "part-id": {"allOf": [{"$ref": "#/$defs/pass_artifact"}, {"properties": {"color_space": {"const": "data"}}}]},
        "material-id": {"allOf": [{"$ref": "#/$defs/pass_artifact"}, {"properties": {"color_space": {"const": "data"}}}]},
        "wireframe": {"allOf": [{"$ref": "#/$defs/pass_artifact"}, {"properties": {"color_space": {"const": "data"}}}]},
        "uv-stretch": {"allOf": [{"$ref": "#/$defs/pass_artifact"}, {"properties": {"color_space": {"const": "data"}}}]}
      }
    },
    "canonical_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,128}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullable_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "pass_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "mime", "size_bytes", "width", "height", "channels", "color_space"],
      "properties": {
        "sha256": {"$ref": "#/$defs/sha256"},
        "mime": {"const": "image/png"},
        "size_bytes": {"type": "integer", "minimum": 1, "maximum": 67108864},
        "width": {"const": 512},
        "height": {"const": 512},
        "channels": {"const": "rgba8"},
        "color_space": {"enum": ["srgb", "linear", "data"]}
      }
    }
  }
}
