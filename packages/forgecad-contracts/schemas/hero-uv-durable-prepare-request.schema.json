{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/hero-uv-durable-prepare-request.schema.json",
  "title": "HeroUvDurablePrepareRequest@1",
  "description": "Closed Runtime prepare request for one candidate-bound Low artifact. Runtime reads Low GLB/readback bytes from CAS, replays the bounded HeroUvLayout Worker twice, then owns CAS/SQLite persistence; this does not advance a stage.",
  "type": "object", "additionalProperties": false,
  "required": [
    "schema_version", "project_id", "candidate_id", "candidate_state_sha256", "base_version_id",
    "source_low_artifact_id", "source_low_artifact_object_sha256", "source_low_artifact_sha256",
    "source_low_artifact_readback_object_sha256", "source_low_artifact_readback_sha256",
    "resolution", "padding_texels", "min_mip_level", "hard_edge_angle_deg", "stretch_threshold",
    "visibility_weights", "idempotency_key", "max_response_bytes", "source_only",
    "runtime_write_performed", "writer_policy", "canonicalization_policy", "input_sha256"
  ],
  "properties": {
    "schema_version": {"const": "HeroUvDurablePrepareRequest@1"},
    "project_id": {"$ref": "#/$defs/id"}, "candidate_id": {"$ref": "#/$defs/id"},
    "candidate_state_sha256": {"$ref": "#/$defs/sha256"}, "base_version_id": {"$ref": "#/$defs/nullable_id"},
    "source_low_artifact_id": {"$ref": "#/$defs/id"}, "source_low_artifact_object_sha256": {"$ref": "#/$defs/sha256"},
    "source_low_artifact_sha256": {"$ref": "#/$defs/sha256"},
    "source_low_artifact_readback_object_sha256": {"$ref": "#/$defs/sha256"},
    "source_low_artifact_readback_sha256": {"$ref": "#/$defs/sha256"},
    "resolution": {"enum": [2048, 4096]}, "padding_texels": {"type": "integer", "minimum": 1, "maximum": 128},
    "min_mip_level": {"type": "integer", "minimum": 0, "maximum": 12},
    "hard_edge_angle_deg": {"type": "number", "exclusiveMinimum": 0.1, "exclusiveMaximum": 89.9},
    "stretch_threshold": {"type": "number", "minimum": 1, "maximum": 100},
    "visibility_weights": {"type": "array", "minItems": 1, "maxItems": 4096, "uniqueItems": true, "items": {"$ref": "#/$defs/visibility_weight"}},
    "idempotency_key": {"$ref": "#/$defs/id"}, "max_response_bytes": {"const": 8388608},
    "source_only": {"const": true}, "runtime_write_performed": {"const": false},
    "writer_policy": {"const": "forgecad-runtime-only-state-writer@1"},
    "canonicalization_policy": {"const": "canonical-json-sha256-excluding-canonical-sha256@1"},
    "input_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,128}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullable_id": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9_.:-]{1,128}$"},
    "visibility_weight": {
      "type": "object", "additionalProperties": false, "required": ["part_id", "first_person", "world", "hidden"],
      "properties": {"part_id": {"$ref": "#/$defs/id"}, "first_person": {"type": "number", "minimum": 0, "maximum": 1}, "world": {"type": "number", "minimum": 0, "maximum": 1}, "hidden": {"type": "number", "minimum": 0, "maximum": 1}}
    }
  }
}
