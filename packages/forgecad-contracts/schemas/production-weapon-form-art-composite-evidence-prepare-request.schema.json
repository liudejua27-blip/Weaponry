{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/production-weapon-form-art-composite-evidence-prepare-request.schema.json",
  "title": "ProductionWeaponFormArtCompositeEvidencePrepareRequest@1",
  "description": "Closed Runtime-only request to render and persist exact six-view, nine-AOV FormArt evidence for one durable composite proposal candidate. All cameras, RenderSets, AOVs and observations are derived by Runtime from the approved fresh baseline and proposal lineage; the caller cannot provide image bytes, meshes, paths, scripts or camera transforms.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operation",
    "composite_evidence_id",
    "proposal_id",
    "session_id",
    "project_id",
    "composite_proposal_record_canonical_sha256",
    "composite_proposal_receipt_object_sha256",
    "original_fresh_baseline_id",
    "original_fresh_baseline_canonical_sha256",
    "source_form_art_evidence_id",
    "source_form_art_evidence_object_sha256",
    "source_form_art_evidence_canonical_sha256",
    "proposal_candidate_id",
    "proposal_candidate_state_sha256",
    "proposal_artifact_id",
    "proposal_artifact_sha256",
    "proposal_artifact_readback_object_sha256",
    "proposal_artifact_readback_sha256",
    "idempotency_key",
    "max_response_bytes",
    "runtime_write_performed",
    "writer_policy",
    "canonicalization_policy",
    "input_sha256"
  ],
  "properties": {
    "schema_version": {"const": "ProductionWeaponFormArtCompositeEvidencePrepareRequest@1"},
    "operation": {"const": "forgecad.production.weapon.form-art-composite-evidence-prepare@1"},
    "composite_evidence_id": {"$ref": "#/$defs/id"},
    "proposal_id": {"$ref": "#/$defs/id"},
    "session_id": {"$ref": "#/$defs/id"},
    "project_id": {"$ref": "#/$defs/id"},
    "composite_proposal_record_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "composite_proposal_receipt_object_sha256": {"$ref": "#/$defs/sha256"},
    "original_fresh_baseline_id": {"$ref": "#/$defs/id"},
    "original_fresh_baseline_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "source_form_art_evidence_id": {"$ref": "#/$defs/id"},
    "source_form_art_evidence_object_sha256": {"$ref": "#/$defs/sha256"},
    "source_form_art_evidence_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "proposal_candidate_id": {"$ref": "#/$defs/id"},
    "proposal_candidate_state_sha256": {"$ref": "#/$defs/sha256"},
    "proposal_artifact_id": {"$ref": "#/$defs/id"},
    "proposal_artifact_sha256": {"$ref": "#/$defs/sha256"},
    "proposal_artifact_readback_object_sha256": {"$ref": "#/$defs/sha256"},
    "proposal_artifact_readback_sha256": {"$ref": "#/$defs/sha256"},
    "idempotency_key": {"$ref": "#/$defs/id"},
    "max_response_bytes": {"const": 1048576},
    "runtime_write_performed": {"const": false},
    "writer_policy": {"const": "forgecad-runtime-only-state-writer@1"},
    "canonicalization_policy": {"const": "canonical-json-sha256-excluding-input-sha256@1"},
    "input_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
