{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/visual-review-report.schema.json",
  "title": "VisualReviewReport",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "review_id", "candidate_id", "reference_id", "render_set_hash", "comparison_report_hash", "round", "stage", "issues", "status", "canonical_sha256"],
  "properties": {
    "schema_version": {"const": "VisualReviewReport@1"},
    "review_id": {"$ref": "#/$defs/identifier"},
    "candidate_id": {"$ref": "#/$defs/identifier"},
    "reference_id": {"$ref": "#/$defs/identifier"},
    "render_set_hash": {"$ref": "#/$defs/sha256"},
    "comparison_report_hash": {"$ref": "#/$defs/sha256"},
    "round": {"type": "integer", "minimum": 1, "maximum": 5},
    "stage": {"enum": ["silhouette", "structure", "form", "material-surface", "final"]},
    "issues": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/issue"}},
    "status": {"enum": ["submitted", "needs_revision", "accepted"]},
    "canonical_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,128}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issue_id", "pass", "region_id", "claim", "confidence", "visibility", "action"],
      "properties": {
        "issue_id": {"$ref": "#/$defs/identifier"},
        "pass": {"enum": ["beauty", "silhouette", "depth", "normal", "ao", "part-id", "material-id", "wireframe", "uv-stretch"]},
        "region_id": {"$ref": "#/$defs/identifier"},
        "claim": {"type": "string", "minLength": 1, "maxLength": 512},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "visibility": {"enum": ["observed", "inferred", "unknown"]},
        "action": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    }
  }
}
