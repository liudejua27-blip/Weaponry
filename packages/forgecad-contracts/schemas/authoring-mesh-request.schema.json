{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/authoring-mesh-request.schema.json",
  "title": "AuthoringMeshRequest@1",
  "description": "Closed, candidate/program/artifact/readback-bound request for a Runtime-derived AuthoringMesh read-only projection. Mesh and identity fields are never caller supplied.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "candidate_id",
    "artifact_id",
    "artifact_readback_sha256",
    "program_sha256",
    "operator_catalog_sha256",
    "readback_config_sha256",
    "authoring_node_id",
    "part_id",
    "authoring_mesh_policy_sha256",
    "max_response_bytes"
  ],
  "properties": {
    "schema_version": {"const": "AuthoringMeshRequest@1"},
    "project_id": {"$ref": "#/$defs/identifier"},
    "candidate_id": {"$ref": "#/$defs/identifier"},
    "artifact_id": {"$ref": "#/$defs/sha256"},
    "artifact_readback_sha256": {"$ref": "#/$defs/sha256"},
    "program_sha256": {"$ref": "#/$defs/sha256"},
    "operator_catalog_sha256": {"$ref": "#/$defs/sha256"},
    "readback_config_sha256": {"$ref": "#/$defs/sha256"},
    "authoring_node_id": {"$ref": "#/$defs/identifier"},
    "part_id": {"$ref": "#/$defs/identifier"},
    "authoring_mesh_policy_sha256": {
      "const": "aa72cadabba90ddb43dd0014cfa434ab9b13f4e072b09258072f37334c72e709"
    },
    "max_response_bytes": {"const": 1048576}
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]{1,128}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
