{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/production-weapon-form-art-composite-proposal-prepare-request.schema.json",
  "title": "ProductionWeaponFormArtCompositeProposalPrepareRequest@1",
  "description": "Prepare one Runtime-owned cumulative FormArt candidate from an exact original visual baseline, exact current proposal base and a closed registered-operation plan. The request cannot contain raw mesh, profile points, scripts, paths, URLs or arbitrary operators.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "proposal_id",
    "session_id",
    "project_id",
    "original_fresh_baseline_id",
    "plan",
    "idempotency_key",
    "max_response_bytes",
    "runtime_write_performed",
    "writer_policy",
    "canonicalization_policy",
    "input_sha256"
  ],
  "properties": {
    "schema_version": {"const": "ProductionWeaponFormArtCompositeProposalPrepareRequest@1"},
    "proposal_id": {"$ref": "common.schema.json#/$defs/identifier"},
    "session_id": {"$ref": "common.schema.json#/$defs/identifier"},
    "project_id": {"$ref": "common.schema.json#/$defs/identifier"},
    "original_fresh_baseline_id": {"$ref": "common.schema.json#/$defs/identifier"},
    "plan": {"$ref": "production-weapon-form-art-composite-proposal-plan.schema.json"},
    "idempotency_key": {"$ref": "common.schema.json#/$defs/identifier"},
    "max_response_bytes": {"const": 1048576},
    "runtime_write_performed": {"const": false},
    "writer_policy": {"const": "forgecad-runtime-only-state-writer@1"},
    "canonicalization_policy": {"const": "canonical-json-sha256-excluding-input-sha256@1"},
    "input_sha256": {"$ref": "common.schema.json#/$defs/sha256"}
  }
}
