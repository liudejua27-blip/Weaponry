{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/mechanical-animation-clip-v2.schema.json",
  "title": "MechanicalAnimationClip@2",
  "description": "A Runtime-owned immutable appearance-aware rigid mechanical animation clip. It binds one appearance candidate to an exact geometry source, material-surface quality report, AppearanceSourceLineage and deterministic double-worker replay. It is structural-only and non-promoting.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "clip_id", "project_id", "appearance_candidate_id",
    "appearance_candidate_state_sha256", "appearance_artifact_id", "appearance_artifact_sha256",
    "appearance_artifact_readback_sha256", "appearance_artifact_readback_object_sha256",
    "source_geometry_candidate_id", "source_geometry_candidate_state_sha256",
    "source_geometry_artifact_id", "source_geometry_artifact_sha256",
    "source_geometry_candidate_evidence_sha256", "material_surface_quality_id",
    "material_surface_quality_report_object_sha256", "material_surface_quality_canonical_sha256",
    "appearance_source_lineage_sidecar_object_sha256", "appearance_source_lineage_canonical_sha256",
    "appearance_program_object_sha256", "appearance_program_sha256", "geometry_program_object_sha256",
    "geometry_program_sha256", "geometry_preservation_projection_sha256", "operator_catalog_sha256",
    "readback_config_sha256", "request_sha256", "rest_frame", "rest_frame_sha256", "pose_action",
    "pose_action_sha256", "sampling_policy", "sampling_policy_sha256", "source_replay",
    "source_replay_worker_cohort_sha256", "replay_policy", "materialization_status", "quality_status",
    "visual_quality_status", "commercial_fps_quality_status", "human_review_status",
    "commercial_engine_status", "runtime_write_performed", "production_stage_advanced",
    "candidate_confirmed", "version_created", "export_performed", "canonical_sha256", "created_at"
  ],
  "properties": {
    "schema_version": {"const": "MechanicalAnimationClip@2"},
    "clip_id": {"$ref": "#/$defs/id"},
    "project_id": {"$ref": "#/$defs/id"},
    "appearance_candidate_id": {"$ref": "#/$defs/id"},
    "appearance_candidate_state_sha256": {"$ref": "#/$defs/sha256"},
    "appearance_artifact_id": {"$ref": "#/$defs/id"},
    "appearance_artifact_sha256": {"$ref": "#/$defs/sha256"},
    "appearance_artifact_readback_sha256": {"$ref": "#/$defs/sha256"},
    "appearance_artifact_readback_object_sha256": {"$ref": "#/$defs/sha256"},
    "source_geometry_candidate_id": {"$ref": "#/$defs/id"},
    "source_geometry_candidate_state_sha256": {"$ref": "#/$defs/sha256"},
    "source_geometry_artifact_id": {"$ref": "#/$defs/id"},
    "source_geometry_artifact_sha256": {"$ref": "#/$defs/sha256"},
    "source_geometry_candidate_evidence_sha256": {"$ref": "#/$defs/sha256"},
    "material_surface_quality_id": {"$ref": "#/$defs/id"},
    "material_surface_quality_report_object_sha256": {"$ref": "#/$defs/sha256"},
    "material_surface_quality_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "appearance_source_lineage_sidecar_object_sha256": {"$ref": "#/$defs/sha256"},
    "appearance_source_lineage_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "appearance_program_object_sha256": {"$ref": "#/$defs/sha256"},
    "appearance_program_sha256": {"$ref": "#/$defs/sha256"},
    "geometry_program_object_sha256": {"$ref": "#/$defs/sha256"},
    "geometry_program_sha256": {"$ref": "#/$defs/sha256"},
    "geometry_preservation_projection_sha256": {"$ref": "#/$defs/sha256"},
    "operator_catalog_sha256": {"$ref": "#/$defs/sha256"},
    "readback_config_sha256": {"$ref": "#/$defs/sha256"},
    "request_sha256": {"$ref": "#/$defs/sha256"},
    "rest_frame": {"$ref": "https://forgecad.local/contracts/mechanical-rest-frame.schema.json"},
    "rest_frame_sha256": {"$ref": "#/$defs/sha256"},
    "pose_action": {"$ref": "https://forgecad.local/contracts/mechanical-pose-action.schema.json"},
    "pose_action_sha256": {"$ref": "#/$defs/sha256"},
    "sampling_policy": {"$ref": "#/$defs/sampling_policy"},
    "sampling_policy_sha256": {"$ref": "#/$defs/sha256"},
    "source_replay": {"$ref": "#/$defs/source_replay"},
    "source_replay_worker_cohort_sha256": {"$ref": "#/$defs/sha256"},
    "replay_policy": {"const": "geometry-plus-appearance-double-worker-replay@1"},
    "materialization_status": {"const": "runtime-owned-immutable-cas-appearance-aware-clip"},
    "quality_status": {"const": "structural_only"},
    "visual_quality_status": {"const": "NOT_PROVEN"},
    "commercial_fps_quality_status": {"const": "NOT_PROVEN"},
    "human_review_status": {"const": "NOT_RUN"},
    "commercial_engine_status": {"const": "NOT_RUN"},
    "runtime_write_performed": {"const": true},
    "production_stage_advanced": {"const": false},
    "candidate_confirmed": {"const": false},
    "version_created": {"const": false},
    "export_performed": {"const": false},
    "canonical_sha256": {"$ref": "#/$defs/sha256"},
    "created_at": {"$ref": "#/$defs/timestamp"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "minLength": 1, "maxLength": 128},
    "sampling_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "timebase_hz", "interpolation", "unkeyed", "sample_time_ticks", "max_samples", "frame_preview_batch_size"],
      "properties": {
        "schema_version": {"const": "MechanicalAnimationSamplingPolicy@1"},
        "timebase_hz": {"const": 1000},
        "interpolation": {"const": "scalar-linear-integer-ticks-clamped"},
        "unkeyed": {"const": "rest"},
        "sample_time_ticks": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"type": "integer", "minimum": 0, "maximum": 1000000}},
        "max_samples": {"const": 16},
        "frame_preview_batch_size": {"const": 1}
      }
    },
    "source_replay": {
      "type": "object", "additionalProperties": false,
      "required": ["worker_build_cohort_sha256", "first_artifact_sha256", "repeat_artifact_sha256", "byte_exact_with_appearance_artifact", "appearance_materials_replayed", "strict_readback_passed"],
      "properties": {
        "worker_build_cohort_sha256": {"$ref": "#/$defs/sha256"},
        "first_artifact_sha256": {"$ref": "#/$defs/sha256"},
        "repeat_artifact_sha256": {"$ref": "#/$defs/sha256"},
        "byte_exact_with_appearance_artifact": {"const": true},
        "appearance_materials_replayed": {"const": true},
        "strict_readback_passed": {"const": true}
      }
    }
  }
}
