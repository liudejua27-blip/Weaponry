{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/human-visual-review-receipt.schema.json",
  "title": "HumanVisualReviewReceipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "receipt_id", "candidate_id", "reference_id", "render_set_hash", "comparison_report_hash", "scores", "approved", "recorded_at", "canonical_sha256"],
  "properties": {
    "schema_version": {"const": "HumanVisualReviewReceipt@1"},
    "receipt_id": {"$ref": "#/$defs/identifier"},
    "candidate_id": {"$ref": "#/$defs/identifier"},
    "reference_id": {"$ref": "#/$defs/identifier"},
    "render_set_hash": {"$ref": "#/$defs/sha256"},
    "comparison_report_hash": {"$ref": "#/$defs/sha256"},
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": ["likeness", "geometry_detail", "material_fidelity", "editability"],
      "properties": {
        "likeness": {"type": "integer", "minimum": 1, "maximum": 5},
        "geometry_detail": {"type": "integer", "minimum": 1, "maximum": 5},
        "material_fidelity": {"type": "integer", "minimum": 1, "maximum": 5},
        "editability": {"type": "integer", "minimum": 1, "maximum": 5}
      }
    },
    "approved": {"type": "boolean"},
    "recorded_at": {"type": "string", "minLength": 1, "maxLength": 64},
    "canonical_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,128}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
