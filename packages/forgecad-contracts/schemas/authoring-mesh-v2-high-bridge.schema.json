{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/authoring-mesh-v2-high-bridge.schema.json",
  "title": "AuthoringMeshV2HighBridge@1",
  "description": "Closed Runtime-owned durable link for the complete ordered source-bound AuthoringMeshRevision@2 Part set evaluated by the dedicated direct V2 High Worker. The worker input is constructed by Runtime from durable materialized revision truth and a fixed per-Part CPU stitched policy; callers never provide raw revision topology or evaluator steps. The link records High structural/replay/readback identities only and does not create a production High asset or prove visual, human, engine or commercial quality.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "bridge_id", "project_id", "source_scope", "source_revision_schema_version",
    "mesh_id", "lineage_id", "revision_id", "revision_index", "revision_sha256", "revision_object_sha256",
    "source_binding_id", "source_binding_sha256", "source_binding_object_sha256",
    "materialized_candidate_id", "materialized_candidate_state_sha256",
    "materialized_program_sha256", "materialized_program_object_sha256",
    "materialized_artifact_id", "materialized_artifact_sha256", "materialized_artifact_object_sha256",
    "materialized_artifact_readback_sha256", "materialized_artifact_readback_object_sha256",
    "representation_plan_sha256", "source_node_id", "part_id", "material_zone_id", "solid",
    "source_part_output_sha256", "preserved_part_ids", "materialized_artifact_hash_policy",
    "high_execution_request_schema_version", "high_execution_operation", "high_operation", "high_result_schema_version", "high_readback_schema_version",
    "high_evaluator_contract", "high_subdivision_backend", "high_subdivision_levels",
    "high_max_triangles_per_face", "high_max_output_vertices", "high_max_output_triangles",
    "high_execution_request_sha256", "high_evaluation_sha256", "high_result_sha256", "high_result_object_sha256", "high_readback_sha256",
    "high_readback_object_sha256", "high_worker_algorithm_sha256", "high_worker_build_cohort_sha256",
    "high_replay_count", "high_replay_byte_exact", "high_non_destructive", "high_projected_source_mesh_sha256",
    "high_source_vertex_count", "high_source_triangle_count", "high_evaluated_part_count",
    "high_evaluated_triangle_count", "cohort_policy", "scope_limitations", "high_structural_status", "high_status",
    "quality_status", "visual_status", "human_status", "engine_status", "high_mesh_created",
    "high_stage_unlocked", "production_stage_advanced", "candidate_confirmed", "version_created",
    "export_performed", "runtime_write_performed", "persistent_user_data_touched", "writer_policy",
    "canonicalization_policy", "canonical_sha256", "created_at"
  ],
  "properties": {
    "schema_version": {"const": "AuthoringMeshV2HighBridge@1"},
    "bridge_id": {"$ref": "#/$defs/identifier"},
    "project_id": {"$ref": "#/$defs/identifier"},
    "source_scope": {"const": "materialized-v2-revision-part-set@1"},
    "source_revision_schema_version": {"const": "AuthoringMeshRevision@2"},
    "mesh_id": {"$ref": "#/$defs/identifier"},
    "lineage_id": {"$ref": "#/$defs/identifier"},
    "revision_id": {"$ref": "#/$defs/identifier"},
    "revision_index": {"$ref": "#/$defs/revision_index"},
    "revision_sha256": {"$ref": "#/$defs/sha256"},
    "revision_object_sha256": {"$ref": "#/$defs/sha256"},
    "source_binding_id": {"$ref": "#/$defs/identifier"},
    "source_binding_sha256": {"$ref": "#/$defs/sha256"},
    "source_binding_object_sha256": {"$ref": "#/$defs/sha256"},
    "materialized_candidate_id": {"$ref": "#/$defs/identifier"},
    "materialized_candidate_state_sha256": {"$ref": "#/$defs/sha256"},
    "materialized_program_sha256": {"$ref": "#/$defs/sha256"},
    "materialized_program_object_sha256": {"$ref": "#/$defs/sha256"},
    "materialized_artifact_id": {"$ref": "#/$defs/identifier"},
    "materialized_artifact_sha256": {"$ref": "#/$defs/sha256"},
    "materialized_artifact_object_sha256": {"$ref": "#/$defs/sha256"},
    "materialized_artifact_readback_sha256": {"$ref": "#/$defs/sha256"},
    "materialized_artifact_readback_object_sha256": {"$ref": "#/$defs/sha256"},
    "representation_plan_sha256": {"$ref": "#/$defs/sha256"},
    "source_node_id": {"$ref": "#/$defs/identifier"},
    "part_id": {"$ref": "#/$defs/identifier"},
    "material_zone_id": {"$ref": "#/$defs/identifier"},
    "solid": {"type": "boolean"},
    "source_part_output_sha256": {"$ref": "#/$defs/sha256"},
    "preserved_part_ids": {"type": "array", "minItems": 0, "maxItems": 128, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
    "materialized_artifact_hash_policy": {"const": "artifact-sha256-equals-object-sha256-until-semantic-artifact-contract@1"},
    "high_execution_request_schema_version": {"const": "AuthoringMeshV2HighExecutionRequest@2"},
    "high_execution_operation": {"const": "forgecad.production.authoring-mesh-v2-high-execute@1"},
    "high_operation": {"const": "forgecad.production.authoring-mesh-v2-high-evaluate@1"},
    "high_result_schema_version": {"const": "AuthoringMeshV2HighResult@2"},
    "high_readback_schema_version": {"const": "AuthoringMeshV2HighReadback@2"},
    "high_evaluator_contract": {"const": "forgecad-owned-cpu-catmull-clark-stitched-polygon@2"},
    "high_subdivision_backend": {"const": "cpu_regular_quad"},
    "high_subdivision_levels": {"const": 1},
    "high_max_triangles_per_face": {"const": 32},
    "high_max_output_vertices": {"const": 32768},
    "high_max_output_triangles": {"const": 600000},
    "high_execution_request_sha256": {"$ref": "#/$defs/sha256"},
    "high_evaluation_sha256": {"$ref": "#/$defs/sha256"},
    "high_result_sha256": {"$ref": "#/$defs/sha256"},
    "high_result_object_sha256": {"$ref": "#/$defs/sha256"},
    "high_readback_sha256": {"$ref": "#/$defs/sha256"},
    "high_readback_object_sha256": {"$ref": "#/$defs/sha256"},
    "high_worker_algorithm_sha256": {"$ref": "#/$defs/sha256"},
    "high_worker_build_cohort_sha256": {"$ref": "#/$defs/sha256"},
    "high_replay_count": {"const": 2},
    "high_replay_byte_exact": {"const": true},
    "high_non_destructive": {"const": true},
    "high_projected_source_mesh_sha256": {"$ref": "#/$defs/sha256"},
    "high_source_vertex_count": {"type": "integer", "minimum": 1, "maximum": 32768},
    "high_source_triangle_count": {"type": "integer", "minimum": 1, "maximum": 65536},
    "high_evaluated_part_count": {"type": "integer", "minimum": 1, "maximum": 128},
    "high_evaluated_triangle_count": {"type": "integer", "minimum": 1, "maximum": 600000},
    "cohort_policy": {"const": "same-worker-build-cohort-required-for-durable-link@1"},
    "scope_limitations": {
      "const": [
        "RUNTIME_DERIVES_COMPLETE_ORDERED_PART_INPUTS",
        "RUNTIME_CONSTRUCTS_CPU_STITCHED_STEPS",
        "NO_CALLER_SUPPLIED_REVISION_TOPOLOGY",
        "NO_OPEN_SUBDIVISION_BACKEND",
        "VERIFIED_PRESERVED_PARTS_FROM_MATERIALIZED_GLB"
      ]
    },
    "high_structural_status": {"const": "PASS_SOURCE_STRUCTURAL"},
    "high_status": {"const": "NOT_RUN"},
    "quality_status": {"const": "structural_only"},
    "visual_status": {"const": "NOT_RUN"},
    "human_status": {"const": "NOT_RUN"},
    "engine_status": {"const": "NOT_RUN"},
    "high_mesh_created": {"const": false},
    "high_stage_unlocked": {"const": false},
    "production_stage_advanced": {"const": false},
    "candidate_confirmed": {"const": false},
    "version_created": {"const": false},
    "export_performed": {"const": false},
    "runtime_write_performed": {"const": true},
    "persistent_user_data_touched": {"const": true},
    "writer_policy": {"const": "forgecad-runtime-only-state-writer@1"},
    "canonicalization_policy": {"const": "canonical-json-sha256-excluding-canonical-sha256@1"},
    "canonical_sha256": {"$ref": "#/$defs/sha256"},
    "created_at": {"$ref": "#/$defs/timestamp"}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "revision_index": {"type": "integer", "minimum": 0, "maximum": 1000000},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"}
  }
}
