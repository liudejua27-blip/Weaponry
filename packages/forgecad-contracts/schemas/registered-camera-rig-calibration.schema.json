{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/registered-camera-rig-calibration.schema.json",
  "title": "RegisteredCameraRigCalibration@1",
  "description": "A candidate/artifact/program-bound wrapper that retains the canonical subject-space CameraRigCalibration@1 and separately records exact transient renderer cameras materialized through a closed subject-frame registration. It is evidence lineage, not a quality, stage, confirmation or export claim.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registered_rig_id",
    "project_id",
    "candidate_id",
    "candidate_state_sha256",
    "artifact_id",
    "artifact_sha256",
    "geometry_program_object_sha256",
    "geometry_program_sha256",
    "operator_catalog_sha256",
    "subject_camera_rig",
    "subject_camera_rig_object_sha256",
    "subject_camera_rig_canonical_sha256",
    "subject_frame_registration",
    "subject_frame_registration_canonical_sha256",
    "renderer_views",
    "read_only",
    "runtime_write",
    "depth_status",
    "quality_status",
    "production_stage_advanced",
    "candidate_confirmed",
    "version_created",
    "export_performed",
    "canonical_sha256"
  ],
  "properties": {
    "schema_version": {"const": "RegisteredCameraRigCalibration@1"},
    "registered_rig_id": {"$ref": "#/$defs/id"},
    "project_id": {"$ref": "#/$defs/id"},
    "candidate_id": {"$ref": "#/$defs/id"},
    "candidate_state_sha256": {"$ref": "#/$defs/sha256"},
    "artifact_id": {"$ref": "#/$defs/id"},
    "artifact_sha256": {"$ref": "#/$defs/sha256"},
    "geometry_program_object_sha256": {"$ref": "#/$defs/sha256"},
    "geometry_program_sha256": {"$ref": "#/$defs/sha256"},
    "operator_catalog_sha256": {"$ref": "#/$defs/sha256"},
    "subject_camera_rig": {"$ref": "https://forgecad.local/contracts/camera-rig-calibration.schema.json"},
    "subject_camera_rig_object_sha256": {"$ref": "#/$defs/sha256"},
    "subject_camera_rig_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "subject_frame_registration": {"$ref": "https://forgecad.local/contracts/production-weapon-subject-frame-registration.schema.json"},
    "subject_frame_registration_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "renderer_views": {
      "type": "array",
      "minItems": 6,
      "maxItems": 8,
      "items": {"$ref": "#/$defs/registered_view"}
    },
    "read_only": {"const": true},
    "runtime_write": {"const": false},
    "depth_status": {"const": "UNKNOWN"},
    "quality_status": {"const": "NOT_EVALUATED"},
    "production_stage_advanced": {"const": false},
    "candidate_confirmed": {"const": false},
    "version_created": {"const": false},
    "export_performed": {"const": false},
    "canonical_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,128}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "registered_view": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "view_id",
        "kind",
        "subject_camera_hash",
        "registered_camera",
        "registered_camera_hash",
        "registration_canonical_sha256",
        "weight",
        "primary"
      ],
      "properties": {
        "view_id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["left", "right", "top", "bottom", "front", "back", "front-three-quarter", "rear-three-quarter"]},
        "subject_camera_hash": {"$ref": "#/$defs/sha256"},
        "registered_camera": {"$ref": "https://forgecad.local/contracts/camera-calibration-v2.schema.json"},
        "registered_camera_hash": {"$ref": "#/$defs/sha256"},
        "registration_canonical_sha256": {"$ref": "#/$defs/sha256"},
        "weight": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "primary": {"type": "boolean"}
      }
    }
  }
}
