{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/production-weapon-form-art-repair-plan-get-result.schema.json",
  "title": "ProductionWeaponFormArtRepairPlanGetResult@1",
  "description": "Runtime-derived, evidence-bound, non-promoting repair plan for the current composite FPS weapon FormArt candidate. It describes one registered source-local repair and its mandatory re-evaluation gates; it is not a mesh mutation, approval or quality pass.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operation",
    "repair_plan_id",
    "composite_evidence_id",
    "proposal_id",
    "session_id",
    "project_id",
    "proposal_candidate_id",
    "proposal_candidate_state_sha256",
    "proposal_artifact_sha256",
    "composed_geometry_program_sha256",
    "composite_evidence_record_canonical_sha256",
    "composite_evidence_receipt_object_sha256",
    "cross_view_evidence_bundle_sha256",
    "cross_view_canonical_sha256",
    "proposal_form_art_evidence_receipt_object_sha256",
    "proposal_form_art_evidence_canonical_sha256",
    "target_part_id",
    "source_node_id",
    "strategy_id",
    "current_profile",
    "target_profile",
    "evidence_issues",
    "mandatory_revalidation_gates",
    "preserved_invariants",
    "plan_status",
    "quality_status",
    "repair_execution_status",
    "repair_execution_allowed_by_this_tool",
    "candidate_confirm_allowed",
    "secondary_form_approved",
    "production_stage_advanced",
    "candidate_confirmed",
    "version_created",
    "export_performed",
    "runtime_write_performed",
    "persistent_user_data_touched",
    "derivation_policy",
    "canonical_sha256"
  ],
  "properties": {
    "schema_version": {"const": "ProductionWeaponFormArtRepairPlanGetResult@1"},
    "operation": {"const": "forgecad.production.weapon.form-art-repair-plan-get@1"},
    "repair_plan_id": {"$ref": "#/$defs/id"},
    "composite_evidence_id": {"$ref": "#/$defs/id"},
    "proposal_id": {"$ref": "#/$defs/id"},
    "session_id": {"$ref": "#/$defs/id"},
    "project_id": {"$ref": "#/$defs/id"},
    "proposal_candidate_id": {"$ref": "#/$defs/id"},
    "proposal_candidate_state_sha256": {"$ref": "#/$defs/sha256"},
    "proposal_artifact_sha256": {"$ref": "#/$defs/sha256"},
    "composed_geometry_program_sha256": {"$ref": "#/$defs/sha256"},
    "composite_evidence_record_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "composite_evidence_receipt_object_sha256": {"$ref": "#/$defs/sha256"},
    "cross_view_evidence_bundle_sha256": {"$ref": "#/$defs/sha256"},
    "cross_view_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "proposal_form_art_evidence_receipt_object_sha256": {"$ref": "#/$defs/sha256"},
    "proposal_form_art_evidence_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "target_part_id": {"const": "rear-stock"},
    "source_node_id": {"const": "rear-stock"},
    "strategy_id": {"const": "rear-stock-owner-void-half-y-flat-z@1"},
    "current_profile": {"$ref": "#/$defs/profile"},
    "target_profile": {"$ref": "#/$defs/profile"},
    "evidence_issues": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/issue"}},
    "mandatory_revalidation_gates": {"type": "array", "minItems": 7, "maxItems": 7, "items": {"type": "string", "minLength": 1, "maxLength": 128}, "uniqueItems": true},
    "preserved_invariants": {"type": "array", "minItems": 8, "maxItems": 8, "items": {"type": "string", "minLength": 1, "maxLength": 128}, "uniqueItems": true},
    "plan_status": {"const": "READY_EVIDENCE_BOUND_TYPED_REPAIR_PLAN"},
    "quality_status": {"const": "QUALITY_TARGET_NOT_MET"},
    "repair_execution_status": {"const": "NOT_RUN"},
    "repair_execution_allowed_by_this_tool": {"const": false},
    "candidate_confirm_allowed": {"const": false},
    "secondary_form_approved": {"const": "NOT_CREATED"},
    "production_stage_advanced": {"const": false},
    "candidate_confirmed": {"const": false},
    "version_created": {"const": false},
    "export_performed": {"const": false},
    "runtime_write_performed": {"const": false},
    "persistent_user_data_touched": {"const": false},
    "derivation_policy": {"const": "durable-cross-view-form-art-owner-void-repair-plan@1"},
    "canonical_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "station": {
      "type": "object",
      "additionalProperties": false,
      "required": ["station_ratio_milli", "current_y_offset_m", "target_y_offset_m", "delta_y_m", "current_z_wedge_m", "target_z_wedge_m"],
      "properties": {
        "station_ratio_milli": {"type": "integer", "minimum": 0, "maximum": 1000},
        "current_y_offset_m": {"type": "number", "minimum": -0.02, "maximum": 0.0},
        "target_y_offset_m": {"type": "number", "minimum": -0.02, "maximum": 0.0},
        "delta_y_m": {"type": "number", "minimum": -0.01, "maximum": 0.0},
        "current_z_wedge_m": {"const": 0.0},
        "target_z_wedge_m": {"const": 0.0}
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "selection_policy", "coordinate_space", "station_roles", "station_parameters", "topology_application"],
      "properties": {
        "profile_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "selection_policy": {"const": "runtime-derived-boundary-bridge-station-roles@1"},
        "coordinate_space": {"const": "source-local"},
        "station_roles": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"enum": ["endpoint-near", "quarter-near", "center", "quarter-far", "endpoint-far"]}},
        "station_parameters": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"$ref": "#/$defs/station"}},
        "topology_application": {"enum": ["existing-profile-readback", "registered-next-repair-only"]}
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issue_id", "view_kind", "metric", "observed", "required", "evidence_sha256", "status"],
      "properties": {
        "issue_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "view_kind": {"enum": ["left", "right", "rear-three-quarter"]},
        "metric": {"type": "string", "minLength": 1, "maxLength": 128},
        "observed": {"type": "number"},
        "required": {"type": "number"},
        "evidence_sha256": {"$ref": "#/$defs/sha256"},
        "status": {"const": "FAIL"}
      }
    }
  }
}
