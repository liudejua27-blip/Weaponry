{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/game-asset-lod-derive-result.schema.json",
  "title": "GameAssetLodDeriveResult@1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "source_candidate_id",
    "source_candidate_state_sha256",
    "source_artifact_sha256",
    "source_artifact_readback_sha256",
    "source_geometry_program_sha256",
    "derive_policy",
    "levels",
    "stable_part_ids",
    "stable_material_zone_ids",
    "worker_replay_verified",
    "runtime_write_performed",
    "persistent_user_data_touched",
    "materialization_required",
    "quality_status",
    "canonical_sha256"
  ],
  "properties": {
    "schema_version": {"const": "GameAssetLodDeriveResult@1"},
    "project_id": {"$ref": "#/$defs/id"},
    "source_candidate_id": {"$ref": "#/$defs/id"},
    "source_candidate_state_sha256": {"$ref": "#/$defs/sha256"},
    "source_artifact_sha256": {"$ref": "#/$defs/sha256"},
    "source_artifact_readback_sha256": {"$ref": "#/$defs/sha256"},
    "source_geometry_program_sha256": {"$ref": "#/$defs/sha256"},
    "derive_policy": {"const": "runtime-owned-typed-segment-lowering-lod1-half-lod2-quarter@1"},
    "levels": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/level"}
    },
    "stable_part_ids": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "stable_material_zone_ids": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "worker_replay_verified": {"const": true},
    "runtime_write_performed": {"const": false},
    "persistent_user_data_touched": {"const": false},
    "materialization_required": {"const": true},
    "quality_status": {"const": "structural_only"},
    "canonical_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_id", "operator_id", "parameter", "source_value", "derived_value"],
      "properties": {
        "node_id": {"$ref": "#/$defs/id"},
        "operator_id": {"$ref": "#/$defs/id"},
        "parameter": {"enum": ["radial_segments", "longitude_segments", "latitude_segments", "u_segments", "v_segments", "segments", "bevel_segments", "transition_segments", "subdivision_levels"]},
        "source_value": {"type": "integer", "minimum": 0, "maximum": 64},
        "derived_value": {"type": "integer", "minimum": 0, "maximum": 64}
      }
    },
    "level": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "source_kind", "geometry_program", "geometry_program_sha256", "transient_artifact_sha256", "triangle_count", "triangle_ratio_to_lod0", "parameter_changes", "part_bindings", "part_bounds", "transient_readback", "worker_build_cohort_sha256", "worker_replay_count", "replay_byte_exact"],
      "properties": {
        "level": {"type": "integer", "minimum": 0, "maximum": 2},
        "source_kind": {"enum": ["durable-source-artifact", "runtime-derived-transient-program"]},
        "geometry_program": {"$ref": "geometry-program-v2.schema.json"},
        "geometry_program_sha256": {"$ref": "#/$defs/sha256"},
        "transient_artifact_sha256": {"$ref": "#/$defs/sha256"},
        "triangle_count": {"type": "integer", "minimum": 1, "maximum": 250000},
        "triangle_ratio_to_lod0": {"type": "number", "exclusiveMinimum": 0.0, "maximum": 1.0},
        "parameter_changes": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/change"}},
        "part_bindings": {"type": "array", "minItems": 1, "maxItems": 4096, "items": {"$ref": "#/$defs/binding"}},
        "part_bounds": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/bound"}},
        "transient_readback": {"$ref": "#/$defs/readback"},
        "worker_build_cohort_sha256": {"$ref": "#/$defs/sha256"},
        "worker_replay_count": {"const": 2},
        "replay_byte_exact": {"const": true}
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["part_id", "source_node_id", "material_zone_id", "solid", "triangle_count"],
      "properties": {
        "part_id": {"$ref": "#/$defs/id"},
        "source_node_id": {"$ref": "#/$defs/id"},
        "material_zone_id": {"$ref": "#/$defs/id"},
        "solid": {"type": "boolean"},
        "triangle_count": {"type": "integer", "minimum": 1, "maximum": 250000}
      }
    },
    "vector3": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number", "minimum": -10.0, "maximum": 10.0}},
    "bound": {
      "type": "object",
      "additionalProperties": false,
      "required": ["part_id", "min_m", "max_m"],
      "properties": {
        "part_id": {"$ref": "#/$defs/id"},
        "min_m": {"$ref": "#/$defs/vector3"},
        "max_m": {"$ref": "#/$defs/vector3"}
      }
    },
    "readback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "storage", "program_sha256", "operator_catalog_sha256", "readback_config_sha256", "uv_status", "tangent_status", "external_uri_count", "hard_gate_passed", "canonical_sha256"],
      "properties": {
        "schema_version": {"const": "GameLodTransientReadback@1"},
        "storage": {"const": "memory-only-no-CAS"},
        "program_sha256": {"$ref": "#/$defs/sha256"},
        "operator_catalog_sha256": {"$ref": "#/$defs/sha256"},
        "readback_config_sha256": {"$ref": "#/$defs/sha256"},
        "uv_status": {"const": "passed"},
        "tangent_status": {"const": "passed"},
        "external_uri_count": {"const": 0},
        "hard_gate_passed": {"const": true},
        "canonical_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
