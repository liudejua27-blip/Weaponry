{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/geometry-modifier-apply-request.schema.json",
  "title": "GeometryModifierApplyRequest",
  "description": "A closed candidate-bound request for applying one bounded unary modifier stack to one durable Part. GeometryProgram and GLB bytes are intentionally absent; Runtime reconstructs both from the source candidate evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "source_candidate_id",
    "source_candidate_canonical_sha256",
    "source_artifact_sha256",
    "source_artifact_readback_sha256",
    "source_geometry_program_sha256",
    "source_operator_catalog_sha256",
    "source_readback_config_sha256",
    "source_part_id",
    "base_version_id",
    "modifiers",
    "idempotency_key",
    "max_response_bytes",
    "input_sha256"
  ],
  "properties": {
    "schema_version": {"const": "GeometryModifierApplyRequest@1"},
    "project_id": {"$ref": "#/$defs/identifier"},
    "source_candidate_id": {"$ref": "#/$defs/identifier"},
    "source_candidate_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "source_artifact_sha256": {"$ref": "#/$defs/sha256"},
    "source_artifact_readback_sha256": {"$ref": "#/$defs/sha256"},
    "source_geometry_program_sha256": {"$ref": "#/$defs/sha256"},
    "source_operator_catalog_sha256": {"$ref": "#/$defs/sha256"},
    "source_readback_config_sha256": {"$ref": "#/$defs/sha256"},
    "source_part_id": {"$ref": "#/$defs/identifier"},
    "base_version_id": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/identifier"}
      ]
    },
    "modifiers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "oneOf": [
          {"$ref": "https://forgecad.local/contracts/geometry-modifier-stack-request.schema.json#/$defs/transform_modifier"},
          {"$ref": "https://forgecad.local/contracts/geometry-modifier-stack-request.schema.json#/$defs/mirror_modifier"},
          {"$ref": "https://forgecad.local/contracts/geometry-modifier-stack-request.schema.json#/$defs/array_modifier"},
          {"$ref": "https://forgecad.local/contracts/geometry-modifier-stack-request.schema.json#/$defs/bevel_modifier"},
          {"$ref": "https://forgecad.local/contracts/geometry-modifier-stack-request.schema.json#/$defs/normal_policy_modifier"}
        ]
      }
    },
    "idempotency_key": {"$ref": "#/$defs/identifier"},
    "max_response_bytes": {"const": 1048576},
    "input_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,128}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
