{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/collision-proxy-set.schema.json",
  "title": "CollisionProxySet@1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "source_lod_level", "source_candidate_id", "source_candidate_state_sha256", "source_artifact_sha256", "source_artifact_readback_sha256", "lod_receipt_object_sha256", "part_ids", "policy", "proxies", "coverage", "gameplay_only", "physical_properties_included", "validator_status", "hard_gate_passed", "quality_status", "canonical_sha256"],
  "properties": {
    "schema_version": {"const": "CollisionProxySet@1"},
    "project_id": {"$ref": "#/$defs/id"},
    "source_lod_level": {"const": 2},
    "source_candidate_id": {"$ref": "#/$defs/id"},
    "source_candidate_state_sha256": {"$ref": "#/$defs/sha256"},
    "source_artifact_sha256": {"$ref": "#/$defs/sha256"},
    "source_artifact_readback_sha256": {"$ref": "#/$defs/sha256"},
    "lod_receipt_object_sha256": {"$ref": "#/$defs/sha256"},
    "part_ids": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "policy": {"const": "per-part-aabb-box-from-lod2-visual-geometry@1"},
    "proxies": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/proxy"}},
    "coverage": {"const": 1},
    "gameplay_only": {"const": true},
    "physical_properties_included": {"const": false},
    "validator_status": {"const": "exact-part-aabb-coverage-pass"},
    "hard_gate_passed": {"const": true},
    "quality_status": {"const": "structural_only"},
    "canonical_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "number": {"type": "number", "minimum": -10, "maximum": 10},
    "positive": {"type": "number", "exclusiveMinimum": 0, "maximum": 10},
    "vec3": {"type": "array", "minItems": 3, "maxItems": 3, "prefixItems": [{"$ref": "#/$defs/number"}, {"$ref": "#/$defs/number"}, {"$ref": "#/$defs/number"}], "items": false},
    "positive_vec3": {"type": "array", "minItems": 3, "maxItems": 3, "prefixItems": [{"$ref": "#/$defs/positive"}, {"$ref": "#/$defs/positive"}, {"$ref": "#/$defs/positive"}], "items": false},
    "proxy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proxy_id", "part_id", "shape", "center_m", "half_extents_m", "rotation_quat_xyzw", "source_bounds_sha256"],
      "properties": {
        "proxy_id": {"$ref": "#/$defs/id"},
        "part_id": {"$ref": "#/$defs/id"},
        "shape": {"const": "box"},
        "center_m": {"$ref": "#/$defs/vec3"},
        "half_extents_m": {"$ref": "#/$defs/positive_vec3"},
        "rotation_quat_xyzw": {"const": [0, 0, 0, 1]},
        "source_bounds_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
