{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/camera-fit-result.schema.json",
  "title": "CameraFitResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "candidate_id", "target_sha256", "selected_camera", "candidates", "status", "canonical_sha256"],
  "properties": {
    "schema_version": {"const": "CameraFitResult@1"},
    "candidate_id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,128}$"},
    "target_sha256": {"$ref": "#/$defs/sha256"},
    "selected_camera": {"$ref": "https://forgecad.local/contracts/camera-calibration.schema.json"},
    "candidates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["camera", "loss", "metrics"],
        "properties": {
          "camera": {"$ref": "https://forgecad.local/contracts/camera-calibration.schema.json"},
          "loss": {"type": "number", "minimum": 0},
          "metrics": {"type": "object", "additionalProperties": false, "required": ["silhouette_iou", "boundary_f1_4px", "bbox_edge_error", "centroid_error"], "properties": {"silhouette_iou": {"type": "number", "minimum": 0, "maximum": 1}, "boundary_f1_4px": {"type": "number", "minimum": 0, "maximum": 1}, "bbox_edge_error": {"type": "number", "minimum": 0, "maximum": 1}, "centroid_error": {"type": "number", "minimum": 0, "maximum": 1}}}
        }
      }
    },
    "status": {"enum": ["ready", "no_improvement", "unavailable"]},
    "canonical_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
