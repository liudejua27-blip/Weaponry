{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/knife-pass-state-prepare-request.schema.json",
  "title": "KnifePassStatePrepareRequest@1",
  "description": "Closed prepare envelope for one hash-bound KnifePassState. The request may propose a pass state; only Runtime may persist it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "operation", "project_id", "pass_state",
    "idempotency_key", "max_response_bytes", "runtime_write_performed", "writer_policy",
    "canonicalization_policy", "input_sha256"
  ],
  "properties": {
    "schema_version": {"const": "KnifePassStatePrepareRequest@1"},
    "operation": {"const": "knife_pass_state_prepare"},
    "project_id": {"$ref": "#/$defs/identifier"},
    "pass_state": {"$ref": "https://forgecad.local/contracts/knife-pass-state.schema.json"},
    "idempotency_key": {"$ref": "#/$defs/idempotency_key"},
    "max_response_bytes": {"const": 1048576},
    "runtime_write_performed": {"const": false},
    "writer_policy": {"const": "forgecad-runtime-only-state-writer@1"},
    "canonicalization_policy": {"const": "canonical-json-sha256-excluding-input-sha256@1"},
    "input_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "idempotency_key": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},
    "safe_text": {"type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^[^\\u0000-\\u001f\\u007f]*$"}
  }
}
