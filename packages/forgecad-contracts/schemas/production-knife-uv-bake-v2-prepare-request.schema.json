{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/production-knife-uv-bake-v2-prepare-request.schema.json",
  "title": "WeaponryKnifeUvBakeV2PrepareRequest@1",
  "description": "Closed Runtime-owned per-Part UV, Cage and geometric Bake aggregate. It requires at least two Low component links and preserves direct Worker High semantic hashes separately from durable High GLB/readback hashes. Structural output is not visual, human, engine or commercial acceptance.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "operation", "project_id", "candidate_id", "candidate_state_sha256",
    "base_version_id", "source_high_artifact_id", "source_high_result_sha256",
    "source_high_result_object_sha256", "source_high_readback_sha256",
    "source_high_readback_object_sha256", "source_high_artifact_sha256",
    "source_high_artifact_object_sha256", "source_high_artifact_readback_sha256",
    "source_high_artifact_readback_object_sha256", "components", "idempotency_key",
    "source_only", "runtime_write_performed", "writer_policy", "canonicalization_policy",
    "input_sha256"
  ],
  "properties": {
    "schema_version": {"const": "WeaponryKnifeUvBakeV2PrepareRequest@1"},
    "operation": {"const": "production_knife_uv_bake_v2_prepare"},
    "project_id": {"$ref": "#/$defs/id"},
    "candidate_id": {"$ref": "#/$defs/id"},
    "candidate_state_sha256": {"$ref": "#/$defs/sha256"},
    "base_version_id": {"$ref": "#/$defs/nullable_id"},
    "source_high_artifact_id": {"$ref": "#/$defs/id"},
    "source_high_result_sha256": {"$ref": "#/$defs/sha256"},
    "source_high_result_object_sha256": {"$ref": "#/$defs/sha256"},
    "source_high_readback_sha256": {"$ref": "#/$defs/sha256"},
    "source_high_readback_object_sha256": {"$ref": "#/$defs/sha256"},
    "source_high_artifact_sha256": {"$ref": "#/$defs/sha256"},
    "source_high_artifact_object_sha256": {"$ref": "#/$defs/sha256"},
    "source_high_artifact_readback_sha256": {"$ref": "#/$defs/sha256"},
    "source_high_artifact_readback_object_sha256": {"$ref": "#/$defs/sha256"},
    "components": {
      "type": "array", "minItems": 2, "maxItems": 32, "uniqueItems": true,
      "items": {"$ref": "#/$defs/component"}
    },
    "idempotency_key": {"$ref": "#/$defs/id"},
    "source_only": {"const": true},
    "runtime_write_performed": {"const": false},
    "writer_policy": {"const": "forgecad-runtime-only-state-writer@1"},
    "canonicalization_policy": {"const": "canonical-json-sha256-excluding-canonical-sha256@1"},
    "input_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {
      "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "sha256": {
      "type": "string", "pattern": "^[0-9a-f]{64}$"
    },
    "nullable_id": {
      "type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "component": {
      "type": "object", "additionalProperties": false,
      "required": [
        "part_id", "material_zone_id", "source_high_part_id", "source_high_node_id",
        "source_high_material_zone_id", "low_link_id", "low_artifact_object_sha256",
        "low_artifact_sha256", "low_readback_object_sha256", "low_readback_sha256",
        "visibility_weights", "hero_uv_idempotency_key"
      ],
      "properties": {
        "part_id": {"$ref": "#/$defs/id"},
        "material_zone_id": {"$ref": "#/$defs/id"},
        "source_high_part_id": {"$ref": "#/$defs/id"},
        "source_high_node_id": {"$ref": "#/$defs/id"},
        "source_high_material_zone_id": {"$ref": "#/$defs/id"},
        "low_link_id": {"$ref": "#/$defs/id"},
        "low_artifact_object_sha256": {"$ref": "#/$defs/sha256"},
        "low_artifact_sha256": {"$ref": "#/$defs/sha256"},
        "low_readback_object_sha256": {"$ref": "#/$defs/sha256"},
        "low_readback_sha256": {"$ref": "#/$defs/sha256"},
        "visibility_weights": {"type": "array", "minItems": 1, "maxItems": 4096, "items": {"type": "object", "additionalProperties": true}},
        "hero_uv_idempotency_key": {"$ref": "#/$defs/id"}
      }
    }
  }
}
