{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/production-camera-lock-prepare-request.schema.json",
  "title": "ProductionCameraLockPrepareRequest@1",
  "description": "Closed approval request for an independent ProductionCameraLock@1 prerequisite. The caller supplies the candidate/source/reference binding, the exact reviewed/camera profiles, a complete CameraRigCalibration@1, the approval receipt/session/expiry binding, a transient approval summary and an idempotency key. Runtime validates approval session and expiry, derives object/canonical/receipt-object/created fields, and never advances the ProductionStage head. The six reviewed reference view kinds are not the HQ360 definition; the seven camera view kinds are not six orthographic references, and bottom is only a camera-rig calibration helper.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "camera_lock_id",
    "session_id",
    "project_id",
    "source_transition_id",
    "source_transition_sha256",
    "source_head_canonical_sha256",
    "candidate_id",
    "candidate_state_sha256",
    "artifact_id",
    "artifact_sha256",
    "reference_id",
    "reference_sha256",
    "required_reference_view_kinds",
    "required_camera_view_kinds",
    "primary_view_kind",
    "calibration_policy",
    "input_sha256",
    "approved",
    "camera_rig",
    "approval_receipt_id",
    "approval_session_id",
    "approval_expires_at",
    "approval_summary",
    "idempotency_key"
  ],
  "properties": {
    "schema_version": {"const": "ProductionCameraLockPrepareRequest@1"},
    "camera_lock_id": {"$ref": "#/$defs/id"},
    "session_id": {"$ref": "#/$defs/id"},
    "project_id": {"$ref": "#/$defs/id"},
    "source_transition_id": {"$ref": "#/$defs/id"},
    "source_transition_sha256": {"$ref": "#/$defs/sha256"},
    "source_head_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "candidate_id": {"$ref": "#/$defs/id"},
    "candidate_state_sha256": {"$ref": "#/$defs/sha256"},
    "artifact_id": {"$ref": "#/$defs/id"},
    "artifact_sha256": {"$ref": "#/$defs/sha256"},
    "reference_id": {"$ref": "#/$defs/id"},
    "reference_sha256": {"$ref": "#/$defs/sha256"},
    "required_reference_view_kinds": {"const": ["front", "back", "left", "right", "top", "rear-three-quarter"]},
    "required_camera_view_kinds": {"const": ["front", "back", "left", "right", "top", "bottom", "rear-three-quarter"]},
    "primary_view_kind": {"const": "left"},
    "calibration_policy": {"const": "fps-weapon-reviewed-six-reference-seven-camera-lock@1"},
    "input_sha256": {"$ref": "#/$defs/sha256"},
    "approved": {"const": true},
    "camera_rig": {"$ref": "https://forgecad.local/contracts/camera-rig-calibration.schema.json"},
    "approval_receipt_id": {"$ref": "#/$defs/id"},
    "approval_session_id": {"$ref": "#/$defs/id"},
    "approval_expires_at": {"$ref": "#/$defs/epoch"},
    "approval_summary": {"type": "string", "minLength": 1, "maxLength": 512},
    "idempotency_key": {"$ref": "#/$defs/id"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "epoch": {"type": "string", "pattern": "^[0-9]{1,10}$"}
  }
}
