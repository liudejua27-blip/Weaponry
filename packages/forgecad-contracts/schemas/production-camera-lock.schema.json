{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/production-camera-lock.schema.json",
  "title": "ProductionCameraLock@1",
  "description": "An independent, candidate-bound prerequisite consumed by the ProductionStage@3 reference-coverage-reviewed to camera-calibrated edge. The six reviewed reference view kinds are a review-extended profile, not the HQ360 definition; the seven camera view kinds are not six orthographic references, and bottom is only a camera-rig calibration helper. Persisting this record never advances the ProductionStage head, confirms a candidate, creates a version or exports.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "camera_lock_id",
    "session_id",
    "project_id",
    "source_transition_id",
    "source_transition_sha256",
    "source_head_canonical_sha256",
    "candidate_id",
    "candidate_state_sha256",
    "artifact_id",
    "artifact_sha256",
    "reference_id",
    "reference_sha256",
    "reference_canvas_object_sha256",
    "reference_canvas_canonical_sha256",
    "design_spec_object_sha256",
    "design_spec_canonical_sha256",
    "camera_rig_object_sha256",
    "camera_rig_canonical_sha256",
    "required_reference_view_kinds",
    "required_camera_view_kinds",
    "primary_view_kind",
    "calibration_policy",
    "review_status",
    "calibration_status",
    "structural_status",
    "visual_status",
    "human_status",
    "engine_status",
    "distribution_status",
    "approval_receipt_id",
    "approval_session_id",
    "approval_expires_at",
    "approval_summary_sha256",
    "input_sha256",
    "request_key_sha256",
    "receipt_object_sha256",
    "canonical_sha256",
    "created_at"
  ],
  "properties": {
    "schema_version": {"const": "ProductionCameraLock@1"},
    "camera_lock_id": {"$ref": "#/$defs/id"},
    "session_id": {"$ref": "#/$defs/id"},
    "project_id": {"$ref": "#/$defs/id"},
    "source_transition_id": {"$ref": "#/$defs/id"},
    "source_transition_sha256": {"$ref": "#/$defs/sha256"},
    "source_head_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "candidate_id": {"$ref": "#/$defs/id"},
    "candidate_state_sha256": {"$ref": "#/$defs/sha256"},
    "artifact_id": {"$ref": "#/$defs/id"},
    "artifact_sha256": {"$ref": "#/$defs/sha256"},
    "reference_id": {"$ref": "#/$defs/id"},
    "reference_sha256": {"$ref": "#/$defs/sha256"},
    "reference_canvas_object_sha256": {"$ref": "#/$defs/sha256"},
    "reference_canvas_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "design_spec_object_sha256": {"$ref": "#/$defs/sha256"},
    "design_spec_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "camera_rig_object_sha256": {"$ref": "#/$defs/sha256"},
    "camera_rig_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "required_reference_view_kinds": {"const": ["front", "back", "left", "right", "top", "rear-three-quarter"]},
    "required_camera_view_kinds": {"const": ["front", "back", "left", "right", "top", "bottom", "rear-three-quarter"]},
    "primary_view_kind": {"const": "left"},
    "calibration_policy": {"const": "fps-weapon-reviewed-six-reference-seven-camera-lock@1"},
    "review_status": {"const": "user-approved-reference-coverage"},
    "calibration_status": {"const": "passed"},
    "structural_status": {"const": "PASS_SOURCE_STRUCTURAL"},
    "visual_status": {"const": "QUALITY_TARGET_NOT_MET"},
    "human_status": {"const": "NOT_RUN"},
    "engine_status": {"const": "NOT_RUN"},
    "distribution_status": {"const": "NOT_RUN"},
    "approval_receipt_id": {"$ref": "#/$defs/id"},
    "approval_session_id": {"$ref": "#/$defs/id"},
    "approval_expires_at": {"$ref": "#/$defs/epoch"},
    "approval_summary_sha256": {"$ref": "#/$defs/sha256"},
    "input_sha256": {"$ref": "#/$defs/sha256"},
    "request_key_sha256": {"$ref": "#/$defs/sha256"},
    "receipt_object_sha256": {"$ref": "#/$defs/sha256"},
    "canonical_sha256": {"$ref": "#/$defs/sha256"},
    "created_at": {"$ref": "#/$defs/timestamp"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "epoch": {"type": "string", "pattern": "^[0-9]{1,10}$"},
    "timestamp": {"type": "string", "minLength": 1, "maxLength": 64}
  }
}
