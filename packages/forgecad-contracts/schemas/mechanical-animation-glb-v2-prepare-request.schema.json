{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/mechanical-animation-glb-v2-prepare-request.schema.json",
  "title": "MechanicalAnimationGlbPrepareRequest@2",
  "description": "Closed explicit-write request for appearance-aware animated GLB materialization. Upstream appearance, geometry and material lineage is resolved from the immutable Clip@2 binding rather than caller-supplied raw media.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "project_id", "appearance_candidate_id", "appearance_candidate_state_sha256",
    "clip_id", "clip_object_sha256", "clip_sha256", "materialization_policy", "input_sha256", "idempotency_key"
  ],
  "properties": {
    "schema_version": {"const": "MechanicalAnimationGlbPrepareRequest@2"},
    "project_id": {"$ref": "#/$defs/id"},
    "appearance_candidate_id": {"$ref": "#/$defs/id"},
    "appearance_candidate_state_sha256": {"$ref": "#/$defs/sha256"},
    "clip_id": {"$ref": "#/$defs/id"},
    "clip_object_sha256": {"$ref": "#/$defs/sha256"},
    "clip_sha256": {"$ref": "#/$defs/sha256"},
    "materialization_policy": {"const": "appearance-aware-rigid-node-trs-gltf-linear-scheduled-samples@2"},
    "input_sha256": {"$ref": "#/$defs/sha256"},
    "idempotency_key": {"$ref": "#/$defs/id"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
