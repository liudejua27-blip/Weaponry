{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/authoring-mesh-edit-prepare.schema.json",
  "title": "AuthoringMeshEditPrepareResult",
  "description": "A closed structural result for a Runtime-owned staged authoring mesh candidate. It is not a confirmed version, an export authorization, or Blender/BMesh parity.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "source_candidate_id",
    "source_candidate_canonical_sha256",
    "base_version_id",
    "new_candidate_id",
    "candidate",
    "job",
    "input_sha256",
    "preview_input_sha256",
    "expected_preview_canonical_sha256",
    "preview_canonical_sha256",
    "operation",
    "edit_policy_sha256",
    "edited_element_ids",
    "edit_lineage_sha256",
    "source_topology_sha256",
    "derived_topology_sha256",
    "source_program_sha256",
    "derived_program_sha256",
    "source_artifact_sha256",
    "derived_artifact_sha256",
    "source_artifact_readback_sha256",
    "derived_artifact_readback_sha256",
    "source_geometry_candidate_evidence_sha256",
    "derived_geometry_candidate_evidence_sha256",
    "source_worker_build_cohort_sha256",
    "derived_worker_build_cohort_sha256",
    "geometry_materialization",
    "materialization_status",
    "runtime_write_performed",
    "persistent_user_data_touched",
    "version_status",
    "confirm_status",
    "export_status",
    "max_response_bytes",
    "validator_status",
    "quality_status",
    "limitations",
    "canonical_sha256"
  ],
  "properties": {
    "schema_version": {"const": "AuthoringMeshEditPrepare@1"},
    "project_id": {"$ref": "#/$defs/identifier"},
    "source_candidate_id": {"$ref": "#/$defs/identifier"},
    "source_candidate_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "base_version_id": {"$ref": "#/$defs/nullable_identifier"},
    "new_candidate_id": {"$ref": "#/$defs/identifier"},
    "candidate": {"$ref": "https://forgecad.local/contracts/candidate.schema.json"},
    "job": {"$ref": "https://forgecad.local/contracts/runtime-job.schema.json"},
    "input_sha256": {"$ref": "#/$defs/sha256"},
    "preview_input_sha256": {"$ref": "#/$defs/sha256"},
    "expected_preview_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "preview_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "operation": {"enum": ["translate_vertices", "single_face_extrude", "split_edge", "collapse_edge", "dissolve_edge"]},
    "edit_policy_sha256": {"const": "fc76c6dffef2a41c05ff0a65ff160c8fce5eb37d312a3ef7f78043ef92539144"},
    "edited_element_ids": {"$ref": "https://forgecad.local/contracts/authoring-mesh-edit-preview.schema.json#/$defs/edited_ids"},
    "edit_lineage_sha256": {"$ref": "#/$defs/sha256"},
    "source_topology_sha256": {"$ref": "#/$defs/sha256"},
    "derived_topology_sha256": {"$ref": "#/$defs/sha256"},
    "source_program_sha256": {"$ref": "#/$defs/sha256"},
    "derived_program_sha256": {"$ref": "#/$defs/sha256"},
    "source_artifact_sha256": {"$ref": "#/$defs/sha256"},
    "derived_artifact_sha256": {"$ref": "#/$defs/sha256"},
    "source_artifact_readback_sha256": {"$ref": "#/$defs/sha256"},
    "derived_artifact_readback_sha256": {"$ref": "#/$defs/sha256"},
    "source_geometry_candidate_evidence_sha256": {"$ref": "#/$defs/sha256"},
    "derived_geometry_candidate_evidence_sha256": {"$ref": "#/$defs/sha256"},
    "source_worker_build_cohort_sha256": {"$ref": "#/$defs/sha256"},
    "derived_worker_build_cohort_sha256": {"$ref": "#/$defs/sha256"},
    "geometry_materialization": {"const": "runtime-owned-cas-staged-candidate"},
    "materialization_status": {"const": "runtime-owned-staged-candidate"},
    "runtime_write_performed": {"const": true},
    "persistent_user_data_touched": {"const": true},
    "version_status": {"const": "no-version-created"},
    "confirm_status": {"const": "approval-required"},
    "export_status": {"const": "locked-until-confirm"},
    "max_response_bytes": {"const": 1048576},
    "validator_status": {"const": "passed"},
    "quality_status": {"const": "structural_only"},
    "limitations": {"const": [
        "STAGED_CANDIDATE_REQUIRES_USER_APPROVAL_BEFORE_CONFIRM",
        "NO_VERSION_CREATED_UNTIL_CONFIRM",
        "NO_EXPORT_BEFORE_CONFIRM",
        "TRANSLATE_VERTICES_SINGLE_FACE_EXTRUDE_OR_TYPED_TOPOLOGY_OPERATION",
        "GENERATED_IDS_STABLE_ONLY_FOR_EXACT_SOURCE_AND_EDIT",
        "NO_CROSS_VERSION_STABLE_ELEMENT_ID_PROMISE",
        "NO_SELECTION_HISTORY_OR_UNDO_BLOB_IN_GEOMETRY_TRUTH",
        "NO_BLENDER_BMESH_PYTHON_OR_PLUGIN_RUNTIME",
        "STRUCTURAL_READBACK_DOES_NOT_PROVE_VISUAL_QUALITY"
      ]},
    "canonical_sha256": {"$ref": "#/$defs/sha256"}
  },
  "allOf": [
    {
      "if": {"properties": {"operation": {"enum": ["split_edge", "collapse_edge", "dissolve_edge"]}}},
      "then": {"properties": {"edited_element_ids": {"required": ["typed_operation_proof"]}}}
    }
  ],
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,128}$"},
    "nullable_identifier": {
      "type": ["string", "null"],
      "pattern": "^[A-Za-z0-9_.-]{1,128}$"
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
