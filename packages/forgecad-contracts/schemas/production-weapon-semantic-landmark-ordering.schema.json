{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/production-weapon-semantic-landmark-ordering.schema.json",
  "title": "ProductionWeaponSemanticLandmarkOrdering@1",
  "description": "Read-only subject-axis/source-node ordering used to prevent stock/muzzle and left/right semantic swaps. This contract deliberately contains no 2D target landmarks and cannot satisfy landmark coverage or NME quality gates.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "ordering_id", "project_id", "candidate_id", "candidate_state_sha256",
    "artifact_id", "artifact_sha256", "reference_sha256", "subject_camera_rig_object_sha256",
    "subject_camera_rig_canonical_sha256", "registered_camera_rig_canonical_sha256", "ordering_policy",
    "identity_view_kinds", "camera_view_kinds", "primary_view_kind", "subject_longitudinal_order",
    "anchors", "target_landmark_arrays_present", "target_landmark_metrics_status", "ordering_status",
    "authored_orientation_status", "read_only", "runtime_write", "production_stage_advanced",
    "candidate_confirmed", "version_created", "export_performed", "canonical_sha256"
  ],
  "properties": {
    "schema_version": {"const": "ProductionWeaponSemanticLandmarkOrdering@1"},
    "ordering_id": {"$ref": "#/$defs/id"},
    "project_id": {"$ref": "#/$defs/id"},
    "candidate_id": {"$ref": "#/$defs/id"},
    "candidate_state_sha256": {"$ref": "#/$defs/sha256"},
    "artifact_id": {"$ref": "#/$defs/id"},
    "artifact_sha256": {"$ref": "#/$defs/sha256"},
    "reference_sha256": {"$ref": "#/$defs/sha256"},
    "subject_camera_rig_object_sha256": {"$ref": "#/$defs/sha256"},
    "subject_camera_rig_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "registered_camera_rig_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "ordering_policy": {"const": "exact-subject-axis-source-order-no-2d-landmarks@1"},
    "identity_view_kinds": {"const": ["front", "back", "left", "right", "top", "rear-three-quarter"]},
    "camera_view_kinds": {"const": ["front", "back", "left", "right", "top", "bottom", "rear-three-quarter"]},
    "primary_view_kind": {"const": "left"},
    "subject_longitudinal_order": {"const": ["stock", "muzzle"]},
    "anchors": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/anchor"}},
    "target_landmark_arrays_present": {"const": false},
    "target_landmark_metrics_status": {"const": "NOT_PRESENT"},
    "ordering_status": {"const": "PASS_DERIVED_SOURCE_ORDER_ONLY"},
    "authored_orientation_status": {"const": "BLOCKED_REQUIRED"},
    "read_only": {"const": true},
    "runtime_write": {"const": false},
    "production_stage_advanced": {"const": false},
    "candidate_confirmed": {"const": false},
    "version_created": {"const": false},
    "export_performed": {"const": false},
    "canonical_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "anchor": {
      "type": "object", "additionalProperties": false,
      "required": ["anchor_id", "semantic_role", "part_ids", "source_node_ids", "geometry_axis", "subject_axis", "source_positions_m", "tie_policy"],
      "properties": {
        "anchor_id": {"enum": ["muzzle", "stock", "side-left", "side-right"]},
        "semantic_role": {"enum": ["muzzle", "stock", "left", "right"]},
        "part_ids": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "source_node_ids": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "geometry_axis": {"enum": ["+X", "-X", "+Y", "-Y", "+Z", "-Z"]},
        "subject_axis": {"enum": ["+X", "-X", "+Y", "-Y", "+Z", "-Z"]},
        "source_positions_m": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"type": "number"}},
        "tie_policy": {"enum": ["explicit-source-group", "exact-part-output-source-order"]}
      }
    }
  }
}
