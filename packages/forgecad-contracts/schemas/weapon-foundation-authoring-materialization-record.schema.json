{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/weapon-foundation-authoring-materialization-record.schema.json",
  "title": "WeaponFoundationAuthoringMaterializationRecord@1",
  "description": "Runtime-owned durable index for one project-bound foundation import. Each Part is represented by hashes, opaque mesh/lineage/revision identities and bounded counts; no topology is inlined.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "record_id", "materialization_id", "project_id",
    "descriptor_object_sha256", "descriptor_sha256", "foundation_request_id",
    "foundation_request_sha256", "foundation_result_object_sha256", "topology_object_sha256",
    "socket_map_object_sha256", "rig_map_object_sha256", "fps_presentation_package_object_sha256",
    "source_asset_id", "source_asset_sha256", "source_asset_role", "materialization_profile",
    "source_only", "part_count", "parts", "materialization_status", "quality_status",
    "review_status", "storage_policy", "writer_policy", "runtime_write_performed",
    "persistent_user_data_touched", "request_input_sha256", "idempotency_key", "limitations",
    "canonicalization_policy", "canonical_sha256", "created_at"
  ],
  "properties": {
    "schema_version": {"const": "WeaponFoundationAuthoringMaterializationRecord@1"},
    "record_id": {"$ref": "#/$defs/id"},
    "materialization_id": {"$ref": "#/$defs/id"},
    "project_id": {"$ref": "#/$defs/id"},
    "descriptor_object_sha256": {"$ref": "#/$defs/sha256"},
    "descriptor_sha256": {"$ref": "#/$defs/sha256"},
    "foundation_request_id": {"$ref": "#/$defs/id"},
    "foundation_request_sha256": {"$ref": "#/$defs/sha256"},
    "foundation_result_object_sha256": {"$ref": "#/$defs/sha256"},
    "topology_object_sha256": {"$ref": "#/$defs/sha256"},
    "socket_map_object_sha256": {"$ref": "#/$defs/sha256"},
    "rig_map_object_sha256": {"$ref": "#/$defs/sha256"},
    "fps_presentation_package_object_sha256": {"$ref": "#/$defs/sha256"},
    "source_asset_id": {"$ref": "#/$defs/asset_id"},
    "source_asset_sha256": {"$ref": "#/$defs/sha256"},
    "source_asset_role": {"$ref": "#/$defs/asset_role"},
    "materialization_profile": {"const": "part-bounded-authoring-mesh-v2-genesis@1"},
    "source_only": {"const": true},
    "part_count": {"type": "integer", "minimum": 1, "maximum": 128},
    "parts": {"type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": {"$ref": "#/$defs/part_summary"}},
    "materialization_status": {"const": "runtime-owned-durable-authoring-mesh-v2-foundation@1"},
    "quality_status": {"const": "structural_only"},
    "review_status": {"const": "DRAFT_UNREVIEWED"},
    "storage_policy": {"const": "runtime-owned-sqlite-cas-per-part-authoring-mesh-v2@1"},
    "writer_policy": {"const": "forgecad-runtime-only-state-writer@1"},
    "runtime_write_performed": {"const": true},
    "persistent_user_data_touched": {"const": true},
    "request_input_sha256": {"$ref": "#/$defs/sha256"},
    "idempotency_key": {"$ref": "#/$defs/id"},
    "limitations": {"const": ["RUNTIME_SOLE_WRITER", "NO_CANDIDATE_BINDING", "NO_VERSION", "NO_EXPORT", "NO_PROMOTION", "DRAFT_UNREVIEWED", "STRUCTURAL_ONLY", "NO_INLINE_TOPOLOGY", "HASH_ONLY_SOURCE_DESCRIPTOR", "PART_BOUNDED_ONE_IMPORT_PER_CALL"]},
    "canonicalization_policy": {"const": "canonical-json-sha256-excluding-canonical-sha256@1"},
    "canonical_sha256": {"$ref": "#/$defs/sha256"},
    "created_at": {"type": "string", "minLength": 1, "maxLength": 64}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "asset_id": {"enum": ["pichuliru-weapon-west", "lightning-low-pbr", "wrad-arms"]},
    "asset_role": {"enum": ["rigged-weapon-semantic-source", "high-low-bake-pbr-animation-benchmark", "first-person-armature-source"]},
    "count": {"type": "integer", "minimum": 0, "maximum": 32768},
    "triangle_count": {"type": "integer", "minimum": 0, "maximum": 250000},
    "part_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "part_id", "material_zone_id", "source_part_topology_sha256", "authoring_mesh_id",
        "authoring_mesh_object_sha256", "authoring_mesh_sha256", "authoring_mesh_lineage_id",
        "authoring_mesh_lineage_sha256", "authoring_mesh_revision_id", "authoring_mesh_revision_sha256",
        "source_binding_sha256", "vertex_count", "edge_count",
        "half_edge_count", "corner_count", "face_count", "loop_count", "ring_count",
        "source_triangle_count", "sanitized_triangle_count"
      ],
      "properties": {
        "part_id": {"$ref": "#/$defs/id"},
        "material_zone_id": {"$ref": "#/$defs/id"},
        "source_part_topology_sha256": {"$ref": "#/$defs/sha256"},
        "authoring_mesh_id": {"$ref": "#/$defs/id"},
        "authoring_mesh_object_sha256": {"$ref": "#/$defs/sha256"},
        "authoring_mesh_sha256": {"$ref": "#/$defs/sha256"},
        "authoring_mesh_lineage_id": {"$ref": "#/$defs/id"},
        "authoring_mesh_lineage_sha256": {"$ref": "#/$defs/sha256"},
        "authoring_mesh_revision_id": {"$ref": "#/$defs/id"},
        "authoring_mesh_revision_sha256": {"$ref": "#/$defs/sha256"},
        "source_binding_sha256": {"$ref": "#/$defs/sha256"},
        "vertex_count": {"$ref": "#/$defs/count"},
        "edge_count": {"$ref": "#/$defs/count"},
        "half_edge_count": {"$ref": "#/$defs/count"},
        "corner_count": {"$ref": "#/$defs/count"},
        "face_count": {"$ref": "#/$defs/count"},
        "loop_count": {"$ref": "#/$defs/count"},
        "ring_count": {"$ref": "#/$defs/count"},
        "source_triangle_count": {"$ref": "#/$defs/triangle_count"},
        "sanitized_triangle_count": {"$ref": "#/$defs/triangle_count"}
      }
    }
  }
}
