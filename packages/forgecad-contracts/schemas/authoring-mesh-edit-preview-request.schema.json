{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/authoring-mesh-edit-preview-request.schema.json",
  "title": "AuthoringMeshEditPreviewRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "topology_request", "base_topology_sha256", "edit", "edit_policy_sha256", "input_sha256"],
  "properties": {
    "schema_version": {"const": "AuthoringMeshEditPreviewRequest@1"},
    "topology_request": {"$ref": "https://forgecad.local/contracts/authoring-topology-request.schema.json"},
    "base_topology_sha256": {"$ref": "#/$defs/sha256"},
    "edit": {"oneOf": [
      {"$ref": "#/$defs/translate_vertices"},
      {"$ref": "#/$defs/single_face_extrude"},
      {"$ref": "#/$defs/split_edge"},
      {"$ref": "#/$defs/collapse_edge"},
      {"$ref": "#/$defs/dissolve_edge"}
    ]},
    "edit_policy_sha256": {"const": "fc76c6dffef2a41c05ff0a65ff160c8fce5eb37d312a3ef7f78043ef92539144"},
    "input_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,128}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "translate_vertices": {
      "type": "object", "additionalProperties": false,
      "required": ["operation", "vertex_ids", "delta_m"],
      "properties": {
        "operation": {"const": "translate_vertices"},
        "vertex_ids": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "delta_m": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number", "minimum": -1, "maximum": 1}}
      }
    },
    "single_face_extrude": {
      "type": "object", "additionalProperties": false,
      "required": ["operation", "face_id", "distance_m"],
      "properties": {
        "operation": {"const": "single_face_extrude"},
        "face_id": {"$ref": "#/$defs/identifier"},
        "distance_m": {"type": "number", "minimum": 0.000001, "maximum": 1}
      }
    },
    "split_edge": {
      "type": "object", "additionalProperties": false,
      "required": ["operation", "edge_id", "parent_revision", "operation_lineage_sha256"],
      "properties": {
        "operation": {"const": "split_edge"},
        "edge_id": {"$ref": "#/$defs/identifier"},
        "parent_revision": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "operation_lineage_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "collapse_edge": {
      "type": "object", "additionalProperties": false,
      "required": ["operation", "edge_id", "survivor_vertex_id", "parent_revision", "operation_lineage_sha256"],
      "properties": {
        "operation": {"const": "collapse_edge"},
        "edge_id": {"$ref": "#/$defs/identifier"},
        "survivor_vertex_id": {"$ref": "#/$defs/identifier"},
        "parent_revision": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "operation_lineage_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "dissolve_edge": {
      "type": "object", "additionalProperties": false,
      "required": ["operation", "edge_id", "parent_revision", "operation_lineage_sha256"],
      "properties": {
        "operation": {"const": "dissolve_edge"},
        "edge_id": {"$ref": "#/$defs/identifier"},
        "parent_revision": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "operation_lineage_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
