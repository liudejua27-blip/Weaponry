{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/production-weapon-form-quality-prepare-request.schema.json",
  "title": "ProductionWeaponFormQualityPrepareRequest@1",
  "description": "Prepare-only input for one ProductionWeaponFormQuality@1 form edge. The immutable CrossViewEvidenceBundle@1 and ReferenceCanvas@1/DesignSpec hashes are authoritative; caller-provided Part-ID, negative-space and line-flow projections must point to one of those sources or remain NOT_PROVEN. This request never renders, advances a stage, confirms a candidate, creates a version or exports.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "form_quality_id", "session_id", "project_id", "form_stage",
    "source_stage", "target_stage", "camera_calibrated_head_transition_id",
    "camera_calibrated_head_transition_sha256", "camera_calibrated_head_canonical_sha256",
    "camera_calibrated_head_candidate_id", "camera_calibrated_head_candidate_state_sha256",
    "camera_calibrated_head_artifact_id", "camera_calibrated_head_artifact_sha256",
    "camera_calibrated_head_stage", "candidate_id", "candidate_state_sha256", "artifact_id",
    "artifact_sha256", "reference_id", "reference_sha256", "reference_canvas_object_sha256",
    "reference_canvas_canonical_sha256", "design_spec_object_sha256", "design_spec_canonical_sha256",
    "camera_lock_id", "camera_lock_canonical_sha256", "camera_rig_object_sha256",
    "camera_rig_canonical_sha256", "camera_lock_receipt_object_sha256",
    "camera_lock_source_transition_id", "camera_lock_source_transition_sha256",
    "camera_lock_source_head_canonical_sha256", "reviewed_reference_view_kinds",
    "fixed_camera_view_kinds", "cross_view_evidence_object_sha256",
    "cross_view_evidence_canonical_sha256", "cross_view_evidence_view_kinds",
    "form_evidence_object_sha256", "form_evidence_canonical_sha256",
    "form_view_evaluations", "previous_form_quality_id",
    "previous_form_quality_report_object_sha256", "previous_form_quality_canonical_sha256",
    "form_quality_policy", "form_quality_policy_sha256", "threshold_policy",
    "threshold_policy_sha256", "input_sha256", "idempotency_key"
  ],
  "properties": {
    "schema_version": {"const": "ProductionWeaponFormQualityPrepareRequest@1"},
    "form_quality_id": {"$ref": "#/$defs/id"},
    "session_id": {"$ref": "#/$defs/id"},
    "project_id": {"$ref": "#/$defs/id"},
    "form_stage": {"enum": ["blockout", "primary", "secondary"]},
    "source_stage": {"$ref": "https://forgecad.local/contracts/production-weapon-form-quality.schema.json#/$defs/stage"},
    "target_stage": {"$ref": "https://forgecad.local/contracts/production-weapon-form-quality.schema.json#/$defs/stage"},
    "camera_calibrated_head_transition_id": {"$ref": "#/$defs/id"},
    "camera_calibrated_head_transition_sha256": {"$ref": "#/$defs/sha256"},
    "camera_calibrated_head_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "camera_calibrated_head_candidate_id": {"$ref": "#/$defs/id"},
    "camera_calibrated_head_candidate_state_sha256": {"$ref": "#/$defs/sha256"},
    "camera_calibrated_head_artifact_id": {"$ref": "#/$defs/id"},
    "camera_calibrated_head_artifact_sha256": {"$ref": "#/$defs/sha256"},
    "camera_calibrated_head_stage": {"const": "camera-calibrated"},
    "candidate_id": {"$ref": "#/$defs/id"},
    "candidate_state_sha256": {"$ref": "#/$defs/sha256"},
    "artifact_id": {"$ref": "#/$defs/id"},
    "artifact_sha256": {"$ref": "#/$defs/sha256"},
    "reference_id": {"$ref": "#/$defs/id"},
    "reference_sha256": {"$ref": "#/$defs/sha256"},
    "reference_canvas_object_sha256": {"$ref": "#/$defs/sha256"},
    "reference_canvas_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "design_spec_object_sha256": {"$ref": "#/$defs/sha256"},
    "design_spec_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "camera_lock_id": {"$ref": "#/$defs/id"},
    "camera_lock_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "camera_rig_object_sha256": {"$ref": "#/$defs/sha256"},
    "camera_rig_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "camera_lock_receipt_object_sha256": {"$ref": "#/$defs/sha256"},
    "camera_lock_source_transition_id": {"$ref": "#/$defs/id"},
    "camera_lock_source_transition_sha256": {"$ref": "#/$defs/sha256"},
    "camera_lock_source_head_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "reviewed_reference_view_kinds": {"const": ["front", "back", "left", "right", "top", "rear-three-quarter"]},
    "fixed_camera_view_kinds": {"const": ["front", "back", "left", "right", "top", "bottom", "rear-three-quarter"]},
    "cross_view_evidence_object_sha256": {"$ref": "#/$defs/sha256"},
    "cross_view_evidence_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "cross_view_evidence_view_kinds": {"const": ["front", "back", "left", "right", "top", "rear-three-quarter"]},
    "form_evidence_object_sha256": {"$ref": "#/$defs/sha256"},
    "form_evidence_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "form_view_evaluations": {
      "type": "array", "minItems": 6, "maxItems": 6, "uniqueItems": true,
      "prefixItems": [
        {"$ref": "https://forgecad.local/contracts/production-weapon-form-quality.schema.json#/$defs/form_view_front"},
        {"$ref": "https://forgecad.local/contracts/production-weapon-form-quality.schema.json#/$defs/form_view_back"},
        {"$ref": "https://forgecad.local/contracts/production-weapon-form-quality.schema.json#/$defs/form_view_left"},
        {"$ref": "https://forgecad.local/contracts/production-weapon-form-quality.schema.json#/$defs/form_view_right"},
        {"$ref": "https://forgecad.local/contracts/production-weapon-form-quality.schema.json#/$defs/form_view_top"},
        {"$ref": "https://forgecad.local/contracts/production-weapon-form-quality.schema.json#/$defs/form_view_rear_three_quarter"}
      ],
      "items": false
    },
    "previous_form_quality_id": {"$ref": "#/$defs/nullable_id"},
    "previous_form_quality_report_object_sha256": {"$ref": "#/$defs/nullable_sha256"},
    "previous_form_quality_canonical_sha256": {"$ref": "#/$defs/nullable_sha256"},
    "form_quality_policy": {"const": "production-weapon-form-quality-six-view-no-regression@1"},
    "form_quality_policy_sha256": {"$ref": "#/$defs/sha256"},
    "threshold_policy": {"const": "production-weapon-form-view-thresholds@1"},
    "threshold_policy_sha256": {"$ref": "#/$defs/sha256"},
    "input_sha256": {"$ref": "#/$defs/sha256"},
    "idempotency_key": {"$ref": "#/$defs/id"}
  },
  "allOf": [
    {
      "if": {"properties": {"form_stage": {"const": "blockout"}}, "required": ["form_stage"]},
      "then": {
        "properties": {
          "source_stage": {"const": "camera-calibrated"},
          "target_stage": {"const": "blockout-reviewed"},
          "previous_form_quality_id": {"type": "null"},
          "previous_form_quality_report_object_sha256": {"type": "null"},
          "previous_form_quality_canonical_sha256": {"type": "null"}
        }
      }
    },
    {
      "if": {"properties": {"form_stage": {"const": "primary"}}, "required": ["form_stage"]},
      "then": {
        "properties": {
          "source_stage": {"const": "blockout-reviewed"},
          "target_stage": {"const": "primary-form-approved"},
          "previous_form_quality_id": {"$ref": "#/$defs/id"},
          "previous_form_quality_report_object_sha256": {"$ref": "#/$defs/sha256"},
          "previous_form_quality_canonical_sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    {
      "if": {"properties": {"form_stage": {"const": "secondary"}}, "required": ["form_stage"]},
      "then": {
        "properties": {
          "source_stage": {"const": "primary-form-approved"},
          "target_stage": {"const": "secondary-form-approved"},
          "previous_form_quality_id": {"$ref": "#/$defs/id"},
          "previous_form_quality_report_object_sha256": {"$ref": "#/$defs/sha256"},
          "previous_form_quality_canonical_sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    }
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullable_id": {"oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
    "nullable_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
  }
}
