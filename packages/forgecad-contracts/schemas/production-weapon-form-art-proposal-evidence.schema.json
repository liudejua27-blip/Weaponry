        "line_flow_status": {"enum": ["observed", "inferred", "unknown", "not-applicable"]},
        "line_flow_rows": {"type": "array", "maxItems": 512, "items": {"$ref": "#/$defs/line_flow_row"}},
        "view_observation_status": {"enum": ["observed", "inferred", "unknown"]},
        "quality_status": {"const": "NOT_PROVEN"}
      },
      "allOf": [
        {
          "if": {"properties": {"negative_space_status": {"const": "not-applicable"}}, "required": ["negative_space_status"]},
          "then": {"properties": {"negative_space_rows": {"maxItems": 0}}}
        },
        {
          "if": {"properties": {"line_flow_status": {"const": "not-applicable"}}, "required": ["line_flow_status"]},
          "then": {"properties": {"line_flow_rows": {"maxItems": 0}}}
        },
        {
          "if": {"properties": {"negative_space_status": {"const": "observed"}}, "required": ["negative_space_status"]},
          "then": {"properties": {"negative_space_rows": {"minItems": 1}}}
        },
        {
          "if": {"properties": {"line_flow_status": {"const": "observed"}}, "required": ["line_flow_status"]},
          "then": {"properties": {"line_flow_rows": {"minItems": 1}}}
        }
      ]
    }
  }
}
