{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://forgecad.local/contracts/skill-execution-receipt.schema.json",
  "title":"SkillExecutionReceipt",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","receipt_id","skill_id","skill_version","input_sha256","output_sha256","status","validator_ids","created_at"],
  "properties":{"schema_version":{"const":"SkillExecutionReceipt@1"},"receipt_id":{"type":"string","pattern":"^[A-Za-z0-9_.-]{1,128}$"},"skill_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{0,63}$"},"skill_version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},"input_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"output_sha256":{"type":["string","null"],"pattern":"^[0-9a-f]{64}$"},"status":{"enum":["succeeded","failed","rejected","not-run"]},"validator_ids":{"type":"array","items":{"type":"string"},"maxItems":32},"created_at":{"type":"string","maxLength":64}}
}
