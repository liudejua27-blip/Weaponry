{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/repair-apply-result.schema.json",
  "title": "ForgeCAD Repair Apply Prepare Result",
  "description": "CAS-backed, replayable Repair application intent. The result is source-bound and never authorizes candidate confirmation by itself.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "job_id",
    "project_id",
    "session_id",
    "candidate_id",
    "source_candidate_id",
    "proposal_candidate_id",
    "run_id",
    "input_sha256",
    "intent_sha256",
    "intent_object_sha256",
    "apply_intent_object_sha256",
    "apply_intent_canonical_sha256",
    "base_version_id",
    "prepared_object_id",
    "prepared_object_sha256",
    "quality_report_id",
    "cross_view_evidence_sha256",
    "status",
    "next_transaction",
    "confirm_allowed",
    "source_candidate_unchanged",
    "active_design_state_mutated",
    "persistent_user_data_touched",
    "canonical_sha256"
  ],
  "properties": {
    "schema_version": {"const": "RepairApplyPrepareResult@1"},
    "job_id": {"$ref": "#/$defs/identifier"},
    "project_id": {"$ref": "#/$defs/identifier"},
    "session_id": {"$ref": "#/$defs/identifier"},
    "candidate_id": {"$ref": "#/$defs/identifier"},
    "source_candidate_id": {"$ref": "#/$defs/identifier"},
    "proposal_candidate_id": {"$ref": "#/$defs/identifier"},
    "run_id": {"$ref": "#/$defs/identifier"},
    "input_sha256": {"$ref": "#/$defs/sha256"},
    "intent_sha256": {"$ref": "#/$defs/sha256"},
    "intent_object_sha256": {"$ref": "#/$defs/sha256"},
    "apply_intent_object_sha256": {"$ref": "#/$defs/sha256"},
    "apply_intent_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "base_version_id": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "prepared_object_id": {"$ref": "#/$defs/identifier"},
    "prepared_object_sha256": {"$ref": "#/$defs/sha256"},
    "quality_report_id": {"$ref": "#/$defs/identifier"},
    "cross_view_evidence_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "status": {"const": "ready"},
    "next_transaction": {"enum": ["candidate_confirm", "cross_view_promotion_confirm"]},
    "confirm_allowed": {"const": false},
    "source_candidate_unchanged": {"const": true},
    "active_design_state_mutated": {"const": false},
    "persistent_user_data_touched": {"const": false},
    "canonical_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
