{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/knife-source-binding-result.schema.json",
  "title": "KnifeSourceBindingResult@1",
  "description": "Closed result for a Runtime-owned KnifeSourceBinding. It returns exact source lineage and persistence effects only; High, visual, human, engine and commercial acceptance remain blocked or not run.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "operation", "request_kind", "status", "project_id",
    "source_binding_id", "source_binding_sha256", "source_binding_object_sha256",
    "binding_status", "authoring_eligibility", "intent_bundle_id",
    "intent_bundle_sha256", "intent_bundle_object_sha256", "brief_id",
    "brief_sha256", "brief_object_sha256", "reference_id",
    "reference_object_sha256", "reference_evidence_sha256", "quality_contract_id",
    "quality_contract_sha256", "quality_contract_object_sha256",
    "source_candidate_id", "source_candidate_state_sha256", "authoring_mesh_id",
    "authoring_mesh_lineage_id", "authoring_mesh_revision_id",
    "authoring_mesh_revision_index", "authoring_mesh_revision_sha256",
    "authoring_mesh_revision_object_sha256", "authoring_mesh_identity_sha256",
    "downstream_binding_requirements", "source_binding", "idempotency_key",
    "replayed", "store_effect", "cas_effect", "atomicity_status",
    "store_commit_status", "cas_commit_status", "runtime_write_performed",
    "persistent_user_data_touched", "partial_result_exposed",
    "high_mesh_created", "high_stage_unlocked", "production_stage_advanced",
    "candidate_confirmed", "version_created", "export_performed", "quality_status",
    "visual_status", "human_status", "engine_status", "writer_policy",
    "canonicalization_policy", "canonical_sha256"
  ],
  "properties": {
    "schema_version": {"const": "KnifeSourceBindingResult@1"},
    "operation": {"enum": ["knife_source_binding_prepare", "knife_source_binding_get"]},
    "request_kind": {"enum": ["prepare", "get"]},
    "status": {"enum": ["prepared", "replayed", "found"]},
    "project_id": {"$ref": "#/$defs/identifier"},
    "source_binding_id": {"$ref": "#/$defs/identifier"},
    "source_binding_sha256": {"$ref": "#/$defs/sha256"},
    "source_binding_object_sha256": {"$ref": "#/$defs/sha256"},
    "binding_status": {"const": "runtime-bound"},
    "authoring_eligibility": {"const": "ELIGIBLE"},
    "intent_bundle_id": {"$ref": "#/$defs/identifier"},
    "intent_bundle_sha256": {"$ref": "#/$defs/sha256"},
    "intent_bundle_object_sha256": {"$ref": "#/$defs/sha256"},
    "brief_id": {"$ref": "#/$defs/identifier"},
    "brief_sha256": {"$ref": "#/$defs/sha256"},
    "brief_object_sha256": {"$ref": "#/$defs/sha256"},
    "reference_id": {"$ref": "#/$defs/identifier"},
    "reference_object_sha256": {"$ref": "#/$defs/sha256"},
    "reference_evidence_sha256": {"$ref": "#/$defs/sha256"},
    "quality_contract_id": {"$ref": "#/$defs/identifier"},
    "quality_contract_sha256": {"$ref": "#/$defs/sha256"},
    "quality_contract_object_sha256": {"$ref": "#/$defs/sha256"},
    "source_candidate_id": {"$ref": "#/$defs/identifier"},
    "source_candidate_state_sha256": {"$ref": "#/$defs/sha256"},
    "authoring_mesh_id": {"$ref": "#/$defs/identifier"},
    "authoring_mesh_lineage_id": {"$ref": "#/$defs/identifier"},
    "authoring_mesh_revision_id": {"$ref": "#/$defs/identifier"},
    "authoring_mesh_revision_index": {"$ref": "#/$defs/revision_index"},
    "authoring_mesh_revision_sha256": {"$ref": "#/$defs/sha256"},
    "authoring_mesh_revision_object_sha256": {"$ref": "#/$defs/sha256"},
    "authoring_mesh_identity_sha256": {"$ref": "#/$defs/sha256"},
    "downstream_binding_requirements": {"$ref": "#/$defs/downstream_binding_requirements"},
    "source_binding": {"$ref": "https://forgecad.local/contracts/knife-source-binding.schema.json"},
    "idempotency_key": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},
    "replayed": {"type": "boolean"},
    "store_effect": {"enum": ["inserted", "not-touched"]},
    "cas_effect": {"enum": ["inserted", "not-touched"]},
    "atomicity_status": {"enum": ["committed", "not-touched"]},
    "store_commit_status": {"enum": ["committed", "not-touched"]},
    "cas_commit_status": {"enum": ["committed", "not-touched"]},
    "runtime_write_performed": {"type": "boolean"},
    "persistent_user_data_touched": {"type": "boolean"},
    "partial_result_exposed": {"const": false},
    "high_mesh_created": {"const": false},
    "high_stage_unlocked": {"const": false},
    "production_stage_advanced": {"const": false},
    "candidate_confirmed": {"const": false},
    "version_created": {"const": false},
    "export_performed": {"const": false},
    "quality_status": {"const": "source_binding_only"},
    "visual_status": {"const": "NOT_RUN"},
    "human_status": {"const": "NOT_RUN"},
    "engine_status": {"const": "NOT_RUN"},
    "writer_policy": {"const": "forgecad-runtime-only-state-writer@1"},
    "canonicalization_policy": {"const": "canonical-json-sha256-excluding-canonical-sha256@1"},
    "canonical_sha256": {"$ref": "#/$defs/sha256"}
  },
  "oneOf": [
    {
      "properties": {
        "operation": {"const": "knife_source_binding_prepare"},
        "request_kind": {"const": "prepare"},
        "status": {"const": "prepared"},
        "idempotency_key": {"type": "string"},
        "replayed": {"const": false},
        "store_effect": {"const": "inserted"},
        "cas_effect": {"const": "inserted"},
        "atomicity_status": {"const": "committed"},
        "store_commit_status": {"const": "committed"},
        "cas_commit_status": {"const": "committed"},
        "runtime_write_performed": {"const": true},
        "persistent_user_data_touched": {"const": true}
      }
    },
    {
      "properties": {
        "operation": {"const": "knife_source_binding_prepare"},
        "request_kind": {"const": "prepare"},
        "status": {"const": "replayed"},
        "idempotency_key": {"type": "string"},
        "replayed": {"const": true},
        "store_effect": {"const": "not-touched"},
        "cas_effect": {"const": "not-touched"},
        "atomicity_status": {"const": "not-touched"},
        "store_commit_status": {"const": "not-touched"},
        "cas_commit_status": {"const": "not-touched"},
        "runtime_write_performed": {"const": false},
        "persistent_user_data_touched": {"const": false}
      }
    },
    {
      "properties": {
        "operation": {"const": "knife_source_binding_get"},
        "request_kind": {"const": "get"},
        "status": {"const": "found"},
        "idempotency_key": {"type": "null"},
        "replayed": {"const": false},
        "store_effect": {"const": "not-touched"},
        "cas_effect": {"const": "not-touched"},
        "atomicity_status": {"const": "not-touched"},
        "store_commit_status": {"const": "not-touched"},
        "cas_commit_status": {"const": "not-touched"},
        "runtime_write_performed": {"const": false},
        "persistent_user_data_touched": {"const": false}
      }
    }
  ],
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "revision_index": {"type": "integer", "minimum": 0, "maximum": 1000000},
    "downstream_binding_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["curve_modifier_graph", "curve_evaluated_mesh", "high", "render"],
      "properties": {
        "curve_modifier_graph": {"const": "must-inherit-source-binding-sha256@1"},
        "curve_evaluated_mesh": {"const": "must-inherit-source-binding-sha256@1"},
        "high": {"const": "must-inherit-source-binding-sha256@1"},
        "render": {"const": "must-inherit-source-binding-sha256@1"}
      }
    }
  }
}
