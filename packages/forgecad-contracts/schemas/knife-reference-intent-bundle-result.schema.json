{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/knife-reference-intent-bundle-result.schema.json",
  "title": "KnifeReferenceIntentBundleResult@1",
  "description": "Closed Runtime result for an immutable reference intent bundle. It never creates High geometry, advances a stage, confirms a candidate, creates a version, or exports.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "operation", "request_kind", "status", "project_id",
    "brief_id", "brief_sha256", "brief_object_sha256", "brief_authoring_eligibility",
    "reference_id", "reference_object_sha256", "reference_evidence_sha256",
    "intent_bundle_id", "intent_bundle_sha256", "intent_bundle_object_sha256",
    "intent_bundle", "idempotency_key", "replayed", "store_effect", "cas_effect",
    "runtime_write_performed", "persistent_user_data_touched", "production_stage_advanced",
    "candidate_confirmed", "version_created", "export_performed", "high_mesh_created",
    "high_stage_unlocked", "writer_policy", "canonicalization_policy", "canonical_sha256"
  ],
  "properties": {
    "schema_version": {"const": "KnifeReferenceIntentBundleResult@1"},
    "operation": {"enum": ["knife_reference_intent_bundle_prepare", "knife_reference_intent_bundle_get"]},
    "request_kind": {"enum": ["prepare", "get"]},
    "status": {"enum": ["stored", "replayed", "found"]},
    "project_id": {"$ref": "#/$defs/identifier"},
    "brief_id": {"$ref": "#/$defs/identifier"},
    "brief_sha256": {"$ref": "#/$defs/sha256"},
    "brief_object_sha256": {"$ref": "#/$defs/sha256"},
    "brief_authoring_eligibility": {"const": "ELIGIBLE"},
    "reference_id": {"$ref": "#/$defs/identifier"},
    "reference_object_sha256": {"$ref": "#/$defs/sha256"},
    "reference_evidence_sha256": {"$ref": "#/$defs/sha256"},
    "intent_bundle_id": {"$ref": "#/$defs/identifier"},
    "intent_bundle_sha256": {"$ref": "#/$defs/sha256"},
    "intent_bundle_object_sha256": {"$ref": "#/$defs/sha256"},
    "intent_bundle": {"$ref": "https://forgecad.local/contracts/knife-reference-intent-bundle.schema.json"},
    "idempotency_key": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},
    "replayed": {"type": "boolean"},
    "store_effect": {"enum": ["inserted", "not-touched"]},
    "cas_effect": {"enum": ["inserted", "not-touched"]},
    "runtime_write_performed": {"type": "boolean"},
    "persistent_user_data_touched": {"type": "boolean"},
    "production_stage_advanced": {"const": false},
    "candidate_confirmed": {"const": false},
    "version_created": {"const": false},
    "export_performed": {"const": false},
    "high_mesh_created": {"const": false},
    "high_stage_unlocked": {"const": false},
    "writer_policy": {"const": "forgecad-runtime-only-state-writer@1"},
    "canonicalization_policy": {"const": "canonical-json-sha256-excluding-canonical-sha256@1"},
    "canonical_sha256": {"$ref": "#/$defs/sha256"}
  },
  "oneOf": [
    {"properties": {"operation": {"const": "knife_reference_intent_bundle_prepare"}, "request_kind": {"const": "prepare"}, "status": {"const": "stored"}, "idempotency_key": {"type": "string"}, "replayed": {"const": false}, "store_effect": {"const": "inserted"}, "cas_effect": {"const": "inserted"}, "runtime_write_performed": {"const": true}, "persistent_user_data_touched": {"const": true}}},
    {"properties": {"operation": {"const": "knife_reference_intent_bundle_prepare"}, "request_kind": {"const": "prepare"}, "status": {"const": "replayed"}, "idempotency_key": {"type": "string"}, "replayed": {"const": true}, "store_effect": {"const": "not-touched"}, "cas_effect": {"const": "not-touched"}, "runtime_write_performed": {"const": false}, "persistent_user_data_touched": {"const": false}}},
    {"properties": {"operation": {"const": "knife_reference_intent_bundle_get"}, "request_kind": {"const": "get"}, "status": {"const": "found"}, "idempotency_key": {"type": "null"}, "replayed": {"const": false}, "store_effect": {"const": "not-touched"}, "cas_effect": {"const": "not-touched"}, "runtime_write_performed": {"const": false}, "persistent_user_data_touched": {"const": false}}}
  ],
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
