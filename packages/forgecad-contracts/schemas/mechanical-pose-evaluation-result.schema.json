{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/mechanical-pose-evaluation-result.schema.json",
  "title": "MechanicalPoseEvaluationResult",
  "description": "A candidate-bound structural pose projection. Geometry, skin and animation assets are not materialized.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "artifact_id", "candidate_id", "artifact_readback_sha256", "program_sha256", "operator_catalog_sha256", "readback_config_sha256", "input_sha256", "rest_frame", "rest_frame_sha256", "parent_map_sha256", "pose_action", "pose_action_sha256", "sample_time_ticks", "evaluation_policy", "evaluation_policy_sha256", "evaluation_order", "evaluated_nodes", "evaluated_pose_sha256", "geometry_materialization", "worker_evaluation", "validator_status", "quality_status", "limitations", "canonical_sha256"],
  "properties": {
    "schema_version": {"const": "MechanicalPoseEvaluationResult@1"},
    "project_id": {"$ref": "#/$defs/identifier"}, "artifact_id": {"$ref": "#/$defs/sha256"}, "candidate_id": {"$ref": "#/$defs/identifier"},
    "artifact_readback_sha256": {"$ref": "#/$defs/sha256"}, "program_sha256": {"$ref": "#/$defs/sha256"},
    "operator_catalog_sha256": {"$ref": "#/$defs/sha256"}, "readback_config_sha256": {"$ref": "#/$defs/sha256"}, "input_sha256": {"$ref": "#/$defs/sha256"},
    "rest_frame": {"$ref": "https://forgecad.local/contracts/mechanical-rest-frame.schema.json"}, "rest_frame_sha256": {"$ref": "#/$defs/sha256"}, "parent_map_sha256": {"$ref": "#/$defs/sha256"},
    "pose_action": {"oneOf": [{"type": "null"}, {"$ref": "https://forgecad.local/contracts/mechanical-pose-action.schema.json"}]},
    "pose_action_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "sample_time_ticks": {"type": "integer", "minimum": 0, "maximum": 1000000},
    "evaluation_policy": {"$ref": "#/$defs/policy"}, "evaluation_policy_sha256": {"$ref": "#/$defs/sha256"},
    "evaluation_order": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/identifier"}},
    "evaluated_nodes": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/node"}},
    "evaluated_pose_sha256": {"$ref": "#/$defs/sha256"},
    "geometry_materialization": {"const": "not-materialized"}, "worker_evaluation": {"const": "not-run-runtime-read-only-projection"},
    "validator_status": {"const": "passed"}, "quality_status": {"const": "structural_only"},
    "limitations": {"const": ["mechanical-rigid-links-only", "single-scalar-dof-per-link", "no-skinning-or-mesh-deformation", "no-ik-constraints-nla-fcurves-or-drivers", "no-geometry-materialization", "no-cross-platform-bit-exact-claim", "candidate-not-created", "visual-quality-not-evaluated"]},
    "canonical_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "translation": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}}, "quaternion": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number", "minimum": -1, "maximum": 1}},
    "pose": {"type": "object", "additionalProperties": false, "required": ["translation_m", "rotation_quat_xyzw", "scale"], "properties": {"translation_m": {"$ref": "#/$defs/translation"}, "rotation_quat_xyzw": {"$ref": "#/$defs/quaternion"}, "scale": {"const": [1.0, 1.0, 1.0]}}},
    "node": {"type": "object", "additionalProperties": false, "required": ["link_id", "part_id", "parent_link_id", "joint_type", "joint_value", "value_unit", "local_pose", "world_pose"], "properties": {"link_id": {"$ref": "#/$defs/identifier"}, "part_id": {"$ref": "#/$defs/identifier"}, "parent_link_id": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"}, "joint_type": {"enum": ["fixed", "revolute", "prismatic"]}, "joint_value": {"type": "number", "minimum": -3.141592653589793, "maximum": 3.141592653589793}, "value_unit": {"enum": ["none", "radian", "meter"]}, "local_pose": {"$ref": "#/$defs/pose"}, "world_pose": {"$ref": "#/$defs/pose"}}},
    "policy": {"type": "object", "additionalProperties": false, "required": ["schema_version", "math", "local_composition", "world_composition", "rotation", "interpolation", "unkeyed", "max_links", "max_depth", "max_channels", "max_total_keys", "geometry_materialization"], "properties": {"schema_version": {"const": "MechanicalPoseEvaluationPolicy@1"}, "math": {"const": "binary64-quantized-1e-12"}, "local_composition": {"const": "rest-local-times-joint-delta"}, "world_composition": {"const": "parent-world-times-local"}, "rotation": {"const": "normalized-quaternion-xyzw-canonical-sign"}, "interpolation": {"const": "scalar-linear-integer-ticks-clamped"}, "unkeyed": {"const": "rest"}, "max_links": {"const": 64}, "max_depth": {"const": 16}, "max_channels": {"const": 64}, "max_total_keys": {"const": 512}, "geometry_materialization": {"const": "not-materialized"}}}
  }
}
