{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/authoring-topology-request.schema.json",
  "title": "AuthoringTopologyRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "project_id", "candidate_id", "artifact_id", "artifact_readback_sha256",
    "program_sha256", "operator_catalog_sha256",
    "readback_config_sha256", "authoring_node_id", "part_id",
    "authoring_topology_policy_sha256", "max_response_bytes"
  ],
  "properties": {
    "schema_version": {"const": "AuthoringTopologyRequest@1"},
    "project_id": {"$ref": "#/$defs/identifier"},
    "candidate_id": {"$ref": "#/$defs/identifier"},
    "artifact_id": {"$ref": "#/$defs/sha256"},
    "artifact_readback_sha256": {"$ref": "#/$defs/sha256"},
    "program_sha256": {"$ref": "#/$defs/sha256"},
    "operator_catalog_sha256": {"$ref": "#/$defs/sha256"},
    "readback_config_sha256": {"$ref": "#/$defs/sha256"},
    "authoring_node_id": {"$ref": "#/$defs/identifier"},
    "part_id": {"$ref": "#/$defs/identifier"},
    "authoring_topology_policy_sha256": {"const": "a6fb36a530e49537673b66d65ecb6e4fb4f51ffb3e7d01a0980be71f28cb367d"},
    "max_response_bytes": {"const": 1048576}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,128}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
