{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/native-high-durable-link.schema.json",
  "title": "NativeHighDurableLink@1",
  "description": "Closed compact Runtime-owned durable index for one source-only Native High artifact and its embedded GLB/readback. It carries candidate/base lineage and CAS hashes with no promotion or approval semantics.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "link_id", "project_id", "candidate_id", "candidate_state_sha256", "base_version_id",
    "source_authoring_mesh_id", "source_authoring_mesh_object_sha256", "source_authoring_mesh_sha256",
    "detail_graph_object_sha256", "detail_graph_canonical_sha256", "artifact_id", "artifact_object_sha256",
    "artifact_sha256", "artifact_readback_object_sha256", "artifact_readback_sha256", "glb_object_sha256",
    "glb_sha256", "glb_readback_object_sha256", "glb_readback_sha256", "high_worker_algorithm_sha256",
    "high_worker_build_cohort_sha256", "replay_count", "replay_byte_exact", "request_sha256", "idempotency_key",
    "link_policy", "writer_policy", "materialization_status", "idempotency_policy", "source_only",
    "runtime_write_performed", "persistent_user_data_touched", "production_stage_advanced", "candidate_confirmed",
    "version_created", "export_performed", "quality_status", "limitations", "canonicalization_policy", "canonical_sha256"
  ],
  "properties": {
    "schema_version": {"const": "NativeHighDurableLink@1"},
    "link_id": {"$ref": "#/$defs/id"},
    "project_id": {"$ref": "#/$defs/id"},
    "candidate_id": {"$ref": "#/$defs/id"},
    "candidate_state_sha256": {"$ref": "#/$defs/sha256"},
    "base_version_id": {"$ref": "#/$defs/nullable_id"},
    "source_authoring_mesh_id": {"$ref": "#/$defs/id"},
    "source_authoring_mesh_object_sha256": {"$ref": "#/$defs/sha256"},
    "source_authoring_mesh_sha256": {"$ref": "#/$defs/sha256"},
    "detail_graph_object_sha256": {"$ref": "#/$defs/sha256"},
    "detail_graph_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "artifact_id": {"$ref": "#/$defs/id"},
    "artifact_object_sha256": {"$ref": "#/$defs/sha256"},
    "artifact_sha256": {"$ref": "#/$defs/sha256"},
    "artifact_readback_object_sha256": {"$ref": "#/$defs/sha256"},
    "artifact_readback_sha256": {"$ref": "#/$defs/sha256"},
    "glb_object_sha256": {"$ref": "#/$defs/sha256"},
    "glb_sha256": {"$ref": "#/$defs/sha256"},
    "glb_readback_object_sha256": {"$ref": "#/$defs/sha256"},
    "glb_readback_sha256": {"$ref": "#/$defs/sha256"},
    "high_worker_algorithm_sha256": {"$ref": "#/$defs/sha256"},
    "high_worker_build_cohort_sha256": {"$ref": "#/$defs/sha256"},
    "replay_count": {"const": 2},
    "replay_byte_exact": {"const": true},
    "request_sha256": {"$ref": "#/$defs/sha256"},
    "idempotency_key": {"$ref": "#/$defs/id"},
    "link_policy": {"const": "native-high-authoring-mesh-detail-graph-artifact-glb-readback@1"},
    "writer_policy": {"const": "forgecad-runtime-only-state-writer@1"},
    "materialization_status": {"const": "runtime-owned-durable-native-high-source-only@1"},
    "idempotency_policy": {"const": "same-input-hash-replays-without-new-record@1"},
    "source_only": {"const": true},
    "runtime_write_performed": {"const": true},
    "persistent_user_data_touched": {"const": true},
    "production_stage_advanced": {"const": false},
    "candidate_confirmed": {"const": false},
    "version_created": {"const": false},
    "export_performed": {"const": false},
    "quality_status": {"const": "structural_only"},
    "limitations": {"const": ["RUNTIME_SOLE_WRITER", "NO_STAGE_ADVANCEMENT", "NO_CANDIDATE_CONFIRM", "NO_VERSION_CREATED", "NO_EXPORT", "SOURCE_ONLY_NOT_PRODUCTION_WEAPON_HIGH", "STRUCTURAL_ONLY_NOT_COMMERCIAL_QUALITY"]},
    "canonicalization_policy": {"const": "canonical-json-sha256-excluding-canonical-sha256@1"},
    "canonical_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,128}$"},
    "nullable_id": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9_.:-]{1,128}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
