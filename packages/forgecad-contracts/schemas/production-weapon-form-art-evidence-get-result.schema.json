        "diagnostic_id": {"$ref": "#/$defs/id"}, "session_id": {"$ref": "#/$defs/id"}, "project_id": {"$ref": "#/$defs/id"}, "candidate_id": {"$ref": "#/$defs/id"},
        "candidate_state_sha256": {"$ref": "#/$defs/sha256"}, "artifact_id": {"$ref": "#/$defs/id"}, "artifact_sha256": {"$ref": "#/$defs/sha256"}, "artifact_readback_canonical_sha256": {"$ref": "#/$defs/sha256"},
        "reference_id": {"$ref": "#/$defs/id"}, "reference_sha256": {"$ref": "#/$defs/sha256"}, "view_kind": {"enum": ["left", "right", "rear-three-quarter"]}, "view_id": {"$ref": "#/$defs/id"},
        "camera_hash": {"$ref": "#/$defs/sha256"}, "camera_canonical_sha256": {"$ref": "#/$defs/sha256"}, "camera_object_sha256": {"$ref": "#/$defs/sha256"}, "camera_rig_object_sha256": {"$ref": "#/$defs/sha256"}, "camera_rig_canonical_sha256": {"$ref": "#/$defs/sha256"},
        "form_art_evidence_object_sha256": {"$ref": "#/$defs/sha256"}, "form_art_evidence_canonical_sha256": {"$ref": "#/$defs/sha256"}, "form_art_view_receipt_object_sha256": {"$ref": "#/$defs/sha256"}, "form_art_view_receipt_canonical_sha256": {"$ref": "#/$defs/sha256"},
        "target_object_sha256": {"$ref": "#/$defs/sha256"}, "target_canonical_sha256": {"$ref": "#/$defs/sha256"}, "target_mask_source_sha256": {"$ref": "#/$defs/sha256"}, "projected_target_mask_sha256": {"$ref": "#/$defs/sha256"}, "reviewed_region_mask_sha256": {"$ref": "#/$defs/sha256"}, "expected_void_mask_sha256": {"$ref": "#/$defs/sha256"},
        "render_set_object_sha256": {"$ref": "#/$defs/sha256"}, "render_set_canonical_sha256": {"$ref": "#/$defs/sha256"},
        "reviewed_region_structure_id": {"enum": ["left.open-stock-void", "right.open-stock-void", "rear3q.open-stock-void"]}, "reviewed_region_canonical_sha256": {"$ref": "#/$defs/sha256"},
        "owner_changed_status": {"const": "NOT_APPLICABLE_SINGLE_CANDIDATE"}, "policy": {"const": "production-weapon-raster-source-attribution-single-candidate-diagnostic@1"},
        "diagnostic": {"$ref": "#/$defs/diagnostic"}, "quality_status": {"const": "NOT_PROVEN"},
        "runtime_write": {"const": false}, "worker_started": {"const": true}, "production_stage_advanced": {"const": false}, "candidate_confirmed": {"const": false}, "version_created": {"const": false}, "export_performed": {"const": false},
        "input_sha256": {"$ref": "#/$defs/sha256"}, "diagnostic_canonical_sha256": {"$ref": "#/$defs/sha256"}
      }
