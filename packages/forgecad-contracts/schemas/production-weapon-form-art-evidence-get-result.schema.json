        "status": {"const": "TRANSIENT_SOURCE_ATTRIBUTION_OBSERVED"}, "diagnostic_only": {"const": true},
        "promotable": {"const": false}, "runtime_write": {"const": false}, "production_stage_advanced": {"const": false}
      }
