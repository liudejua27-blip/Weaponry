{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/candidate-animation-vfx-quality-v2-prepare-request.schema.json",
  "title": "CandidateAnimationVfxQualityPrepareRequest@2",
  "description": "Closed prepare request for CandidateAnimationVfxQuality@2. The Runtime must exact-get Attachment@3 and derive base, bloom, particle, trail, trail-bloom, camera and worker predicates from its dual-candidate parent plus ordered fifteen-frame set; legacy V1 sidecar sequence keys are not accepted. The frame-set digest is canonical JSON {schema_version: CandidateAnimationVfxQualityAttachmentFrameSet@1, attachment_key_sha256, frames: [{frame_index, canonical_sha256}]} ordered by frame_index 0..14.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "animation_vfx_quality_id", "project_id",
    "source_material_surface_transition_id", "source_material_surface_transition_sha256",
    "source_material_surface_head_canonical_sha256", "source_material_surface_quality_id",
    "source_material_surface_quality_report_object_sha256", "source_material_surface_quality_canonical_sha256",
    "candidate_id", "geometry_candidate_id", "geometry_candidate_state_sha256",
    "geometry_delivery_manifest_object_sha256", "geometry_artifact_sha256", "appearance_candidate_id",
    "appearance_candidate_state_sha256", "appearance_delivery_manifest_object_sha256", "appearance_artifact_sha256",
    "geometry_preservation_projection_sha256", "geometry_preservation_status",
    "animated_socket_materialization_key_sha256", "animated_artifact_sha256",
    "animated_socket_anchor_set_object_sha256", "animated_socket_anchor_set_canonical_sha256",
    "appearance_anchor_set_object_sha256", "appearance_anchor_set_canonical_sha256",
    "anchor_binding_policy", "anchor_binding_sha256", "animation_clip_id",
    "animation_clip_object_sha256", "animation_clip_canonical_sha256", "animation_receipt_object_sha256",
    "animation_receipt_canonical_sha256", "projection_key_sha256", "projection_object_sha256",
    "projection_canonical_sha256", "particle_sequence_key_sha256", "particle_sequence_canonical_sha256",
    "trail_sequence_key_sha256", "trail_sequence_canonical_sha256", "trail_bloom_sequence_key_sha256",
    "trail_bloom_sequence_canonical_sha256", "vfx_profile_object_sha256", "vfx_profile_canonical_sha256",
    "trail_bloom_profile_sha256", "socket_node_id_encoding_sha256", "socket_roles_sha256",
    "camera_object_sha256", "camera_identity_sha256", "render_profile_sha256",
    "render_worker_build_cohort_sha256", "sample_schedule_sha256", "sample_count", "sample_time_ticks",
    "attachment_policy", "frame_scope", "attachment_key_sha256", "attachment_canonical_sha256",
    "attachment_receipt_object_sha256", "attachment_receipt_canonical_sha256", "attachment_frame_count",
    "attachment_frame_set_sha256", "animation_vfx_scope", "animation_vfx_policy",
    "animation_vfx_policy_sha256", "from_stage", "to_stage", "input_sha256", "idempotency_key"
  ],
  "properties": {
    "schema_version": {"const": "CandidateAnimationVfxQualityPrepareRequest@2"},
    "animation_vfx_quality_id": {"$ref": "#/$defs/id"}, "project_id": {"$ref": "#/$defs/id"},
    "source_material_surface_transition_id": {"$ref": "#/$defs/id"},
    "source_material_surface_transition_sha256": {"$ref": "#/$defs/sha256"},
    "source_material_surface_head_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "source_material_surface_quality_id": {"$ref": "#/$defs/id"},
    "source_material_surface_quality_report_object_sha256": {"$ref": "#/$defs/sha256"},
    "source_material_surface_quality_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "candidate_id": {"$ref": "#/$defs/id"},
    "geometry_candidate_id": {"$ref": "#/$defs/id", "x-forgecad-distinct-from": "appearance_candidate_id"},
    "geometry_candidate_state_sha256": {"$ref": "#/$defs/sha256"},
    "geometry_delivery_manifest_object_sha256": {"$ref": "#/$defs/sha256"},
    "geometry_artifact_sha256": {"$ref": "#/$defs/sha256"},
    "appearance_candidate_id": {"$ref": "#/$defs/id", "x-forgecad-distinct-from": "geometry_candidate_id"},
    "appearance_candidate_state_sha256": {"$ref": "#/$defs/sha256"},
    "appearance_delivery_manifest_object_sha256": {"$ref": "#/$defs/sha256"},
    "appearance_artifact_sha256": {"$ref": "#/$defs/sha256"},
    "geometry_preservation_projection_sha256": {"$ref": "#/$defs/sha256"},
    "geometry_preservation_status": {"const": "source-output-renderable-geometry-byte-exact"},
    "animated_socket_materialization_key_sha256": {"$ref": "#/$defs/sha256"},
    "animated_artifact_sha256": {"$ref": "#/$defs/sha256"},
    "animated_socket_anchor_set_object_sha256": {"$ref": "#/$defs/sha256"},
    "animated_socket_anchor_set_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "appearance_anchor_set_object_sha256": {"$ref": "#/$defs/sha256"},
    "appearance_anchor_set_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "anchor_binding_policy": {"const": "geometry-appearance-anchor-role-owner-trs-equivalent@1"},
    "anchor_binding_sha256": {"$ref": "#/$defs/sha256"},
    "animation_clip_id": {"$ref": "#/$defs/id"},
    "animation_clip_object_sha256": {"$ref": "#/$defs/sha256"},
    "animation_clip_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "animation_receipt_object_sha256": {"$ref": "#/$defs/sha256"},
    "animation_receipt_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "projection_key_sha256": {"$ref": "#/$defs/sha256"},
    "projection_object_sha256": {"$ref": "#/$defs/sha256"},
    "projection_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "particle_sequence_key_sha256": {"$ref": "#/$defs/sha256"},
    "particle_sequence_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "trail_sequence_key_sha256": {"$ref": "#/$defs/sha256"},
    "trail_sequence_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "trail_bloom_sequence_key_sha256": {"$ref": "#/$defs/sha256"},
    "trail_bloom_sequence_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "vfx_profile_object_sha256": {"$ref": "#/$defs/sha256"},
    "vfx_profile_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "trail_bloom_profile_sha256": {"$ref": "#/$defs/sha256"},
    "socket_node_id_encoding_sha256": {"$ref": "#/$defs/sha256"},
    "socket_roles_sha256": {"$ref": "#/$defs/sha256"},
    "camera_object_sha256": {"$ref": "#/$defs/sha256"},
    "camera_identity_sha256": {"$ref": "#/$defs/sha256"},
    "render_profile_sha256": {"$ref": "#/$defs/sha256"},
    "render_worker_build_cohort_sha256": {"$ref": "#/$defs/sha256"},
    "sample_schedule_sha256": {"$ref": "#/$defs/sha256"},
    "sample_count": {"const": 15, "type": "integer"},
    "sample_time_ticks": {"type": "array", "minItems": 15, "maxItems": 15, "uniqueItems": true, "items": {"type": "integer", "minimum": 0, "maximum": 1000000}},
    "attachment_policy": {"const": "projection-v2-particles-v2-trails-v2-trails-bloom-v2-animated-socket-attachment-bridge@3"},
    "frame_scope": {"const": "lod0-animation-attachment-v3-source-frames-1-15-with-trails-bloom-v2-frames-0-14@3"},
    "attachment_key_sha256": {"$ref": "#/$defs/sha256"},
    "attachment_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "attachment_receipt_object_sha256": {"$ref": "#/$defs/sha256"},
    "attachment_receipt_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "attachment_frame_count": {"const": 15, "type": "integer"},
    "attachment_frame_set_sha256": {
      "$ref": "#/$defs/sha256",
      "description": "SHA-256 of canonical JSON {schema_version: CandidateAnimationVfxQualityAttachmentFrameSet@1, attachment_key_sha256, frames: [{frame_index, canonical_sha256}]} with frames ordered by frame_index 0..14.",
      "x-forgecad-frame-set-digest": {"schema_version": "CandidateAnimationVfxQualityAttachmentFrameSet@1", "frame_count": 15, "ordered_by": "frame_index-ascending-0..14", "fields": ["frame_index", "canonical_sha256"]}
    },
    "animation_vfx_scope": {"const": "lod0-rigid-animation-full-vfx-stack-attachment-v3-all-15-frames@2"},
    "animation_vfx_policy": {"const": "candidate-animation-vfx-attachment-v3-structural-hard-gate@2"},
    "animation_vfx_policy_sha256": {"$ref": "#/$defs/sha256"},
    "from_stage": {"const": "material-surface"}, "to_stage": {"const": "animation-vfx"},
    "input_sha256": {"$ref": "#/$defs/sha256"}, "idempotency_key": {"$ref": "#/$defs/id"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
