{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/fictional-energy-vfx-trails-bloom-render-set.schema.json",
  "title": "FictionalEnergyVfxTrailsBloomRenderSet@1",
  "type": "object",
  "additionalProperties": false,
  "required": [
