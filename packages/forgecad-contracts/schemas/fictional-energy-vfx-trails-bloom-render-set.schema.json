    "source_trail_key_sha256",
    "candidate_id",
    "artifact_sha256",
    "camera_hash",
    "camera_object_sha256",
    "render_profile_sha256",
    "render_worker_build_cohort_sha256",
    "render_worker_binding_status",
    "trail_bloom_profile",
    "trail_bloom_profile_sha256",
    "base_opaque_depth_object_sha256",
    "base_opaque_depth_pass",
    "trail_seed_sha256",
    "trail_inventory_sha256",
    "trail_id_encoding_sha256",
    "node_inventory_sha256",
    "owner_world_transform_sha256",
    "source_trail_color_object_sha256",
    "source_trail_id_object_sha256",
    "source_trail_depth_object_sha256",
    "passes",
    "pass_artifacts",
    "base_aov_passes",
    "bloom_passes",
    "particle_pass_sha256s",
    "source_trail_passes",
    "trail_bloom_policy",
    "input_policy",
    "occlusion_policy",
    "render_policy",
    "base_aov_byte_exact_verified",
    "base_opaque_depth_byte_exact_reused",
    "bloom_pass_byte_exact_reused",
    "particle_passes_byte_exact_reused",
    "source_trail_passes_byte_exact_reused",
    "base_bloom_mutated",
    "particle_passes_mutated",
    "trail_passes_mutated",
    "trail_bloom_source_rendered",
    "trail_bloom_contribution_rendered",
    "trail_bloom_rendered",
    "trail_bloom_input",
    "canonical_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "FictionalEnergyVfxTrailsBloomRenderSet@1"
    },
    "render_set_id": {
      "$ref": "#/$defs/identifier"
    },
    "trail_bloom_key_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "base_frame_key_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "bloom_key_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "source_trail_key_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "candidate_id": {
      "$ref": "#/$defs/identifier"
    },
    "artifact_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "camera_hash": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "camera_object_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "render_profile_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "render_worker_build_cohort_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "render_worker_binding_status": {
      "const": "same_cohort_verified"
    },
    "trail_bloom_profile": {
      "$ref": "#/$defs/trail_bloom_profile"
    },
    "trail_bloom_profile_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "base_opaque_depth_object_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "base_opaque_depth_pass": {
      "const": "depth"
    },
    "trail_seed_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "trail_inventory_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "trail_id_encoding_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "node_inventory_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "owner_world_transform_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "source_trail_color_object_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "source_trail_id_object_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "source_trail_depth_object_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "passes": {
      "const": [
        "trail-emissive-source",
        "trail-bloom-contribution"
      ]
    },
    "pass_artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trail-emissive-source",
        "trail-bloom-contribution"
      ],
      "properties": {
        "trail-emissive-source": {
          "$ref": "#/$defs/pass"
        },
        "trail-bloom-contribution": {
          "$ref": "#/$defs/pass"
        }
      }
    },
    "base_aov_passes": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/sha256"
      }
    },
    "bloom_passes": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/sha256"
      }
    },
    "particle_pass_sha256s": {
      "type": "array",
      "minItems": 2,
      "maxItems": 5,
      "items": {
        "type": "array",
        "minItems": 3,
        "maxItems": 3,
        "uniqueItems": true,
        "items": {
          "$ref": "common.schema.json#/$defs/sha256"
        }
      }
    },
    "source_trail_passes": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/sha256"
      }
    },
    "trail_bloom_policy": {
      "const": "lod0-typed-trails-hdr-source-two-pass-fixed-kernel@1"
    },
    "input_policy": {
      "const": "existing-trail-color-depth-plus-current-base-opaque-depth-byte-exact@1"
    },
    "occlusion_policy": {
      "const": "current-base-opaque-depth-before-trail-depth-reversed-normalized-u8-epsilon-1e-4@1"
    },
    "render_policy": {
      "const": "lod0-trail-bloom-two-new-passes-base-bloom-particles-trails-byte-exact-reused@1"
    },
    "base_aov_byte_exact_verified": {
      "const": true
    },
    "base_opaque_depth_byte_exact_reused": {
      "const": true
    },
    "bloom_pass_byte_exact_reused": {
      "const": true
    },
    "particle_passes_byte_exact_reused": {
      "const": true
    },
    "source_trail_passes_byte_exact_reused": {
      "const": true
    },
    "base_bloom_mutated": {
      "const": false
    },
    "particle_passes_mutated": {
      "const": false
    },
    "trail_passes_mutated": {
      "const": false
    },
    "trail_bloom_source_rendered": {
      "const": true
    },
    "trail_bloom_contribution_rendered": {
      "const": true
    },
    "trail_bloom_rendered": {
      "const": true
    },
    "trail_bloom_input": {
      "const": true
    },
    "canonical_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "trail_bloom_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "threshold",
        "source_gain",
        "radius_px",
        "intensity",
        "hdr_clamp",
        "blur_passes",
        "kernel"
      ],
      "properties": {
        "threshold": {
          "const": 1.0
        },
        "source_gain": {
          "const": 8.0
        },
        "radius_px": {
          "const": 8
        },
        "intensity": {
          "const": 4.0
        },
        "hdr_clamp": {
          "const": 16.0
        },
        "blur_passes": {
          "const": 2
        },
        "kernel": {
          "const": "separable-box-two-pass-fixed-radius@1"
        }
      }
    },
    "pass": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pass",
        "sha256",
        "mime",
        "size_bytes",
        "width",
        "height",
        "channels",
        "color_space"
      ],
      "properties": {
        "pass": {
          "enum": [
            "trail-emissive-source",
            "trail-bloom-contribution"
          ]
        },
        "sha256": {
          "$ref": "common.schema.json#/$defs/sha256"
        },
        "mime": {
          "const": "image/png"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4194304
        },
        "width": {
          "const": 512
        },
        "height": {
          "const": 512
        },
        "channels": {
          "const": "rgba8"
        },
        "color_space": {
          "const": "data"
        }
      }
    }
  }
}
