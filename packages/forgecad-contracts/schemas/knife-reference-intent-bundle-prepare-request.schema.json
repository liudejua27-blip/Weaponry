{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/knife-reference-intent-bundle-prepare-request.schema.json",
  "title": "KnifeReferenceIntentBundlePrepareRequest@1",
  "description": "Closed prepare envelope for a Runtime-owned KnifeReferenceIntentBundle. The caller proposes typed observations; Runtime alone may persist them.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "operation", "project_id", "brief_id", "brief_sha256",
    "brief_object_sha256", "reference_id", "reference_object_sha256",
    "reference_evidence_sha256", "brief_authoring_eligibility", "intent_bundle",
    "idempotency_key", "max_response_bytes", "runtime_write_performed",
    "writer_policy", "canonicalization_policy", "input_sha256"
  ],
  "properties": {
    "schema_version": {"const": "KnifeReferenceIntentBundlePrepareRequest@1"},
    "operation": {"const": "knife_reference_intent_bundle_prepare"},
    "project_id": {"$ref": "#/$defs/identifier"},
    "brief_id": {"$ref": "#/$defs/identifier"},
    "brief_sha256": {"$ref": "#/$defs/sha256"},
    "brief_object_sha256": {"$ref": "#/$defs/sha256"},
    "reference_id": {"$ref": "#/$defs/identifier"},
    "reference_object_sha256": {"$ref": "#/$defs/sha256"},
    "reference_evidence_sha256": {"$ref": "#/$defs/sha256"},
    "brief_authoring_eligibility": {"const": "ELIGIBLE"},
    "intent_bundle": {"$ref": "https://forgecad.local/contracts/knife-reference-intent-bundle.schema.json"},
    "idempotency_key": {"$ref": "#/$defs/idempotency_key"},
    "max_response_bytes": {"const": 1048576},
    "runtime_write_performed": {"const": false},
    "writer_policy": {"const": "forgecad-runtime-only-state-writer@1"},
    "canonicalization_policy": {"const": "canonical-json-sha256-excluding-input-sha256@1"},
    "input_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "idempotency_key": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"}
  }
}
