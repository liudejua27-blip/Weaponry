{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/low-quad-draft-worker-result.schema.json",
  "title": "LowQuadDraftWorkerResult@1",
  "description": "Hash-bound structural result for an explicit quad Low/Retopo draft. The compiled GLB is a strict readback artifact; the editable source remains the explicit quad AuthoringMesh draft. This result is not artist approval, commercial quality, or a Runtime write.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operation",
    "project_id",
    "source_high_artifact_sha256",
    "source_high_artifact_readback_sha256",
    "source_high_part_id",
    "source_high_node_id",
    "source_high_material_zone_id",
    "source_lineage",
    "source_lineage_sha256",
    "draft",
    "draft_sha256",
    "authoring_mesh_sha256",
    "edge_flow",
    "edge_flow_sha256",
    "low_quad_draft_artifact_sha256",
    "low_quad_draft_artifact_kind",
    "low_quad_draft_mime",
    "low_quad_draft_size_bytes",
    "low_quad_draft_glb_base64",
    "low_quad_draft_readback",
    "low_geometry_program_sha256",
    "quad_face_count",
    "render_triangle_count",
    "vertex_budget",
    "edge_budget",
    "face_budget",
    "low_retopology_policy",
    "algorithm",
    "algorithm_sha256",
    "explicit_quad_faces",
    "auto_retopology_performed",
    "retopology_derived",
    "artist_authored_quad_topology",
    "edge_flow_status",
    "quality_status",
    "validator_status",
    "hard_gate_passed",
    "runtime_write_performed",
    "production_stage_advanced",
    "promotion_eligible",
    "candidate_confirmed",
    "version_created",
    "export_performed",
    "canonical_sha256"
  ],
  "properties": {
    "schema_version": {"const": "LowQuadDraftWorkerResult@1"},
    "operation": {"const": "production_weapon_low_quad_draft"},
    "project_id": {"$ref": "#/$defs/id"},
    "source_high_artifact_sha256": {"$ref": "#/$defs/sha256"},
    "source_high_artifact_readback_sha256": {"$ref": "#/$defs/sha256"},
    "source_high_part_id": {"$ref": "#/$defs/id"},
    "source_high_node_id": {"$ref": "#/$defs/id"},
    "source_high_material_zone_id": {"$ref": "#/$defs/id"},
    "source_lineage": {"$ref": "#/$defs/source_lineage"},
    "source_lineage_sha256": {"$ref": "#/$defs/sha256"},
    "draft": {"type": "object"},
    "draft_sha256": {"$ref": "#/$defs/sha256"},
    "authoring_mesh_sha256": {"$ref": "#/$defs/sha256"},
    "edge_flow": {"$ref": "#/$defs/edge_flow"},
    "edge_flow_sha256": {"$ref": "#/$defs/sha256"},
    "low_quad_draft_artifact_sha256": {"$ref": "#/$defs/sha256"},
    "low_quad_draft_artifact_kind": {"const": "production-weapon-low-quad-draft-glb"},
    "low_quad_draft_mime": {"const": "model/gltf-binary"},
    "low_quad_draft_size_bytes": {"type": "integer", "minimum": 1, "maximum": 67108864},
    "low_quad_draft_glb_base64": {"type": "string", "minLength": 1, "maxLength": 89478488},
    "low_quad_draft_readback": {"type": "object"},
    "low_geometry_program_sha256": {"$ref": "#/$defs/sha256"},
    "quad_face_count": {"type": "integer", "minimum": 1, "maximum": 8192},
    "render_triangle_count": {"type": "integer", "minimum": 2, "maximum": 16384},
    "vertex_budget": {"$ref": "#/$defs/budget"},
    "edge_budget": {"$ref": "#/$defs/budget"},
    "face_budget": {"$ref": "#/$defs/budget"},
    "low_retopology_policy": {"const": "explicit-artist-editable-quad-draft-source-only@1"},
    "algorithm": {"const": "deterministic-explicit-quad-compile-edge-flow@1"},
    "algorithm_sha256": {"$ref": "#/$defs/sha256"},
    "explicit_quad_faces": {"const": true},
    "auto_retopology_performed": {"const": false},
    "retopology_derived": {"const": false},
    "artist_authored_quad_topology": {"const": false},
    "edge_flow_status": {"const": "DRAFT_UNREVIEWED"},
    "quality_status": {"const": "structural_only"},
    "validator_status": {"const": "passed"},
    "hard_gate_passed": {"const": true},
    "runtime_write_performed": {"const": false},
    "production_stage_advanced": {"const": false},
    "promotion_eligible": {"const": false},
    "candidate_confirmed": {"const": false},
    "version_created": {"const": false},
    "export_performed": {"const": false},
    "canonical_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "budget": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8192
    },
    "source_lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_high_artifact_sha256", "source_high_artifact_readback_sha256", "source_high_part_id", "source_high_node_id", "source_high_material_zone_id"],
      "properties": {
        "source_high_artifact_sha256": {"$ref": "#/$defs/sha256"},
        "source_high_artifact_readback_sha256": {"$ref": "#/$defs/sha256"},
        "source_high_part_id": {"$ref": "#/$defs/id"},
        "source_high_node_id": {"$ref": "#/$defs/id"},
        "source_high_material_zone_id": {"$ref": "#/$defs/id"}
      }
    },
    "edge_flow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "policy", "quad_faces", "quad_face_count", "edge_count", "boundary_edge_count", "non_manifold_edge_count", "vertex_face_valence_histogram", "status", "edge_flow_proven", "artist_review_status", "canonical_sha256"],
      "properties": {
        "schema_version": {"const": "LowQuadEdgeFlow@1"},
        "policy": {"const": "explicit-quad-adjacency-only@1"},
        "quad_faces": {"type": "array", "minItems": 1, "maxItems": 8192, "items": {"type": "object"}},
        "quad_face_count": {"type": "integer", "minimum": 1, "maximum": 8192},
        "edge_count": {"type": "integer", "minimum": 1, "maximum": 16384},
        "boundary_edge_count": {"const": 0},
        "non_manifold_edge_count": {"const": 0},
        "vertex_face_valence_histogram": {"type": "array", "maxItems": 8192, "items": {"type": "object"}},
        "status": {"const": "DRAFT_UNREVIEWED"},
        "edge_flow_proven": {"const": false},
        "artist_review_status": {"const": "NOT_RUN"},
        "canonical_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
