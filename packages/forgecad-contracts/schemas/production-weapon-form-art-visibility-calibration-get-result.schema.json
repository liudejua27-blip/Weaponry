{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/production-weapon-form-art-visibility-calibration-get-result.schema.json",
  "title": "ProductionWeaponFormArtVisibilityCalibrationGetResult@1",
  "description": "Transient exact-camera before/after triangle-owner, depth-winner and negative-space calibration. It may authorize only a subsequent typed repair plan, never geometry mutation or production-stage promotion.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "operation", "calibration_id", "failure_diagnostic_id",
    "failure_diagnostic_canonical_sha256", "composite_evidence_id", "proposal_id",
    "session_id", "project_id", "current_base_candidate_id", "current_base_candidate_state_sha256",
    "proposal_candidate_id", "proposal_candidate_state_sha256", "current_base_artifact_sha256",
    "proposal_artifact_sha256", "current_base_form_art_evidence_receipt_object_sha256",
    "proposal_form_art_evidence_receipt_object_sha256", "camera_rig_object_sha256",
    "camera_rig_canonical_sha256", "views", "side_aperture_occluders_calibrated",
    "single_common_side_aperture_occluder", "calibrated_side_aperture_sources",
    "repair_plan_authorized", "geometry_repair_authorized",
    "next_atomic_action", "diagnostic_status", "quality_status", "form_quality_v2_status",
    "candidate_confirm_allowed", "secondary_form_approved", "production_stage_advanced",
    "candidate_confirmed", "version_created", "export_performed", "runtime_write_performed",
    "persistent_user_data_touched", "worker_started", "calibration_policy", "canonical_sha256"
  ],
  "properties": {
    "schema_version": {"const": "ProductionWeaponFormArtVisibilityCalibrationGetResult@1"},
    "operation": {"const": "forgecad.production.weapon.form-art-visibility-calibration-get@1"},
    "calibration_id": {"$ref": "#/$defs/id"},
    "failure_diagnostic_id": {"$ref": "#/$defs/id"},
    "failure_diagnostic_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "composite_evidence_id": {"$ref": "#/$defs/id"},
    "proposal_id": {"$ref": "#/$defs/id"},
    "session_id": {"$ref": "#/$defs/id"},
    "project_id": {"$ref": "#/$defs/id"},
    "current_base_candidate_id": {"$ref": "#/$defs/id"},
    "current_base_candidate_state_sha256": {"$ref": "#/$defs/sha256"},
    "proposal_candidate_id": {"$ref": "#/$defs/id"},
    "proposal_candidate_state_sha256": {"$ref": "#/$defs/sha256"},
    "current_base_artifact_sha256": {"$ref": "#/$defs/sha256"},
    "proposal_artifact_sha256": {"$ref": "#/$defs/sha256"},
    "current_base_form_art_evidence_receipt_object_sha256": {"$ref": "#/$defs/sha256"},
    "proposal_form_art_evidence_receipt_object_sha256": {"$ref": "#/$defs/sha256"},
    "camera_rig_object_sha256": {"$ref": "#/$defs/sha256"},
    "camera_rig_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "views": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/view"}},
    "side_aperture_occluders_calibrated": {"type": "boolean"},
    "single_common_side_aperture_occluder": {"type": "boolean"},
    "calibrated_side_aperture_sources": {"type": "array", "maxItems": 2, "items": {"$ref": "#/$defs/view_source_identity"}},
    "repair_plan_authorized": {"type": "boolean"},
    "geometry_repair_authorized": {"const": false},
    "next_atomic_action": {"enum": ["AUTHOR_HASH_BOUND_TYPED_TWO_VIEW_SIDE_APERTURE_REPAIR_PLAN_FOR_CALIBRATED_OCCLUDERS", "BLOCK_NEW_GEOMETRY_PROFILE_UNTIL_SIDE_APERTURE_OCCLUDER_IS_UNAMBIGUOUS"]},
    "diagnostic_status": {"enum": ["TWO_VIEW_SIDE_APERTURE_OCCLUDERS_CALIBRATED_REPAIR_PLAN_ONLY", "VISIBILITY_CALIBRATION_COMPLETE_OCCLUDER_REMAINS_AMBIGUOUS"]},
    "quality_status": {"const": "QUALITY_TARGET_NOT_MET"},
    "form_quality_v2_status": {"const": "NOT_CREATED"},
    "candidate_confirm_allowed": {"const": false},
    "secondary_form_approved": {"const": "NOT_CREATED"},
    "production_stage_advanced": {"const": false},
    "candidate_confirmed": {"const": false},
    "version_created": {"const": false},
    "export_performed": {"const": false},
    "runtime_write_performed": {"const": false},
    "persistent_user_data_touched": {"const": false},
    "worker_started": {"const": true},
    "calibration_policy": {"const": "exact-before-after-triangle-owner-depth-and-side-aperture-calibration@1"},
    "canonical_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "transform": {"enum": ["identity", "horizontal-flip", "vertical-flip", "both-flip"]},
    "source_identity": {
      "type": "object", "additionalProperties": false,
      "required": ["semantic_part_id", "source_node_id"],
      "properties": {"semantic_part_id": {"$ref": "#/$defs/id"}, "source_node_id": {"$ref": "#/$defs/id"}}
    },
    "view_source_identity": {
      "type": "object", "additionalProperties": false,
      "required": ["view_kind", "semantic_part_id", "source_node_id"],
      "properties": {
        "view_kind": {"enum": ["left", "right"]},
        "semantic_part_id": {"$ref": "#/$defs/id"},
        "source_node_id": {"$ref": "#/$defs/id"}
      }
    },
    "source_count": {
      "type": "object", "additionalProperties": false,
      "required": ["semantic_part_id", "source_node_id", "pixel_count"],
      "properties": {
        "semantic_part_id": {"$ref": "#/$defs/id"}, "source_node_id": {"$ref": "#/$defs/id"},
        "pixel_count": {"type": "integer", "minimum": 1, "maximum": 262144}
      }
    },
    "structure": {
      "type": "object", "additionalProperties": false,
      "required": [
        "structure_id", "evidence_status", "sealed", "missing", "ranked_transform",
        "reviewed_region_canonical_sha256", "reference_region_mask_sha256",
        "reference_expected_void_mask_sha256", "ranked_region_mask_sha256",
        "ranked_expected_void_mask_sha256", "ranked_expected_void_pixel_count",
        "baseline_visible_source_pixel_count", "proposal_visible_source_pixel_count",
        "reference_baseline_visible_source_pixel_count", "reference_proposal_visible_source_pixel_count",
        "winner_changed_pixel_count", "depth_changed_pixel_count", "part_id_changed_pixel_count",
        "silhouette_changed_pixel_count", "baseline_sources", "proposal_sources",
        "reference_baseline_sources", "reference_proposal_sources",
        "highest_proposal_source", "unique_highest_proposal_source", "classification"
      ],
      "properties": {
        "structure_id": {"$ref": "#/$defs/id"},
        "evidence_status": {"enum": ["observed", "inferred", "unknown", "missing"]},
        "sealed": {"type": "boolean"}, "missing": {"type": "boolean"},
        "ranked_transform": {"$ref": "#/$defs/transform"},
        "reviewed_region_canonical_sha256": {"$ref": "#/$defs/sha256"},
        "reference_region_mask_sha256": {"$ref": "#/$defs/sha256"},
        "reference_expected_void_mask_sha256": {"$ref": "#/$defs/sha256"},
        "ranked_region_mask_sha256": {"$ref": "#/$defs/sha256"},
        "ranked_expected_void_mask_sha256": {"$ref": "#/$defs/sha256"},
        "ranked_expected_void_pixel_count": {"type": "integer", "minimum": 1, "maximum": 262144},
        "baseline_visible_source_pixel_count": {"type": "integer", "minimum": 0, "maximum": 262144},
        "proposal_visible_source_pixel_count": {"type": "integer", "minimum": 0, "maximum": 262144},
        "reference_baseline_visible_source_pixel_count": {"type": "integer", "minimum": 0, "maximum": 262144},
        "reference_proposal_visible_source_pixel_count": {"type": "integer", "minimum": 0, "maximum": 262144},
        "winner_changed_pixel_count": {"type": "integer", "minimum": 0, "maximum": 262144},
        "depth_changed_pixel_count": {"type": "integer", "minimum": 0, "maximum": 262144},
        "part_id_changed_pixel_count": {"type": "integer", "minimum": 0, "maximum": 262144},
        "silhouette_changed_pixel_count": {"type": "integer", "minimum": 0, "maximum": 262144},
        "baseline_sources": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/source_count"}},
        "proposal_sources": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/source_count"}},
        "reference_baseline_sources": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/source_count"}},
        "reference_proposal_sources": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/source_count"}},
        "highest_proposal_source": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/source_count"}]},
        "unique_highest_proposal_source": {"type": "boolean"},
        "classification": {"enum": ["SEALED_BY_UNIQUE_VISIBLE_SOURCE", "SEALED_WITHOUT_VISIBLE_SOURCE_AT_RANKED_EXPECTED_VOID", "SEALED_BY_AMBIGUOUS_VISIBLE_SOURCES", "OPEN_EXPECTED_VOID_BACKGROUND", "OPEN_EVIDENCE_WITH_VISIBLE_SOURCE_OVERLAP"]}
      }
    },
    "view": {
      "type": "object", "additionalProperties": false,
      "required": [
        "view_kind", "view_id", "camera_hash", "camera_canonical_sha256", "ranked_transform",
        "baseline_triangle_ids_sha256", "baseline_source_table_sha256",
        "proposal_triangle_ids_sha256", "proposal_source_table_sha256",
        "winner_changed_pixel_count", "depth_changed_pixel_count", "part_id_changed_pixel_count",
        "silhouette_changed_pixel_count", "structures"
      ],
      "properties": {
        "view_kind": {"enum": ["left", "right", "rear-three-quarter"]},
        "view_id": {"$ref": "#/$defs/id"}, "camera_hash": {"$ref": "#/$defs/sha256"},
        "camera_canonical_sha256": {"$ref": "#/$defs/sha256"}, "ranked_transform": {"$ref": "#/$defs/transform"},
        "baseline_triangle_ids_sha256": {"$ref": "#/$defs/sha256"}, "baseline_source_table_sha256": {"$ref": "#/$defs/sha256"},
        "proposal_triangle_ids_sha256": {"$ref": "#/$defs/sha256"}, "proposal_source_table_sha256": {"$ref": "#/$defs/sha256"},
        "winner_changed_pixel_count": {"type": "integer", "minimum": 0, "maximum": 262144},
        "depth_changed_pixel_count": {"type": "integer", "minimum": 0, "maximum": 262144},
        "part_id_changed_pixel_count": {"type": "integer", "minimum": 0, "maximum": 262144},
        "silhouette_changed_pixel_count": {"type": "integer", "minimum": 0, "maximum": 262144},
        "structures": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/structure"}}
      }
    }
  }
}
