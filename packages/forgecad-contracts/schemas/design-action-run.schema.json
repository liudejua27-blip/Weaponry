{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/design-action-run.schema.json",
  "title": "DesignActionRun",
  "description": "Runtime-owned receipt for one bounded design action and its prepare, compile, readback, render, and evaluate stages.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "session_id",
    "project_id",
    "candidate_id",
    "reference_id",
    "reference_sha256",
    "camera_hash",
    "input_sha256",
    "observation_sha256",
    "action",
    "requested_stage",
    "status",
    "completed_stage",
    "stage_results",
    "quality_status",
    "failed_gates",
    "allowed_actions",
    "locked_actions",
    "checkpoint_id",
    "checkpoint_hash",
    "runtime_write",
    "persistent_user_data_touched",
    "canonical_sha256"
  ],
  "properties": {
    "schema_version": {"const": "DesignActionRun@1"},
    "run_id": {"$ref": "#/$defs/identifier"},
    "session_id": {"$ref": "#/$defs/identifier"},
    "project_id": {"$ref": "#/$defs/identifier"},
    "candidate_id": {"$ref": "#/$defs/identifier"},
    "reference_id": {"$ref": "#/$defs/identifier"},
    "reference_sha256": {"$ref": "#/$defs/sha256"},
    "camera_hash": {"$ref": "#/$defs/sha256"},
    "input_sha256": {"$ref": "#/$defs/sha256"},
    "observation_sha256": {"$ref": "#/$defs/sha256"},
    "action": {"$ref": "#/$defs/action"},
    "requested_stage": {"$ref": "#/$defs/stage"},
    "status": {"$ref": "#/$defs/run_status"},
    "completed_stage": {"$ref": "#/$defs/nullable_pipeline_stage"},
    "stage_results": {"$ref": "#/$defs/stage_results"},
    "quality_status": {"$ref": "#/$defs/quality_status"},
    "failed_gates": {
      "type": "array",
      "maxItems": 24,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/gate_id"}
    },
    "allowed_actions": {
      "type": "array",
      "maxItems": 24,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/action_capability"}
    },
    "locked_actions": {
      "type": "array",
      "minItems": 2,
      "maxItems": 24,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/action_capability"}
    },
    "checkpoint_id": {"$ref": "#/$defs/nullable_identifier"},
    "checkpoint_hash": {"$ref": "#/$defs/nullable_sha256"},
    "optimization_job_id": {"$ref": "#/$defs/nullable_identifier"},
    "optimization_intent_sha256": {"$ref": "#/$defs/nullable_sha256"},
    "proposal": {"$ref": "#/$defs/nullable_proposal"},
    "runtime_write": {"const": false},
    "persistent_user_data_touched": {"const": false},
    "canonical_sha256": {"$ref": "#/$defs/sha256"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"checkpoint_id": {"const": null}},
        "required": ["checkpoint_id"]
      },
      "then": {"properties": {"checkpoint_hash": {"const": null}}},
      "else": {"properties": {"checkpoint_hash": {"$ref": "#/$defs/sha256"}}}
    },
    {
      "if": {
        "properties": {"status": {"const": "prepared"}},
        "required": ["status"]
      },
      "then": {
        "properties": {
          "quality_status": {"const": "not-run"},
          "failed_gates": {"maxItems": 0}
        }
      }
    },
    {
      "if": {
        "properties": {"status": {"const": "running"}},
        "required": ["status"]
      },
      "then": {
        "properties": {
          "quality_status": {"enum": ["not-run", "unknown"]},
          "failed_gates": {"maxItems": 0}
        }
      }
    },
    {
      "if": {
        "properties": {"status": {"const": "completed"}},
        "required": ["status"]
      },
      "then": {
        "properties": {
          "quality_status": {
            "enum": [
              "PARTIAL_VISIBLE_VIEW_PASS",
              "QUALITY_TARGET_NOT_MET",
              "BLOCKED_REFERENCE_COVERAGE",
              "unknown"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {"status": {"enum": ["failed", "blocked"]}},
        "required": ["status"]
      },
      "then": {"properties": {"failed_gates": {"minItems": 1}}}
    },
    {
      "if": {
        "properties": {
          "quality_status": {
            "enum": ["QUALITY_TARGET_NOT_MET", "BLOCKED_REFERENCE_COVERAGE"]
          }
        },
        "required": ["quality_status"]
      },
      "then": {"properties": {"failed_gates": {"minItems": 1}}}
    },
    {
      "properties": {
        "locked_actions": {"contains": {"const": "confirm"}}
      }
    },
    {
      "properties": {
        "locked_actions": {"contains": {"const": "export"}}
      }
    },
    {
      "not": {
        "properties": {
          "allowed_actions": {"contains": {"const": "confirm"}}
        }
      }
    },
    {
      "not": {
        "properties": {
          "allowed_actions": {"contains": {"const": "export"}}
        }
      }
    },
    {
      "oneOf": [
        {
          "properties": {
            "status": {"const": "prepared"},
            "completed_stage": {"const": "prepare"},
            "stage_results": {
              "properties": {
                "prepare": {"properties": {"status": {"const": "completed"}}},
                "compile": {"properties": {"status": {"const": "not-run"}}},
                "readback": {"properties": {"status": {"const": "not-run"}}},
                "render": {"properties": {"status": {"const": "not-run"}}},
                "evaluate": {"properties": {"status": {"const": "not-run"}}}
              }
            }
          }
        },
        {
          "properties": {
            "status": {"const": "running"},
            "completed_stage": {"const": null},
            "stage_results": {
              "properties": {
                "prepare": {"properties": {"status": {"const": "running"}}},
                "compile": {"properties": {"status": {"const": "not-run"}}},
                "readback": {"properties": {"status": {"const": "not-run"}}},
                "render": {"properties": {"status": {"const": "not-run"}}},
                "evaluate": {"properties": {"status": {"const": "not-run"}}}
              }
            }
          }
        },
        {
          "properties": {
            "status": {"const": "running"},
            "completed_stage": {"const": "prepare"},
            "stage_results": {
              "properties": {
                "prepare": {"properties": {"status": {"const": "completed"}}},
                "compile": {"properties": {"status": {"const": "running"}}},
                "readback": {"properties": {"status": {"const": "not-run"}}},
                "render": {"properties": {"status": {"const": "not-run"}}},
                "evaluate": {"properties": {"status": {"const": "not-run"}}}
              }
            }
          }
        },
        {
          "properties": {
            "status": {"const": "running"},
            "completed_stage": {"const": "compile"},
            "stage_results": {
              "properties": {
                "prepare": {"properties": {"status": {"const": "completed"}}},
                "compile": {"properties": {"status": {"const": "completed"}}},
                "readback": {"properties": {"status": {"const": "running"}}},
                "render": {"properties": {"status": {"const": "not-run"}}},
                "evaluate": {"properties": {"status": {"const": "not-run"}}}
              }
            }
          }
        },
        {
          "properties": {
            "status": {"const": "running"},
            "completed_stage": {"const": "readback"},
            "stage_results": {
              "properties": {
                "prepare": {"properties": {"status": {"const": "completed"}}},
                "compile": {"properties": {"status": {"const": "completed"}}},
                "readback": {"properties": {"status": {"const": "completed"}}},
                "render": {"properties": {"status": {"const": "running"}}},
                "evaluate": {"properties": {"status": {"const": "not-run"}}}
              }
            }
          }
        },
        {
          "properties": {
            "status": {"const": "running"},
            "completed_stage": {"const": "render"},
            "stage_results": {
              "properties": {
                "prepare": {"properties": {"status": {"const": "completed"}}},
                "compile": {"properties": {"status": {"const": "completed"}}},
                "readback": {"properties": {"status": {"const": "completed"}}},
                "render": {"properties": {"status": {"const": "completed"}}},
                "evaluate": {"properties": {"status": {"const": "running"}}}
              }
            }
          }
        },
        {
          "properties": {
            "status": {"const": "completed"},
            "completed_stage": {"const": "evaluate"},
            "stage_results": {
              "properties": {
                "prepare": {"properties": {"status": {"const": "completed"}}},
                "compile": {"properties": {"status": {"const": "completed"}}},
                "readback": {"properties": {"status": {"const": "completed"}}},
                "render": {"properties": {"status": {"const": "completed"}}},
                "evaluate": {"properties": {"status": {"const": "completed"}}}
              }
            }
          }
        },
        {
          "properties": {
            "status": {"const": "failed"},
            "completed_stage": {"const": null},
            "stage_results": {
              "properties": {
                "prepare": {"properties": {"status": {"const": "failed"}}},
                "compile": {"properties": {"status": {"const": "not-run"}}},
                "readback": {"properties": {"status": {"const": "not-run"}}},
                "render": {"properties": {"status": {"const": "not-run"}}},
                "evaluate": {"properties": {"status": {"const": "not-run"}}}
              }
            }
          }
        },
        {
          "properties": {
            "status": {"const": "failed"},
            "completed_stage": {"const": "prepare"},
            "stage_results": {
              "properties": {
                "prepare": {"properties": {"status": {"const": "completed"}}},
                "compile": {"properties": {"status": {"const": "failed"}}},
                "readback": {"properties": {"status": {"const": "not-run"}}},
                "render": {"properties": {"status": {"const": "not-run"}}},
                "evaluate": {"properties": {"status": {"const": "not-run"}}}
              }
            }
          }
        },
        {
          "properties": {
            "status": {"const": "failed"},
            "completed_stage": {"const": "compile"},
            "stage_results": {
              "properties": {
                "prepare": {"properties": {"status": {"const": "completed"}}},
                "compile": {"properties": {"status": {"const": "completed"}}},
                "readback": {"properties": {"status": {"const": "failed"}}},
                "render": {"properties": {"status": {"const": "not-run"}}},
                "evaluate": {"properties": {"status": {"const": "not-run"}}}
              }
            }
          }
        },
        {
          "properties": {
            "status": {"const": "failed"},
            "completed_stage": {"const": "readback"},
            "stage_results": {
              "properties": {
                "prepare": {"properties": {"status": {"const": "completed"}}},
                "compile": {"properties": {"status": {"const": "completed"}}},
                "readback": {"properties": {"status": {"const": "completed"}}},
                "render": {"properties": {"status": {"const": "failed"}}},
                "evaluate": {"properties": {"status": {"const": "not-run"}}}
              }
            }
          }
        },
        {
          "properties": {
            "status": {"const": "failed"},
            "completed_stage": {"const": "render"},
            "stage_results": {
              "properties": {
                "prepare": {"properties": {"status": {"const": "completed"}}},
                "compile": {"properties": {"status": {"const": "completed"}}},
                "readback": {"properties": {"status": {"const": "completed"}}},
                "render": {"properties": {"status": {"const": "completed"}}},
                "evaluate": {"properties": {"status": {"const": "failed"}}}
              }
            }
          }
        },
        {
          "properties": {
            "status": {"const": "blocked"},
            "completed_stage": {"const": null},
            "stage_results": {
              "properties": {
                "prepare": {"properties": {"status": {"const": "blocked"}}},
                "compile": {"properties": {"status": {"enum": ["not-run", "skipped"]}}},
                "readback": {"properties": {"status": {"enum": ["not-run", "skipped"]}}},
                "render": {"properties": {"status": {"enum": ["not-run", "skipped"]}}},
                "evaluate": {"properties": {"status": {"enum": ["not-run", "skipped"]}}}
              }
            }
          }
        },
        {
          "properties": {
            "status": {"const": "blocked"},
            "completed_stage": {"const": "prepare"},
            "stage_results": {
              "properties": {
                "prepare": {"properties": {"status": {"const": "completed"}}},
                "compile": {"properties": {"status": {"const": "blocked"}}},
                "readback": {"properties": {"status": {"enum": ["not-run", "skipped"]}}},
                "render": {"properties": {"status": {"enum": ["not-run", "skipped"]}}},
                "evaluate": {"properties": {"status": {"enum": ["not-run", "skipped"]}}}
              }
            }
          }
        },
        {
          "properties": {
            "status": {"const": "blocked"},
            "completed_stage": {"const": "compile"},
            "stage_results": {
              "properties": {
                "prepare": {"properties": {"status": {"const": "completed"}}},
                "compile": {"properties": {"status": {"const": "completed"}}},
                "readback": {"properties": {"status": {"const": "blocked"}}},
                "render": {"properties": {"status": {"enum": ["not-run", "skipped"]}}},
                "evaluate": {"properties": {"status": {"enum": ["not-run", "skipped"]}}}
              }
            }
          }
        },
        {
          "properties": {
            "status": {"const": "blocked"},
            "completed_stage": {"const": "readback"},
            "stage_results": {
              "properties": {
                "prepare": {"properties": {"status": {"const": "completed"}}},
                "compile": {"properties": {"status": {"const": "completed"}}},
                "readback": {"properties": {"status": {"const": "completed"}}},
                "render": {"properties": {"status": {"const": "blocked"}}},
                "evaluate": {"properties": {"status": {"enum": ["not-run", "skipped"]}}}
              }
            }
          }
        },
        {
          "properties": {
            "status": {"const": "blocked"},
            "completed_stage": {"const": "render"},
            "stage_results": {
              "properties": {
                "prepare": {"properties": {"status": {"const": "completed"}}},
                "compile": {"properties": {"status": {"const": "completed"}}},
                "readback": {"properties": {"status": {"const": "completed"}}},
                "render": {"properties": {"status": {"const": "completed"}}},
                "evaluate": {"properties": {"status": {"const": "blocked"}}}
              }
            }
          }
        }
      ]
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "nullable_identifier": {
      "type": ["string", "null"],
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nullable_sha256": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "safe_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "not": {
        "anyOf": [
          {"pattern": "^[/\\\\]"},
          {"pattern": "^[A-Za-z]:[/\\\\]"},
          {"pattern": "^(file|data|https?|ftp|ssh|git)://"},
          {"pattern": "(^|[/\\\\])\\.\\.([/\\\\]|$)"},
          {"pattern": "\\b[Pp][Aa][Tt][Hh]\\b"},
          {"pattern": "\\b[Uu][Rr][Ll]\\b"},
          {"pattern": "\\b[Pp][Rr][Oo][Mm][Pp][Tt]\\b"},
          {"pattern": "\\b[Ss][Ee][Cc][Rr][Ee][Tt]\\b"},
          {"pattern": "\\b[Ss][Cc][Rr][Ii][Pp][Tt]\\b"},
          {"pattern": "\\b[Pp][Yy][Tt][Hh][Oo][Nn]\\b"},
          {"pattern": "\\b[Jj][Aa][Vv][Aa][Ss][Cc][Rr][Ii][Pp][Tt]\\b"},
          {"pattern": "\\b[Ee][Xx][Ee][Cc]\\b"},
          {"pattern": "\\b[Ee][Vv][Aa][Ll]\\b"},
          {"pattern": "\\b[Bb][Aa][Ss][Hh]\\b"},
          {"pattern": "\\b[Ss][Hh][Ee][Ll][Ll]\\b"},
          {"pattern": "\\b[Zz][Ss][Hh]\\b"},
          {"pattern": "\\b[Pp][Oo][Ww][Ee][Rr][Ss][Hh][Ee][Ll][Ll]\\b"},
          {"pattern": "[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]\\s*[:=]"},
          {"pattern": "[Aa][Pp][Ii][-_]?[Kk][Ee][Yy]\\s*[:=]"},
          {"pattern": "[Ss][Ee][Cc][Rr][Ee][Tt]\\s*[:=]"},
          {"pattern": "[Bb][Ee][Aa][Rr][Ee][Rr]\\s+"},
          {"pattern": "[Tt][Oo][Kk][Ee][Nn]\\s*[:=]"},
          {"pattern": "[Aa][Uu][Tt][Hh][Oo][Rr][Ii][Zz][Aa][Tt][Ii][Oo][Nn]\\s*[:=]"},
          {"pattern": "[Pp][Rr][Ii][Vv][Aa][Tt][Ee]\\s+[Kk][Ee][Yy]"}
        ]
      }
    },
    "stage": {
      "enum": [
        "reference-canvas",
        "primary-form",
        "secondary-structure",
        "tertiary-detail",
        "uv-pbr",
        "final-review"
      ]
    },
    "pipeline_stage": {
      "enum": ["prepare", "compile", "readback", "render", "evaluate"]
    },
    "nullable_pipeline_stage": {
      "enum": [null, "prepare", "compile", "readback", "render", "evaluate"]
    },
    "run_status": {
      "enum": ["prepared", "running", "completed", "failed", "blocked"]
    },
    "stage_status": {
      "enum": ["not-run", "running", "completed", "failed", "blocked", "skipped"]
    },
    "quality_status": {
      "enum": [
        "PARTIAL_VISIBLE_VIEW_PASS",
        "QUALITY_TARGET_NOT_MET",
        "BLOCKED_REFERENCE_COVERAGE",
        "not-run",
        "unknown"
      ]
    },
    "gate_id": {
      "enum": [
        "reference-authorized",
        "reference-coverage",
        "primary-silhouette",
        "primary-proportion",
        "secondary-structure",
        "tertiary-detail",
        "visible-view",
        "uv-tangent-pbr",
        "multi-view-compare",
        "codex-typed-review",
        "human-review",
        "export-restart-hash",
        "360-reference-coverage",
        "input-binding",
        "stage-precondition",
        "budget",
        "prepare",
        "compile",
        "readback",
        "render",
        "evaluate"
      ]
    },
    "action_kind": {
      "enum": [
        "reference-import",
        "coverage-annotation",
        "mark-unknown",
        "primary-blockout",
        "primary-form-adjustment",
        "secondary-structure",
        "tertiary-detail",
        "material-zone",
        "uv-pbr",
        "final-review",
        "request-reference",
        "bounded-repair",
        "checkpoint",
        "rollback",
        "human-review",
        "next-stage"
      ]
    },
    "action_capability": {
      "enum": [
        "reference-import",
        "coverage-annotation",
        "mark-unknown",
        "primary-blockout",
        "primary-form-adjustment",
        "secondary-structure",
        "tertiary-detail",
        "material-zone",
        "uv-pbr",
        "final-review",
        "request-reference",
        "bounded-repair",
        "checkpoint",
        "rollback",
        "human-review",
        "next-stage",
        "retry",
        "inspect",
        "confirm",
        "export"
      ]
    },
    "operator_id": {
      "type": ["string", "null"],
      "enum": [
        null,
        "forgecad.geometry.primitive@2",
        "forgecad.geometry.profile-extrude@1",
        "forgecad.geometry.profile-loft@1",
        "forgecad.geometry.profile-loft@2",
        "forgecad.geometry.longitudinal-section-loft@1",
        "forgecad.geometry.subd-cage@1",
        "forgecad.geometry.subd-cage@2", "forgecad.geometry.authoring-mesh@1",
        "forgecad.geometry.surface-patch@1",
        "forgecad.geometry.surface-shell@1",
        "forgecad.geometry.revolve@1",
        "forgecad.geometry.tube-sweep@1",
        "forgecad.geometry.transform@2",
        "forgecad.geometry.mirror@1",
        "forgecad.geometry.array@1",
        "forgecad.geometry.bevel@1",
        "forgecad.geometry.normal-policy@1",
        "forgecad.geometry.panel@1",
        "forgecad.geometry.vent-array@1",
        "forgecad.geometry.vent-array@2",
        "forgecad.geometry.recessed-channel@1",
        "forgecad.geometry.energy-core@1",
        "forgecad.geometry.joint-stack@1",
        "forgecad.geometry.boolean@1",
        "forgecad.geometry.part-output@1"
      ]
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_id",
        "action_kind",
        "scope_kind",
        "target_id",
        "operator_id",
        "parameter_changes",
        "bounded"
      ],
      "properties": {
        "action_id": {"$ref": "#/$defs/identifier"},
        "action_kind": {"$ref": "#/$defs/action_kind"},
        "scope_kind": {"enum": ["session", "part", "material-zone", "reference"]},
        "target_id": {"$ref": "#/$defs/nullable_identifier"},
        "operator_id": {"$ref": "#/$defs/operator_id"},
        "parameter_changes": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/parameter_change"}
        },
        "bounded": {"const": true},
        "description": {"$ref": "#/$defs/safe_text"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"scope_kind": {"const": "session"}},
            "required": ["scope_kind"]
          },
          "then": {"properties": {"target_id": {"const": null}}}
        },
        {
          "if": {
            "properties": {"scope_kind": {"enum": ["part", "material-zone", "reference"]}},
            "required": ["scope_kind"]
          },
          "then": {"properties": {"target_id": {"$ref": "#/$defs/identifier"}}}
        },
        {
          "if": {
            "properties": {"action_kind": {"const": "request-reference"}},
            "required": ["action_kind"]
          },
          "then": {"properties": {"scope_kind": {"const": "reference"}}}
        }
      ]
    },
    "parameter_change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parameter_id", "before", "after", "minimum", "maximum", "unit"],
      "properties": {
        "parameter_id": {"$ref": "#/$defs/identifier"},
        "before": {"type": "number", "minimum": -1000, "maximum": 1000},
        "after": {"type": "number", "minimum": -1000, "maximum": 1000},
        "minimum": {"type": "number", "minimum": -1000, "maximum": 1000},
        "maximum": {"type": "number", "minimum": -1000, "maximum": 1000},
        "unit": {"enum": ["meter", "radian", "ratio", "count"]}
      }
    },
    "stage_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {"$ref": "#/$defs/stage_status"},
        "result_sha256": {"$ref": "#/$defs/sha256"},
        "output_sha256": {"$ref": "#/$defs/sha256"},
        "summary_sha256": {"$ref": "#/$defs/sha256"},
        "error_code": {"$ref": "#/$defs/identifier"},
        "checkpoint_id": {"$ref": "#/$defs/identifier"},
        "checkpoint_sha256": {"$ref": "#/$defs/sha256"},
        "canonical_sha256": {"$ref": "#/$defs/sha256"},
        "completed_at": {"type": "string", "minLength": 1, "maxLength": 64}
      },
      "allOf": [
        {
          "if": {
            "properties": {"checkpoint_id": {"type": "string"}},
            "required": ["checkpoint_id"]
          },
          "then": {
            "required": ["checkpoint_sha256"],
            "properties": {"checkpoint_sha256": {"$ref": "#/$defs/sha256"}}
          },
          "else": {"properties": {"checkpoint_sha256": {"const": null}}}
        }
      ]
    },
    "stage_results": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prepare", "compile", "readback", "render", "evaluate"],
      "properties": {
        "prepare": {"$ref": "#/$defs/stage_result"},
        "compile": {"$ref": "#/$defs/stage_result"},
