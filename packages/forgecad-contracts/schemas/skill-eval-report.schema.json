{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://forgecad.local/contracts/skill-eval-report.schema.json",
  "title":"SkillEvalReport",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","report_id","skill_id","skill_version","suite_id","status","metrics","evidence_sha256","created_at"],
  "properties":{"schema_version":{"const":"SkillEvalReport@1"},"report_id":{"type":"string","pattern":"^[A-Za-z0-9_.-]{1,128}$"},"skill_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{0,63}$"},"skill_version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},"suite_id":{"type":"string","pattern":"^[A-Za-z0-9_.-]{1,128}$"},"status":{"enum":["passed","failed","not-run"]},"metrics":{"type":"object"},"evidence_sha256":{"type":["string","null"],"pattern":"^[0-9a-f]{64}$"},"created_at":{"type":"string","maxLength":64}}
}
