{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/subdivision-topology-lineage-request.schema.json",
  "title": "SubdivisionTopologyLineageRequest",
  "description": "A closed read-only request for a fixed Geometry Worker projection of control-root ancestry into one exact subd-cage@2 evaluated quad topology. It does not request a candidate, artifact, GLB or persistent authoring IDs.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "geometry_program", "subdivision_node_id", "max_lineage_elements", "canonical_sha256"],
  "properties": {
    "schema_version": {"const": "SubdivisionTopologyLineageRequest@1"},
    "geometry_program": {"$ref": "https://forgecad.local/contracts/geometry-program-v2.schema.json"},
    "subdivision_node_id": {"$ref": "#/$defs/identifier"},
    "max_lineage_elements": {"type": "integer", "minimum": 1, "maximum": 25000},
    "canonical_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,128}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
