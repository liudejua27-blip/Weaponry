{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/game-asset-lod-derive-request.schema.json",
  "title": "GameAssetLodDeriveRequest@1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "source_candidate_id",
    "source_candidate_state_sha256",
    "source_artifact_sha256",
    "source_artifact_readback_sha256",
    "source_geometry_program_sha256",
    "source_operator_catalog_sha256",
    "source_readback_config_sha256",
    "derive_policy",
    "canonical_sha256"
  ],
  "properties": {
    "schema_version": {"const": "GameAssetLodDeriveRequest@1"},
    "project_id": {"$ref": "#/$defs/id"},
    "source_candidate_id": {"$ref": "#/$defs/id"},
    "source_candidate_state_sha256": {"$ref": "#/$defs/sha256"},
    "source_artifact_sha256": {"$ref": "#/$defs/sha256"},
    "source_artifact_readback_sha256": {"$ref": "#/$defs/sha256"},
    "source_geometry_program_sha256": {"$ref": "#/$defs/sha256"},
    "source_operator_catalog_sha256": {"$ref": "#/$defs/sha256"},
    "source_readback_config_sha256": {"$ref": "#/$defs/sha256"},
    "derive_policy": {"const": "runtime-owned-typed-segment-lowering-lod1-half-lod2-quarter@1"},
    "canonical_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
