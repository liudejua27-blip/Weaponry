    "attempt_candidate_id": {"$ref": "#/$defs/identifier"},
    "attempt_candidate_state_sha256": {"$ref": "#/$defs/sha256"},
    "attempt_artifact_sha256": {"$ref": "#/$defs/sha256"},
    "attempt_geometry_program_sha256": {"$ref": "#/$defs/sha256"},
    "attempt_geometry_program_object_sha256": {"$ref": "#/$defs/sha256"},
    "attempt_artifact_readback_object_sha256": {"$ref": "#/$defs/sha256"},
    "attempt_representation_plan_sha256": {"$ref": "#/$defs/sha256"},
    "authoring_mesh_id": {"$ref": "#/$defs/identifier"},
    "authoring_mesh_lineage_id": {"$ref": "#/$defs/identifier"},
    "authoring_mesh_revision_id": {"$ref": "#/$defs/identifier"},
    "authoring_mesh_revision_index": {"$ref": "#/$defs/revision_index"},
    "authoring_mesh_revision_sha256": {"$ref": "#/$defs/sha256"},
    "authoring_mesh_revision_object_sha256": {"$ref": "#/$defs/sha256"},
    "authoring_mesh_identity_sha256": {"$ref": "#/$defs/sha256"},
    "authoring_mesh_sha256": {"$ref": "#/$defs/sha256"},
    "fixed_view_id": {"$ref": "#/$defs/identifier"},
    "camera_set_sha256": {"$ref": "#/$defs/sha256"},
    "render_set_id": {"$ref": "#/$defs/identifier"},
    "render_set_sha256": {"$ref": "#/$defs/sha256"},
    "render_set_object_sha256": {"$ref": "#/$defs/sha256"},
    "reference_comparison_id": {"$ref": "#/$defs/identifier"},
    "reference_comparison_sha256": {"$ref": "#/$defs/sha256"},
    "reference_comparison_object_sha256": {"$ref": "#/$defs/sha256"},
    "quality_report_id": {"$ref": "#/$defs/identifier"},
    "quality_report_sha256": {"$ref": "#/$defs/sha256"},
    "quality_report_object_sha256": {"$ref": "#/$defs/sha256"},
    "evidence_bundle_sha256": {"$ref": "#/$defs/sha256"},
    "max_response_bytes": {"const": 1048576},
    "runtime_write_performed": {"const": false},
    "persistent_user_data_touched": {"const": false},
    "writer_policy": {"const": "forgecad-runtime-only-state-writer@1"},
    "canonicalization_policy": {"const": "canonical-json-sha256-excluding-input-sha256@1"},
    "input_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "revision_index": {"type": "integer", "minimum": 0, "maximum": 1000000},
    "safe_text": {"type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^[^\\u0000-\\u001f\\u007f]*$"}
  }
}
