{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://forgecad.local/contracts/representation-plan.schema.json",
  "title":"RepresentationPlan",
  "type":"object","additionalProperties":false,
  "required":["schema_version","project_id","reference_id","units","coordinate_system","target_views","budgets","canonical_sha256"],
  "properties":{
    "schema_version":{"const":"RepresentationPlan@1"},
    "project_id":{"type":"string","pattern":"^[A-Za-z0-9_.-]{1,128}$"},
    "reference_id":{"type":"string","pattern":"^[A-Za-z0-9_.-]{1,128}$"},
    "units":{"enum":["meter"]},
    "coordinate_system":{"enum":["right-handed-y-up"]},
    "target_views":{"type":"array","minItems":1,"maxItems":8,"items":{"enum":["front","three-quarter","side","back","top","detail"]}},
    "budgets":{"type":"object","additionalProperties":false,"required":["max_parts","max_nodes","max_triangles","max_runtime_ms"],"properties":{"max_parts":{"type":"integer","minimum":1,"maximum":64},"max_nodes":{"type":"integer","minimum":1,"maximum":512},"max_triangles":{"type":"integer","minimum":1,"maximum":1000000},"max_runtime_ms":{"type":"integer","minimum":1,"maximum":120000}}},
    "canonical_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}
  }
}
