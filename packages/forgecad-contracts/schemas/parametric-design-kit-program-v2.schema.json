{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/parametric-design-kit-program-v2.schema.json",
  "title": "ParametricDesignKitProgramV2",
  "description": "A Runtime-validated, non-persistent first-party geometry-group expansion. It remains structural-only and must pass geometry_prepare, strict readback, visual quality, approval, and confirm gates.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "template_id", "template_definition", "template_sha256", "template_catalog_sha256", "operator_catalog_sha256", "project_id", "representation_plan_sha256", "instance_id", "part_id", "material_zone_id", "solid", "parameters", "parameters_sha256", "instance_sha256", "program_sha256", "geometry_program", "evaluation_order", "source_map", "validator_status", "quality_status", "runtime_write_performed", "candidate_created", "limitations", "canonical_sha256"],
  "properties": {
    "schema_version": {"const": "ParametricDesignKitProgram@2"},
    "template_id": {"enum": ["forgecad.group.rounded-box@1", "forgecad.group.mirrored-box@1", "forgecad.group.arrayed-cylinder@1"]},
    "template_definition": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "template_id", "interface", "stages", "lowering_sha256", "nested_group_depth", "max_nodes", "execution", "canonical_sha256"],
      "properties": {
        "schema_version": {"const": "ForgeCADGeometryGroupTemplate@1"},
        "template_id": {"enum": ["forgecad.group.rounded-box@1", "forgecad.group.mirrored-box@1", "forgecad.group.arrayed-cylinder@1"]},
        "interface": {
          "type": "object", "additionalProperties": false, "required": ["field_mode", "inputs", "outputs"],
          "properties": {
            "field_mode": {"const": "single-value-only"},
            "inputs": {"type": "array", "minItems": 6, "maxItems": 8, "items": {"$ref": "#/$defs/interface_input"}},
            "outputs": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["socket_id", "socket_type"], "properties": {"socket_id": {"const": "geometry"}, "socket_type": {"const": "geometry"}}}}
          }
        },
        "stages": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/template_stage"}},
        "lowering_sha256": {"$ref": "#/$defs/sha256"},
        "nested_group_depth": {"const": 0}, "max_nodes": {"const": 3},
        "execution": {"const": "runtime-lowered-to-geometry-program-v2"}, "canonical_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "template_sha256": {"$ref": "#/$defs/sha256"}, "template_catalog_sha256": {"$ref": "#/$defs/sha256"}, "operator_catalog_sha256": {"$ref": "#/$defs/sha256"},
    "project_id": {"$ref": "#/$defs/identifier"}, "representation_plan_sha256": {"$ref": "#/$defs/sha256"}, "instance_id": {"$ref": "#/$defs/identifier"},
    "part_id": {"$ref": "#/$defs/identifier"}, "material_zone_id": {"$ref": "#/$defs/identifier"}, "solid": {"const": true},
    "parameters": {"oneOf": [
      {"$ref": "https://forgecad.local/contracts/parametric-design-kit-request-v2.schema.json#/$defs/rounded_box_parameters"},
      {"$ref": "https://forgecad.local/contracts/parametric-design-kit-request-v2.schema.json#/$defs/mirrored_box_parameters"},
      {"$ref": "https://forgecad.local/contracts/parametric-design-kit-request-v2.schema.json#/$defs/arrayed_cylinder_parameters"}
    ]},
    "parameters_sha256": {"$ref": "#/$defs/sha256"}, "instance_sha256": {"$ref": "#/$defs/sha256"}, "program_sha256": {"$ref": "#/$defs/sha256"},
    "geometry_program": {"$ref": "https://forgecad.local/contracts/geometry-program-v2.schema.json"},
    "evaluation_order": {"type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
    "source_map": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/source_map_entry"}},
    "validator_status": {"const": "passed"}, "quality_status": {"const": "structural_only"}, "runtime_write_performed": {"const": false}, "candidate_created": {"const": false},
    "limitations": {"type": "array", "minItems": 7, "maxItems": 7, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
    "canonical_sha256": {"$ref": "#/$defs/sha256"}
  },
  "allOf": [
    {"if": {"properties": {"template_id": {"const": "forgecad.group.rounded-box@1"}}}, "then": {"properties": {"parameters": {"$ref": "https://forgecad.local/contracts/parametric-design-kit-request-v2.schema.json#/$defs/rounded_box_parameters"}}}},
    {"if": {"properties": {"template_id": {"const": "forgecad.group.mirrored-box@1"}}}, "then": {"properties": {"parameters": {"$ref": "https://forgecad.local/contracts/parametric-design-kit-request-v2.schema.json#/$defs/mirrored_box_parameters"}}}},
    {"if": {"properties": {"template_id": {"const": "forgecad.group.arrayed-cylinder@1"}}}, "then": {"properties": {"parameters": {"$ref": "https://forgecad.local/contracts/parametric-design-kit-request-v2.schema.json#/$defs/arrayed_cylinder_parameters"}}}}
  ],
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "interface_input": {
      "type": "object", "additionalProperties": false,
      "required": ["socket_id", "direction", "socket_type", "cardinality", "unit", "field_mode"],
      "properties": {
        "socket_id": {"$ref": "#/$defs/identifier"}, "direction": {"const": "input"}, "socket_type": {"enum": ["scalar", "int", "vec3", "enum"]},
        "cardinality": {"const": "single"}, "unit": {"enum": ["meter", "radian", "ratio", "none"]}, "field_mode": {"const": "single-value"}
      }
    },
    "template_stage": {
      "type": "object", "additionalProperties": false, "required": ["stage_id", "operator_id", "inputs"],
      "properties": {"stage_id": {"$ref": "#/$defs/identifier"}, "operator_id": {"enum": ["forgecad.geometry.primitive@2", "forgecad.geometry.bevel@1", "forgecad.geometry.mirror@1", "forgecad.geometry.array@1", "forgecad.geometry.normal-policy@1"]}, "inputs": {"type": "array", "maxItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}}}
    },
    "source_map_entry": {
      "type": "object", "additionalProperties": false, "required": ["stage_id", "node_id", "operator_id", "input_node_ids", "parameter_ids"],
      "properties": {
        "stage_id": {"$ref": "#/$defs/identifier"}, "node_id": {"$ref": "#/$defs/identifier"},
        "operator_id": {"enum": ["forgecad.geometry.primitive@2", "forgecad.geometry.bevel@1", "forgecad.geometry.mirror@1", "forgecad.geometry.array@1", "forgecad.geometry.normal-policy@1"]},
        "input_node_ids": {"type": "array", "maxItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "parameter_ids": {"type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}}
      }
    }
  }
}
