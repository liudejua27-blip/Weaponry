{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/runtime-job.schema.json",
  "title": "ForgeCAD Job Summary",
  "type": "object",
  "required": ["job_id", "project_id", "kind", "status", "progress", "created_at", "updated_at"],
  "properties": {
    "job_id": {"type": "string"},
    "project_id": {"type": "string"},
    "kind": {"type": "string"},
    "status": {"type": "string"},
    "progress": {"type": "integer", "minimum": 0, "maximum": 100},
    "error_code": {"type": ["string", "null"]},
    "created_at": {"type": "string"},
    "updated_at": {"type": "string"}
  },
  "additionalProperties": false
}
