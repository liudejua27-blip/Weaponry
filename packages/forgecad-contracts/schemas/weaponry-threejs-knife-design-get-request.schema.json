{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/weaponry-threejs-knife-design-get-request.schema.json",
  "title": "WeaponryThreeJsKnifeDesignGetRequest@1",
  "description": "Closed exact readback for one immutable Three.js knife design.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "operation", "project_id", "design_id", "program_sha256",
    "program_object_sha256", "max_response_bytes", "runtime_write_performed",
    "persistent_user_data_touched", "writer_policy", "canonicalization_policy", "input_sha256"
  ],
  "properties": {
    "schema_version": {"const": "WeaponryThreeJsKnifeDesignGetRequest@1"},
    "operation": {"const": "weaponry_threejs_knife_design_get"},
    "project_id": {"$ref": "#/$defs/identifier"},
    "design_id": {"$ref": "#/$defs/identifier"},
    "program_sha256": {"$ref": "#/$defs/sha256"},
    "program_object_sha256": {"$ref": "#/$defs/sha256"},
    "max_response_bytes": {"const": 1048576},
    "runtime_write_performed": {"const": false},
    "persistent_user_data_touched": {"const": false},
    "writer_policy": {"const": "forgecad-runtime-only-state-writer@1"},
    "canonicalization_policy": {"const": "canonical-json-sha256-excluding-input-sha256@1"},
    "input_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
