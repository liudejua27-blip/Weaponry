{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/weaponry-threejs-knife-comparison-result.schema.json",
  "title": "WeaponryThreeJsKnifeComparisonResult@1",
  "description": "Closed deterministic measurement result for one packaged Three.js FRONT comparison. It reports a score only; visual, human, engine and commercial approval remain NOT_RUN.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "operation", "request_kind", "status", "comparison_id", "project_id",
    "preview_execution_id", "preview_design_id", "preview_program_sha256",
    "preview_program_object_sha256", "preview_worker_cohort_sha256", "preview_receipt_sha256",
    "preview_receipt_object_sha256", "preview_aov_sha256", "preview_aov_object_sha256",
    "reference_id", "reference_object_sha256", "reference_evidence_sha256", "view_id", "aov_id",
    "handedness_transform", "reference_crop", "semantic_part_ids", "editable_part_ids",
    "frozen_part_ids", "metric_policy", "normalization_policy", "metrics", "thresholds",
    "comparison_status", "quality_status", "visual_status", "parent_retained",
    "candidate_created", "version_created", "export_performed", "human_status", "engine_status",
    "commercial_status", "comparison_sha256", "comparison_object_sha256", "idempotency_key",
    "replayed", "store_effect", "cas_effect", "runtime_write_performed",
    "persistent_user_data_touched", "writer_policy", "canonicalization_policy", "canonical_sha256"
  ],
  "properties": {
    "schema_version": {"const": "WeaponryThreeJsKnifeComparisonResult@1"},
    "operation": {"enum": ["weaponry_threejs_knife_comparison_prepare", "weaponry_threejs_knife_comparison_get"]},
    "request_kind": {"enum": ["prepare", "get"]},
    "status": {"enum": ["stored", "replayed", "found"]},
    "comparison_id": {"$ref": "#/$defs/id"},
    "project_id": {"$ref": "#/$defs/id"},
    "preview_execution_id": {"$ref": "#/$defs/id"},
    "preview_design_id": {"$ref": "#/$defs/id"},
    "preview_program_sha256": {"$ref": "#/$defs/sha256"},
    "preview_program_object_sha256": {"$ref": "#/$defs/sha256"},
    "preview_worker_cohort_sha256": {"$ref": "#/$defs/sha256"},
    "preview_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "preview_receipt_object_sha256": {"$ref": "#/$defs/sha256"},
    "preview_aov_sha256": {"$ref": "#/$defs/sha256"},
    "preview_aov_object_sha256": {"$ref": "#/$defs/sha256"},
    "reference_id": {"$ref": "#/$defs/id"},
    "reference_object_sha256": {"$ref": "#/$defs/sha256"},
    "reference_evidence_sha256": {"$ref": "#/$defs/sha256"},
    "view_id": {"const": "FRONT"},
    "aov_id": {"const": "semantic-id"},
    "handedness_transform": {"const": "mirror-render-x-to-reference@1"},
    "reference_crop": {"$ref": "#/$defs/reference_crop"},
    "semantic_part_ids": {"$ref": "#/$defs/semantic_part_ids"},
    "editable_part_ids": {"const": ["blade-body", "cutting-edge"]},
    "frozen_part_ids": {"$ref": "#/$defs/frozen_part_ids"},
    "metric_policy": {"const": "fixed-front-semantic-id-blade-only-metrics@1"},
    "normalization_policy": {"const": "aspect-preserving-foreground-bbox-fit@1:512x512:8px-margin"},
    "metrics": {"$ref": "#/$defs/metrics"},
    "thresholds": {"$ref": "#/$defs/thresholds"},
    "comparison_status": {"const": "MEASURED_NOT_APPROVED"},
    "quality_status": {"const": "MEASURED_NOT_APPROVED"},
    "visual_status": {"const": "NOT_RUN"},
    "parent_retained": {"const": true},
    "candidate_created": {"const": false},
    "version_created": {"const": false},
    "export_performed": {"const": false},
    "human_status": {"const": "NOT_RUN"},
    "engine_status": {"const": "NOT_RUN"},
    "commercial_status": {"const": "NOT_RUN"},
    "comparison_sha256": {"$ref": "#/$defs/sha256"},
    "comparison_object_sha256": {"$ref": "#/$defs/sha256"},
    "idempotency_key": {"type": ["string", "null"], "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$"},
    "replayed": {"type": "boolean"},
    "store_effect": {"enum": ["inserted", "not-touched"]},
    "cas_effect": {"enum": ["inserted", "not-touched"]},
    "runtime_write_performed": {"type": "boolean"},
    "persistent_user_data_touched": {"type": "boolean"},
    "writer_policy": {"const": "forgecad-runtime-only-state-writer@1"},
    "canonicalization_policy": {"const": "canonical-json-sha256-excluding-canonical-sha256@1"},
    "canonical_sha256": {"$ref": "#/$defs/sha256"}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "stored"}}}, "then": {"properties": {"operation": {"const": "weaponry_threejs_knife_comparison_prepare"}, "request_kind": {"const": "prepare"}, "idempotency_key": {"type": "string"}, "replayed": {"const": false}, "store_effect": {"const": "inserted"}, "cas_effect": {"const": "inserted"}, "runtime_write_performed": {"const": true}, "persistent_user_data_touched": {"const": true}}}},
    {"if": {"properties": {"status": {"const": "replayed"}}}, "then": {"properties": {"operation": {"const": "weaponry_threejs_knife_comparison_prepare"}, "request_kind": {"const": "prepare"}, "idempotency_key": {"type": "string"}, "replayed": {"const": true}, "store_effect": {"const": "not-touched"}, "cas_effect": {"const": "not-touched"}, "runtime_write_performed": {"const": false}, "persistent_user_data_touched": {"const": false}}}},
    {"if": {"properties": {"status": {"const": "found"}}}, "then": {"properties": {"operation": {"const": "weaponry_threejs_knife_comparison_get"}, "request_kind": {"const": "get"}, "idempotency_key": {"type": "null"}, "replayed": {"const": false}, "store_effect": {"const": "not-touched"}, "cas_effect": {"const": "not-touched"}, "runtime_write_performed": {"const": false}, "persistent_user_data_touched": {"const": false}}}}
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reference_crop": {
      "type": "object", "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {"x": {"const": 10}, "y": {"const": 20}, "width": {"const": 650}, "height": {"const": 200}}
    },
    "semantic_part_ids": {
      "type": "object", "additionalProperties": false,
      "required": ["blade-body", "cutting-edge"],
      "properties": {"blade-body": {"const": 1}, "cutting-edge": {"const": 2}}
    },
    "frozen_part_ids": {
      "type": "array", "minItems": 11, "maxItems": 11,
      "prefixItems": [
        {"const": "fastener-grip-a"}, {"const": "fastener-grip-b"}, {"const": "fastener-grip-c"},
        {"const": "fastener-grip-d"}, {"const": "gem-guard-eye"}, {"const": "gem-pommel"},
        {"const": "grip"}, {"const": "guard"}, {"const": "pommel"},
        {"const": "relief-dragon-belly"}, {"const": "relief-dragon-spine"}
      ],
      "items": false
    },
    "thresholds": {
      "type": "object", "additionalProperties": false,
      "required": ["silhouette_iou_min", "boundary_f1_4px_min", "symmetric_chamfer_px_max"],
      "properties": {"silhouette_iou_min": {"const": 0.9}, "boundary_f1_4px_min": {"const": 0.9}, "symmetric_chamfer_px_max": {"const": 4.0}}
    },
    "metrics": {
      "type": "object", "additionalProperties": false,
      "required": ["silhouette_iou_milli", "boundary_f1_milli", "sdf_chamfer_milli"],
      "properties": {
        "silhouette_iou_milli": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "boundary_f1_milli": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "sdf_chamfer_milli": {"type": "integer", "minimum": 0, "maximum": 1000000}
      }
    }
  }
}
