{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/mechanical-animation-clip-prepare-request.schema.json",
  "title": "MechanicalAnimationClipPrepareRequest",
  "description": "A closed explicit-write request that validates and materializes one bounded candidate-bound rigid mechanical action as an immutable Runtime CAS clip.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "clip_id", "pose_sequence_request", "clip_policy", "input_sha256"],
  "properties": {
    "schema_version": {"const": "MechanicalAnimationClipPrepareRequest@1"},
    "clip_id": {"$ref": "#/$defs/identifier"},
    "pose_sequence_request": {"$ref": "https://forgecad.local/contracts/mechanical-pose-sequence-preview-request.schema.json"},
    "clip_policy": {"const": "runtime-owned-immutable-cas-rigid-mechanical-action@1"},
    "input_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
