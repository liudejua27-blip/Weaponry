{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/mechanical-pose-sequence-preview-request.schema.json",
  "title": "MechanicalPoseSequencePreviewRequest",
  "description": "A closed candidate-bound request for at most 16 ordered read-only mechanical pose samples.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "artifact_id", "candidate_id", "artifact_readback_sha256", "program_sha256", "operator_catalog_sha256", "readback_config_sha256", "rest_frame_draft", "pose_action_draft", "sample_time_ticks", "input_sha256"],
  "properties": {
    "schema_version": {"const": "MechanicalPoseSequencePreviewRequest@1"},
    "project_id": {"$ref": "#/$defs/identifier"},
    "artifact_id": {"$ref": "#/$defs/sha256"},
    "candidate_id": {"$ref": "#/$defs/identifier"},
    "artifact_readback_sha256": {"$ref": "#/$defs/sha256"},
    "program_sha256": {"$ref": "#/$defs/sha256"},
    "operator_catalog_sha256": {"$ref": "#/$defs/sha256"},
    "readback_config_sha256": {"$ref": "#/$defs/sha256"},
    "rest_frame_draft": {"$ref": "#/$defs/rest_frame_draft"},
    "pose_action_draft": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/action_draft"}]},
    "sample_time_ticks": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"type": "integer", "minimum": 0, "maximum": 1000000}},
    "input_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "translation": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number", "minimum": -10, "maximum": 10}},
    "axis": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number", "minimum": -1, "maximum": 1}},
    "quaternion": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number", "minimum": -1, "maximum": 1}},
    "link_draft": {
      "type": "object", "additionalProperties": false,
      "required": ["link_id", "part_id", "source_node_ids", "joint_type", "rest_translation_m", "rest_rotation_quat_xyzw", "axis_local", "limit_min", "limit_max", "value_unit"],
      "properties": {
        "link_id": {"$ref": "#/$defs/identifier"}, "part_id": {"$ref": "#/$defs/identifier"},
        "source_node_ids": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/$defs/identifier"}},
        "joint_type": {"enum": ["fixed", "revolute", "prismatic"]},
        "rest_translation_m": {"$ref": "#/$defs/translation"}, "rest_rotation_quat_xyzw": {"$ref": "#/$defs/quaternion"},
        "axis_local": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/axis"}]},
        "limit_min": {"type": ["number", "null"], "minimum": -3.141592653589793, "maximum": 3.141592653589793},
        "limit_max": {"type": ["number", "null"], "minimum": -3.141592653589793, "maximum": 3.141592653589793},
        "value_unit": {"enum": ["none", "radian", "meter"]}
      }
    },
    "parent": {"type": "object", "additionalProperties": false, "required": ["child_link_id", "parent_link_id"], "properties": {"child_link_id": {"$ref": "#/$defs/identifier"}, "parent_link_id": {"$ref": "#/$defs/identifier"}}},
    "rest_frame_draft": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "rest_frame_id", "coordinate_system", "transform_convention", "root_link_id", "links", "parent_map"],
      "properties": {
        "schema_version": {"const": "MechanicalRestFrameDraft@1"}, "rest_frame_id": {"$ref": "#/$defs/identifier"},
        "coordinate_system": {"const": "forgecad-rh-y-up-m@1"}, "transform_convention": {"const": "column-vector-trs-quaternion@1"},
        "root_link_id": {"$ref": "#/$defs/identifier"},
        "links": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/link_draft"}},
        "parent_map": {"type": "array", "minItems": 0, "maxItems": 63, "items": {"$ref": "#/$defs/parent"}}
      }
    },
    "key": {"type": "object", "additionalProperties": false, "required": ["time_ticks", "value"], "properties": {"time_ticks": {"type": "integer", "minimum": 0, "maximum": 1000000}, "value": {"type": "number", "minimum": -3.141592653589793, "maximum": 3.141592653589793}}},
    "channel": {"type": "object", "additionalProperties": false, "required": ["link_id", "value_unit", "keys"], "properties": {"link_id": {"$ref": "#/$defs/identifier"}, "value_unit": {"enum": ["radian", "meter"]}, "keys": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/key"}}}},
    "action_draft": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "action_id", "timebase_hz", "duration_ticks", "interpolation", "extrapolation", "unkeyed_policy", "channels"],
      "properties": {
        "schema_version": {"const": "MechanicalPoseActionDraft@1"}, "action_id": {"$ref": "#/$defs/identifier"},
        "timebase_hz": {"const": 1000}, "duration_ticks": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "interpolation": {"const": "linear@1"}, "extrapolation": {"const": "clamp@1"}, "unkeyed_policy": {"const": "rest@1"},
        "channels": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/channel"}}
      }
    }
  }
}
