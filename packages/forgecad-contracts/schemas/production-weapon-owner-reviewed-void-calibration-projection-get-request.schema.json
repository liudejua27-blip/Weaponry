{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/production-weapon-owner-reviewed-void-calibration-projection-get-request.schema.json",
  "title": "ProductionWeaponOwnerReviewedVoidCalibrationProjectionGetRequest@1",
  "description": "Closed zero-write request for Runtime-derived owner-to-reviewed-void calibration. The request accepts only opaque IDs and SHA-256 bindings; raw masks, image bytes, vertex IDs, triangle IDs and transforms are unrepresentable.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "operation", "projection_id", "session_id", "project_id", "candidate_id",
    "candidate_state_sha256", "artifact_id", "artifact_sha256", "artifact_readback_sha256",
    "form_art_evidence_id", "form_art_evidence_object_sha256", "form_art_evidence_canonical_sha256",
    "fresh_baseline_id", "fresh_baseline_canonical_sha256", "fresh_baseline_receipt_object_sha256",
    "registration_lineage_id", "registration_lineage_canonical_sha256", "registration_lineage_receipt_object_sha256",
    "registered_rig_v2_id", "registered_rig_v2_object_sha256", "registered_rig_v2_canonical_sha256",
    "max_response_bytes", "writer_policy", "runtime_write_performed", "persistent_user_data_touched",
    "input_sha256"
  ],
  "properties": {
    "schema_version": {"const": "ProductionWeaponOwnerReviewedVoidCalibrationProjectionGetRequest@1"},
    "operation": {"const": "forgecad.production.weapon.owner-reviewed-void-calibration-projection-get@1"},
    "projection_id": {"$ref": "#/$defs/id"},
    "session_id": {"$ref": "#/$defs/id"},
    "project_id": {"$ref": "#/$defs/id"},
    "candidate_id": {"$ref": "#/$defs/id"},
    "candidate_state_sha256": {"$ref": "#/$defs/sha256"},
    "artifact_id": {"$ref": "#/$defs/id"},
    "artifact_sha256": {"$ref": "#/$defs/sha256"},
    "artifact_readback_sha256": {"$ref": "#/$defs/sha256"},
    "form_art_evidence_id": {"$ref": "#/$defs/id"},
    "form_art_evidence_object_sha256": {"$ref": "#/$defs/sha256"},
    "form_art_evidence_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "fresh_baseline_id": {"$ref": "#/$defs/id"},
    "fresh_baseline_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "fresh_baseline_receipt_object_sha256": {"$ref": "#/$defs/sha256"},
    "registration_lineage_id": {"$ref": "#/$defs/id"},
    "registration_lineage_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "registration_lineage_receipt_object_sha256": {"$ref": "#/$defs/sha256"},
    "registered_rig_v2_id": {"$ref": "#/$defs/id"},
    "registered_rig_v2_object_sha256": {"$ref": "#/$defs/sha256"},
    "registered_rig_v2_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "max_response_bytes": {"const": 1048576},
    "writer_policy": {"const": "forgecad-runtime-only-state-writer@1"},
    "runtime_write_performed": {"const": false},
    "persistent_user_data_touched": {"const": false},
    "input_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
