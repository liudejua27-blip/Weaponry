{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/reference-evidence.schema.json",
  "title": "ReferenceEvidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "reference_id",
    "project_id",
    "object_sha256",
    "mime",
    "size_bytes",
    "width",
    "height",
    "frame_count",
    "import_mode",
    "authorization",
    "derived_object_sha256",
    "canonical_sha256",
    "created_at"
  ],
  "properties": {
    "schema_version": {"const": "ReferenceEvidence@1"},
    "reference_id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,128}$"},
    "project_id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,128}$"},
    "object_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "mime": {"enum": ["image/png", "image/jpeg"]},
    "size_bytes": {"type": "integer", "minimum": 1, "maximum": 8388608},
    "width": {"type": "integer", "minimum": 1, "maximum": 8192},
    "height": {"type": "integer", "minimum": 1, "maximum": 8192},
    "frame_count": {"const": 1},
    "import_mode": {"enum": ["inline_content", "codex_local_file"]},
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["user_authorized", "declaration"],
      "properties": {
        "user_authorized": {"const": true},
        "declaration": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    },
    "derived_object_sha256": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "canonical_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "created_at": {"type": "string", "minLength": 1, "maxLength": 64}
  }
}
