{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/geometry-program-v2.schema.json",
  "title": "GeometryProgramV2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "representation_plan_sha256",
    "operator_catalog_sha256",
    "units",
    "budgets",
    "nodes",
    "part_outputs",
    "canonical_sha256"
  ],
  "properties": {
    "schema_version": {"const": "GeometryProgram@2"},
    "project_id": {"$ref": "#/$defs/identifier"},
    "representation_plan_sha256": {"$ref": "#/$defs/sha256"},
    "operator_catalog_sha256": {"$ref": "#/$defs/sha256"},
    "units": {
      "type": "object",
      "additionalProperties": false,
      "required": ["length", "angle", "coordinate_system"],
      "properties": {
        "length": {"const": "meter"},
        "angle": {"const": "radian"},
        "coordinate_system": {"const": "right-handed-y-up"}
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_nodes",
        "max_triangles",
        "max_glb_bytes",
        "max_worker_memory_bytes",
        "max_runtime_ms"
      ],
      "properties": {
        "max_nodes": {"type": "integer", "minimum": 1, "maximum": 512},
        "max_triangles": {"type": "integer", "minimum": 1, "maximum": 250000},
        "max_glb_bytes": {"type": "integer", "minimum": 1, "maximum": 67108864},
        "max_worker_memory_bytes": {"type": "integer", "minimum": 1, "maximum": 536870912},
        "max_runtime_ms": {"type": "integer", "minimum": 1, "maximum": 10000}
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {"$ref": "#/$defs/geometry_node"}
    },
    "part_outputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {"$ref": "#/$defs/part_output"}
    },
    "canonical_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]{1,128}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "dimension_scalar": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 10
    },
    "radius_scalar": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 5
    },
    "coordinate_scalar": {
      "type": "number",
      "minimum": -10,
      "maximum": 10
    },
    "radian_scalar": {
      "type": "number",
      "minimum": -6.283185307179586,
      "maximum": 6.283185307179586
    },
    "dimension_vector": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/dimension_scalar"}
    },
    "radius_vector": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/radius_scalar"}
    },
    "coordinate_vector": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/coordinate_scalar"}
    },
    "radian_vector": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/radian_scalar"}
    },
    "geometry_node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_id", "operator_id", "inputs", "parameters"],
      "properties": {
        "node_id": {"$ref": "#/$defs/identifier"},
        "operator_id": {
          "enum": [
            "forgecad.geometry.primitive@2",
            "forgecad.geometry.profile-extrude@1",
            "forgecad.geometry.profile-loft@1",
            "forgecad.geometry.profile-loft@2",
            "forgecad.geometry.multi-loop-profile-loft@1",
            "forgecad.geometry.longitudinal-section-loft@1",
            "forgecad.geometry.subd-cage@1",
            "forgecad.geometry.surface-patch@1",
            "forgecad.geometry.surface-shell@1",
            "forgecad.geometry.revolve@1",
            "forgecad.geometry.tube-sweep@1",
            "forgecad.geometry.transform@2",
            "forgecad.geometry.mirror@1",
            "forgecad.geometry.array@1",
            "forgecad.geometry.panel@1",
            "forgecad.geometry.vent-array@1",
            "forgecad.geometry.joint-stack@1",
            "forgecad.geometry.boolean@1",
            "forgecad.geometry.part-output@1"
          ]
        },
        "inputs": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        },
        "parameters": {
          "oneOf": [
            {"$ref": "#/$defs/box_parameters"},
            {"$ref": "#/$defs/cylinder_parameters"},
            {"$ref": "#/$defs/ellipsoid_parameters"},
            {"$ref": "#/$defs/sphere_parameters"},
            {"$ref": "#/$defs/profile_extrude_parameters"},
            {"$ref": "#/$defs/profile_loft_parameters"},
            {"$ref": "#/$defs/profile_loft_v2_parameters"},
            {"$ref": "#/$defs/multi_loop_profile_loft_parameters"},
            {"$ref": "#/$defs/longitudinal_section_loft_parameters"},
            {"$ref": "#/$defs/subd_cage_parameters"},
            {"$ref": "#/$defs/surface_patch_parameters"},
            {"$ref": "#/$defs/surface_shell_parameters"},
            {"$ref": "#/$defs/revolve_parameters"},
            {"$ref": "#/$defs/tube_sweep_parameters"},
            {"$ref": "#/$defs/transform_parameters"},
            {"$ref": "#/$defs/mirror_parameters"},
            {"$ref": "#/$defs/array_parameters"},
            {"$ref": "#/$defs/panel_parameters"},
            {"$ref": "#/$defs/vent_array_parameters"},
            {"$ref": "#/$defs/joint_stack_parameters"},
            {"$ref": "#/$defs/boolean_parameters"},
            {"$ref": "#/$defs/part_output_parameters"}
          ]
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "operator_id": {"const": "forgecad.geometry.boolean@1"}
              }
            },
            "then": {
              "properties": {
                "inputs": {"minItems": 2, "maxItems": 2}
              }
            }
          }
        ]
      }
    },
    "base_primitive_parameters": {
      "type": "object",
      "properties": {
        "position_m": {"$ref": "#/$defs/coordinate_vector"},
        "rotation_rad": {"$ref": "#/$defs/radian_vector"}
      }
    },
    "box_parameters": {
      "allOf": [
        {"$ref": "#/$defs/base_primitive_parameters"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["shape", "size_m", "position_m", "rotation_rad"],
          "properties": {
            "shape": {"const": "box"},
            "size_m": {"$ref": "#/$defs/dimension_vector"},
            "position_m": {"$ref": "#/$defs/coordinate_vector"},
            "rotation_rad": {"$ref": "#/$defs/radian_vector"}
          }
        }
      ]
    },
    "cylinder_parameters": {
      "allOf": [
        {"$ref": "#/$defs/base_primitive_parameters"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["shape", "radius_m", "height_m", "radial_segments", "position_m", "rotation_rad"],
          "properties": {
            "shape": {"const": "cylinder"},
            "radius_m": {"$ref": "#/$defs/radius_scalar"},
            "height_m": {"$ref": "#/$defs/dimension_scalar"},
            "radial_segments": {"type": "integer", "minimum": 8, "maximum": 64},
            "position_m": {"$ref": "#/$defs/coordinate_vector"},
            "rotation_rad": {"$ref": "#/$defs/radian_vector"}
          }
        }
      ]
    },
    "ellipsoid_parameters": {
      "allOf": [
        {"$ref": "#/$defs/base_primitive_parameters"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["shape", "radii_m", "longitude_segments", "latitude_segments", "position_m", "rotation_rad"],
          "properties": {
            "shape": {"const": "ellipsoid"},
            "radii_m": {"$ref": "#/$defs/radius_vector"},
            "longitude_segments": {"type": "integer", "minimum": 8, "maximum": 64},
            "latitude_segments": {"type": "integer", "minimum": 4, "maximum": 64},
            "position_m": {"$ref": "#/$defs/coordinate_vector"},
            "rotation_rad": {"$ref": "#/$defs/radian_vector"}
          }
        }
      ]
    },
    "sphere_parameters": {
      "allOf": [
        {"$ref": "#/$defs/base_primitive_parameters"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["shape", "radius_m", "longitude_segments", "latitude_segments", "position_m", "rotation_rad"],
          "properties": {
            "shape": {"const": "sphere"},
            "radius_m": {"$ref": "#/$defs/radius_scalar"},
            "longitude_segments": {"type": "integer", "minimum": 8, "maximum": 64},
            "latitude_segments": {"type": "integer", "minimum": 4, "maximum": 64},
            "position_m": {"$ref": "#/$defs/coordinate_vector"},
            "rotation_rad": {"$ref": "#/$defs/radian_vector"}
          }
        }
      ]
    },
    "profile_point": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"$ref": "#/$defs/coordinate_scalar"}
    },
    "profile_points": {
      "type": "array",
      "minItems": 3,
      "maxItems": 64,
      "items": {"$ref": "#/$defs/profile_point"}
    },
    "path_point": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/coordinate_scalar"}
    },
    "path_points": {
      "type": "array",
      "minItems": 2,
      "maxItems": 128,
      "items": {"$ref": "#/$defs/path_point"}
    },
    "profile_extrude_parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shape", "profile", "depth_m", "position_m", "rotation_rad"],
      "properties": {
        "shape": {"const": "profile-extrude"},
        "profile": {"$ref": "#/$defs/profile_points"},
        "depth_m": {"$ref": "#/$defs/dimension_scalar"},
        "position_m": {"$ref": "#/$defs/coordinate_vector"},
        "rotation_rad": {"$ref": "#/$defs/radian_vector"}
      }
    },
    "loft_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["height_m", "points"],
      "properties": {
        "height_m": {"$ref": "#/$defs/coordinate_scalar"},
        "points": {"$ref": "#/$defs/profile_points"}
      }
    },
    "profile_loft_parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shape", "profiles", "position_m", "rotation_rad"],
      "properties": {
        "shape": {"const": "profile-loft"},
        "profiles": {
          "type": "array",
          "minItems": 2,
          "maxItems": 16,
          "items": {"$ref": "#/$defs/loft_profile"}
        },
        "position_m": {"$ref": "#/$defs/coordinate_vector"},
        "rotation_rad": {"$ref": "#/$defs/radian_vector"}
      }
    },
    "profile_loft_v2_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["station_m", "points", "corner_indices"],
      "properties": {
        "station_m": {"$ref": "#/$defs/coordinate_scalar"},
        "points": {"$ref": "#/$defs/profile_points"},
        "corner_indices": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 0, "maximum": 63}
        }
      }
    },
    "profile_loft_v2_parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shape", "profiles", "resample_points", "interpolation", "interpolation_rings", "preserve_corners", "position_m", "rotation_rad"],
      "properties": {
        "shape": {"const": "profile-loft-v2"},
        "profiles": {
          "type": "array",
          "minItems": 2,
          "maxItems": 16,
          "items": {"$ref": "#/$defs/profile_loft_v2_profile"}
        },
        "resample_points": {"type": "integer", "minimum": 4, "maximum": 64},
        "interpolation": {"enum": ["linear", "catmull-rom"]},
        "interpolation_rings": {"type": "integer", "minimum": 0, "maximum": 16},
        "preserve_corners": {"type": "boolean"},
        "position_m": {"$ref": "#/$defs/coordinate_vector"},
        "rotation_rad": {"$ref": "#/$defs/radian_vector"}
      }
    },
    "multi_loop_profile_loft_loop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["points"],
      "properties": {
        "points": {"$ref": "#/$defs/profile_points"},
        "corner_indices": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 0, "maximum": 63}
        }
      }
    },
    "multi_loop_profile_loft_hole": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hole_id", "points"],
      "properties": {
        "hole_id": {"$ref": "#/$defs/identifier"},
        "points": {"$ref": "#/$defs/profile_points"},
        "corner_indices": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 0, "maximum": 63}
        }
      }
    },
    "multi_loop_profile_loft_component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component_id", "outer", "holes"],
      "properties": {
        "component_id": {"$ref": "#/$defs/identifier"},
        "outer": {"$ref": "#/$defs/multi_loop_profile_loft_loop"},
        "holes": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/multi_loop_profile_loft_hole"}
        }
      }
    },
    "multi_loop_profile_loft_station": {
      "type": "object",
      "additionalProperties": false,
      "required": ["station_id", "station_m", "components"],
      "properties": {
        "station_id": {"$ref": "#/$defs/identifier"},
        "station_m": {"$ref": "#/$defs/coordinate_scalar"},
        "components": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {"$ref": "#/$defs/multi_loop_profile_loft_component"}
        }
      }
    },
    "multi_loop_profile_loft_parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shape", "stations", "resample_points", "interpolation", "interpolation_rings", "preserve_corners", "position_m", "rotation_rad"],
      "properties": {
        "shape": {"const": "multi-loop-profile-loft"},
        "stations": {
          "type": "array",
          "minItems": 2,
          "maxItems": 16,
          "items": {"$ref": "#/$defs/multi_loop_profile_loft_station"}
        },
        "resample_points": {"type": "integer", "minimum": 4, "maximum": 64},
        "interpolation": {"enum": ["linear", "catmull-rom"]},
        "interpolation_rings": {"type": "integer", "minimum": 0, "maximum": 16},
        "preserve_corners": {"type": "boolean"},
        "position_m": {"$ref": "#/$defs/coordinate_vector"},
        "rotation_rad": {"$ref": "#/$defs/radian_vector"}
      }
    },
    "longitudinal_section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["station_m", "points"],
      "properties": {
        "station_m": {"$ref": "#/$defs/coordinate_scalar"},
        "points": {"$ref": "#/$defs/profile_points"}
      }
    },
    "longitudinal_section_loft_parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shape", "sections", "position_m", "rotation_rad"],
      "properties": {
        "shape": {"const": "longitudinal-section-loft"},
        "sections": {
          "type": "array",
          "minItems": 2,
          "maxItems": 16,
          "items": {"$ref": "#/$defs/longitudinal_section"}
        },
        "position_m": {"$ref": "#/$defs/coordinate_vector"},
        "rotation_rad": {"$ref": "#/$defs/radian_vector"}
      }
    },
    "surface_patch_control_point": {
      "$ref": "#/$defs/coordinate_vector"
    },
    "surface_patch_control_points": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "items": {"$ref": "#/$defs/surface_patch_control_point"}
    },
    "subd_cage_control_points": {
      "type": "array",
      "minItems": 4,
      "maxItems": 256,
      "items": {"$ref": "#/$defs/surface_patch_control_point"}
    },
    "subd_cage_parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shape", "control_points", "u_points", "v_points", "subdivision_levels", "position_m", "rotation_rad"],
      "properties": {
        "shape": {"const": "subd-cage"},
        "control_points": {"$ref": "#/$defs/subd_cage_control_points"},
        "u_points": {"type": "integer", "minimum": 2, "maximum": 16},
        "v_points": {"type": "integer", "minimum": 2, "maximum": 16},
        "subdivision_levels": {"type": "integer", "minimum": 0, "maximum": 2},
        "position_m": {"$ref": "#/$defs/coordinate_vector"},
        "rotation_rad": {"$ref": "#/$defs/radian_vector"}
      }
    },
    "surface_patch_parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shape", "control_points", "u_segments", "v_segments", "position_m", "rotation_rad"],
      "properties": {
        "shape": {"const": "surface-patch"},
        "control_points": {"$ref": "#/$defs/surface_patch_control_points"},
        "u_segments": {"type": "integer", "minimum": 4, "maximum": 32},
        "v_segments": {"type": "integer", "minimum": 4, "maximum": 32},
        "position_m": {"$ref": "#/$defs/coordinate_vector"},
        "rotation_rad": {"$ref": "#/$defs/radian_vector"}
      }
    },
    "surface_shell_parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shape", "control_points", "u_segments", "v_segments", "thickness_m", "position_m", "rotation_rad"],
      "properties": {
        "shape": {"const": "surface-shell"},
        "control_points": {"$ref": "#/$defs/surface_patch_control_points"},
        "u_segments": {"type": "integer", "minimum": 4, "maximum": 32},
        "v_segments": {"type": "integer", "minimum": 4, "maximum": 32},
        "thickness_m": {"$ref": "#/$defs/dimension_scalar"},
        "position_m": {"$ref": "#/$defs/coordinate_vector"},
        "rotation_rad": {"$ref": "#/$defs/radian_vector"}
      }
    },
    "revolve_parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shape", "profile", "radial_segments", "position_m", "rotation_rad"],
      "properties": {
        "shape": {"const": "revolve"},
        "profile": {
          "type": "array",
          "minItems": 2,
          "maxItems": 64,
          "items": {"$ref": "#/$defs/profile_point"}
        },
        "radial_segments": {"type": "integer", "minimum": 8, "maximum": 64},
        "position_m": {"$ref": "#/$defs/coordinate_vector"},
        "rotation_rad": {"$ref": "#/$defs/radian_vector"}
      }
    },
    "tube_sweep_parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shape", "path", "radius_m", "radial_segments", "cap_ends", "position_m", "rotation_rad"],
      "properties": {
        "shape": {"const": "tube-sweep"},
        "path": {"$ref": "#/$defs/path_points"},
        "radius_m": {"$ref": "#/$defs/radius_scalar"},
        "radial_segments": {"type": "integer", "minimum": 8, "maximum": 64},
        "cap_ends": {"type": "boolean"},
        "position_m": {"$ref": "#/$defs/coordinate_vector"},
        "rotation_rad": {"$ref": "#/$defs/radian_vector"}
      }
    },
    "transform_parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shape", "translation_m", "rotation_rad", "scale"],
      "properties": {
        "shape": {"const": "transform"},
        "translation_m": {"$ref": "#/$defs/coordinate_vector"},
        "rotation_rad": {"$ref": "#/$defs/radian_vector"},
        "scale": {"$ref": "#/$defs/dimension_vector"}
      }
    },
    "mirror_parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shape", "axis", "offset_m"],
      "properties": {
        "shape": {"const": "mirror"},
        "axis": {"enum": ["x", "y", "z"]},
        "offset_m": {"$ref": "#/$defs/coordinate_scalar"}
      }
    },
    "array_parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shape", "count", "offset_m"],
      "properties": {
        "shape": {"const": "array"},
        "count": {"type": "integer", "minimum": 1, "maximum": 32},
        "offset_m": {"$ref": "#/$defs/coordinate_vector"}
      }
    },
    "panel_parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shape", "size_m", "thickness_m", "bevel_m", "position_m", "rotation_rad"],
      "properties": {
        "shape": {"const": "panel"},
        "size_m": {"$ref": "#/$defs/dimension_vector"},
        "thickness_m": {"$ref": "#/$defs/dimension_scalar"},
        "bevel_m": {"$ref": "#/$defs/dimension_scalar"},
        "position_m": {"$ref": "#/$defs/coordinate_vector"},
        "rotation_rad": {"$ref": "#/$defs/radian_vector"}
      }
    },
    "vent_array_parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shape", "width_m", "height_m", "depth_m", "slot_count", "slot_width_m", "slot_spacing_m", "position_m", "rotation_rad"],
      "properties": {
        "shape": {"const": "vent-array"},
        "width_m": {"$ref": "#/$defs/dimension_scalar"},
        "height_m": {"$ref": "#/$defs/dimension_scalar"},
        "depth_m": {"$ref": "#/$defs/dimension_scalar"},
        "slot_count": {"type": "integer", "minimum": 1, "maximum": 32},
        "slot_width_m": {"$ref": "#/$defs/dimension_scalar"},
        "slot_spacing_m": {"$ref": "#/$defs/dimension_scalar"},
        "position_m": {"$ref": "#/$defs/coordinate_vector"},
        "rotation_rad": {"$ref": "#/$defs/radian_vector"}
      }
    },
    "joint_stack_parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shape", "radius_m", "depth_m", "ring_count", "ring_spacing_m", "radial_segments", "position_m", "rotation_rad"],
      "properties": {
        "shape": {"const": "joint-stack"},
        "radius_m": {"$ref": "#/$defs/radius_scalar"},
        "depth_m": {"$ref": "#/$defs/dimension_scalar"},
        "ring_count": {"type": "integer", "minimum": 1, "maximum": 16},
        "ring_spacing_m": {"$ref": "#/$defs/dimension_scalar"},
        "radial_segments": {"type": "integer", "minimum": 8, "maximum": 64},
        "position_m": {"$ref": "#/$defs/coordinate_vector"},
        "rotation_rad": {"$ref": "#/$defs/radian_vector"}
      }
    },
    "boolean_parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shape"],
      "properties": {
        "shape": {"enum": ["union", "difference", "intersection"]}
      }
    },
    "part_output_parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shape"],
      "properties": {
        "shape": {"const": "part-output"}
      }
