{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/fictional-energy-vfx-appearance-frame-sample.schema.json",
  "title": "FictionalEnergyVfxAppearanceFrameSample@1",
  "description": "A read-only VFX intent sample with three actual Appearance GLB provenance and MaterialZone-to-stable-material-ID verification. It still does not execute or persist a render.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "delivery_manifest_object_sha256", "vfx_profile_object_sha256", "timebase_hz", "requested_time_ticks", "sampling_policy", "appearance_binding_policy", "interpolation", "effects", "lod_appearance_bindings", "glb_material_zone_binding_verified", "emissive_animation_rendered", "runtime_write_performed", "persistent_user_data_touched", "quality_status", "limitations", "canonical_sha256"],
  "properties": {
    "schema_version": {"const": "FictionalEnergyVfxAppearanceFrameSample@1"},
    "project_id": {"$ref": "#/$defs/identifier"},
    "delivery_manifest_object_sha256": {"$ref": "#/$defs/sha256"},
    "vfx_profile_object_sha256": {"$ref": "#/$defs/sha256"},
    "timebase_hz": {"const": 1000},
    "requested_time_ticks": {"type": "integer", "minimum": 0, "maximum": 1000000},
    "sampling_policy": {"const": "integer-tick-linear-once-clamp-loop-modulo-duration@1"},
    "appearance_binding_policy": {"const": "three-lod-appearance-program-glb-material-zone-stable-id@1"},
    "interpolation": {"const": "LINEAR"},
    "effects": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/effect_sample"}},
    "lod_appearance_bindings": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/lod_binding"}},
    "glb_material_zone_binding_verified": {"const": true},
    "emissive_animation_rendered": {"const": false},
    "runtime_write_performed": {"const": false},
    "persistent_user_data_touched": {"const": false},
    "quality_status": {"const": "structural_only"},
    "limitations": {"const": ["appearance-and-glb-material-binding-verified-no-render", "no-runtime-cas-frame-receipt", "anchor-remains-sidecar-not-glb-socket", "no-bloom-particles-trails-or-engine-roundtrip", "structural-binding-does-not-prove-visual-quality"]},
    "canonical_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "zone_material_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["material_zone_id", "material_id"],
      "properties": {
        "material_zone_id": {"$ref": "#/$defs/identifier"},
        "material_id": {"$ref": "#/$defs/identifier"}
      }
    },
    "effect_material_zone_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["effect_id", "anchor_id", "owner_part_id", "material_zone_id", "material_id"],
      "allOf": [
        {"if": {"properties": {"effect_id": {"const": "muzzle-pulse"}}, "required": ["effect_id"]}, "then": {"properties": {"material_id": {"const": "energy-cyan-muzzle-emissive"}}}},
        {"if": {"properties": {"effect_id": {"const": "energy-core-breathe"}}, "required": ["effect_id"]}, "then": {"properties": {"material_id": {"const": "energy-cyan-emissive"}}}}
      ],
      "properties": {
        "effect_id": {"$ref": "#/$defs/identifier"},
        "anchor_id": {"enum": ["socket-muzzle-vfx", "socket-energy-core-vfx"]},
        "owner_part_id": {"$ref": "#/$defs/identifier"},
        "material_zone_id": {"$ref": "#/$defs/identifier"},
        "material_id": {"enum": ["energy-cyan-muzzle-emissive", "energy-cyan-emissive"]}
      }
    },
    "lod_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "candidate_id", "candidate_state_sha256", "artifact_sha256", "artifact_readback_sha256", "appearance_program_schema_version", "appearance_program_sha256", "material_pack_id", "material_pack_manifest_sha256", "zone_material_bindings", "effect_material_zone_bindings"],
      "properties": {
        "level": {"type": "integer", "minimum": 0, "maximum": 2},
        "candidate_id": {"$ref": "#/$defs/identifier"},
        "candidate_state_sha256": {"$ref": "#/$defs/sha256"},
        "artifact_sha256": {"$ref": "#/$defs/sha256"},
        "artifact_readback_sha256": {"$ref": "#/$defs/sha256"},
        "appearance_program_schema_version": {"enum": ["AppearanceProgram@2", "AppearanceProgram@3"]},
        "appearance_program_sha256": {"$ref": "#/$defs/sha256"},
        "material_pack_id": {"const": "forgecad-fictional-energy-weapon-2k"},
        "material_pack_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "zone_material_bindings": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/zone_material_binding"}},
        "effect_material_zone_bindings": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/effect_material_zone_binding"}}
      }
    },
    "effect_sample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["effect_id", "anchor_id", "effect_kind", "material_id", "color_linear_rgb", "loop_mode", "duration_ticks", "requested_time_ticks", "resolved_time_ticks", "emissive_strength", "lod_visibility"],
      "allOf": [
        {"if": {"properties": {"effect_id": {"const": "muzzle-pulse"}}, "required": ["effect_id"]}, "then": {"properties": {"material_id": {"const": "energy-cyan-muzzle-emissive"}}}},
        {"if": {"properties": {"effect_id": {"const": "energy-core-breathe"}}, "required": ["effect_id"]}, "then": {"properties": {"material_id": {"const": "energy-cyan-emissive"}}}}
      ],
      "properties": {
        "effect_id": {"$ref": "#/$defs/identifier"},
        "anchor_id": {"enum": ["socket-muzzle-vfx", "socket-energy-core-vfx"]},
        "effect_kind": {"enum": ["muzzle-emissive-pulse", "energy-core-emissive-breathe"]},
        "material_id": {"enum": ["energy-cyan-muzzle-emissive", "energy-cyan-emissive"]},
        "color_linear_rgb": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number", "minimum": 0, "maximum": 1}},
        "loop_mode": {"enum": ["once", "loop"]},
        "duration_ticks": {"type": "integer", "minimum": 1, "maximum": 10000},
        "requested_time_ticks": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "resolved_time_ticks": {"type": "integer", "minimum": 0, "maximum": 10000},
        "emissive_strength": {"type": "number", "minimum": 0, "maximum": 16},
        "lod_visibility": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "boolean"}}
      }
    }
  }
}
