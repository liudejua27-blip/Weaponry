{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/runtime-job-result.schema.json",
  "title": "ForgeCAD Runtime Job Result",
  "description": "Hash-bound result envelope for a completed Runtime Job. The payload remains the contract owned by the Job kind.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "job", "result_sha256", "result"],
  "properties": {
    "schema_version": {"const": "RuntimeJobResult@1"},
    "job": {"$ref": "https://forgecad.local/contracts/runtime-job.schema.json"},
    "result_sha256": {"$ref": "#/$defs/sha256"},
    "result": {"$ref": "https://forgecad.local/contracts/primary-form-repair-prepare-result.schema.json"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
