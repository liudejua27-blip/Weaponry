{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/authoring-mesh-identity-lineage-v2-prepare-result.schema.json",
  "title": "AuthoringMeshIdentityLineagePrepareResult@2",
  "description": "Closed Runtime-owned durable identity-lineage prepare result. It returns AuthoringMeshIdentityLineage@1 plus separate CAS object and payload hashes for the identity ledger and current AuthoringMesh canonical mesh; correspondence is Runtime-derived and cross-version stability remains unproven.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "source_candidate_id", "source_candidate_state_sha256", "base_version_id", "authoring_node_id", "part_id", "lineage_id", "genesis_source_mesh_sha256", "current_source_mesh_sha256", "candidate_id", "candidate_state_sha256", "canonical_mesh_id", "canonical_mesh_object_sha256", "canonical_mesh_sha256", "parent_lineage_object_sha256", "parent_lineage_sha256", "revision_index", "revision_kind", "operation_lineage_sha256", "source_program_object_sha256", "source_program_sha256", "source_artifact_object_sha256", "source_artifact_sha256", "source_artifact_readback_object_sha256", "source_artifact_readback_sha256", "evaluated_artifact_object_sha256", "evaluated_artifact_sha256", "evaluated_artifact_readback_object_sha256", "evaluated_artifact_readback_sha256", "identity_lineage_object_sha256", "identity_lineage_sha256", "identity_lineage", "request_input_sha256", "idempotency_key", "replayed", "restart_hash_verified", "runtime_write_performed", "persistent_user_data_touched", "stage_advanced", "candidate_confirmed", "version_created", "export_performed", "quality_status", "limitations", "canonicalization_policy", "canonical_sha256"],
  "properties": {
    "schema_version": {"const": "AuthoringMeshIdentityLineagePrepareResult@2"},
    "project_id": {"$ref": "#/$defs/identifier"},
    "source_candidate_id": {"$ref": "#/$defs/identifier"},
    "source_candidate_state_sha256": {"$ref": "#/$defs/sha256"},
    "base_version_id": {"$ref": "#/$defs/nullable_identifier"},
    "authoring_node_id": {"$ref": "#/$defs/identifier"},
    "part_id": {"$ref": "#/$defs/identifier"},
    "lineage_id": {"$ref": "#/$defs/identifier"},
    "genesis_source_mesh_sha256": {"$ref": "#/$defs/sha256"},
    "current_source_mesh_sha256": {"$ref": "#/$defs/sha256"},
    "candidate_id": {"$ref": "#/$defs/identifier"},
    "candidate_state_sha256": {"$ref": "#/$defs/sha256"},
    "canonical_mesh_id": {"$ref": "#/$defs/identifier"},
    "canonical_mesh_object_sha256": {"$ref": "#/$defs/sha256"},
    "canonical_mesh_sha256": {"$ref": "#/$defs/sha256"},
    "parent_lineage_object_sha256": {"$ref": "#/$defs/nullable_sha256"},
    "parent_lineage_sha256": {"$ref": "#/$defs/nullable_sha256"},
    "revision_index": {"type": "integer", "minimum": 0, "maximum": 1000000},
    "revision_kind": {"enum": ["genesis", "preserving-edit", "topology-edit"]},
    "operation_lineage_sha256": {"$ref": "#/$defs/sha256"},
    "source_program_object_sha256": {"$ref": "#/$defs/sha256"},
    "source_program_sha256": {"$ref": "#/$defs/sha256"},
    "source_artifact_object_sha256": {"$ref": "#/$defs/sha256"},
    "source_artifact_sha256": {"$ref": "#/$defs/sha256"},
    "source_artifact_readback_object_sha256": {"$ref": "#/$defs/sha256"},
    "source_artifact_readback_sha256": {"$ref": "#/$defs/sha256"},
    "evaluated_artifact_object_sha256": {"$ref": "#/$defs/sha256"},
    "evaluated_artifact_sha256": {"$ref": "#/$defs/sha256"},
    "evaluated_artifact_readback_object_sha256": {"$ref": "#/$defs/sha256"},
    "evaluated_artifact_readback_sha256": {"$ref": "#/$defs/sha256"},
    "identity_lineage_object_sha256": {"$ref": "#/$defs/sha256"},
    "identity_lineage_sha256": {"$ref": "#/$defs/sha256"},
    "identity_lineage": {"$ref": "https://forgecad.local/contracts/authoring-mesh-identity-lineage.schema.json"},
    "request_input_sha256": {"$ref": "#/$defs/sha256"},
    "idempotency_key": {"$ref": "#/$defs/idempotency_key"},
    "replayed": {"type": "boolean"},
    "restart_hash_verified": {"type": "boolean"},
    "runtime_write_performed": {"const": true},
    "persistent_user_data_touched": {"const": true},
    "stage_advanced": {"const": false},
    "candidate_confirmed": {"const": false},
    "version_created": {"const": false},
    "export_performed": {"const": false},
    "quality_status": {"const": "structural_only"},
    "limitations": {"const": ["RUNTIME_SOLE_WRITER", "NO_STAGE_ADVANCEMENT", "NO_CANDIDATE_CONFIRM", "NO_VERSION_CREATED", "NO_EXPORT", "IDENTITY_LEDGER_RUNTIME_DERIVED", "GENERAL_CORRESPONDENCE_BEYOND_TYPED_SPLIT_COLLAPSE_DISSOLVE_NOT_PROVEN", "CROSS_VERSION_STABILITY_NOT_PROVEN", "STRUCTURAL_ONLY_NOT_COMMERCIAL_QUALITY"]},
    "canonicalization_policy": {"const": "canonical-json-sha256-excluding-canonical-sha256@1"},
    "canonical_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,128}$"},
    "nullable_identifier": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9_.:-]{1,128}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullable_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "idempotency_key": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"}
  }
}
