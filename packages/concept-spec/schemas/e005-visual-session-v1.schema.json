{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/schemas/e005-visual-session-v1.schema.json",
  "title": "E005VisualSessionV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "session_id", "initial_source_sha256", "final_source_sha256", "state", "visual_patch_sha256", "review_evidence", "receipt", "receipt_sha256"],
  "properties": {
    "schema_version": {"const": "E005VisualSession@1"},
    "session_id": {"$ref": "#/$defs/id"},
    "initial_source_sha256": {"$ref": "#/$defs/hash"},
    "final_source_sha256": {"$ref": "#/$defs/hash"},
    "state": {"enum": ["accepted_by_visual_review", "patched_pending_visual_confirmation"]},
    "visual_patch_sha256": {"$ref": "#/$defs/hash"},
    "review_evidence": {"$ref": "e005-visual-review-evidence-v1.schema.json"},
    "receipt": {"$ref": "e005-visual-session-receipt-v1.schema.json"},
    "receipt_sha256": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9_.@-]{3,128}$"},
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
