{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://forgecad.local/schemas/expanded-visual-geometry-dag-v1.schema.json",
  "title":"ExpandedVisualGeometryDAGV1",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","compiler_version","id_algorithm_version","source_program_sha256","expanded_program_sha256","lineage_sha256","expanded_dag_sha256","budget_evidence","lineage","expanded_program"],
  "properties":{
    "schema_version":{"const":"ExpandedVisualGeometryDAG@1"},
    "compiler_version":{"const":"forgecad-core-vp203.1"},
    "id_algorithm_version":{"const":"geometry-source-path-v1"},
    "source_program_sha256":{"$ref":"#/$defs/hash"},
    "expanded_program_sha256":{"$ref":"#/$defs/hash"},
    "lineage_sha256":{"$ref":"#/$defs/hash"},
    "expanded_dag_sha256":{"$ref":"#/$defs/hash"},
    "budget_evidence":{"$ref":"#/$defs/budget_evidence"},
    "lineage":{"type":"array","minItems":1,"maxItems":256,"items":{"$ref":"#/$defs/lineage"}},
    "expanded_program":{"$ref":"forge-visual-geometry-program-v2.schema.json"}
  },
  "$defs":{
    "hash":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "budget_evidence":{"type":"object","additionalProperties":false,"required":["profile_count","section_set_count","node_count","part_count","output_count","operation_count","estimated_triangle_upper_bound"],"properties":{"profile_count":{"type":"integer","minimum":1},"section_set_count":{"type":"integer","minimum":0},"node_count":{"type":"integer","minimum":1},"part_count":{"type":"integer","minimum":1},"output_count":{"type":"integer","minimum":1},"operation_count":{"type":"integer","minimum":1},"estimated_triangle_upper_bound":{"type":"integer","minimum":1,"maximum":100000}}},
    "lineage":{"type":"object","additionalProperties":false,"required":["source_node_id","expanded_node_id","source_macro_path","instance_indices"],"properties":{"source_node_id":{"type":"string","pattern":"^node_[a-z0-9_-]+$"},"expanded_node_id":{"type":"string","pattern":"^node_[a-z0-9_-]+$"},"source_macro_path":{"type":"array","maxItems":16,"items":{"type":"string"}},"instance_indices":{"type":"array","maxItems":16,"items":{"type":"integer","minimum":0,"maximum":65535}}}}
  }
}
