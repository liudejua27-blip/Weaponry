{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/schemas/concept/material-zone-appearance.schema.json",
  "title": "MaterialZoneAppearance",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "appearance_id", "material_zone_id", "source_part_id", "base_material_id", "finish", "transmission_bps", "uncertainty_bps", "texture_width", "texture_height", "channels", "projection_layers"],
  "properties": {
    "schema_version": { "const": "MaterialZoneAppearance@1" },
    "appearance_id": { "type": "string", "minLength": 1, "maxLength": 360 },
    "material_zone_id": { "type": "string", "minLength": 1, "maxLength": 160 },
    "source_part_id": { "type": "string", "minLength": 1, "maxLength": 160 },
    "base_material_id": { "type": "string", "minLength": 1, "maxLength": 160 },
    "finish": { "type": "string", "minLength": 1, "maxLength": 160 },
    "coating": { "type": ["string", "null"], "minLength": 1, "maxLength": 160 },
    "transmission_bps": { "type": "integer", "minimum": 0, "maximum": 10000 },
    "uncertainty_bps": { "type": "integer", "minimum": 0, "maximum": 10000 },
    "texture_width": { "type": "integer", "minimum": 1, "maximum": 2048 },
    "texture_height": { "type": "integer", "minimum": 1, "maximum": 2048 },
    "channels": { "type": "array", "minItems": 1, "maxItems": 7, "uniqueItems": true, "items": { "$ref": "#/$defs/channel" } },
    "projection_layers": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/projection_layer" } }
  },
  "$defs": {
    "channel": { "enum": ["base_color", "metallic", "roughness", "normal", "occlusion", "emissive", "opacity"] },
    "projection_layer": {
      "type": "object", "additionalProperties": false,
      "required": ["layer_id", "evidence_artifact_id", "camera_hypothesis_id", "channels", "unobserved_texel_mask_artifact_id"],
      "properties": {
        "layer_id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "evidence_artifact_id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "camera_hypothesis_id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "channels": { "type": "array", "minItems": 1, "maxItems": 7, "uniqueItems": true, "items": { "$ref": "#/$defs/channel" } },
        "unobserved_texel_mask_artifact_id": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    }
  }
}
