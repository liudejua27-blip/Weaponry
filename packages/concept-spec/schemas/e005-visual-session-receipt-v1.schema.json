{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/schemas/e005-visual-session-receipt-v1.schema.json",
  "title": "E005VisualSessionReceiptV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "receipt_id", "session_id", "task_payload_sha256", "request_sha256", "source_program_sha256", "expanded_program_sha256", "shape_program_sha256", "glb_sha256", "normalized_geometry_sha256", "fixed_view_sha256", "compile_readback_sha256", "restricted_geometry_evidence_sha256", "comparison_report_sha256", "phases", "usage"],
  "properties": {
    "schema_version": {"const": "E005VisualSessionReceipt@1"},
    "receipt_id": {"$ref": "#/$defs/id"},
    "session_id": {"$ref": "#/$defs/id"},
    "task_payload_sha256": {"$ref": "#/$defs/hash"},
    "request_sha256": {"$ref": "#/$defs/hash"},
    "source_program_sha256": {"$ref": "#/$defs/hash"},
    "expanded_program_sha256": {"$ref": "#/$defs/hash"},
    "shape_program_sha256": {"$ref": "#/$defs/hash"},
    "glb_sha256": {"$ref": "#/$defs/hash"},
    "normalized_geometry_sha256": {"$ref": "#/$defs/hash"},
    "fixed_view_sha256": {"$ref": "#/$defs/hash"},
    "compile_readback_sha256": {"$ref": "#/$defs/hash"},
    "restricted_geometry_evidence_sha256": {"$ref": "#/$defs/hash"},
    "comparison_report_sha256": {"$ref": "#/$defs/hash"},
    "phases": {"type": "array", "minItems": 8, "maxItems": 13, "items": {"$ref": "visual-program-execution-receipt-v1.schema.json#/$defs/phase"}},
    "usage": {"$ref": "visual-program-execution-receipt-v1.schema.json#/$defs/usage"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9_.@-]{3,128}$"},
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
