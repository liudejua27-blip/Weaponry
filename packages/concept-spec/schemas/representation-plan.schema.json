{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/schemas/concept/representation-plan.schema.json",
  "title": "RepresentationPlan",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "plan_id", "request_sha256", "subject_profile_sha256", "visual_feature_contract_sha256", "capability_manifest_sha256", "parts"],
  "properties": {
    "schema_version": { "const": "RepresentationPlan@1" },
    "plan_id": { "type": "string", "minLength": 1, "maxLength": 160 },
    "request_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
    "subject_profile_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
    "visual_feature_contract_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
    "capability_manifest_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
    "parts": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "type": "object", "additionalProperties": false, "required": ["part_id", "representation", "capability_id", "covered_feature_ids", "rationale"], "properties": {
      "part_id": { "type": "string", "minLength": 1, "maxLength": 160 },
      "representation": { "enum": ["procedural", "deformable", "mesh_seed", "hybrid"] },
      "capability_id": { "type": "string", "minLength": 1, "maxLength": 160 },
      "covered_feature_ids": { "type": "array", "maxItems": 512, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 160 } },
      "rationale": { "type": "string", "minLength": 1, "maxLength": 1200 }
    } } }
  }
}
