{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/schemas/concept/forge-visual-composition-v2.schema.json",
  "title": "ForgeVisualCompositionV2",
  "description": "FGC-VP202 pure macro and bounded repeat source. It contains no executable expressions, recursion, URL, path, network or dynamic import capability.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "program_id", "domain", "units", "seed", "parameters", "materials", "macros", "calls", "budgets"],
  "properties": {
    "schema_version": { "const": "ForgeVisualComposition@1" },
    "program_id": { "type": "string", "pattern": "^visual_[a-z0-9_-]+$", "maxLength": 96 },
    "domain": { "type": "string", "minLength": 1, "maxLength": 96 },
    "units": { "const": "millimeter" },
    "seed": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
    "parameters": { "type": "array", "maxItems": 64, "items": { "$ref": "forge-visual-program-v2.schema.json#/properties/parameters/items" } },
    "materials": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "forge-visual-program-v2.schema.json#/properties/materials/items" } },
    "macros": {
      "type": "array", "minItems": 1, "maxItems": 64,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["macro_id", "parameters", "items"],
        "properties": {
          "macro_id": { "$ref": "#/$defs/macroId" },
          "parameters": {
            "type": "array", "maxItems": 32,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["local_parameter_id", "kind", "unit"],
              "properties": {
                "local_parameter_id": { "$ref": "#/$defs/localId" },
                "kind": { "enum": ["number", "integer", "length", "angle", "ratio"] },
                "unit": { "enum": ["unitless", "count", "millimeter", "radian", "ratio"] }
              }
            }
          },
          "items": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "#/$defs/macroItem" } }
        }
      }
    },
    "calls": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "#/$defs/call" } },
    "budgets": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "max_macros", "max_macro_calls", "max_expansion_depth", "max_expanded_nodes", "max_parts", "max_materials", "max_outputs", "max_primitives", "triangle_budget"],
      "properties": {
        "schema_version": { "const": "ExpansionBudget@1" },
        "max_macros": { "type": "integer", "minimum": 1, "maximum": 64 },
        "max_macro_calls": { "type": "integer", "minimum": 1, "maximum": 256 },
        "max_expansion_depth": { "type": "integer", "minimum": 1, "maximum": 8 },
        "max_expanded_nodes": { "type": "integer", "minimum": 1, "maximum": 256 },
        "max_parts": { "type": "integer", "minimum": 1, "maximum": 128 },
        "max_materials": { "type": "integer", "minimum": 1, "maximum": 64 },
        "max_outputs": { "type": "integer", "minimum": 1, "maximum": 128 },
        "max_primitives": { "type": "integer", "minimum": 1, "maximum": 256 },
        "triangle_budget": { "type": "integer", "minimum": 100, "maximum": 100000 }
      }
    }
  },
  "$defs": {
    "macroId": { "type": "string", "pattern": "^macro_[a-z0-9_-]+$", "maxLength": 96 },
    "callId": { "type": "string", "pattern": "^call_[a-z0-9_-]+$", "maxLength": 96 },
    "chainId": { "type": "string", "pattern": "^chain_[a-z0-9_-]+$", "maxLength": 96 },
    "localId": { "type": "string", "pattern": "^local_[a-z0-9_-]+$", "maxLength": 96 },
    "scopedScalar": {
      "anyOf": [
        { "type": "number" },
        { "type": "object", "additionalProperties": false, "required": ["parameter_id"], "properties": { "parameter_id": { "type": "string", "pattern": "^param_[a-z0-9_-]+$", "maxLength": 128 } } },
        { "type": "object", "additionalProperties": false, "required": ["local_parameter_id"], "properties": { "local_parameter_id": { "$ref": "#/$defs/localId" } } }
      ]
    },
    "scopedVector3": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "$ref": "#/$defs/scopedScalar" } },
    "scopedCount": {
      "anyOf": [
        { "type": "integer", "minimum": 1, "maximum": 64 },
        { "type": "object", "additionalProperties": false, "required": ["parameter_id"], "properties": { "parameter_id": { "type": "string", "pattern": "^param_[a-z0-9_-]+$" } } },
        { "type": "object", "additionalProperties": false, "required": ["local_parameter_id"], "properties": { "local_parameter_id": { "$ref": "#/$defs/localId" } } }
      ]
    },
    "binding": {
      "type": "object", "additionalProperties": false,
      "required": ["local_parameter_id", "value"],
      "properties": { "local_parameter_id": { "$ref": "#/$defs/localId" }, "value": { "$ref": "#/$defs/scopedScalar" } }
    },
    "repeat": {
      "type": "object", "additionalProperties": false,
      "required": ["count", "step"],
      "properties": { "count": { "$ref": "#/$defs/scopedCount" }, "step": { "$ref": "#/$defs/scopedVector3" } }
    },
    "call": {
      "type": "object", "additionalProperties": false,
      "required": ["call_id", "macro_id", "bindings", "repeat"],
      "properties": {
        "call_id": { "$ref": "#/$defs/callId" },
        "macro_id": { "$ref": "#/$defs/macroId" },
        "bindings": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/binding" } },
        "repeat": { "$ref": "#/$defs/repeat" }
      }
    },
    "primitive": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["primitive_kind", "size"], "properties": { "primitive_kind": { "const": "box" }, "size": { "$ref": "#/$defs/scopedVector3" } } },
        { "type": "object", "additionalProperties": false, "required": ["primitive_kind", "radius", "height"], "properties": { "primitive_kind": { "const": "cylinder" }, "radius": { "$ref": "#/$defs/scopedScalar" }, "height": { "$ref": "#/$defs/scopedScalar" } } }
      ]
    },
    "macroItem": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "chain_id", "primitive", "position", "rotation", "role", "material_id"],
          "properties": {
            "kind": { "const": "chain" }, "chain_id": { "$ref": "#/$defs/chainId" }, "primitive": { "$ref": "#/$defs/primitive" },
            "position": { "$ref": "#/$defs/scopedVector3" }, "rotation": { "$ref": "#/$defs/scopedVector3" },
            "role": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{1,63}$" }, "material_id": { "type": "string", "pattern": "^mat_[a-z0-9_-]+$" }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "call_id", "macro_id", "bindings", "repeat"],
          "properties": { "kind": { "const": "invoke" }, "call_id": { "$ref": "#/$defs/callId" }, "macro_id": { "$ref": "#/$defs/macroId" }, "bindings": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/binding" } }, "repeat": { "$ref": "#/$defs/repeat" } }
        }
      ]
    }
  }
}
