{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/schemas/visual-program-execution-receipt-v1.schema.json",
  "title": "VisualProgramExecutionReceiptV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "receipt_id", "session_id", "authoring_count", "patch_count", "source_program_sha256", "expanded_program_sha256", "shape_program_sha256", "phases", "usage", "cancelled"],
  "properties": {
    "schema_version": {"const": "VisualProgramExecutionReceipt@1"},
    "receipt_id": {"$ref": "#/$defs/id"},
    "session_id": {"$ref": "#/$defs/id"},
    "authoring_count": {"const": 1},
    "patch_count": {"type": "integer", "minimum": 0, "maximum": 1},
    "source_program_sha256": {"$ref": "#/$defs/hash"},
    "expanded_program_sha256": {"$ref": "#/$defs/hash"},
    "shape_program_sha256": {"$ref": "#/$defs/hash"},
    "glb_sha256": {"$ref": "#/$defs/hash"},
    "phases": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/phase"}},
    "usage": {"$ref": "#/$defs/usage"},
    "cancelled": {"type": "boolean"},
    "failure_code": {"$ref": "#/$defs/id"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9_.@-]{1,128}$"},
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "phase": {"type": "object", "additionalProperties": false, "required": ["sequence", "phase", "duration_ms", "input_sha256", "output_sha256", "cache"], "properties": {"sequence": {"type": "integer", "minimum": 1, "maximum": 32}, "phase": {"enum": ["author", "validate", "expand", "lower", "compile_readback", "render", "evaluate", "patch", "preview"]}, "duration_ms": {"type": "integer", "minimum": 0, "maximum": 240000}, "input_sha256": {"$ref": "#/$defs/hash"}, "output_sha256": {"$ref": "#/$defs/hash"}, "cache": {"enum": ["hit", "miss", "not_applicable"]}, "fragment_cache_hit_operation_ids": {"type": "array", "maxItems": 1024, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "fragment_cache_miss_operation_ids": {"type": "array", "maxItems": 1024, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}}},
    "usage": {"type": "object", "additionalProperties": false, "required": ["provider_requests", "product_tool_calls", "input_tokens", "output_tokens", "prompt_cache_hit_tokens", "prompt_cache_miss_tokens", "estimated_cost_microusd"], "properties": {"provider_requests": {"type": "integer", "minimum": 0, "maximum": 2}, "product_tool_calls": {"type": "integer", "minimum": 0, "maximum": 65535}, "input_tokens": {"type": "integer", "minimum": 0}, "output_tokens": {"type": "integer", "minimum": 0}, "prompt_cache_hit_tokens": {"type": "integer", "minimum": 0}, "prompt_cache_miss_tokens": {"type": "integer", "minimum": 0}, "estimated_cost_microusd": {"type": "integer", "minimum": 0}}}
  }
}
