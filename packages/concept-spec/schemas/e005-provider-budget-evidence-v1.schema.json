{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/schemas/e005-provider-budget-evidence-v1.schema.json",
  "title": "E005ProviderBudgetEvidenceV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "authorization_id",
    "authorization_binding_sha256",
    "reservation_id",
    "task_id",
    "task_payload_sha256",
    "request_sha256",
    "provider_id",
    "model_id",
    "call_kind",
    "call_number",
    "kind_call_number",
    "settlement",
    "network_call_made",
    "outcome_code",
    "reserved_input_tokens",
    "reserved_output_tokens",
    "reserved_cost_ceiling_microusd",
    "author_calls_accounted_after",
    "patch_calls_accounted_after",
    "calls_accounted_after",
    "accounted_input_tokens_after",
    "accounted_output_tokens_after",
    "accounted_cost_ceiling_microusd_after",
    "settled_at_unix_ms"
  ],
  "properties": {
    "schema_version": {"const": "E005ProviderBudgetEvidence@1"},
    "authorization_id": {"$ref": "#/$defs/id"},
    "authorization_binding_sha256": {"$ref": "#/$defs/hash"},
    "reservation_id": {"$ref": "#/$defs/id"},
    "task_id": {"$ref": "#/$defs/id"},
    "task_payload_sha256": {"$ref": "#/$defs/hash"},
    "request_sha256": {"$ref": "#/$defs/hash"},
    "provider_id": {"$ref": "#/$defs/id"},
    "model_id": {"$ref": "#/$defs/id"},
    "call_kind": {"enum": ["author", "patch"]},
    "call_number": {"type": "integer", "minimum": 1, "maximum": 60},
    "kind_call_number": {"type": "integer", "minimum": 1, "maximum": 30},
    "settlement": {"enum": ["accounted", "released"]},
    "network_call_made": {"type": "boolean"},
    "outcome_code": {
      "enum": [
        "PRE_DISPATCH_RELEASED",
        "PROVIDER_COMPLETED_PASSED",
        "PROVIDER_COMPLETED_REPAIRABLE",
        "PROVIDER_COMPLETED_FAILED",
        "PROVIDER_TIMEOUT",
        "PROVIDER_CANCELLED",
        "PROVIDER_TRANSPORT_FAILED",
        "RECOVERED_UNCERTAIN_DISPATCH"
      ]
    },
    "output_source_sha256": {"$ref": "#/$defs/hash"},
    "output_gate_sha256": {"$ref": "#/$defs/hash"},
    "reserved_input_tokens": {"type": "integer", "minimum": 1},
    "reserved_output_tokens": {"type": "integer", "minimum": 1},
    "reserved_cost_ceiling_microusd": {"type": "integer", "minimum": 1},
    "author_calls_accounted_after": {"type": "integer", "minimum": 0, "maximum": 30},
    "patch_calls_accounted_after": {"type": "integer", "minimum": 0, "maximum": 30},
    "calls_accounted_after": {"type": "integer", "minimum": 0, "maximum": 60},
    "accounted_input_tokens_after": {"type": "integer", "minimum": 0},
    "accounted_output_tokens_after": {"type": "integer", "minimum": 0},
    "accounted_cost_ceiling_microusd_after": {"type": "integer", "minimum": 0},
    "settled_at_unix_ms": {"type": "integer", "minimum": 0}
  },
  "allOf": [
    {
      "if": {"properties": {"settlement": {"const": "accounted"}}, "required": ["settlement"]},
      "then": {"properties": {"network_call_made": {"const": true}}}
    },
    {
      "if": {"properties": {"settlement": {"const": "released"}}, "required": ["settlement"]},
      "then": {
        "properties": {
          "network_call_made": {"const": false},
          "outcome_code": {"const": "PRE_DISPATCH_RELEASED"}
        },
        "not": {
          "anyOf": [
            {"required": ["output_source_sha256"]},
            {"required": ["output_gate_sha256"]}
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome_code": {"enum": ["PROVIDER_COMPLETED_PASSED", "PROVIDER_COMPLETED_REPAIRABLE"]}
        },
        "required": ["outcome_code"]
      },
      "then": {"required": ["output_source_sha256", "output_gate_sha256"]}
    }
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9_.@-]{3,160}$"},
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
