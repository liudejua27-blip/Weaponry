{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/schemas/concept/reference-appearance-projection-receipt.schema.json",
  "title": "ReferenceAppearanceProjectionReceipt",
  "description": "Hash-only Rust-owned proof that sealed reference pixels were rasterized into one final UAS@2 PBR GLB.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_request_sha256", "source_program_sha256", "final_glb_sha256", "compile_readback_sha256", "worker_receipt_sha256", "worker_schema_version", "algorithm_id", "algorithm_version", "projection_id", "projection_sha256", "source_evidence_id", "source_image_sha256", "camera_hypothesis_id", "camera_provenance_sha256", "target_material_zone_id", "base_color_texture_id", "base_color_sha256", "base_color_byte_size", "unobserved_texel_mask_id", "unobserved_texel_mask_sha256", "unobserved_texel_mask_byte_size", "observed_texel_count", "unobserved_texel_count", "fusion_count", "raster_triangle_count", "source_evidence_ids", "source_image_sha256s", "camera_hypothesis_ids", "camera_provenance_sha256s", "world_to_clip_sha256s"],
  "properties": {
    "schema_version": { "const": "ReferenceAppearanceProjectionReceipt@1" },
    "source_request_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
    "source_program_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
    "final_glb_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
    "compile_readback_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
    "worker_receipt_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
    "worker_schema_version": { "enum": ["ReferenceCameraUvRasterBakeReceipt@2", "ReferenceCameraUvRasterFusionReceipt@3"] },
    "algorithm_id": { "const": "forgecad.reference_camera_uv_raster" },
    "algorithm_version": { "const": "1" },
    "projection_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "projection_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
    "source_evidence_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "source_image_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
    "camera_hypothesis_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "camera_provenance_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
    "target_material_zone_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "base_color_texture_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "base_color_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
    "base_color_byte_size": { "type": "integer", "minimum": 1 },
    "unobserved_texel_mask_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "unobserved_texel_mask_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
    "unobserved_texel_mask_byte_size": { "type": "integer", "minimum": 1 },
    "observed_texel_count": { "type": "integer", "minimum": 1 },
    "unobserved_texel_count": { "type": "integer", "minimum": 1 },
    "fusion_count": { "type": "integer", "enum": [1, 2] },
    "raster_triangle_count": { "type": "integer", "minimum": 1 },
    "world_to_clip_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
    "source_evidence_ids": { "type": "array", "maxItems": 2, "items": { "type": "string", "minLength": 1, "maxLength": 200 } },
    "source_image_sha256s": { "type": "array", "maxItems": 2, "items": { "$ref": "common.schema.json#/$defs/sha256" } },
    "camera_hypothesis_ids": { "type": "array", "maxItems": 2, "items": { "type": "string", "minLength": 1, "maxLength": 200 } },
    "camera_provenance_sha256s": { "type": "array", "maxItems": 2, "items": { "$ref": "common.schema.json#/$defs/sha256" } },
    "world_to_clip_sha256s": { "type": "array", "maxItems": 2, "items": { "$ref": "common.schema.json#/$defs/sha256" } }
  }
}
