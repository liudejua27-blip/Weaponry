{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/schemas/e005-structural-difference-matrix-v1.schema.json",
  "title": "E005StructuralDifferenceMatrixV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "matrix_id",
    "task_set_sha256",
    "run_receipts_sha256",
    "status",
    "entry_count",
    "entries",
    "entries_sha256",
    "pair_count",
    "comparisons",
    "comparisons_sha256",
    "structurally_distinct_pair_count",
    "matrix_pass"
  ],
  "properties": {
    "schema_version": {"const": "E005StructuralDifferenceMatrix@1"},
    "matrix_id": {"$ref": "#/$defs/id"},
    "task_set_sha256": {"$ref": "#/$defs/hash"},
    "run_receipts_sha256": {"$ref": "#/$defs/hash"},
    "status": {"enum": ["not_run", "complete"]},
    "entry_count": {"type": "integer", "minimum": 0, "maximum": 30},
    "entries": {
      "type": "array",
      "maxItems": 30,
      "items": {"$ref": "#/$defs/entry"}
    },
    "entries_sha256": {"$ref": "#/$defs/hash"},
    "pair_count": {"type": "integer", "minimum": 0, "maximum": 435},
    "comparisons": {
      "type": "array",
      "maxItems": 435,
      "items": {"$ref": "#/$defs/comparison"}
    },
    "comparisons_sha256": {"$ref": "#/$defs/hash"},
    "structurally_distinct_pair_count": {"type": "integer", "minimum": 0, "maximum": 435},
    "matrix_pass": {"type": "boolean"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "not_run"}}, "required": ["status"]},
      "then": {
        "properties": {
          "entry_count": {"const": 0},
          "entries": {"maxItems": 0},
          "pair_count": {"const": 0},
          "comparisons": {"maxItems": 0},
          "structurally_distinct_pair_count": {"const": 0},
          "matrix_pass": {"const": false}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "complete"}}, "required": ["status"]},
      "then": {
        "properties": {
          "entry_count": {"const": 30},
          "entries": {"minItems": 30},
          "pair_count": {"const": 435},
          "comparisons": {"minItems": 435},
          "structurally_distinct_pair_count": {"const": 435},
          "matrix_pass": {"const": true}
        }
      }
    }
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9_.@-]{3,128}$"},
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "run_id",
        "run_receipt_sha256",
        "structural_descriptor_sha256",
        "semantic_structure_sha256",
        "normalized_geometry_sha256",
        "topology_signature_sha256",
        "operation_sequence_sha256",
        "profile_signature_sha256",
        "part_zone_signature_sha256",
        "bounds_mm",
        "glb_sha256"
      ],
      "properties": {
        "task_id": {"$ref": "#/$defs/id"},
        "run_id": {"$ref": "#/$defs/id"},
        "run_receipt_sha256": {"$ref": "#/$defs/hash"},
        "structural_descriptor_sha256": {"$ref": "#/$defs/hash"},
        "semantic_structure_sha256": {"$ref": "#/$defs/hash"},
        "normalized_geometry_sha256": {"$ref": "#/$defs/hash"},
        "topology_signature_sha256": {"$ref": "#/$defs/hash"},
        "operation_sequence_sha256": {"$ref": "#/$defs/hash"},
        "profile_signature_sha256": {"$ref": "#/$defs/hash"},
        "part_zone_signature_sha256": {"$ref": "#/$defs/hash"},
        "bounds_mm": {
          "type": "array",
          "items": {"type": "number", "exclusiveMinimum": 0, "maximum": 100000},
          "minItems": 3,
          "maxItems": 3
        },
        "glb_sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_a",
        "task_b",
        "same_morphology_family",
        "difference_axes",
        "same_semantic_structure",
        "same_normalized_geometry",
        "clone_class",
        "failure_codes",
        "structurally_distinct"
      ],
      "properties": {
        "task_a": {"$ref": "#/$defs/id"},
        "task_b": {"$ref": "#/$defs/id"},
        "same_morphology_family": {"type": "boolean"},
        "difference_axes": {
          "type": "array",
          "maxItems": 6,
          "uniqueItems": true,
          "items": {"enum": ["topology", "operation_sequence", "profile", "part_zone", "bounds", "glb"]}
        },
        "same_semantic_structure": {"type": "boolean"},
        "same_normalized_geometry": {"type": "boolean"},
        "clone_class": {"enum": ["none", "same_topology_parametric_clone", "material_or_scale_clone", "same_structure_and_geometry"]},
        "failure_codes": {
          "type": "array",
          "maxItems": 2,
          "uniqueItems": true,
          "items": {"enum": ["E005_STRUCTURAL_PARAMETRIC_CLONE", "E005_STRUCTURAL_MATERIAL_OR_SCALE_CLONE"]}
        },
        "structurally_distinct": {"type": "boolean"}
      }
    }
  }
}
