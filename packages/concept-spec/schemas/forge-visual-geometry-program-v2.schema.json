{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/schemas/forge-visual-geometry-program-v2.schema.json",
  "title": "ForgeVisualGeometryProgramV2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","program_id","domain","units","seed","materials","profiles","section_sets","nodes","outputs","budgets"],
  "properties": {
    "schema_version": {"const": "ForgeVisualGeometryProgram@2"},
    "program_id": {"type":"string","pattern":"^visual_[a-z0-9_-]+$","maxLength":96},
    "domain": {"type":"string","minLength":1,"maxLength":96},
    "units": {"const":"millimeter"},
    "seed": {"type":"integer","minimum":0,"maximum":2147483647},
    "materials": {"type":"array","minItems":1,"maxItems":64,"items":{"$ref":"#/$defs/material"}},
    "profiles": {"type":"array","minItems":1,"maxItems":32,"items":{"$ref":"#/$defs/profile"}},
    "section_sets": {"type":"array","maxItems":16,"items":{"$ref":"#/$defs/section_set"}},
    "nodes": {"type":"array","minItems":1,"maxItems":256,"items":{"$ref":"#/$defs/node"}},
    "outputs": {"type":"array","minItems":1,"maxItems":128,"items":{"$ref":"#/$defs/output"}},
    "budgets": {"$ref":"#/$defs/budget"}
  },
  "$defs": {
    "id": {"type":"string","pattern":"^[a-z][a-z0-9_-]+$","maxLength":96},
    "positive": {"type":"number","exclusiveMinimum":0,"maximum":100000},
    "bounded": {"type":"number","minimum":-100000,"maximum":100000},
    "point2": {"type":"array","prefixItems":[{"type":"number","minimum":-1,"maximum":1},{"type":"number","minimum":-1,"maximum":1}],"items":false,"minItems":2,"maxItems":2},
    "point3": {"type":"array","prefixItems":[{"$ref":"#/$defs/bounded"},{"$ref":"#/$defs/bounded"},{"$ref":"#/$defs/bounded"}],"items":false,"minItems":3,"maxItems":3},
    "scale2": {"type":"array","prefixItems":[{"$ref":"#/$defs/positive"},{"$ref":"#/$defs/positive"}],"items":false,"minItems":2,"maxItems":2},
    "size3": {"type":"array","prefixItems":[{"$ref":"#/$defs/positive"},{"$ref":"#/$defs/positive"},{"$ref":"#/$defs/positive"}],"items":false,"minItems":3,"maxItems":3},
    "axis": {"enum":["x","y","z"]},
    "material": {
      "type":"object","additionalProperties":false,"required":["material_id","base_material_id"],
      "properties":{"material_id":{"type":"string","pattern":"^mat_[a-z0-9_-]+$"},"base_material_id":{"type":"string","pattern":"^mat_[a-z0-9_-]+$"}}
    },
    "profile": {
      "type":"object","additionalProperties":false,"required":["profile_id","points","resample_count"],
      "properties":{"profile_id":{"type":"string","pattern":"^profile_[a-z0-9_-]+$"},"points":{"type":"array","minItems":3,"maxItems":32,"items":{"$ref":"#/$defs/point2"}},"resample_count":{"type":"integer","minimum":8,"maximum":256}}
    },
    "section": {
      "type":"object","additionalProperties":false,"required":["section_id","position","profile_id","scale","twist_degrees","cap_policy"],
      "properties":{"section_id":{"type":"string","pattern":"^section_[a-z0-9_-]+$"},"position":{"type":"number","minimum":-1,"maximum":1},"profile_id":{"type":"string","pattern":"^profile_[a-z0-9_-]+$"},"scale":{"type":"number","minimum":0.25,"maximum":4},"twist_degrees":{"type":"number","minimum":-45,"maximum":45},"cap_policy":{"enum":["none","start","end"]}}
    },
    "section_set": {
      "type":"object","additionalProperties":false,"required":["section_set_id","main_axis","sections"],
      "properties":{"section_set_id":{"type":"string","pattern":"^sectionset_[a-z0-9_-]+$"},"main_axis":{"$ref":"#/$defs/axis"},"sections":{"type":"array","minItems":2,"maxItems":12,"items":{"$ref":"#/$defs/section"}}}
    },
    "node_base": {"type":"object","required":["kind","node_id"],"properties":{"node_id":{"type":"string","pattern":"^node_[a-z0-9_-]+$"}}},
    "node": {"oneOf":[
      {"type":"object","additionalProperties":false,"required":["kind","node_id","size","position"],"properties":{"kind":{"const":"box"},"node_id":{"type":"string","pattern":"^node_[a-z0-9_-]+$"},"size":{"$ref":"#/$defs/size3"},"position":{"$ref":"#/$defs/point3"}}},
      {"type":"object","additionalProperties":false,"required":["kind","node_id","profile_id","profile_scale","height","position","cap_start","cap_end"],"properties":{"kind":{"const":"extrude"},"node_id":{"type":"string","pattern":"^node_[a-z0-9_-]+$"},"profile_id":{"type":"string","pattern":"^profile_[a-z0-9_-]+$"},"profile_scale":{"$ref":"#/$defs/scale2"},"height":{"$ref":"#/$defs/positive"},"position":{"$ref":"#/$defs/point3"},"cap_start":{"type":"boolean"},"cap_end":{"type":"boolean"}}},
      {"type":"object","additionalProperties":false,"required":["kind","node_id","profile_id","profile_scale","angle","radial_segments","position"],"properties":{"kind":{"const":"revolve"},"node_id":{"type":"string","pattern":"^node_[a-z0-9_-]+$"},"profile_id":{"type":"string","pattern":"^profile_[a-z0-9_-]+$"},"profile_scale":{"$ref":"#/$defs/scale2"},"angle":{"type":"number","exclusiveMinimum":0,"maximum":6.283185307179586},"radial_segments":{"type":"integer","minimum":8,"maximum":64},"position":{"$ref":"#/$defs/point3"}}},
      {"type":"object","additionalProperties":false,"required":["kind","node_id","section_set_id","cross_section_scale","axis_length","position"],"properties":{"kind":{"const":"loft"},"node_id":{"type":"string","pattern":"^node_[a-z0-9_-]+$"},"section_set_id":{"type":"string","pattern":"^sectionset_[a-z0-9_-]+$"},"cross_section_scale":{"$ref":"#/$defs/scale2"},"axis_length":{"$ref":"#/$defs/positive"},"position":{"$ref":"#/$defs/point3"}}},
      {"type":"object","additionalProperties":false,"required":["kind","node_id","profile_id","profile_scale","path_points","path_closed","path_twist_degrees","cap_start","cap_end","position"],"properties":{"kind":{"const":"sweep"},"node_id":{"type":"string","pattern":"^node_[a-z0-9_-]+$"},"profile_id":{"type":"string","pattern":"^profile_[a-z0-9_-]+$"},"profile_scale":{"$ref":"#/$defs/scale2"},"path_points":{"type":"array","minItems":2,"maxItems":32,"items":{"$ref":"#/$defs/point3"}},"path_closed":{"type":"boolean"},"path_twist_degrees":{"type":"number","minimum":-90,"maximum":90},"cap_start":{"type":"boolean"},"cap_end":{"type":"boolean"},"position":{"$ref":"#/$defs/point3"}}},
      {"type":"object","additionalProperties":false,"required":["kind","node_id","input_node_id","axis"],"properties":{"kind":{"const":"mirror"},"node_id":{"type":"string","pattern":"^node_[a-z0-9_-]+$"},"input_node_id":{"type":"string","pattern":"^node_[a-z0-9_-]+$"},"axis":{"$ref":"#/$defs/axis"}}},
      {"type":"object","additionalProperties":false,"required":["kind","node_id","input_node_id","axis","count","spacing"],"properties":{"kind":{"const":"array"},"node_id":{"type":"string","pattern":"^node_[a-z0-9_-]+$"},"input_node_id":{"type":"string","pattern":"^node_[a-z0-9_-]+$"},"axis":{"$ref":"#/$defs/axis"},"count":{"type":"integer","minimum":2,"maximum":64},"spacing":{"$ref":"#/$defs/positive"}}},
      {"type":"object","additionalProperties":false,"required":["kind","node_id","input_node_ids"],"properties":{"kind":{"enum":["union","subtract"]},"node_id":{"type":"string","pattern":"^node_[a-z0-9_-]+$"},"input_node_ids":{"type":"array","minItems":2,"maxItems":8,"uniqueItems":true,"items":{"type":"string","pattern":"^node_[a-z0-9_-]+$"}}}},
      {"type":"object","additionalProperties":false,"required":["kind","node_id","input_node_id","part_id","role"],"properties":{"kind":{"const":"part"},"node_id":{"type":"string","pattern":"^node_[a-z0-9_-]+$"},"input_node_id":{"type":"string","pattern":"^node_[a-z0-9_-]+$"},"part_id":{"type":"string","pattern":"^part_[a-z0-9_-]+$"},"role":{"type":"string","pattern":"^[a-z][a-z0-9_-]+$","maxLength":64}}},
      {"type":"object","additionalProperties":false,"required":["kind","node_id","input_node_id","zone_id","material_id"],"properties":{"kind":{"const":"material_zone"},"node_id":{"type":"string","pattern":"^node_[a-z0-9_-]+$"},"input_node_id":{"type":"string","pattern":"^node_[a-z0-9_-]+$"},"zone_id":{"type":"string","pattern":"^zone_[a-z0-9_-]+$"},"material_id":{"type":"string","pattern":"^mat_[a-z0-9_-]+$"}}}
    ]},
    "output": {"type":"object","additionalProperties":false,"required":["output_id","node_id"],"properties":{"output_id":{"type":"string","pattern":"^output_[a-z0-9_-]+$"},"node_id":{"type":"string","pattern":"^node_[a-z0-9_-]+$"}}},
    "budget": {"type":"object","additionalProperties":false,"required":["schema_version","max_profiles","max_section_sets","max_nodes","max_parts","max_materials","max_outputs","max_operations","triangle_budget"],"properties":{"schema_version":{"const":"GeometryProgramBudget@1"},"max_profiles":{"type":"integer","minimum":1,"maximum":32},"max_section_sets":{"type":"integer","minimum":0,"maximum":16},"max_nodes":{"type":"integer","minimum":1,"maximum":256},"max_parts":{"type":"integer","minimum":1,"maximum":128},"max_materials":{"type":"integer","minimum":1,"maximum":64},"max_outputs":{"type":"integer","minimum":1,"maximum":128},"max_operations":{"type":"integer","minimum":1,"maximum":256},"triangle_budget":{"type":"integer","minimum":100,"maximum":100000}}}
  }
}
