{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/schemas/forge-visual-author-source-v1.schema.json",
  "title": "ForgeVisualAuthorSourceV1",
  "description": "E005-R1 compact formal author envelope. It composes existing VP203 geometry templates with typed parameters, bounded macro instances, rigid assembly hierarchy, surface intent and detail-motif lineage; it cannot execute arbitrary code or external resources.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "program_id", "domain", "units", "seed", "parameters", "geometry_templates", "macros", "instances", "root_part", "surface_bindings", "budgets"],
  "properties": {
    "schema_version": {"const": "ForgeVisualAuthorSource@1"},
    "program_id": {"type": "string", "pattern": "^visual_[a-z0-9_-]+$", "maxLength": 96},
    "domain": {"type": "string", "minLength": 1, "maxLength": 96},
    "units": {"const": "millimeter"},
    "seed": {"type": "integer", "minimum": 0, "maximum": 2147483647},
    "parameters": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/parameter"}},
    "geometry_templates": {"$ref": "forge-visual-geometry-program-v2.schema.json"},
    "macros": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/macro"}},
    "instances": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/instance"}},
    "root_part": {"$ref": "#/$defs/part_ref"},
    "surface_bindings": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/surface_binding"}},
    "budgets": {"$ref": "#/$defs/budget"}
  },
  "$defs": {
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parameter_id", "kind", "unit", "default", "minimum", "maximum", "allowed_values"],
      "properties": {
        "parameter_id": {"type": "string", "pattern": "^param_[a-z0-9_-]+$", "maxLength": 96},
        "kind": {"enum": ["number", "integer", "boolean", "enum", "length", "angle", "ratio", "color"]},
        "unit": {"enum": ["unitless", "count", "boolean", "enum_value", "millimeter", "radian", "ratio", "linear_rgb"]},
        "default": {},
        "minimum": {"type": ["number", "null"]},
        "maximum": {"type": ["number", "null"]},
        "allowed_values": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "maxLength": 96}}
      }
    },
    "scalar": {
      "oneOf": [
        {"type": "number", "minimum": -100000, "maximum": 100000},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["parameter_id"],
          "properties": {"parameter_id": {"type": "string", "pattern": "^param_[a-z0-9_-]+$", "maxLength": 96}}
        }
      ]
    },
    "count": {
      "oneOf": [
        {"type": "integer", "minimum": 1, "maximum": 64},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["parameter_id"],
          "properties": {"parameter_id": {"type": "string", "pattern": "^param_[a-z0-9_-]+$", "maxLength": 96}}
        }
      ]
    },
    "vec3_scalar": {
      "type": "array",
      "prefixItems": [{"$ref": "#/$defs/scalar"}, {"$ref": "#/$defs/scalar"}, {"$ref": "#/$defs/scalar"}],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "macro": {
      "type": "object",
      "additionalProperties": false,
      "required": ["macro_id", "semantic_kind", "output_ids"],
      "properties": {
        "macro_id": {"type": "string", "pattern": "^macro_[a-z0-9_-]+$", "maxLength": 96},
        "semantic_kind": {"enum": ["primary_form", "structural_form", "detail_motif"]},
        "output_ids": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "pattern": "^output_[a-z0-9_-]+$", "maxLength": 96}}
      }
    },
    "part_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instance_id", "repeat_index", "output_id"],
      "properties": {
        "instance_id": {"type": "string", "pattern": "^instance_[a-z0-9_-]+$", "maxLength": 96},
        "repeat_index": {"type": "integer", "minimum": 0, "maximum": 63},
        "output_id": {"type": "string", "pattern": "^output_[a-z0-9_-]+$", "maxLength": 96}
      }
    },
    "instance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instance_id", "macro_id", "transform", "repeat"],
      "properties": {
        "instance_id": {"type": "string", "pattern": "^instance_[a-z0-9_-]+$", "maxLength": 96},
        "macro_id": {"type": "string", "pattern": "^macro_[a-z0-9_-]+$", "maxLength": 96},
        "transform": {
          "type": "object",
          "additionalProperties": false,
          "required": ["position", "rotation"],
          "properties": {"position": {"$ref": "#/$defs/vec3_scalar"}, "rotation": {"$ref": "#/$defs/vec3_scalar"}}
        },
        "repeat": {
          "type": "object",
          "additionalProperties": false,
          "required": ["count", "step"],
          "properties": {"count": {"$ref": "#/$defs/count"}, "step": {"$ref": "#/$defs/vec3_scalar"}}
        },
        "parent": {"$ref": "#/$defs/part_ref"}
      }
    },
    "surface_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding_id", "macro_id", "output_id", "material_id", "surface_profile", "edge_wear", "micro_detail"],
      "properties": {
        "binding_id": {"type": "string", "pattern": "^surface_[a-z0-9_-]+$", "maxLength": 96},
        "macro_id": {"type": "string", "pattern": "^macro_[a-z0-9_-]+$", "maxLength": 96},
        "output_id": {"type": "string", "pattern": "^output_[a-z0-9_-]+$", "maxLength": 96},
        "material_id": {"type": "string", "pattern": "^mat_[a-z0-9_-]+$", "maxLength": 96},
        "surface_profile": {"enum": ["painted_metal", "brushed_metal", "dark_inset", "rubberized", "emissive_trim"]},
        "edge_wear": {"type": "number", "minimum": 0, "maximum": 1},
        "micro_detail": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "max_parameters", "max_macros", "max_instances", "max_repeat_count", "max_expanded_nodes", "max_expanded_parts", "max_expanded_outputs", "max_operations", "triangle_budget"],
      "properties": {
        "schema_version": {"const": "ForgeVisualAuthorBudget@1"},
        "max_parameters": {"type": "integer", "minimum": 1, "maximum": 64},
        "max_macros": {"type": "integer", "minimum": 1, "maximum": 64},
        "max_instances": {"type": "integer", "minimum": 1, "maximum": 64},
        "max_repeat_count": {"type": "integer", "minimum": 1, "maximum": 64},
        "max_expanded_nodes": {"type": "integer", "minimum": 1, "maximum": 256},
        "max_expanded_parts": {"type": "integer", "minimum": 1, "maximum": 128},
        "max_expanded_outputs": {"type": "integer", "minimum": 1, "maximum": 128},
        "max_operations": {"type": "integer", "minimum": 1, "maximum": 256},
        "triangle_budget": {"type": "integer", "minimum": 100, "maximum": 100000}
      }
    }
  }
}
