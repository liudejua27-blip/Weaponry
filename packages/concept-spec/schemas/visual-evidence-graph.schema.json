{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/schemas/concept/visual-evidence-graph.schema.json",
  "title": "VisualEvidenceGraph",
  "description": "Bounded provider interpretation of sealed visual evidence. Observations, inferences and unknowns remain explicit and cannot become geometry directly.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "graph_id", "request_id", "request_sha256", "project_id", "domain_pack_id", "provider", "claims"],
  "properties": {
    "schema_version": { "const": "VisualEvidenceGraph@1" },
    "graph_id": { "type": "string", "pattern": "^vegraph_[a-z0-9_\\-]+$", "maxLength": 160 },
    "request_id": { "type": "string", "pattern": "^mmreq_[a-z0-9_\\-]+$", "maxLength": 160 },
    "request_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "project_id": { "type": "string", "pattern": "^(prj|project)_[a-z0-9_\\-]+$", "maxLength": 160 },
    "domain_pack_id": { "type": "string", "pattern": "^pack_[A-Za-z0-9_.:\\-]+$", "maxLength": 160 },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider_id", "model_id", "provider_response_sha256", "analyzed_at"],
      "properties": {
        "provider_id": { "type": "string", "minLength": 1, "maxLength": 120 },
        "model_id": { "type": "string", "minLength": 1, "maxLength": 160 },
        "provider_response_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "analyzed_at": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": { "$ref": "#/$defs/claim" }
    }
  },
  "$defs": {
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["left", "top", "right", "bottom"],
      "properties": {
        "left": { "type": "integer", "minimum": 0, "maximum": 999 },
        "top": { "type": "integer", "minimum": 0, "maximum": 999 },
        "right": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "bottom": { "type": "integer", "minimum": 1, "maximum": 1000 }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_id", "level", "status", "target", "description", "critical", "confidence_bps", "source_evidence_ids"],
      "properties": {
        "claim_id": { "type": "string", "pattern": "^vclaim_[a-z0-9_\\-]+$", "maxLength": 160 },
        "level": { "enum": ["macro", "meso", "micro"] },
        "status": { "enum": ["observed", "inferred", "unknown"] },
        "target": { "enum": ["geometry", "assembly", "material", "surface", "style", "evaluation_only"] },
        "description": { "type": "string", "minLength": 1, "maxLength": 480 },
        "critical": { "type": "boolean" },
        "confidence_bps": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "source_evidence_ids": { "type": "array", "maxItems": 12, "uniqueItems": true, "items": { "type": "string", "pattern": "^refevid_[a-z0-9_\\-]+$" } },
        "source_view_id": { "type": ["string", "null"], "minLength": 1, "maxLength": 64 },
        "source_region": { "oneOf": [{ "$ref": "#/$defs/region" }, { "type": "null" }] }
      }
    }
  }
}
