{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/schemas/concept/visual-reference-comparison-report.schema.json",
  "title": "VisualReferenceComparisonReport",
  "description": "Claim-level reference comparison whose scores, repair targets and pass/fail decision are derived and sealed by Rust.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "report_sha256", "comparison_input_sha256", "provider", "assessments", "passed", "failure_codes", "repair_claim_ids"],
  "properties": {
    "schema_version": { "const": "VisualReferenceComparisonReport@1" },
    "report_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "comparison_input_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider_id", "model_id", "provider_response_sha256", "analyzed_at"],
      "properties": {
        "provider_id": { "type": "string", "minLength": 1, "maxLength": 120 },
        "model_id": { "type": "string", "minLength": 1, "maxLength": 160 },
        "provider_response_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "analyzed_at": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    },
    "assessments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "outcome", "similarity_bps", "confidence_bps", "source_evidence_ids", "candidate_view_ids", "reason"],
        "properties": {
          "claim_id": { "type": "string", "pattern": "^vclaim_[A-Za-z0-9_.:\\-]+$", "maxLength": 160 },
          "outcome": { "enum": ["matched", "partial", "contradicted", "not_visible"] },
          "similarity_bps": { "type": "integer", "minimum": 0, "maximum": 10000 },
          "confidence_bps": { "type": "integer", "minimum": 1, "maximum": 10000 },
          "source_evidence_ids": { "type": "array", "minItems": 1, "maxItems": 12, "uniqueItems": true, "items": { "type": "string", "pattern": "^refevid_[A-Za-z0-9_.:\\-]+$" } },
          "candidate_view_ids": { "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": { "enum": ["iso", "front", "back", "left", "right", "top", "gripper_iso", "gripper_front"] } },
          "reason": { "type": "string", "minLength": 1, "maxLength": 320 }
        }
      }
    },
    "macro_similarity_bps": { "type": "integer", "minimum": 0, "maximum": 10000 },
    "meso_similarity_bps": { "type": "integer", "minimum": 0, "maximum": 10000 },
    "micro_similarity_bps": { "type": "integer", "minimum": 0, "maximum": 10000 },
    "passed": { "type": "boolean" },
    "failure_codes": { "type": "array", "maxItems": 16, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z0-9_]+$" } },
    "repair_claim_ids": { "type": "array", "maxItems": 256, "uniqueItems": true, "items": { "type": "string", "pattern": "^vclaim_[A-Za-z0-9_.:\\-]+$" } }
  }
}
