{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/schemas/concept/visual-reference-comparison-report.schema.json",
  "title": "VisualReferenceComparisonReport",
  "description": "Claim-level reference comparison whose scores, repair targets and pass/fail decision are derived and sealed by Rust.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "report_sha256", "comparison_input_sha256", "provider", "assessments", "passed", "failure_codes", "repair_claim_ids"],
  "properties": {
    "schema_version": { "const": "VisualReferenceComparisonReport@2" },
    "report_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "comparison_input_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "budget_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "authorization_id", "authorization_binding_sha256", "reservation_id", "turn_id", "comparison_input_sha256", "call_number", "maximum_calls", "maximum_variable_cost_microusd", "reserved_cost_ceiling_microusd", "settlement", "network_call_made", "calls_accounted_after", "accounted_cost_ceiling_microusd_after", "settled_at_unix_ms"],
      "properties": {
        "schema_version": { "const": "VisualReferenceComparisonBudgetEvidence@1" },
        "authorization_id": { "type": "string", "pattern": "^visauth_[A-Za-z0-9_.:\\-]+$", "maxLength": 160 },
        "authorization_binding_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "reservation_id": { "type": "string", "pattern": "^visreserve_[A-Za-z0-9_.:\\-]+$", "maxLength": 160 },
        "turn_id": { "type": "string", "pattern": "^turn_[A-Za-z0-9_.:\\-]+$", "maxLength": 160 },
        "comparison_input_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "call_number": { "type": "integer", "minimum": 1, "maximum": 3 },
        "maximum_calls": { "const": 3 },
        "maximum_variable_cost_microusd": { "const": 100000 },
        "reserved_cost_ceiling_microusd": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "settlement": { "enum": ["accounted", "released"] },
        "network_call_made": { "type": "boolean" },
        "calls_accounted_after": { "type": "integer", "minimum": 0, "maximum": 3 },
        "accounted_cost_ceiling_microusd_after": { "type": "integer", "minimum": 0, "maximum": 100000 },
        "settled_at_unix_ms": { "type": "integer", "minimum": 0 }
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider_id", "model_id", "provider_response_sha256", "analyzed_at"],
      "properties": {
        "provider_id": { "type": "string", "minLength": 1, "maxLength": 120 },
        "model_id": { "type": "string", "minLength": 1, "maxLength": 160 },
        "provider_response_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "analyzed_at": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    },
    "assessments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "outcome", "similarity_bps", "confidence_bps", "source_evidence_ids", "candidate_view_ids", "reason"],
        "properties": {
          "claim_id": { "type": "string", "pattern": "^vclaim_[A-Za-z0-9_.:\\-]+$", "maxLength": 160 },
          "outcome": { "enum": ["matched", "partial", "contradicted", "not_visible"] },
          "similarity_bps": { "type": "integer", "minimum": 0, "maximum": 10000 },
          "confidence_bps": { "type": "integer", "minimum": 1, "maximum": 10000 },
          "source_evidence_ids": { "type": "array", "minItems": 1, "maxItems": 12, "uniqueItems": true, "items": { "type": "string", "pattern": "^refevid_[A-Za-z0-9_.:\\-]+$" } },
          "candidate_view_ids": { "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": { "enum": ["iso", "front", "back", "left", "right", "top", "gripper_iso", "gripper_front", "turntable_000", "turntable_045", "turntable_090", "turntable_135", "turntable_180", "turntable_225", "turntable_270", "turntable_315"] } },
          "reason": { "type": "string", "minLength": 1, "maxLength": 320 }
        }
      }
    },
    "macro_similarity_bps": { "type": "integer", "minimum": 0, "maximum": 10000 },
    "meso_similarity_bps": { "type": "integer", "minimum": 0, "maximum": 10000 },
    "micro_similarity_bps": { "type": "integer", "minimum": 0, "maximum": 10000 },
    "passed": { "type": "boolean" },
    "failure_codes": { "type": "array", "maxItems": 16, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z0-9_]+$" } },
    "repair_claim_ids": { "type": "array", "maxItems": 256, "uniqueItems": true, "items": { "type": "string", "pattern": "^vclaim_[A-Za-z0-9_.:\\-]+$" } }
  }
}
