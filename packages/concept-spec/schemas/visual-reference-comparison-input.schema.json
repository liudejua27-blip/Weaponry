{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/schemas/concept/visual-reference-comparison-input.schema.json",
  "title": "VisualReferenceComparisonInput",
  "description": "Rust-owned hash-only envelope binding sealed references to the exact candidate GLB and fixed eight-view render set.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_sha256", "evidence_graph_sha256", "program_binding_sha256", "source_program_sha256", "glb_sha256", "acceptance_policy", "reference_sources", "candidate_views"],
  "properties": {
    "schema_version": { "const": "VisualReferenceComparisonInput@2" },
    "request_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "evidence_graph_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "program_binding_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "source_program_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "glb_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "acceptance_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "policy_id", "critical_minimum_bps", "macro_minimum_bps", "meso_minimum_bps", "micro_minimum_bps", "critical_requires_matched", "critical_not_visible_allowed"],
      "properties": {
        "schema_version": { "const": "VisualReferenceAcceptancePolicy@1" },
        "policy_id": { "type": "string", "minLength": 1, "maxLength": 160 },
        "source_contract_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "critical_minimum_bps": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "macro_minimum_bps": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "meso_minimum_bps": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "micro_minimum_bps": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "critical_requires_matched": { "type": "boolean" },
        "critical_not_visible_allowed": { "type": "boolean" }
      }
    },
    "candidate_view_profile": { "enum": ["convergence_eight", "turntable_eight"] },
    "candidate_render_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "renderer_id", "render_manifest_sha256", "visual_environment_id", "visual_environment_sha256", "output_color_space", "tone_mapping"],
      "properties": {
        "schema_version": { "const": "VisualReferenceRenderContract@1" },
        "renderer_id": { "const": "forgecad-workbench-pbr@1" },
        "render_manifest_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "visual_environment_id": { "const": "env_forgecad_room_studio_v2" },
        "visual_environment_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "output_color_space": { "const": "srgb" },
        "tone_mapping": { "const": "aces_filmic" }
      }
    },
    "reference_sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id", "evidence_sha256"],
        "properties": {
          "evidence_id": { "type": "string", "pattern": "^refevid_[A-Za-z0-9_.:\\-]+$", "maxLength": 160 },
          "evidence_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "candidate_views": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["view_id", "glb_sha256", "renderer_id", "image_sha256", "readback_passed"],
        "properties": {
          "view_id": { "enum": ["iso", "front", "back", "left", "right", "top", "gripper_iso", "gripper_front", "turntable_000", "turntable_045", "turntable_090", "turntable_135", "turntable_180", "turntable_225", "turntable_270", "turntable_315"] },
          "glb_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "renderer_id": { "type": "string", "minLength": 1, "maxLength": 120 },
          "image_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "readback_passed": { "const": true }
        }
      }
    }
  }
}
