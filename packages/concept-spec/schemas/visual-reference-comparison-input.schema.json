{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/schemas/concept/visual-reference-comparison-input.schema.json",
  "title": "VisualReferenceComparisonInput",
  "description": "Rust-owned hash-only envelope binding sealed references to the exact candidate GLB and fixed eight-view render set.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_sha256", "evidence_graph_sha256", "program_binding_sha256", "source_program_sha256", "glb_sha256", "reference_sources", "candidate_views"],
  "properties": {
    "schema_version": { "const": "VisualReferenceComparisonInput@1" },
    "request_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "evidence_graph_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "program_binding_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "source_program_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "glb_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "reference_sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id", "evidence_sha256"],
        "properties": {
          "evidence_id": { "type": "string", "pattern": "^refevid_[A-Za-z0-9_.:\\-]+$", "maxLength": 160 },
          "evidence_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "candidate_views": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["view_id", "glb_sha256", "renderer_id", "image_sha256", "readback_passed"],
        "properties": {
          "view_id": { "enum": ["iso", "front", "back", "left", "right", "top", "gripper_iso", "gripper_front"] },
          "glb_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "renderer_id": { "type": "string", "minLength": 1, "maxLength": 120 },
          "image_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "readback_passed": { "const": true }
        }
      }
    }
  }
}
