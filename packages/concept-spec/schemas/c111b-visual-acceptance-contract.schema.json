{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/schemas/c111b-visual-acceptance-contract.schema.json",
  "title": "C111BVisualAcceptanceContract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_id",
    "status",
    "formal_eligible",
    "root_recipe_id",
    "registry_id",
    "authorized_reference",
    "must_show",
    "must_not_show",
    "claims",
    "fixed_views",
    "budgets",
    "independent_human_review",
    "stop_conditions",
    "evidence_lineage"
  ],
  "properties": {
    "schema_version": { "const": "C111BVisualAcceptanceContract@2" },
    "contract_id": { "type": "string", "pattern": "^c111b_[a-z0-9_]+$" },
    "status": { "const": "frozen" },
    "formal_eligible": { "const": false },
    "root_recipe_id": { "const": "recipe_c111_arm_golden_surface" },
    "registry_id": { "const": "registry_c111_golden_surface_robotic_arm_v1" },
    "authorized_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference_set_id", "source_filename", "source_kind", "repository_storage", "sha256", "status"],
      "properties": {
        "reference_set_id": { "type": "string" },
        "source_filename": { "type": "string" },
        "source_kind": { "const": "user_authorized_reference" },
        "repository_storage": { "const": "external_user_authorized" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "status": { "const": "digest_verified" }
      }
    },
    "must_show": { "type": "array", "minItems": 7, "maxItems": 7, "items": { "type": "object" } },
    "must_not_show": { "type": "array", "minItems": 4, "items": { "type": "string", "minLength": 1 } },
    "claims": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "object" } },
    "fixed_views": {
      "type": "array",
      "const": ["iso", "front", "back", "left", "right", "top", "gripper_iso", "gripper_front"]
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["production_triangle_count", "texture", "timing", "provider", "cost"],
      "properties": {
        "production_triangle_count": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minimum", "maximum"],
          "properties": {
            "minimum": { "const": 80000 },
            "maximum": { "const": 150000 }
          }
        },
        "texture": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minimum_resolution", "required_roles", "maximum_map_count"],
          "properties": {
            "minimum_resolution": { "const": 1024 },
            "required_roles": { "type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true, "items": { "enum": ["base_color", "metallic_roughness", "normal", "occlusion", "emissive"] } },
            "maximum_map_count": { "const": 320 }
          }
        },
        "timing": {
          "type": "object",
          "additionalProperties": false,
          "required": ["target_total_seconds", "record_stage_durations", "required_stage_keys"],
          "properties": {
            "target_total_seconds": { "const": 120 },
            "record_stage_durations": { "const": true },
            "required_stage_keys": { "type": "array", "minItems": 6, "maxItems": 6, "uniqueItems": true, "items": { "enum": ["author", "lower", "compile_readback", "render", "evaluate", "preview"] } }
          }
        },
        "provider": {
          "type": "object",
          "additionalProperties": false,
          "required": ["generation", "visual_comparison"],
          "properties": {
            "generation": {
              "type": "object",
              "additionalProperties": false,
              "required": ["network_allowed", "maximum_calls", "record_cache_hits", "record_usage"],
              "properties": {
                "network_allowed": { "const": false },
                "maximum_calls": { "const": 0 },
                "record_cache_hits": { "const": true },
                "record_usage": { "const": true }
              }
            },
            "visual_comparison": {
              "type": "object",
              "additionalProperties": false,
              "required": ["requires_explicit_user_authorization", "network_allowed_when_authorized", "maximum_calls_per_candidate", "maximum_same_intent_repairs", "record_cache_hits", "record_usage"],
              "properties": {
                "requires_explicit_user_authorization": { "const": true },
                "network_allowed_when_authorized": { "const": true },
                "maximum_calls_per_candidate": { "const": 3 },
                "maximum_same_intent_repairs": { "const": 2 },
                "record_cache_hits": { "const": true },
                "record_usage": { "const": true }
              }
            }
          }
        },
        "cost": {
          "type": "object",
          "additionalProperties": false,
          "required": ["currency", "generation_maximum_variable_cost_microusd", "visual_comparison_maximum_variable_cost_microusd", "hard_stop_before_call", "record_estimate"],
          "properties": {
            "currency": { "const": "USD" },
            "generation_maximum_variable_cost_microusd": { "const": 0 },
            "visual_comparison_maximum_variable_cost_microusd": { "const": 100000 },
            "hard_stop_before_call": { "const": true },
            "record_estimate": { "const": true }
          }
        }
      }
    },
    "independent_human_review": { "type": "object" },
    "stop_conditions": { "type": "array", "minItems": 7, "items": { "type": "string", "minLength": 1 } },
    "evidence_lineage": { "type": "object" }
  }
}
