{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/schemas/visual-convergence-input.schema.json",
  "title": "VisualConvergenceInput",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "ledger", "readback", "fixed_views", "detail_coverage", "repairs"],
  "properties": {
    "schema_version": { "const": "VisualConvergenceInput@1" },
    "ledger": { "$ref": "#/$defs/ledger" },
    "readback": { "$ref": "#/$defs/readback" },
    "fixed_views": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/view" }
    },
    "detail_coverage": { "$ref": "#/$defs/detail_coverage" },
    "reference_comparison": { "$ref": "#/$defs/reference_comparison" },
    "repairs": {
      "type": "array",
      "maxItems": 2,
      "items": { "$ref": "#/$defs/repair" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "stage": {
      "type": "string",
      "enum": ["silhouette", "structure", "form", "material", "surface", "lighting", "optimization"]
    },
    "pass": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "input_sha256", "output_sha256", "completed"],
      "properties": {
        "stage": { "$ref": "#/$defs/stage" },
        "input_sha256": { "$ref": "#/$defs/sha256" },
        "output_sha256": { "$ref": "#/$defs/sha256" },
        "completed": { "const": true }
      }
    },
    "ledger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "source_program_sha256", "source_revision", "passes"],
      "properties": {
        "schema_version": { "const": "DesignBuildLedger@1" },
        "source_program_sha256": { "$ref": "#/$defs/sha256" },
        "source_revision": { "type": "integer", "minimum": 1 },
        "passes": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "prefixItems": [
            { "allOf": [{ "$ref": "#/$defs/pass" }, { "properties": { "stage": { "const": "silhouette" } } }] },
            { "allOf": [{ "$ref": "#/$defs/pass" }, { "properties": { "stage": { "const": "structure" } } }] },
            { "allOf": [{ "$ref": "#/$defs/pass" }, { "properties": { "stage": { "const": "form" } } }] },
            { "allOf": [{ "$ref": "#/$defs/pass" }, { "properties": { "stage": { "const": "material" } } }] },
            { "allOf": [{ "$ref": "#/$defs/pass" }, { "properties": { "stage": { "const": "surface" } } }] },
            { "allOf": [{ "$ref": "#/$defs/pass" }, { "properties": { "stage": { "const": "lighting" } } }] },
            { "allOf": [{ "$ref": "#/$defs/pass" }, { "properties": { "stage": { "const": "optimization" } } }] }
          ],
          "items": false
        }
      }
    },
    "readback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["glb_sha256", "shape_program_sha256", "triangle_count", "primitive_count", "material_zone_count", "closed_manifold", "surface_provenance_present", "pbr_channels_complete"],
      "properties": {
        "glb_sha256": { "$ref": "#/$defs/sha256" },
        "shape_program_sha256": { "$ref": "#/$defs/sha256" },
        "triangle_count": { "type": "integer", "minimum": 1 },
        "primitive_count": { "type": "integer", "minimum": 1 },
        "material_zone_count": { "type": "integer", "minimum": 1 },
        "closed_manifold": { "type": "boolean" },
        "surface_provenance_present": { "type": "boolean" },
        "pbr_channels_complete": { "type": "boolean" }
      }
    },
    "view": {
      "type": "object",
      "additionalProperties": false,
      "required": ["view_id", "glb_sha256", "renderer_id", "image_sha256", "readback_passed"],
      "properties": {
        "view_id": { "enum": ["iso", "front", "back", "left", "right", "top", "gripper_iso", "gripper_front"] },
        "glb_sha256": { "$ref": "#/$defs/sha256" },
        "renderer_id": { "type": "string", "minLength": 1, "maxLength": 120 },
        "image_sha256": { "$ref": "#/$defs/sha256" },
        "readback_passed": { "type": "boolean" }
      }
    },
    "detail_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["macro_bound", "meso_bound", "micro_bound", "critical_unresolved"],
      "properties": {
        "macro_bound": { "type": "integer", "minimum": 0 },
        "meso_bound": { "type": "integer", "minimum": 0 },
        "micro_bound": { "type": "integer", "minimum": 0 },
        "critical_unresolved": { "type": "integer", "minimum": 0 }
      }
    },
    "reference_comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["comparison_input_sha256", "comparison_report_sha256", "passed", "failure_codes"],
      "properties": {
        "comparison_input_sha256": { "$ref": "#/$defs/sha256" },
        "comparison_report_sha256": { "$ref": "#/$defs/sha256" },
        "passed": { "type": "boolean" },
        "failure_codes": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 120 }
        }
      }
    },
    "repair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repair_number", "parent_program_sha256", "result_program_sha256", "changed_domains", "same_intent"],
      "properties": {
        "repair_number": { "type": "integer", "minimum": 1, "maximum": 2 },
        "parent_program_sha256": { "$ref": "#/$defs/sha256" },
        "result_program_sha256": { "$ref": "#/$defs/sha256" },
        "changed_domains": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["title", "design_tokens", "parts", "geometry", "assembly", "material", "surface", "detail_inventory", "export_profile"] }
        },
        "same_intent": { "const": true }
      }
    }
  }
}
