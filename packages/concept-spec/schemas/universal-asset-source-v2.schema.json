{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/schemas/concept/universal-asset-source-v2.schema.json",
  "title": "UniversalAssetSourceV2",
  "description": "Rust-derived U004 source envelope. A representation source is a sealed discriminated union of executable branches only: reviewed local procedural, bounded local lattice-deform, local mesh patch, and their per-part local hard-surface hybrid. An unavailable representation is a typed UniversalAuthorOutcome limitation and never creates a UniversalAssetSource.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_id", "state", "request", "request_sha256", "subject_profile", "subject_profile_sha256", "visual_feature_contract", "visual_feature_contract_sha256", "representation_plan", "representation_plan_sha256", "capability_manifest_sha256", "representation_source", "component_sources", "detail_claims", "material_zones", "appearance_compilation", "appearance_evidence"],
  "properties": {
    "schema_version": {"const": "UniversalAssetSource@2"},
    "source_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "state": {"enum": ["planned", "compiled"]},
    "request": {"$ref": "universal-author-request.schema.json"},
    "request_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "subject_profile": {"$ref": "subject-profile.schema.json"},
    "subject_profile_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "visual_feature_contract": {"$ref": "visual-feature-contract.schema.json"},
    "visual_feature_contract_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "representation_plan": {"$ref": "representation-plan.schema.json"},
    "representation_plan_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "capability_manifest_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "representation_source": {"oneOf": [{"$ref": "#/$defs/procedural_source"}, {"$ref": "#/$defs/local_lattice_deform_source"}, {"$ref": "#/$defs/local_mesh_patch_source"}, {"$ref": "#/$defs/local_hard_surface_hybrid_source"}]},
    "component_sources": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "universal-asset-source.schema.json#/$defs/component_source"}},
    "detail_claims": {"type": "array", "minItems": 1, "maxItems": 512, "items": {"$ref": "visual-detail-claim-v2.schema.json"}},
    "material_zones": {"type": "array", "maxItems": 128, "items": {"$ref": "material-zone-appearance.schema.json"}},
    "appearance_compilation": {"$ref": "#/$defs/appearance_compilation"},
    "appearance_evidence": {"$ref": "appearance-evidence-bundle.schema.json"},
    "game_asset_profile": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/game_asset_profile"}]},
    "game_asset_delivery": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/game_asset_delivery_readback"}]},
    "compiled_artifact": {"oneOf": [{"type": "null"}, {"$ref": "universal-asset-source.schema.json#/$defs/compiled_artifact"}]}
  },
  "$defs": {
    "game_asset_profile": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "profile_id", "lod_triangle_budgets", "collision_proxy_part_ids", "sockets", "target_texel_density_pixels_per_meter"],
      "properties": {
        "schema_version": {"const": "GameAssetProfile@1"},
        "profile_id": {"type": "string", "minLength": 1, "maxLength": 160},
        "lod_triangle_budgets": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "integer", "minimum": 1, "maximum": 150000}},
        "collision_proxy_part_ids": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"type": "string", "minLength": 1, "maxLength": 160}, "uniqueItems": true},
        "sockets": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/game_asset_socket"}},
        "target_texel_density_pixels_per_meter": {"type": "integer", "minimum": 128, "maximum": 2048}
      }
    },
    "game_asset_socket": {
      "type": "object", "additionalProperties": false,
      "required": ["socket_id", "part_id", "pivot_meters", "forward"],
      "properties": {
        "socket_id": {"type": "string", "minLength": 1, "maxLength": 160},
        "part_id": {"type": "string", "minLength": 1, "maxLength": 160},
        "pivot_meters": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number", "minimum": -100, "maximum": 100}},
        "forward": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number", "minimum": -1, "maximum": 1}}
      }
    },
    "game_asset_delivery_readback": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "source_glb_sha256", "delivery_glb_sha256", "game_asset_profile_sha256", "bindings_sha256", "lod", "collision_proxies", "sockets", "texel_density"],
      "properties": {
        "schema_version": {"const": "GameAssetDeliveryReceipt@1"},
        "source_glb_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "delivery_glb_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "game_asset_profile_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "bindings_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "lod": {"$ref": "#/$defs/game_asset_lod_readback"},
        "collision_proxies": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/game_asset_collision_proxy"}},
        "sockets": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/game_asset_socket_readback"}},
        "texel_density": {"$ref": "#/$defs/game_asset_texel_density"}
      }
    },
    "game_asset_lod_readback": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "source_glb_sha256", "delivery_glb_sha256", "game_asset_profile_id", "game_asset_profile_sha256", "lods"],
      "properties": {
        "schema_version": {"const": "GameAssetLodReceipt@1"},
        "source_glb_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "delivery_glb_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "game_asset_profile_id": {"type": "string", "minLength": 1, "maxLength": 160},
        "game_asset_profile_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "lods": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/game_asset_lod_level"}}
      }
    },
    "game_asset_lod_level": {
      "type": "object", "additionalProperties": false,
      "required": ["level", "triangle_count", "simplification_error"],
      "properties": {"level": {"type": "integer", "minimum": 0, "maximum": 2}, "triangle_count": {"type": "integer", "minimum": 0}, "simplification_error": {"type": "number", "minimum": 0}}
    },
    "game_asset_collision_proxy": {
      "type": "object", "additionalProperties": false,
      "required": ["subject_part_id", "terminal_operation_id", "mesh_index", "bounds_meters"],
      "properties": {
        "subject_part_id": {"type": "string", "minLength": 1, "maxLength": 160}, "terminal_operation_id": {"type": "string", "minLength": 1, "maxLength": 160}, "mesh_index": {"type": "integer", "minimum": 1},
        "bounds_meters": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}}}
      }
    },
    "game_asset_socket_readback": {
      "type": "object", "additionalProperties": false,
      "required": ["socket_id", "subject_part_id", "terminal_operation_id", "node_index", "pivot_meters", "forward"],
      "properties": {
        "socket_id": {"type": "string", "minLength": 1, "maxLength": 160}, "subject_part_id": {"type": "string", "minLength": 1, "maxLength": 160}, "terminal_operation_id": {"type": "string", "minLength": 1, "maxLength": 160}, "node_index": {"type": "integer", "minimum": 1},
        "pivot_meters": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}}, "forward": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}}
      }
    },
    "game_asset_texel_density": {
      "type": "object", "additionalProperties": false,
      "required": ["material_zones", "surface_area_square_meters", "effective_texel_density_pixels_per_meter", "target_texel_density_pixels_per_meter", "target_met"],
      "properties": {
        "material_zones": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"$ref": "#/$defs/game_asset_material_texel_density"}},
        "surface_area_square_meters": {"type": "number", "exclusiveMinimum": 0}, "effective_texel_density_pixels_per_meter": {"type": "number", "exclusiveMinimum": 0}, "target_texel_density_pixels_per_meter": {"type": "integer", "minimum": 128, "maximum": 2048}, "target_met": {"const": true}
      }
    },
    "game_asset_material_texel_density": {
      "type": "object", "additionalProperties": false,
      "required": ["material_index", "base_color_dimensions_pixels", "surface_area_square_meters", "uv_area_square_units", "effective_texel_density_pixels_per_meter"],
      "properties": {"material_index": {"type": "integer", "minimum": 0}, "base_color_dimensions_pixels": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": 1}}, "surface_area_square_meters": {"type": "number", "exclusiveMinimum": 0}, "uv_area_square_units": {"type": "number", "exclusiveMinimum": 0}, "effective_texel_density_pixels_per_meter": {"type": "number", "exclusiveMinimum": 0}}
    },
    "procedural_source": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "source_contract_id", "compiler_profile_id", "source_program", "source_program_id", "source_program_sha256", "shape_program_sha256", "shape_program", "part_bindings"],
      "properties": {
        "kind": {"const": "procedural"},
        "source_contract_id": {"enum": ["ForgeVisualAuthorSource@1", "ForgeVisualGeometryProgram@2"]},
        "compiler_profile_id": {"type": "string", "minLength": 1, "maxLength": 160},
        "source_program": {"type": "object"},
        "source_program_id": {"type": "string", "minLength": 1, "maxLength": 160},
        "source_program_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "shape_program_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "shape_program": {"$ref": "shape-program.schema.json"},
        "part_bindings": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/$defs/part_binding"}}
      }
    },
    "part_binding": {
      "type": "object", "additionalProperties": false,
      "required": ["subject_part_id", "output_id", "terminal_operation_id", "material_zone_id", "material_id"],
      "properties": {
        "subject_part_id": {"type": "string", "minLength": 1, "maxLength": 160},
        "output_id": {"type": "string", "minLength": 1, "maxLength": 160},
        "terminal_operation_id": {"type": "string", "minLength": 1, "maxLength": 160},
        "material_zone_id": {"type": "string", "minLength": 1, "maxLength": 160},
        "material_id": {"type": "string", "minLength": 1, "maxLength": 160}
      }
    },
    "runtime_procedural_payload": {
      "type": "object", "additionalProperties": false,
      "required": ["source_contract_id", "compiler_profile_id", "source_program", "source_program_id", "source_program_sha256", "shape_program_sha256", "shape_program", "part_bindings"],
      "properties": {
        "source_contract_id": {"enum": ["ForgeVisualAuthorSource@1", "ForgeVisualGeometryProgram@2"]},
        "compiler_profile_id": {"type": "string", "minLength": 1, "maxLength": 160},
        "source_program": {"type": "object"},
        "source_program_id": {"type": "string", "minLength": 1, "maxLength": 160},
        "source_program_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "shape_program_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "shape_program": {"$ref": "shape-program.schema.json"},
        "part_bindings": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/$defs/part_binding"}}
      }
    },
    "local_lattice_deform_source": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "source_contract_id", "procedural_source", "deformations"],
      "properties": {
        "kind": {"const": "deformable"},
        "source_contract_id": {"const": "ForgeLocalLatticeDeformSource@1"},
        "procedural_source": {"$ref": "#/$defs/runtime_procedural_payload"},
        "deformations": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/$defs/lattice_deformation_binding"}}
      }
    },
    "local_mesh_patch_source": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "source_contract_id", "procedural_source", "patches"],
      "properties": {
        "kind": {"const": "local_mesh_patch"},
        "source_contract_id": {"const": "ForgeLocalMeshPatchSource@1"},
        "procedural_source": {"$ref": "#/$defs/runtime_procedural_payload"},
        "patches": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/$defs/local_mesh_patch_binding"}}
      }
    },
    "local_hard_surface_hybrid_source": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "source_contract_id", "procedural_source", "deformations"],
      "properties": {
        "kind": {"const": "hybrid"},
        "source_contract_id": {"const": "ForgeLocalHardSurfaceHybridSource@1"},
        "procedural_source": {"$ref": "#/$defs/runtime_procedural_payload"},
        "deformations": {"type": "array", "minItems": 1, "maxItems": 255, "items": {"$ref": "#/$defs/lattice_deformation_binding"}}
      }
    },
    "lattice_deformation_binding": {
      "type": "object", "additionalProperties": false,
      "required": ["deformation_id", "subject_part_id", "source_operation_id", "deformation_operation_id", "corner_offsets"],
      "properties": {
        "deformation_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "subject_part_id": {"type": "string", "minLength": 1, "maxLength": 160},
        "source_operation_id": {"type": "string", "minLength": 1, "maxLength": 160},
        "deformation_operation_id": {"type": "string", "minLength": 1, "maxLength": 160},
        "corner_offsets": {
          "type": "array", "minItems": 8, "maxItems": 8,
          "items": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number", "minimum": -0.25, "maximum": 0.25}}
        }
      }
    },
    "local_mesh_patch_binding": {
      "type": "object", "additionalProperties": false,
      "required": ["patch_id", "subject_part_id", "source_operation_id", "patch_operation_id", "patch_center", "patch_radius", "patch_offset"],
      "properties": {
        "patch_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "subject_part_id": {"type": "string", "minLength": 1, "maxLength": 160},
        "source_operation_id": {"type": "string", "minLength": 1, "maxLength": 160},
        "patch_operation_id": {"type": "string", "minLength": 1, "maxLength": 160},
        "patch_center": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number", "minimum": 0, "maximum": 1}},
        "patch_radius": {"type": "number", "minimum": 0.05, "maximum": 0.4},
        "patch_offset": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number", "minimum": -0.2, "maximum": 0.2}}
      }
    },
    "appearance_compilation": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "compiler_id", "source_program_sha256", "zones", "compilation_sha256"],
      "properties": {
        "schema_version": {"const": "GenericHardSurfaceAppearanceCompilation@2"},
        "compiler_id": {"const": "forgecad.generic_hard_surface_appearance.v2"},
        "source_program_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "zones": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"$ref": "#/$defs/appearance_zone"}},
        "reference_surface_bindings": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/reference_surface_binding"}},
        "compilation_sha256": {"$ref": "common.schema.json#/$defs/sha256"}
      }
    },
    "appearance_zone": {
      "type": "object", "additionalProperties": false,
      "required": ["target_subject_part_id", "target_material_zone_id", "base_material_id", "surface_layer_program", "surface_layer_program_sha256"],
      "properties": {
        "target_subject_part_id": {"type": "string", "minLength": 1, "maxLength": 160},
        "target_material_zone_id": {"type": "string", "minLength": 1, "maxLength": 160},
        "base_material_id": {"type": "string", "pattern": "^mat_[a-z0-9_-]+$", "maxLength": 96},
        "surface_layer_program": {"type": "object"},
        "surface_layer_program_sha256": {"$ref": "common.schema.json#/$defs/sha256"}
      }
    },
    "reference_surface_binding": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "evidence_id", "evidence_sha256", "facts", "roughness_motif", "binding_sha256"],
      "properties": {
        "schema_version": {"const": "ReferenceSurfaceAppearanceBinding@1"},
        "evidence_id": {"type": "string", "minLength": 1, "maxLength": 160},
        "evidence_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "facts": {
          "type": "object", "additionalProperties": false,
          "required": ["width", "height", "aspect_ratio_milli", "dominant_color_buckets", "brightness", "edge_density", "foreground_bbox_normalized", "foreground_confidence"],
          "properties": {
            "width": {"type": "integer", "minimum": 1, "maximum": 4096},
            "height": {"type": "integer", "minimum": 1, "maximum": 4096},
            "aspect_ratio_milli": {"type": "integer", "minimum": 1, "maximum": 64000},
            "dominant_color_buckets": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": {"enum": ["black", "gray", "white", "blue", "cyan", "red", "yellow", "green", "violet"]}},
            "foreground_dominant_color_buckets": {"type": "array", "maxItems": 4, "uniqueItems": true, "items": {"enum": ["black", "gray", "white", "blue", "cyan", "red", "yellow", "green", "violet"]}},
            "brightness": {"enum": ["dark", "balanced", "bright"]},
            "edge_density": {"enum": ["low", "medium", "high"]},
            "foreground_bbox_normalized": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "integer", "minimum": 0, "maximum": 1000}},
            "contact_sheet_layout_evidence": {"type": "boolean"},
            "foreground_confidence": {"enum": ["low", "medium"]}
          }
        },
        "base_color_token": {"enum": ["silver", "white_ceramic", "gunmetal", "graphite", "copper", "signal_red", "bark_brown", "wood_warm", "foliage_green", "skin_warm", "fur_warm", "fabric_blue", "stone_gray", "concrete_gray", "clay_terracotta"]},
        "surface_finish_token": {"enum": ["brushed_metal", "polished_metal", "ceramic_coat", "glossy_coat", "matte_coat", "rubberized", "dark_glass", "emissive_trim", "wood_grain", "bark_ridged", "leaf_waxy", "fabric_weave", "fur_soft", "skin_matte", "stone_rough", "concrete_rough", "clay_matte"]},
        "roughness_motif": {"enum": ["linear_brush", "edge_wear", "microgrid"]},
        "binding_sha256": {"$ref": "common.schema.json#/$defs/sha256"}
      }
    }
  }
}
