{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/schemas/concept/universal-author-request.schema.json",
  "title": "UniversalAuthorRequest",
  "description": "Rust-sealed category-open author request. Project, Turn, evidence, active asset, selection, locks and capability hash are server truth.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "project_id", "turn_id", "instruction", "input_mode", "reference_inputs", "selection", "locks", "capability_manifest_sha256"],
  "properties": {
    "schema_version": { "const": "UniversalAuthorRequest@1" },
    "request_id": { "type": "string", "minLength": 1, "maxLength": 160 },
    "project_id": { "type": "string", "minLength": 1, "maxLength": 160 },
    "turn_id": { "type": "string", "minLength": 1, "maxLength": 160 },
    "instruction": { "type": "string", "minLength": 1, "maxLength": 200000 },
    "input_mode": { "enum": ["text", "single_image", "multiview", "active_asset", "mixed"] },
    "reference_inputs": {
      "type": "array", "maxItems": 12, "uniqueItems": true,
      "items": { "$ref": "#/$defs/reference_input" }
    },
    "active_asset": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/active_asset" }] },
    "selection": { "$ref": "#/$defs/selection" },
    "locks": { "$ref": "#/$defs/locks" },
    "capability_manifest_sha256": { "$ref": "common.schema.json#/$defs/sha256" }
  },
  "$defs": {
    "reference_input": {
      "type": "object", "additionalProperties": false,
      "required": ["evidence_id", "evidence_sha256", "role"],
      "properties": {
        "evidence_id": { "type": "string", "minLength": 1, "maxLength": 160 },
        "evidence_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
        "role": { "type": "string", "minLength": 1, "maxLength": 80 },
        "view_hint": { "type": ["string", "null"], "minLength": 1, "maxLength": 80 }
      }
    },
    "active_asset": {
      "type": "object", "additionalProperties": false,
      "required": ["asset_version_id", "snapshot_revision", "source_sha256", "readback_sha256"],
      "properties": {
        "asset_version_id": { "type": "string", "minLength": 1, "maxLength": 160 },
        "snapshot_revision": { "type": "integer", "minimum": 0 },
        "source_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
        "readback_sha256": { "$ref": "common.schema.json#/$defs/sha256" }
      }
    },
    "selection": {
      "type": "object", "additionalProperties": false,
      "required": ["part_ids", "material_zone_ids"],
      "properties": {
        "part_ids": { "type": "array", "maxItems": 256, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 160 } },
        "material_zone_ids": { "type": "array", "maxItems": 256, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 160 } }
      }
    },
    "locks": {
      "type": "object", "additionalProperties": false,
      "required": ["preserve_geometry", "preserve_material_surface", "locked_part_ids", "locked_material_zone_ids"],
      "properties": {
        "preserve_geometry": { "type": "boolean" },
        "preserve_material_surface": { "type": "boolean" },
        "locked_part_ids": { "type": "array", "maxItems": 256, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 160 } },
        "locked_material_zone_ids": { "type": "array", "maxItems": 256, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 160 } }
      }
    }
  }
}
