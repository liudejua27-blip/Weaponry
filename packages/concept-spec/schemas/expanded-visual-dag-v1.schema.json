{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/schemas/concept/expanded-visual-dag-v1.schema.json",
  "title": "ExpandedVisualDagV1",
  "description": "Deterministic, rebuildable VP202 cache. It is not a second asset or version truth.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "compiler_version", "id_algorithm_version", "source_program_sha256", "expanded_program_sha256", "lineage_sha256", "expanded_dag_sha256", "budget_evidence", "lineage", "expanded_program"],
  "properties": {
    "schema_version": { "const": "ExpandedVisualDAG@1" },
    "compiler_version": { "const": "forgecad-core-vp202.1" },
    "id_algorithm_version": { "const": "expanded-path-v1" },
    "source_program_sha256": { "$ref": "#/$defs/sha256" },
    "expanded_program_sha256": { "$ref": "#/$defs/sha256" },
    "lineage_sha256": { "$ref": "#/$defs/sha256" },
    "expanded_dag_sha256": { "$ref": "#/$defs/sha256" },
    "budget_evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["macro_count", "macro_call_count", "expanded_node_count", "expanded_output_count", "primitive_count", "estimated_triangle_upper_bound"],
      "properties": {
        "macro_count": { "type": "integer", "minimum": 1, "maximum": 64 },
        "macro_call_count": { "type": "integer", "minimum": 1, "maximum": 256 },
        "expanded_node_count": { "type": "integer", "minimum": 4, "maximum": 256 },
        "expanded_output_count": { "type": "integer", "minimum": 1, "maximum": 128 },
        "primitive_count": { "type": "integer", "minimum": 1, "maximum": 256 },
        "estimated_triangle_upper_bound": { "type": "integer", "minimum": 1, "maximum": 100000 }
      }
    },
    "lineage": {
      "type": "array", "minItems": 1, "maxItems": 128,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["expanded_output_id", "expanded_node_ids", "expanded_part_id", "expanded_material_zone_id", "source_macro_path", "source_chain_id", "instance_indices", "parameter_ids"],
        "properties": {
          "expanded_output_id": { "type": "string", "pattern": "^output_[a-z0-9_-]+$" },
          "expanded_node_ids": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "string", "pattern": "^node_[a-z0-9_-]+$" } },
          "expanded_part_id": { "type": "string", "pattern": "^part_[a-z0-9_-]+$" },
          "expanded_material_zone_id": { "type": "string", "pattern": "^zone_[a-z0-9_-]+$" },
          "source_macro_path": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "string", "pattern": "^macro_[a-z0-9_-]+$" } },
          "source_chain_id": { "type": "string", "pattern": "^chain_[a-z0-9_-]+$" },
          "instance_indices": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "integer", "minimum": 0, "maximum": 63 } },
          "parameter_ids": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "pattern": "^param_[a-z0-9_-]+$" } }
        }
      }
    },
    "expanded_program": { "$ref": "forge-visual-program-v2.schema.json" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
