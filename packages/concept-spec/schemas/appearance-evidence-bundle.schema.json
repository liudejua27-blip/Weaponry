{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/schemas/concept/appearance-evidence-bundle.schema.json",
  "title": "AppearanceEvidenceBundle",
  "description": "Hash-only reference, camera and derived appearance evidence. It contains no pixels, paths, URLs, shader code or material truth.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "bundle_id", "request_sha256", "references", "camera_hypotheses", "derived_artifacts"],
  "properties": {
    "schema_version": { "const": "AppearanceEvidenceBundle@1" },
    "bundle_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "request_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
    "references": { "type": "array", "maxItems": 12, "items": { "$ref": "#/$defs/reference" } },
    "camera_hypotheses": { "type": "array", "maxItems": 24, "items": { "$ref": "reference-camera-hypothesis.schema.json" } },
    "derived_artifacts": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/artifact" } }
  },
  "$defs": {
    "reference": {
      "type": "object", "additionalProperties": false,
      "required": ["evidence_id", "evidence_sha256"],
      "properties": {
        "evidence_id": { "type": "string", "minLength": 1, "maxLength": 160 },
        "evidence_sha256": { "$ref": "common.schema.json#/$defs/sha256" }
      }
    },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_id", "evidence_id", "kind", "content_sha256", "algorithm_id", "algorithm_version", "evidence_only"],
      "properties": {
        "artifact_id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "evidence_id": { "type": "string", "minLength": 1, "maxLength": 160 },
        "kind": { "enum": ["mask", "region", "delighted_color_hint", "normal_hint", "roughness_hint", "metallic_hint", "unobserved_texel_mask"] },
        "content_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
        "algorithm_id": { "type": "string", "minLength": 1, "maxLength": 160 },
        "algorithm_version": { "type": "string", "minLength": 1, "maxLength": 80 },
        "evidence_only": { "const": true }
      }
    }
  }
}
