{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/schemas/forge-visual-geometry-patch-v1.schema.json",
  "title": "ForgeVisualGeometryPatchV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "patch_id", "expected_source_sha256", "operations"],
  "properties": {
    "schema_version": {"const": "ForgeVisualGeometryPatch@1"},
    "patch_id": {"type": "string", "pattern": "^patch_[a-z0-9_-]+$", "maxLength": 96},
    "expected_source_sha256": {"$ref": "#/$defs/hash"},
    "operations": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"$ref": "#/$defs/operation"}}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "node_id": {"type": "string", "pattern": "^node_[a-z0-9_-]+$", "maxLength": 96},
    "positive": {"type": "number", "exclusiveMinimum": 0, "maximum": 100000},
    "point3": {"type": "array", "prefixItems": [{"type": "number", "minimum": -100000, "maximum": 100000}, {"type": "number", "minimum": -100000, "maximum": 100000}, {"type": "number", "minimum": -100000, "maximum": 100000}], "items": false, "minItems": 3, "maxItems": 3},
    "scale2": {"type": "array", "prefixItems": [{"type": "number", "exclusiveMinimum": 0, "maximum": 100000}, {"type": "number", "exclusiveMinimum": 0, "maximum": 100000}], "items": false, "minItems": 2, "maxItems": 2},
    "operation": {"oneOf": [
      {"type": "object", "additionalProperties": false, "required": ["op", "node_id", "position"], "properties": {"op": {"const": "set_node_position"}, "node_id": {"$ref": "#/$defs/node_id"}, "position": {"$ref": "#/$defs/point3"}}},
      {"type": "object", "additionalProperties": false, "required": ["op", "node_id", "height"], "properties": {"op": {"const": "set_extrude_height"}, "node_id": {"$ref": "#/$defs/node_id"}, "height": {"$ref": "#/$defs/positive"}}},
      {"type": "object", "additionalProperties": false, "required": ["op", "node_id", "angle"], "properties": {"op": {"const": "set_revolve_angle"}, "node_id": {"$ref": "#/$defs/node_id"}, "angle": {"type": "number", "exclusiveMinimum": 0, "maximum": 6.283185307179586}}},
      {"type": "object", "additionalProperties": false, "required": ["op", "node_id", "axis_length"], "properties": {"op": {"const": "set_loft_axis_length"}, "node_id": {"$ref": "#/$defs/node_id"}, "axis_length": {"$ref": "#/$defs/positive"}}},
      {"type": "object", "additionalProperties": false, "required": ["op", "node_id", "profile_scale"], "properties": {"op": {"const": "set_sweep_profile_scale"}, "node_id": {"$ref": "#/$defs/node_id"}, "profile_scale": {"$ref": "#/$defs/scale2"}}},
      {"type": "object", "additionalProperties": false, "required": ["op", "node_id", "count", "spacing"], "properties": {"op": {"const": "set_array"}, "node_id": {"$ref": "#/$defs/node_id"}, "count": {"type": "integer", "minimum": 2, "maximum": 64}, "spacing": {"$ref": "#/$defs/positive"}}},
      {"type": "object", "additionalProperties": false, "required": ["op", "material_id", "base_material_id"], "properties": {"op": {"const": "set_material_base"}, "material_id": {"type": "string", "pattern": "^mat_[a-z0-9_-]+$", "maxLength": 96}, "base_material_id": {"type": "string", "pattern": "^mat_[a-z0-9_-]+$", "maxLength": 96}}}
    ]}
  }
}
