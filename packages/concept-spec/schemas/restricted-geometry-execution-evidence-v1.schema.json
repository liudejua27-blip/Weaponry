{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/schemas/restricted-geometry-execution-evidence-v1.schema.json",
  "title": "RestrictedGeometryExecutionEvidenceV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "compile_cache_key_sha256", "compile_cache_hit", "compile_duration_ms", "render_duration_ms", "fragment_cache_hit_operation_ids", "fragment_cache_miss_operation_ids"],
  "properties": {
    "schema_version": {"const": "RestrictedGeometryExecutionEvidence@1"},
    "compile_cache_key_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "compile_cache_hit": {"type": "boolean"},
    "compile_duration_ms": {"type": "integer", "minimum": 0, "maximum": 240000},
    "render_duration_ms": {"type": "integer", "minimum": 0, "maximum": 240000},
    "fragment_cache_hit_operation_ids": {"type": "array", "maxItems": 1024, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "fragment_cache_miss_operation_ids": {"type": "array", "maxItems": 1024, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9_.@-]{1,128}$"}
  }
}
