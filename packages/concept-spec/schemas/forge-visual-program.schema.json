{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/schemas/concept/forge-visual-program.schema.json",
  "title": "ForgeVisualProgram",
  "description": "Rust-validated visual design source binding existing ShapeProgram, AssemblyGraph, Material Zones, surface programs and visible-detail evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "program_id", "domain_pack_id", "title", "stage", "visual_only", "design_tokens", "parts", "geometry_graph", "assembly_graph", "material_graph", "surface_graph", "detail_inventory", "export_profile"],
  "properties": {
    "schema_version": { "const": "ForgeVisualProgram@1" },
    "program_id": { "$ref": "#/$defs/id" },
    "domain_pack_id": { "$ref": "#/$defs/id" },
    "title": { "type": "string", "minLength": 1, "maxLength": 160 },
    "stage": { "enum": ["draft", "sealed"] },
    "visual_only": { "const": true },
    "design_tokens": {
      "type": "array", "minItems": 1, "maxItems": 32,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["token_id", "value"],
        "properties": {
          "token_id": { "$ref": "#/$defs/id" },
          "value": { "type": "string", "minLength": 1, "maxLength": 120 }
        }
      }
    },
    "parts": {
      "type": "array", "minItems": 1, "maxItems": 256,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["part_id", "role", "parent_part_id", "geometry_output_ids", "material_zone_ids"],
        "properties": {
          "part_id": { "$ref": "#/$defs/id" },
          "role": { "$ref": "#/$defs/id" },
          "parent_part_id": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
          "geometry_output_ids": { "type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
          "material_zone_ids": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
        }
      }
    },
    "geometry_graph": {
      "type": "object",
      "required": ["schema_version", "operations", "outputs"],
      "properties": { "schema_version": { "const": "ShapeProgram@1" } }
    },
    "assembly_graph": {
      "type": "object",
      "required": ["schema_version"],
      "properties": { "schema_version": { "const": "AssemblyGraph@1" } }
    },
    "material_graph": {
      "type": "array", "minItems": 1, "maxItems": 2048,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["part_id", "material_zone_id", "material_id"],
        "properties": {
          "part_id": { "$ref": "#/$defs/id" },
          "material_zone_id": { "$ref": "#/$defs/id" },
          "material_id": {
            "enum": [
              "mat_primary",
              "mat_graphite",
              "mat_painted_steel",
              "mat_powder_coat",
              "mat_aluminum",
              "mat_signal_red",
              "mat_composite",
              "mat_abs_matte",
              "mat_carbon_composite",
              "mat_rubber",
              "mat_rubber_tire",
              "mat_dark_glass",
              "mat_clear_glass",
              "mat_emissive_blue",
              "mat_automotive_paint"
            ]
          }
        }
      }
    },
    "surface_graph": {
      "type": "array", "maxItems": 2048,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["surface_program_id", "part_id", "material_zone_id"],
        "properties": {
          "surface_program_id": { "$ref": "#/$defs/id" },
          "part_id": { "$ref": "#/$defs/id" },
          "material_zone_id": { "$ref": "#/$defs/id" }
        }
      }
    },
    "detail_inventory": {
      "type": "array", "minItems": 1, "maxItems": 512,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["detail_id", "level", "description", "critical", "status", "bindings"],
        "properties": {
          "detail_id": { "$ref": "#/$defs/id" },
          "level": { "enum": ["macro", "meso", "micro"] },
          "description": { "type": "string", "minLength": 1, "maxLength": 240 },
          "critical": { "type": "boolean" },
          "status": { "enum": ["bound", "unresolved"] },
          "bindings": {
            "type": "array", "maxItems": 128,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["kind", "part_id", "target_id"],
              "properties": {
                "kind": { "enum": ["geometry_output", "material_zone", "surface_program"] },
                "part_id": { "$ref": "#/$defs/id" },
                "target_id": { "$ref": "#/$defs/id" }
              }
            }
          }
        }
      }
    },
    "export_profile": { "enum": ["interactive_preview", "production_concept"] }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9_.:-]+$" }
  }
}
