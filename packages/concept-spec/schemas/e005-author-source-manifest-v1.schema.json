{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/schemas/e005-author-source-manifest-v1.schema.json",
  "title": "E005AuthorSourceManifestV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_id", "task_set_sha256", "entries"],
  "properties": {
    "schema_version": {"const": "E005AuthorSourceManifest@1"},
    "manifest_id": {"$ref": "#/$defs/id"},
    "task_set_sha256": {"$ref": "#/$defs/hash"},
    "entries": {
      "type": "array",
      "minItems": 30,
      "maxItems": 30,
      "items": {"$ref": "#/$defs/entry"}
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9_.@-]{3,128}$"},
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "authoring_mode", "source_status"],
      "properties": {
        "task_id": {"$ref": "#/$defs/id"},
        "authoring_mode": {"enum": ["not_authorized", "frozen_offline_fixture", "live_provider"]},
        "source_status": {"enum": ["unavailable", "authored"]},
        "failure_code": {"enum": ["E005_SOURCE_UNAVAILABLE", "E005_PROVIDER_UNAUTHORIZED"]},
        "source_program_sha256": {"$ref": "#/$defs/hash"},
        "source_program": {"$ref": "https://forgecad.local/schemas/forge-visual-geometry-program-v2.schema.json"}
      },
      "allOf": [
        {
          "if": {"properties": {"source_status": {"const": "unavailable"}}, "required": ["source_status"]},
          "then": {
            "required": ["failure_code"],
            "properties": {"authoring_mode": {"const": "not_authorized"}},
            "not": {"anyOf": [{"required": ["source_program_sha256"]}, {"required": ["source_program"]}]}
          }
        },
        {
          "if": {"properties": {"source_status": {"const": "authored"}}, "required": ["source_status"]},
          "then": {
            "required": ["source_program_sha256", "source_program"],
            "properties": {"authoring_mode": {"enum": ["frozen_offline_fixture", "live_provider"]}},
            "not": {"required": ["failure_code"]}
          }
        }
      ]
    }
  }
}
