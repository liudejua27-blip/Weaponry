{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/schemas/visual-convergence-input-v2.schema.json",
  "title": "VisualConvergenceInputV2",
  "description": "Product convergence envelope. @1 remains readable only for frozen V003/C111 regression evidence; new author turns use this single-patch contract.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "ledger", "readback", "fixed_views", "detail_coverage", "repairs"],
  "properties": {
    "schema_version": { "const": "VisualConvergenceInput@2" },
    "ledger": { "$ref": "visual-convergence-input.schema.json#/$defs/ledger" },
    "readback": { "$ref": "visual-convergence-input.schema.json#/$defs/readback" },
    "fixed_views": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/view_v2" }
    },
    "detail_coverage": { "$ref": "visual-convergence-input.schema.json#/$defs/detail_coverage" },
    "reference_comparison": { "$ref": "visual-convergence-input.schema.json#/$defs/reference_comparison" },
    "repairs": {
      "type": "array",
      "maxItems": 1,
      "items": { "$ref": "#/$defs/repair_v2" }
    }
  },
  "$defs": {
    "view_v2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["view_id", "glb_sha256", "renderer_id", "image_sha256", "readback_passed"],
      "properties": {
        "view_id": { "enum": ["turntable_000", "turntable_045", "turntable_090", "turntable_135", "turntable_180", "turntable_225", "turntable_270", "turntable_315"] },
        "glb_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "renderer_id": { "type": "string", "minLength": 1, "maxLength": 120 },
        "image_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "readback_passed": { "type": "boolean" }
      }
    },
    "repair_v2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repair_number", "parent_program_sha256", "result_program_sha256", "changed_domains", "same_intent"],
      "properties": {
        "repair_number": { "const": 1 },
        "parent_program_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "result_program_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "changed_domains": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["title", "design_tokens", "parts", "geometry", "assembly", "material", "surface", "detail_inventory", "export_profile"] }
        },
        "same_intent": { "const": true }
      }
    }
  }
}
