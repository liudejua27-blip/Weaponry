{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/schemas/geometry-incremental-plan-v1.schema.json",
  "title": "GeometryIncrementalPlanV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "base_source_sha256", "patched_source_sha256", "patch_sha256", "reused_profile_input_ids", "invalidated_profile_input_ids", "reused_source_node_ids", "invalidated_source_node_ids", "reused_shape_operation_ids", "invalidated_shape_operation_ids", "reused_output_ids", "invalidated_output_ids", "full_compile_cache_hit"],
  "properties": {
    "schema_version": {"const": "GeometryIncrementalPlan@1"},
    "base_source_sha256": {"$ref": "#/$defs/hash"},
    "patched_source_sha256": {"$ref": "#/$defs/hash"},
    "patch_sha256": {"$ref": "#/$defs/hash"},
    "reused_profile_input_ids": {"$ref": "#/$defs/profile_ids"},
    "invalidated_profile_input_ids": {"$ref": "#/$defs/profile_ids"},
    "reused_source_node_ids": {"$ref": "#/$defs/node_ids"},
    "invalidated_source_node_ids": {"$ref": "#/$defs/node_ids"},
    "reused_shape_operation_ids": {"$ref": "#/$defs/operation_ids"},
    "invalidated_shape_operation_ids": {"$ref": "#/$defs/operation_ids"},
    "reused_output_ids": {"$ref": "#/$defs/output_ids"},
    "invalidated_output_ids": {"$ref": "#/$defs/output_ids"},
    "full_compile_cache_hit": {"const": false}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "profile_ids": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "pattern": "^profileinput_[a-z0-9_-]+$"}},
    "node_ids": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"type": "string", "pattern": "^node_[a-z0-9_-]+$"}},
    "operation_ids": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"type": "string", "pattern": "^op_[a-z0-9_-]+$"}},
    "output_ids": {"type": "array", "maxItems": 128, "uniqueItems": true, "items": {"type": "string", "pattern": "^output_[a-z0-9_-]+$"}}
  }
}
