{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/schemas/e005-provider-run-authorization-v1.schema.json",
  "title": "E005ProviderRunAuthorizationV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "authorization_id",
    "task_set_sha256",
    "status",
    "grant_mode",
    "maximum_author_calls",
    "maximum_patch_calls",
    "maximum_total_calls",
    "maximum_input_tokens",
    "maximum_output_tokens",
    "maximum_variable_cost_microusd",
    "maximum_batch_wall_time_ms",
    "maximum_single_call_wall_time_ms",
    "whole_object_template_policy",
    "authorization_binding_sha256"
  ],
  "properties": {
    "schema_version": {"const": "E005ProviderRunAuthorization@1"},
    "authorization_id": {"$ref": "#/$defs/id"},
    "task_set_sha256": {"$ref": "#/$defs/hash"},
    "status": {"enum": ["not_authorized", "authorized"]},
    "grant_mode": {"enum": ["none", "explicit_user_confirmation"]},
    "provider_id": {"$ref": "#/$defs/id"},
    "model_id": {"$ref": "#/$defs/id"},
    "source_policy_sha256": {"$ref": "#/$defs/hash"},
    "pricing_snapshot_sha256": {"$ref": "#/$defs/hash"},
    "disclosure_sha256": {"$ref": "#/$defs/hash"},
    "authorized_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "maximum_author_calls": {"type": "integer", "minimum": 0, "maximum": 30},
    "maximum_patch_calls": {"type": "integer", "minimum": 0, "maximum": 30},
    "maximum_total_calls": {"type": "integer", "minimum": 0, "maximum": 60},
    "maximum_input_tokens": {"type": "integer", "minimum": 0},
    "maximum_output_tokens": {"type": "integer", "minimum": 0},
    "maximum_variable_cost_microusd": {"type": "integer", "minimum": 0},
    "maximum_batch_wall_time_ms": {"type": "integer", "minimum": 0, "maximum": 10800000},
    "maximum_single_call_wall_time_ms": {"type": "integer", "minimum": 0, "maximum": 105000},
    "whole_object_template_policy": {"const": "forbidden"},
    "authorization_binding_sha256": {"$ref": "#/$defs/hash"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "not_authorized"}}, "required": ["status"]},
      "then": {
        "properties": {
          "grant_mode": {"const": "none"},
          "maximum_author_calls": {"const": 0},
          "maximum_patch_calls": {"const": 0},
          "maximum_total_calls": {"const": 0},
          "maximum_input_tokens": {"const": 0},
          "maximum_output_tokens": {"const": 0},
          "maximum_variable_cost_microusd": {"const": 0},
          "maximum_batch_wall_time_ms": {"const": 0},
          "maximum_single_call_wall_time_ms": {"const": 0}
        },
        "not": {
          "anyOf": [
            {"required": ["provider_id"]},
            {"required": ["model_id"]},
            {"required": ["source_policy_sha256"]},
            {"required": ["pricing_snapshot_sha256"]},
            {"required": ["disclosure_sha256"]},
            {"required": ["authorized_at"]},
            {"required": ["expires_at"]}
          ]
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "authorized"}}, "required": ["status"]},
      "then": {
        "required": [
          "provider_id",
          "model_id",
          "source_policy_sha256",
          "pricing_snapshot_sha256",
          "disclosure_sha256",
          "authorized_at",
          "expires_at"
        ],
        "properties": {
          "grant_mode": {"const": "explicit_user_confirmation"},
          "maximum_author_calls": {"const": 30},
          "maximum_patch_calls": {"const": 30},
          "maximum_total_calls": {"const": 60},
          "maximum_input_tokens": {"type": "integer", "minimum": 1},
          "maximum_output_tokens": {"type": "integer", "minimum": 1},
          "maximum_variable_cost_microusd": {"type": "integer", "minimum": 1},
          "maximum_batch_wall_time_ms": {"type": "integer", "minimum": 1},
          "maximum_single_call_wall_time_ms": {"type": "integer", "minimum": 1}
        }
      }
    }
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9_.@-]{3,128}$"},
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
