{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/schemas/concept/multimodal-design-request.schema.json",
  "title": "MultimodalDesignRequest",
  "description": "Rust-owned text, sealed reference, active-asset, selection and preservation intent for one visual design turn.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "project_id", "turn_id", "domain_pack_id", "instruction", "reference_inputs", "locks"],
  "properties": {
    "schema_version": { "const": "MultimodalDesignRequest@1" },
    "request_id": { "type": "string", "pattern": "^mmreq_[a-z0-9_\\-]+$", "maxLength": 160 },
    "project_id": { "type": "string", "pattern": "^(prj|project)_[a-z0-9_\\-]+$", "maxLength": 160 },
    "turn_id": { "type": "string", "pattern": "^turn_[A-Za-z0-9_.:\\-]+$", "maxLength": 160 },
    "domain_pack_id": { "type": "string", "pattern": "^pack_[A-Za-z0-9_.:\\-]+$", "maxLength": 160 },
    "instruction": { "type": "string", "minLength": 1, "maxLength": 200000 },
    "reference_inputs": {
      "type": "array",
      "maxItems": 12,
      "items": { "$ref": "#/$defs/reference_input" }
    },
    "active_asset_version_id": {
      "type": ["string", "null"],
      "pattern": "^assetver_[A-Za-z0-9_.:\\-]+$",
      "maxLength": 160
    },
    "selection": {
      "oneOf": [{ "$ref": "#/$defs/selection" }, { "type": "null" }]
    },
    "locks": { "$ref": "#/$defs/locks" }
  },
  "$defs": {
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["left", "top", "right", "bottom"],
      "properties": {
        "left": { "type": "integer", "minimum": 0, "maximum": 999 },
        "top": { "type": "integer", "minimum": 0, "maximum": 999 },
        "right": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "bottom": { "type": "integer", "minimum": 1, "maximum": 1000 }
      }
    },
    "reference_input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "evidence_sha256", "role"],
      "properties": {
        "evidence_id": { "type": "string", "pattern": "^refevid_[a-z0-9_\\-]+$", "maxLength": 160 },
        "evidence_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "role": { "enum": ["primary_silhouette", "structure", "material", "surface", "local_detail", "style", "multiview", "existing_asset"] },
        "view_id": { "type": ["string", "null"], "minLength": 1, "maxLength": 64 },
        "region": { "oneOf": [{ "$ref": "#/$defs/region" }, { "type": "null" }] }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["part_ids", "material_zone_ids"],
      "properties": {
        "part_ids": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "pattern": "^part_[A-Za-z0-9_.:\\-]+$" } },
        "material_zone_ids": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "pattern": "^zone_[A-Za-z0-9_.:\\-]+$" } },
        "reference_region": { "oneOf": [{ "$ref": "#/$defs/region" }, { "type": "null" }] }
      }
    },
    "locks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preserve_geometry", "preserve_material_surface", "locked_part_ids", "locked_material_zone_ids"],
      "properties": {
        "preserve_geometry": { "type": "boolean" },
        "preserve_material_surface": { "type": "boolean" },
        "locked_part_ids": { "type": "array", "maxItems": 256, "uniqueItems": true, "items": { "type": "string", "pattern": "^part_[A-Za-z0-9_.:\\-]+$" } },
        "locked_material_zone_ids": { "type": "array", "maxItems": 256, "uniqueItems": true, "items": { "type": "string", "pattern": "^zone_[A-Za-z0-9_.:\\-]+$" } }
      }
    }
  }
}
