{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/schemas/concept/universal-asset-source.schema.json",
  "title": "UniversalAssetSource",
  "description": "Rust-derived source envelope. U003 currently seals only the available procedural branch; U004 adds other executable branches without a second version truth.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_id", "state", "request", "request_sha256", "subject_profile", "subject_profile_sha256", "visual_feature_contract", "visual_feature_contract_sha256", "representation_plan", "representation_plan_sha256", "capability_manifest_sha256", "procedural_source", "component_sources", "detail_claims", "material_zones", "appearance_evidence"],
  "properties": {
    "schema_version": { "const": "UniversalAssetSource@1" },
    "source_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "state": { "enum": ["planned", "compiled"] },
    "request": { "$ref": "universal-author-request.schema.json" },
    "request_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
    "subject_profile": { "$ref": "subject-profile.schema.json" },
    "subject_profile_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
    "visual_feature_contract": { "$ref": "visual-feature-contract.schema.json" },
    "visual_feature_contract_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
    "representation_plan": { "$ref": "representation-plan.schema.json" },
    "representation_plan_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
    "capability_manifest_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
    "procedural_source": { "$ref": "forge-visual-program-revision.schema.json" },
    "component_sources": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "$ref": "#/$defs/component_source" } },
    "detail_claims": { "type": "array", "minItems": 1, "maxItems": 512, "items": { "$ref": "visual-detail-claim-v2.schema.json" } },
    "material_zones": { "type": "array", "maxItems": 128, "items": { "$ref": "material-zone-appearance.schema.json" } },
    "appearance_evidence": { "$ref": "appearance-evidence-bundle.schema.json" },
    "compiled_artifact": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/compiled_artifact" }] }
  },
  "$defs": {
    "component_source": {
      "type": "object", "additionalProperties": false,
      "required": ["component_source_id", "subject_part_id", "representation", "capability_id", "source_program_id", "source_program_sha256", "source_program_part_ids"],
      "properties": {
        "component_source_id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "subject_part_id": { "type": "string", "minLength": 1, "maxLength": 160 },
        "representation": { "enum": ["procedural", "deformable", "mesh_seed", "hybrid"] },
        "capability_id": { "type": "string", "minLength": 1, "maxLength": 160 },
        "source_program_id": { "type": "string", "minLength": 1, "maxLength": 160 },
        "source_program_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
        "source_program_part_ids": { "type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 160 } }
      }
    },
    "compiled_artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["source_program_sha256", "shape_program_sha256", "glb_sha256", "readback_sha256", "compile_readback_sha256", "artifact_profile_id", "renderer_id", "view_sha256"],
      "properties": {
        "source_program_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
        "shape_program_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
        "glb_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
        "readback_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
        "compile_readback_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
        "artifact_profile_id": { "type": "string", "minLength": 1, "maxLength": 160 },
        "renderer_id": { "type": "string", "minLength": 1, "maxLength": 160 },
        "view_sha256": { "type": "object", "minProperties": 1, "maxProperties": 16, "additionalProperties": { "$ref": "common.schema.json#/$defs/sha256" } }
      }
    }
  }
}
