{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/schemas/concept/multimodal-program-evidence-binding.schema.json",
  "title": "MultimodalProgramEvidenceBinding",
  "description": "Exact-lineage bridge from one multimodal request and visual evidence graph to one Rust-validated ForgeVisualProgram.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "binding_id", "request_sha256", "evidence_graph_sha256", "source_program_sha256", "project_id", "domain_pack_id", "program_id", "dispositions"],
  "properties": {
    "schema_version": { "const": "MultimodalProgramEvidenceBinding@1" },
    "binding_id": { "type": "string", "pattern": "^mmbind_[a-z0-9_\\-]+$", "maxLength": 160 },
    "request_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "evidence_graph_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "source_program_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "project_id": { "type": "string", "pattern": "^(prj|project)_[a-z0-9_\\-]+$", "maxLength": 160 },
    "domain_pack_id": { "type": "string", "pattern": "^pack_[A-Za-z0-9_.:\\-]+$", "maxLength": 160 },
    "program_id": { "type": "string", "minLength": 1, "maxLength": 160 },
    "dispositions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "disposition", "detail_ids", "reason"],
        "properties": {
          "claim_id": { "type": "string", "pattern": "^vclaim_[a-z0-9_\\-]+$", "maxLength": 160 },
          "disposition": { "enum": ["bound", "unresolved", "evaluation_only"] },
          "detail_ids": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "pattern": "^detail_[A-Za-z0-9_.:\\-]+$" } },
          "reason": { "type": "string", "minLength": 1, "maxLength": 320 }
        }
      }
    }
  }
}
