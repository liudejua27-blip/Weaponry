{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/schemas/concept/c111b-human-review.schema.json",
  "title": "C111BHumanReview",
  "description": "Frozen blind-review kit and human-only responses for one exact C111B GLB.",
  "oneOf": [
    { "$ref": "#/$defs/kit" },
    { "$ref": "#/$defs/responses" }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": ["macro", "meso", "micro", "pbr", "presentation", "usability"],
      "properties": {
        "macro": { "type": "integer", "minimum": 1, "maximum": 5 },
        "meso": { "type": "integer", "minimum": 1, "maximum": 5 },
        "micro": { "type": "integer", "minimum": 1, "maximum": 5 },
        "pbr": { "type": "integer", "minimum": 1, "maximum": 5 },
        "presentation": { "type": "integer", "minimum": 1, "maximum": 5 },
        "usability": { "type": "integer", "minimum": 1, "maximum": 5 }
      }
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["view_id", "file", "sha256", "source_glb_sha256"],
      "properties": {
        "view_id": { "enum": ["iso", "front", "back", "left", "right", "top", "gripper_iso", "gripper_front"] },
        "file": { "type": "string", "pattern": "^captures/[a-z_]+\\.png$" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "source_glb_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "blindView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position", "blind_view_id", "source_view_id", "file", "sha256"],
      "properties": {
        "position": { "type": "integer", "minimum": 1, "maximum": 8 },
        "blind_view_id": { "type": "string", "pattern": "^view_[0-9]{2}$" },
        "source_view_id": { "enum": ["iso", "front", "back", "left", "right", "top", "gripper_iso", "gripper_front"] },
        "file": { "type": "string", "pattern": "^reviewers/reviewer_[0-9a-f]{16}/views/view_[0-9]{2}\\.png$" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "reviewerPacket": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer_id", "packet_id", "packet_file", "packet_sha256", "view_order"],
      "properties": {
        "reviewer_id": { "type": "string", "pattern": "^reviewer_[0-9a-f]{16}$" },
        "packet_id": { "type": "string", "pattern": "^packet_[0-9a-f]{16}$" },
        "packet_file": { "type": "string", "pattern": "^reviewers/reviewer_[0-9a-f]{16}/packet\\.json$" },
        "packet_sha256": { "$ref": "#/$defs/sha256" },
        "view_order": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/blindView" }
        }
      }
    },
    "kit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "review_id", "status", "frozen_at", "lineage", "blind_protocol", "workbench_protocol", "reviewer_packets"],
      "properties": {
        "schema_version": { "const": "C111BHumanReviewKit@1" },
        "review_id": { "type": "string", "pattern": "^c111b_review_[0-9a-f]{16}$" },
        "status": { "const": "frozen_before_scoring" },
        "frozen_at": { "$ref": "#/$defs/timestamp" },
        "lineage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["glb_file", "glb_sha256", "glb_byte_size", "contract_file", "contract_sha256", "readback_file", "readback_sha256", "capture_manifest_file", "capture_manifest_sha256", "capture_runtime_fingerprint_sha256", "captures"],
          "properties": {
            "glb_file": { "const": "artifact/model.glb" },
            "glb_sha256": { "$ref": "#/$defs/sha256" },
            "glb_byte_size": { "type": "integer", "minimum": 1 },
            "contract_file": { "const": "evidence/visual-acceptance-contract.json" },
            "contract_sha256": { "$ref": "#/$defs/sha256" },
            "readback_file": { "const": "evidence/readback.json" },
            "readback_sha256": { "$ref": "#/$defs/sha256" },
            "capture_manifest_file": { "const": "evidence/capture-manifest.json" },
            "capture_manifest_sha256": { "$ref": "#/$defs/sha256" },
            "capture_runtime_fingerprint_sha256": { "$ref": "#/$defs/sha256" },
            "captures": {
              "type": "array",
              "minItems": 8,
              "maxItems": 8,
              "items": { "$ref": "#/$defs/capture" }
            }
          }
        },
        "blind_protocol": {
          "type": "object",
          "additionalProperties": false,
          "required": ["anonymous_reviewers", "randomized_view_order", "randomization_commitment_sha256", "independent_reviewer_count", "human_only", "agent_or_vlm_allowed", "dimensions", "score_scale", "dimension_median_minimum", "reviewer_median_minimum"],
          "properties": {
            "anonymous_reviewers": { "const": true },
            "randomized_view_order": { "const": true },
            "randomization_commitment_sha256": { "$ref": "#/$defs/sha256" },
            "independent_reviewer_count": { "const": 3 },
            "human_only": { "const": true },
            "agent_or_vlm_allowed": { "const": false },
            "dimensions": { "const": ["macro", "meso", "micro", "pbr", "presentation", "usability"] },
            "score_scale": { "const": [1, 2, 3, 4, 5] },
            "dimension_median_minimum": { "const": 4 },
            "reviewer_median_minimum": { "const": 4 }
          }
        },
        "workbench_protocol": {
          "type": "object",
          "additionalProperties": false,
          "required": ["workbench_id", "renderer_id", "same_runtime_fingerprint_required", "usability_requires_interaction_receipt", "static_images_sufficient", "required_interactions"],
          "properties": {
            "workbench_id": { "const": "ForgeCADWorkbench@1" },
            "renderer_id": { "const": "ForgeCADWorkbenchRenderer@1" },
            "same_runtime_fingerprint_required": { "const": true },
            "usability_requires_interaction_receipt": { "const": true },
            "static_images_sufficient": { "const": false },
            "required_interactions": { "const": ["orbit", "zoom", "part_selection", "material_zone_inspection"] }
          }
        },
        "reviewer_packets": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/reviewerPacket" }
        }
      }
    },
    "interactionReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "receipt_id", "receipt_origin", "receipt_sha256", "reviewer_id", "packet_id", "source_glb_sha256", "capture_runtime_fingerprint_sha256", "workbench_id", "renderer_id", "load_state", "static_images_only", "session_started_at", "session_ended_at", "event_log_sha256", "interactions"],
      "properties": {
        "schema_version": { "const": "C111BWorkbenchInteractionReceipt@1" },
        "receipt_id": { "type": "string", "pattern": "^receipt_[0-9a-f]{16}$" },
        "receipt_origin": { "const": "forgecad_workbench_runtime" },
        "receipt_sha256": { "$ref": "#/$defs/sha256" },
        "reviewer_id": { "type": "string", "pattern": "^reviewer_[0-9a-f]{16}$" },
        "packet_id": { "type": "string", "pattern": "^packet_[0-9a-f]{16}$" },
        "source_glb_sha256": { "$ref": "#/$defs/sha256" },
        "capture_runtime_fingerprint_sha256": { "$ref": "#/$defs/sha256" },
        "workbench_id": { "const": "ForgeCADWorkbench@1" },
        "renderer_id": { "const": "ForgeCADWorkbenchRenderer@1" },
        "load_state": { "const": "ready" },
        "static_images_only": { "const": false },
        "session_started_at": { "$ref": "#/$defs/timestamp" },
        "session_ended_at": { "$ref": "#/$defs/timestamp" },
        "event_log_sha256": { "$ref": "#/$defs/sha256" },
        "interactions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["orbit", "zoom", "part_selection", "material_zone_inspection"],
          "properties": {
            "orbit": { "type": "integer", "minimum": 1 },
            "zoom": { "type": "integer", "minimum": 1 },
            "part_selection": { "type": "integer", "minimum": 1 },
            "material_zone_inspection": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer_id", "packet_id", "human_reviewer", "independent_of_implementation", "implementation_participant", "review_method", "submitted_at", "viewed_blind_view_ids", "scores", "interaction_receipt"],
      "properties": {
        "reviewer_id": { "type": "string", "pattern": "^reviewer_[0-9a-f]{16}$" },
        "packet_id": { "type": "string", "pattern": "^packet_[0-9a-f]{16}$" },
        "human_reviewer": { "const": true },
        "independent_of_implementation": { "const": true },
        "implementation_participant": { "const": false },
        "review_method": { "const": "human_only_no_agent_no_vlm" },
        "submitted_at": { "$ref": "#/$defs/timestamp" },
        "viewed_blind_view_ids": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": { "type": "string", "pattern": "^view_[0-9]{2}$" }
        },
        "scores": { "$ref": "#/$defs/scores" },
        "interaction_receipt": { "$ref": "#/$defs/interactionReceipt" }
      }
    },
    "responses": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "review_id", "kit_manifest_sha256", "review_origin", "agent_or_vlm_used", "reviews"],
      "properties": {
        "schema_version": { "const": "C111BHumanReviewResponses@1" },
        "review_id": { "type": "string", "pattern": "^c111b_review_[0-9a-f]{16}$" },
        "kit_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "review_origin": { "const": "independent_human" },
        "agent_or_vlm_used": { "const": false },
        "reviews": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/review" }
        }
      }
    }
  }
}
