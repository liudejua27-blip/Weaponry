{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/schemas/concept/visual-evidence-graph-v2.schema.json",
  "title": "VisualEvidenceGraphV2",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "graph_id", "universal_request_sha256", "subject_profile_sha256", "claims"],
  "properties": {
    "schema_version": { "const": "VisualEvidenceGraph@2" },
    "graph_id": { "type": "string", "minLength": 1, "maxLength": 160 },
    "universal_request_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
    "subject_profile_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
    "claims": { "type": "array", "maxItems": 512, "items": { "type": "object", "additionalProperties": false, "required": ["claim_id", "feature_id", "status", "evidence_regions", "description"], "properties": {
      "claim_id": { "type": "string", "minLength": 1, "maxLength": 160 },
      "feature_id": { "type": "string", "minLength": 1, "maxLength": 160 },
      "status": { "enum": ["observed", "inferred", "hidden", "conflicting"] },
      "evidence_regions": { "type": "array", "maxItems": 32, "items": { "type": "object", "additionalProperties": false, "required": ["evidence_id"], "properties": {
        "evidence_id": { "type": "string", "minLength": 1, "maxLength": 160 },
        "view_id": { "type": ["string", "null"], "minLength": 1, "maxLength": 80 },
        "region_per_mille": { "type": ["array", "null"], "minItems": 4, "maxItems": 4, "items": { "type": "integer", "minimum": 0, "maximum": 1000 } }
      } } },
      "description": { "type": "string", "minLength": 1, "maxLength": 1200 }
    } } }
  }
}
