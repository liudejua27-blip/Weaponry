{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/schemas/concept/forge-visual-patch.schema.json",
  "title": "ForgeVisualPatch",
  "description": "Revision and source-hash bound edits to one Rust-owned ForgeVisualProgram draft. Operations address typed source domains rather than arbitrary JSON paths.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "patch_id",
    "expected_revision",
    "expected_source_sha256",
    "preserve_geometry",
    "preserve_material_surface",
    "operations"
  ],
  "properties": {
    "schema_version": { "const": "ForgeVisualPatch@1" },
    "patch_id": { "$ref": "common.schema.json#/$defs/id" },
    "expected_revision": { "type": "integer", "minimum": 1 },
    "expected_source_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
    "preserve_geometry": { "type": "boolean" },
    "preserve_material_surface": { "type": "boolean" },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/set_title" },
          { "$ref": "#/$defs/upsert_design_token" },
          { "$ref": "#/$defs/remove_design_token" },
          { "$ref": "#/$defs/replace_parts" },
          { "$ref": "#/$defs/replace_geometry_graph" },
          { "$ref": "#/$defs/upsert_geometry_operation" },
          { "$ref": "#/$defs/replace_assembly_graph" },
          { "$ref": "#/$defs/replace_material_graph" },
          { "$ref": "#/$defs/upsert_material_binding" },
          { "$ref": "#/$defs/replace_surface_graph" },
          { "$ref": "#/$defs/upsert_surface_binding" },
          { "$ref": "#/$defs/replace_detail_inventory" },
          { "$ref": "#/$defs/upsert_detail_inventory_item" },
          { "$ref": "#/$defs/set_export_profile" }
        ]
      }
    }
  },
  "$defs": {
    "design_token": {
      "type": "object",
      "additionalProperties": false,
      "required": ["token_id", "value"],
      "properties": {
        "token_id": { "$ref": "common.schema.json#/$defs/id" },
        "value": { "type": "string", "minLength": 1, "maxLength": 120 }
      }
    },
    "part": {
      "type": "object",
      "additionalProperties": false,
      "required": ["part_id", "role", "parent_part_id", "geometry_output_ids", "material_zone_ids"],
      "properties": {
        "part_id": { "$ref": "common.schema.json#/$defs/id" },
        "role": { "$ref": "common.schema.json#/$defs/id" },
        "parent_part_id": {
          "oneOf": [
            { "$ref": "common.schema.json#/$defs/id" },
            { "type": "null" }
          ]
        },
        "geometry_output_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/id" }
        },
        "material_zone_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/id" }
        }
      }
    },
    "material_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["part_id", "material_zone_id", "material_id"],
      "properties": {
        "part_id": { "$ref": "common.schema.json#/$defs/id" },
        "material_zone_id": { "$ref": "common.schema.json#/$defs/id" },
        "material_id": { "$ref": "common.schema.json#/$defs/id" }
      }
    },
    "surface_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface_program_id", "part_id", "material_zone_id"],
      "properties": {
        "surface_program_id": { "$ref": "common.schema.json#/$defs/id" },
        "part_id": { "$ref": "common.schema.json#/$defs/id" },
        "material_zone_id": { "$ref": "common.schema.json#/$defs/id" }
      }
    },
    "detail_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "part_id", "target_id"],
      "properties": {
        "kind": { "enum": ["geometry_output", "material_zone", "surface_program"] },
        "part_id": { "$ref": "common.schema.json#/$defs/id" },
        "target_id": { "$ref": "common.schema.json#/$defs/id" }
      }
    },
    "detail_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["detail_id", "level", "description", "critical", "status", "bindings"],
      "properties": {
        "detail_id": { "$ref": "common.schema.json#/$defs/id" },
        "level": { "enum": ["macro", "meso", "micro"] },
        "description": { "type": "string", "minLength": 1, "maxLength": 240 },
        "critical": { "type": "boolean" },
        "status": { "enum": ["bound", "unresolved"] },
        "bindings": {
          "type": "array",
          "maxItems": 128,
          "items": { "$ref": "#/$defs/detail_binding" }
        }
      }
    },
    "set_title": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "title"],
      "properties": {
        "op": { "const": "set_title" },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 }
      }
    },
    "upsert_design_token": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "token"],
      "properties": {
        "op": { "const": "upsert_design_token" },
        "token": { "$ref": "#/$defs/design_token" }
      }
    },
    "remove_design_token": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "token_id"],
      "properties": {
        "op": { "const": "remove_design_token" },
        "token_id": { "$ref": "common.schema.json#/$defs/id" }
      }
    },
    "replace_parts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "parts"],
      "properties": {
        "op": { "const": "replace_parts" },
        "parts": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "$ref": "#/$defs/part" } }
      }
    },
    "replace_geometry_graph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "geometry_graph"],
      "properties": {
        "op": { "const": "replace_geometry_graph" },
        "geometry_graph": { "$ref": "shape-program.schema.json" }
      }
    },
    "upsert_geometry_operation": {
      "description": "Replaces one existing ShapeProgram operation. operation_id must match the replacement operation and outputs cannot be addressed by this operation.",
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "operation_id", "operation"],
      "properties": {
        "op": { "const": "upsert_geometry_operation" },
        "operation_id": { "$ref": "common.schema.json#/$defs/id" },
        "operation": { "$ref": "shape-program.schema.json#/properties/operations/items" }
      }
    },
    "replace_assembly_graph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "assembly_graph"],
      "properties": {
        "op": { "const": "replace_assembly_graph" },
        "assembly_graph": { "$ref": "assembly-graph.schema.json" }
      }
    },
    "replace_material_graph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "material_graph"],
      "properties": {
        "op": { "const": "replace_material_graph" },
        "material_graph": { "type": "array", "minItems": 1, "maxItems": 2048, "items": { "$ref": "#/$defs/material_binding" } }
      }
    },
    "upsert_material_binding": {
      "description": "Replaces one existing binding identified by part_id and material_zone_id; it cannot create another binding.",
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "binding"],
      "properties": {
        "op": { "const": "upsert_material_binding" },
        "binding": { "$ref": "#/$defs/material_binding" }
      }
    },
    "replace_surface_graph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "surface_graph"],
      "properties": {
        "op": { "const": "replace_surface_graph" },
        "surface_graph": { "type": "array", "maxItems": 2048, "items": { "$ref": "#/$defs/surface_binding" } }
      }
    },
    "upsert_surface_binding": {
      "description": "Rebinds one existing surface_program_id; full ForgeVisualProgram validation still owns the target part and zone.",
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "binding"],
      "properties": {
        "op": { "const": "upsert_surface_binding" },
        "binding": { "$ref": "#/$defs/surface_binding" }
      }
    },
    "replace_detail_inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "detail_inventory"],
      "properties": {
        "op": { "const": "replace_detail_inventory" },
        "detail_inventory": { "type": "array", "minItems": 1, "maxItems": 512, "items": { "$ref": "#/$defs/detail_item" } }
      }
    },
    "upsert_detail_inventory_item": {
      "description": "Replaces one existing detail_id; it cannot introduce a new inventory row.",
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "detail"],
      "properties": {
        "op": { "const": "upsert_detail_inventory_item" },
        "detail": { "$ref": "#/$defs/detail_item" }
      }
    },
    "set_export_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "export_profile"],
      "properties": {
        "op": { "const": "set_export_profile" },
        "export_profile": { "enum": ["interactive_preview", "production_concept"] }
      }
    }
  }
}
