{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/schemas/concept/forge-visual-program-revision.schema.json",
  "title": "ForgeVisualProgramRevision",
  "description": "Existing PV003 Rust-owned source revision, exposed as a reusable reference for UniversalAssetSource@1.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "revision", "source_program_sha256", "parent_source_program_sha256", "program", "changed_domains", "applied_patch_id"],
  "properties": {
    "schema_version": { "const": "ForgeVisualProgramRevision@1" },
    "revision": { "type": "integer", "minimum": 1 },
    "source_program_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
    "parent_source_program_sha256": { "oneOf": [{ "type": "null" }, { "$ref": "common.schema.json#/$defs/sha256" }] },
    "program": { "$ref": "forge-visual-program.schema.json" },
    "changed_domains": { "type": "array", "maxItems": 16, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 80 } },
    "applied_patch_id": { "type": ["string", "null"], "minLength": 1, "maxLength": 160 }
  }
}
