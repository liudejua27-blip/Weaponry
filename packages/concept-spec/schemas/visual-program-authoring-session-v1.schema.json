{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/schemas/visual-program-authoring-session-v1.schema.json",
  "title": "VisualProgramAuthoringSessionV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "session_id", "idempotency_key", "request_sha256", "current_revision", "initial_source_sha256", "current_source_sha256", "current_source", "authoring_count", "patch_count", "state", "receipt", "receipt_sha256"],
  "properties": {
    "schema_version": {"const": "VisualProgramAuthoringSession@1"},
    "session_id": {"$ref": "#/$defs/id"},
    "idempotency_key": {"$ref": "#/$defs/id"},
    "request_sha256": {"$ref": "#/$defs/hash"},
    "current_revision": {"type": "integer", "minimum": 1, "maximum": 2},
    "initial_source_sha256": {"$ref": "#/$defs/hash"},
    "parent_source_sha256": {"$ref": "#/$defs/hash"},
    "current_source_sha256": {"$ref": "#/$defs/hash"},
    "current_source": {"$ref": "forge-visual-geometry-program-v2.schema.json"},
    "authoring_count": {"const": 1},
    "patch_count": {"type": "integer", "minimum": 0, "maximum": 1},
    "state": {"enum": ["awaiting_initial_gate", "awaiting_patch", "awaiting_patched_gate", "ready_for_preview", "failed", "cancelled"]},
    "applied_patch_sha256": {"$ref": "#/$defs/hash"},
    "incremental_plan": {"$ref": "geometry-incremental-plan-v1.schema.json"},
    "gate_report_id": {"$ref": "#/$defs/id"},
    "receipt": {"$ref": "visual-program-execution-receipt-v1.schema.json"},
    "receipt_sha256": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9_.@-]{1,128}$"},
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
