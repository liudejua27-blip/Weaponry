{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/schemas/e005-human-review-bundle-v1.schema.json",
  "title": "E005HumanReviewBundleV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "bundle_id",
    "task_set_sha256",
    "run_receipts_sha256",
    "status",
    "reviewer_commitments",
    "review_count",
    "reviews",
    "reviews_sha256"
  ],
  "properties": {
    "schema_version": {"const": "E005HumanReviewBundle@1"},
    "bundle_id": {"type": "string", "pattern": "^e005_review_[a-z0-9_-]{3,96}$"},
    "task_set_sha256": {"$ref": "#/$defs/hash"},
    "run_receipts_sha256": {"$ref": "#/$defs/hash"},
    "status": {"enum": ["not_run", "complete"]},
    "reviewer_commitments": {
      "type": "array",
      "maxItems": 3,
      "items": {"$ref": "#/$defs/reviewer_commitment"}
    },
    "review_count": {"type": "integer", "minimum": 0, "maximum": 90},
    "reviews": {
      "type": "array",
      "maxItems": 90,
      "items": {"$ref": "#/$defs/review"}
    },
    "reviews_sha256": {"$ref": "#/$defs/hash"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "not_run"}}, "required": ["status"]},
      "then": {
        "properties": {
          "reviewer_commitments": {"maxItems": 0},
          "review_count": {"const": 0},
          "reviews": {"maxItems": 0}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "complete"}}, "required": ["status"]},
      "then": {
        "properties": {
          "reviewer_commitments": {"minItems": 3, "maxItems": 3},
          "review_count": {"const": 90},
          "reviews": {"minItems": 90, "maxItems": 90}
        }
      }
    }
  ],
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9_.@-]{3,128}$"},
    "reviewer_id": {"type": "string", "pattern": "^reviewer_[a-z0-9_-]{3,96}$"},
    "fixed_views": {
      "type": "object",
      "additionalProperties": false,
      "required": ["front", "iso", "side", "top"],
      "properties": {
        "front": {"$ref": "#/$defs/hash"},
        "iso": {"$ref": "#/$defs/hash"},
        "side": {"$ref": "#/$defs/hash"},
        "top": {"$ref": "#/$defs/hash"}
      }
    },
    "reviewer_commitment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer_id", "identity_commitment_sha256"],
      "properties": {
        "reviewer_id": {"$ref": "#/$defs/reviewer_id"},
        "identity_commitment_sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "macro_shape",
        "meso_structure",
        "micro_detail",
        "identity_alignment",
        "pbr_material",
        "hidden_surface_reasonableness",
        "artifact_free"
      ],
      "properties": {
        "macro_shape": {"type": "integer", "minimum": 1, "maximum": 5},
        "meso_structure": {"type": "integer", "minimum": 1, "maximum": 5},
        "micro_detail": {"type": "integer", "minimum": 1, "maximum": 5},
        "identity_alignment": {"type": "integer", "minimum": 1, "maximum": 5},
        "pbr_material": {"type": "integer", "minimum": 1, "maximum": 5},
        "hidden_surface_reasonableness": {"type": "integer", "minimum": 1, "maximum": 5},
        "artifact_free": {"type": "integer", "minimum": 1, "maximum": 5}
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_id",
        "reviewer_id",
        "reviewer_commitment_sha256",
        "task_id",
        "run_id",
        "run_receipt_sha256",
        "fixed_view_sha256",
        "fixed_views",
        "blind_packet_sha256",
        "view_order",
        "human_reviewer",
        "independent_of_implementation",
        "implementation_participant",
        "agent_or_vlm_used",
        "submitted_at",
        "result_stage",
        "scores",
        "overall_score"
      ],
      "properties": {
        "review_id": {"type": "string", "pattern": "^e005_reviewitem_[a-z0-9_-]{3,96}$"},
        "reviewer_id": {"$ref": "#/$defs/reviewer_id"},
        "reviewer_commitment_sha256": {"$ref": "#/$defs/hash"},
        "task_id": {"$ref": "#/$defs/id"},
        "run_id": {"$ref": "#/$defs/id"},
        "run_receipt_sha256": {"$ref": "#/$defs/hash"},
        "fixed_view_sha256": {"$ref": "#/$defs/hash"},
        "fixed_views": {"$ref": "#/$defs/fixed_views"},
        "blind_packet_sha256": {"$ref": "#/$defs/hash"},
        "view_order": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {"enum": ["front", "iso", "side", "top"]}
        },
        "human_reviewer": {"const": true},
        "independent_of_implementation": {"const": true},
        "implementation_participant": {"const": false},
        "agent_or_vlm_used": {"const": false},
        "submitted_at": {"type": "string", "format": "date-time"},
        "result_stage": {"enum": ["first_pass", "after_patch"]},
        "scores": {"$ref": "#/$defs/scores"},
        "overall_score": {"type": "integer", "minimum": 1, "maximum": 5}
      }
    }
  }
}
