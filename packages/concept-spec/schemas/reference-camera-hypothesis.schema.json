{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/schemas/concept/reference-camera-hypothesis.schema.json",
  "title": "ReferenceCameraHypothesis",
  "description": "Evidence-bound camera hypothesis. unresolved is not a solved camera and cannot carry fitted parameters.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "hypothesis_id", "evidence_id", "projection_type", "parameter_source", "landmark_feature_ids", "confidence_bps", "unresolved_fields"],
  "properties": {
    "schema_version": { "const": "ReferenceCameraHypothesis@1" },
    "hypothesis_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "evidence_id": { "type": "string", "minLength": 1, "maxLength": 160 },
    "view_id": { "type": ["string", "null"], "minLength": 1, "maxLength": 80 },
    "projection_type": { "enum": ["perspective", "orthographic", "unknown"] },
    "parameter_source": { "enum": ["metadata", "landmark_fit", "silhouette_fit", "default_hypothesis", "unresolved"] },
    "vertical_fov_millidegrees": { "type": ["integer", "null"], "minimum": 1000, "maximum": 179000 },
    "reprojection_error_bps": { "type": ["integer", "null"], "minimum": 0, "maximum": 10000 },
    "landmark_feature_ids": { "type": "array", "maxItems": 128, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 160 } },
    "confidence_bps": { "type": "integer", "minimum": 0, "maximum": 10000 },
    "unresolved_fields": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 120 } }
  }
}
