{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/authoring-mesh-canonical.schema.json",
  "title": "AuthoringMeshCanonical@1",
  "description": "Runtime-owned durable original half-edge source. It is candidate/program/artifact/readback bound, keeps evaluated geometry as a non-bijective derived identity, and makes cross-version stability an explicit unproven status. Its CAS object hash is intentionally carried only by the outer result/link to avoid a self-referential payload hash.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "canonical_mesh_id",
    "project_id",
    "candidate_id",
    "candidate_state_sha256",
    "base_version_id",
    "authoring_node_id",
    "part_id",
    "source_program_object_sha256",
    "source_program_sha256",
    "source_artifact_object_sha256",
    "source_artifact_sha256",
    "source_artifact_readback_object_sha256",
    "source_artifact_readback_sha256",
    "source_lineage_sha256",
    "representation",
    "storage_policy",
    "writer_policy",
    "original_identity",
    "evaluated_identity",
    "cross_version_stable",
    "cross_version_stability",
    "counts",
    "vertices",
    "edges",
    "half_edges",
    "corners",
    "faces",
    "loops",
    "rings",
    "topology",
    "canonicalization_policy",
    "runtime_write_performed",
    "persistent_user_data_touched",
    "stage_advanced",
    "candidate_confirmed",
    "version_created",
    "export_performed",
    "quality_status",
    "canonical_sha256"
  ],
  "properties": {
    "schema_version": {"const": "AuthoringMeshCanonical@1"},
    "canonical_mesh_id": {"$ref": "#/$defs/identifier"},
    "project_id": {"$ref": "#/$defs/identifier"},
    "candidate_id": {"$ref": "#/$defs/identifier"},
    "candidate_state_sha256": {"$ref": "#/$defs/sha256"},
    "base_version_id": {"$ref": "#/$defs/nullable_identifier"},
    "authoring_node_id": {"$ref": "#/$defs/identifier"},
    "part_id": {"$ref": "#/$defs/identifier"},
    "source_program_object_sha256": {"$ref": "#/$defs/sha256"},
    "source_program_sha256": {"$ref": "#/$defs/sha256"},
    "source_artifact_object_sha256": {"$ref": "#/$defs/sha256"},
    "source_artifact_sha256": {"$ref": "#/$defs/sha256"},
    "source_artifact_readback_object_sha256": {"$ref": "#/$defs/sha256"},
    "source_artifact_readback_sha256": {"$ref": "#/$defs/sha256"},
    "source_lineage_sha256": {"$ref": "#/$defs/sha256"},
    "representation": {"const": "runtime-owned-original-half-edge@1"},
    "storage_policy": {"const": "runtime-owned-sqlite-cas-canonical-authoring-mesh@1"},
    "writer_policy": {"const": "forgecad-runtime-only-state-writer@1"},
    "original_identity": {"$ref": "#/$defs/original_identity"},
    "evaluated_identity": {"$ref": "#/$defs/evaluated_identity"},
    "cross_version_stable": {"const": false},
    "cross_version_stability": {"$ref": "#/$defs/cross_version_stability"},
    "counts": {"$ref": "#/$defs/counts"},
    "vertices": {"type": "array", "minItems": 1, "maxItems": 8192, "items": {"$ref": "#/$defs/vertex"}},
    "edges": {"type": "array", "minItems": 1, "maxItems": 16384, "items": {"$ref": "#/$defs/edge"}},
    "half_edges": {"type": "array", "minItems": 1, "maxItems": 32768, "items": {"$ref": "#/$defs/half_edge"}},
    "corners": {"type": "array", "minItems": 1, "maxItems": 32768, "items": {"$ref": "#/$defs/corner"}},
    "faces": {"type": "array", "minItems": 1, "maxItems": 8192, "items": {"$ref": "#/$defs/face"}},
    "loops": {"type": "array", "minItems": 1, "maxItems": 32768, "items": {"$ref": "#/$defs/loop"}},
    "rings": {"type": "array", "minItems": 0, "maxItems": 8192, "items": {"$ref": "#/$defs/ring"}},
    "topology": {"$ref": "#/$defs/topology"},
    "canonicalization_policy": {"const": "canonical-json-sha256-excluding-canonical-sha256@1"},
    "runtime_write_performed": {"const": true},
    "persistent_user_data_touched": {"const": true},
    "stage_advanced": {"const": false},
    "candidate_confirmed": {"const": false},
    "version_created": {"const": false},
    "export_performed": {"const": false},
    "quality_status": {"const": "structural_only"},
    "canonical_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,128}$"},
    "nullable_identifier": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9_.:-]{1,128}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "coordinate": {"type": "number", "minimum": -1000, "maximum": 1000},
    "position": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/coordinate"}},
    "element_lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["original_element_ids", "evaluated_element_ids", "correspondence_kind", "correspondence_sha256"],
      "properties": {
        "original_element_ids": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "evaluated_element_ids": {"type": "array", "minItems": 0, "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "correspondence_kind": {"enum": ["not_materialized", "one_to_many", "many_to_one", "many_to_many", "unknown"]},
        "correspondence_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "original_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity_id", "namespace", "identity_kind", "element_id_policy", "topology_sha256", "source_lineage_sha256", "stability_scope"],
      "properties": {
        "identity_id": {"$ref": "#/$defs/identifier"},
        "namespace": {"const": "original"},
        "identity_kind": {"const": "runtime-owned-original-authoring@1"},
        "element_id_policy": {"const": "lineage-scoped-opaque-not-cross-version-stable@1"},
        "topology_sha256": {"$ref": "#/$defs/sha256"},
        "source_lineage_sha256": {"$ref": "#/$defs/sha256"},
        "stability_scope": {"const": "same-canonical-mesh-lineage-only@1"}
      }
    },
    "evaluated_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity_id", "namespace", "identity_kind", "element_id_policy", "correspondence_policy", "artifact_object_sha256", "artifact_readback_sha256", "source_lineage_sha256", "cross_version_stable"],
      "properties": {
        "identity_id": {"$ref": "#/$defs/identifier"},
        "namespace": {"const": "evaluated"},
        "identity_kind": {"const": "runtime-derived-evaluated-artifact-readback@1"},
        "element_id_policy": {"const": "artifact-local-no-authoring-bijection@1"},
        "correspondence_policy": {"const": "non-bijective-derived-only@1"},
        "artifact_object_sha256": {"$ref": "#/$defs/sha256"},
        "artifact_readback_sha256": {"$ref": "#/$defs/sha256"},
        "source_lineage_sha256": {"$ref": "#/$defs/sha256"},
        "cross_version_stable": {"const": false}
      }
    },
    "cross_version_stability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "scope", "stable_id_claim", "deleted_id_reuse_policy", "new_id_policy", "evaluated_id_policy"],
      "properties": {
        "status": {"const": "not-proven@1"},
        "scope": {"const": "same-canonical-mesh-lineage-only@1"},
        "stable_id_claim": {"const": "none-across-revisions@1"},
        "deleted_id_reuse_policy": {"const": "not-proven-and-not-a-contract@1"},
        "new_id_policy": {"const": "lineage-operation-parent-derived-draft-only@1"},
        "evaluated_id_policy": {"const": "artifact-local-unstable-derived-only@1"}
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vertex_count", "edge_count", "half_edge_count", "corner_count", "face_count", "loop_count", "ring_count", "boundary_edge_count", "boundary_half_edge_count", "hard_edge_count", "crease_edge_count", "uv_seam_count"],
      "properties": {
        "vertex_count": {"type": "integer", "minimum": 1, "maximum": 8192},
        "edge_count": {"type": "integer", "minimum": 1, "maximum": 16384},
        "half_edge_count": {"type": "integer", "minimum": 1, "maximum": 32768},
        "corner_count": {"type": "integer", "minimum": 1, "maximum": 32768},
        "face_count": {"type": "integer", "minimum": 1, "maximum": 8192},
        "loop_count": {"type": "integer", "minimum": 1, "maximum": 32768},
        "ring_count": {"type": "integer", "minimum": 0, "maximum": 8192},
        "boundary_edge_count": {"type": "integer", "minimum": 0, "maximum": 16384},
        "boundary_half_edge_count": {"type": "integer", "minimum": 0, "maximum": 32768},
        "hard_edge_count": {"type": "integer", "minimum": 0, "maximum": 16384},
        "crease_edge_count": {"type": "integer", "minimum": 0, "maximum": 16384},
        "uv_seam_count": {"type": "integer", "minimum": 0, "maximum": 16384}
      }
    },
    "topology": {
      "type": "object",
      "additionalProperties": false,
      "required": ["boundary_edge_count", "boundary_half_edge_count", "non_manifold_edge_count", "orientation_conflict_count", "status", "validation_status", "rejection_policy", "face_cycle_policy", "twin_policy", "boundary_policy"],
      "properties": {
        "boundary_edge_count": {"type": "integer", "minimum": 0, "maximum": 16384},
        "boundary_half_edge_count": {"type": "integer", "minimum": 0, "maximum": 32768},
        "non_manifold_edge_count": {"const": 0},
        "orientation_conflict_count": {"const": 0},
        "status": {"enum": ["closed_manifold", "manifold_with_boundary"]},
        "validation_status": {"const": "passed"},
        "rejection_policy": {"const": "fail-closed-on-non-manifold@1"},
        "face_cycle_policy": {"const": "next-prev-complete-mutual@1"},
        "twin_policy": {"const": "boundary-only-null-symmetric@1"},
        "boundary_policy": {"const": "single-half-edge-per-boundary-edge@1"}
      }
    },
    "vertex": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vertex_id", "position_m", "outgoing_half_edge_id", "boundary", "lineage"],
      "properties": {
        "vertex_id": {"$ref": "#/$defs/identifier"},
        "position_m": {"$ref": "#/$defs/position"},
        "outgoing_half_edge_id": {"$ref": "#/$defs/identifier"},
        "boundary": {"type": "boolean"},
        "lineage": {"$ref": "#/$defs/element_lineage"}
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["edge_id", "vertex_ids", "half_edge_ids", "boundary", "hard_edge", "crease", "uv_seam", "lineage"],
      "properties": {
        "edge_id": {"$ref": "#/$defs/identifier"},
        "vertex_ids": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "half_edge_ids": {"type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "boundary": {"type": "boolean"},
        "hard_edge": {"type": "boolean"},
        "crease": {"type": "integer", "minimum": 0, "maximum": 2},
        "uv_seam": {"type": "boolean"},
        "lineage": {"$ref": "#/$defs/element_lineage"}
      },
      "allOf": [
        {
          "if": {"properties": {"boundary": {"const": true}}, "required": ["boundary"]},
          "then": {"properties": {"half_edge_ids": {"maxItems": 1}}}
        },
        {
          "if": {"properties": {"boundary": {"const": false}}, "required": ["boundary"]},
          "then": {"properties": {"half_edge_ids": {"minItems": 2}}}
        }
      ]
    },
    "half_edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["half_edge_id", "origin_vertex_id", "edge_id", "face_id", "corner_id", "twin_id", "next_id", "prev_id", "boundary", "orientation", "lineage"],
      "properties": {
        "half_edge_id": {"$ref": "#/$defs/identifier"},
        "origin_vertex_id": {"$ref": "#/$defs/identifier"},
        "edge_id": {"$ref": "#/$defs/identifier"},
        "face_id": {"$ref": "#/$defs/identifier"},
        "corner_id": {"$ref": "#/$defs/identifier"},
        "twin_id": {"$ref": "#/$defs/nullable_identifier"},
        "next_id": {"$ref": "#/$defs/identifier"},
        "prev_id": {"$ref": "#/$defs/identifier"},
        "boundary": {"type": "boolean"},
        "orientation": {"enum": ["forward", "reverse"]},
        "lineage": {"$ref": "#/$defs/element_lineage"}
      },
      "allOf": [
        {
          "if": {"properties": {"boundary": {"const": true}}, "required": ["boundary"]},
          "then": {"properties": {"twin_id": {"type": "null"}}}
        },
        {
          "if": {"properties": {"boundary": {"const": false}}, "required": ["boundary"]},
          "then": {"properties": {"twin_id": {"$ref": "#/$defs/identifier"}}}
        }
      ]
    },
    "corner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["corner_id", "face_id", "half_edge_id", "vertex_id", "ordinal", "lineage"],
      "properties": {
        "corner_id": {"$ref": "#/$defs/identifier"},
        "face_id": {"$ref": "#/$defs/identifier"},
        "half_edge_id": {"$ref": "#/$defs/identifier"},
        "vertex_id": {"$ref": "#/$defs/identifier"},
        "ordinal": {"type": "integer", "minimum": 0, "maximum": 31},
        "lineage": {"$ref": "#/$defs/element_lineage"}
      }
    },
    "face": {
      "type": "object",
      "additionalProperties": false,
      "required": ["face_id", "first_half_edge_id", "corner_ids", "degree", "boundary", "lineage"],
      "properties": {
        "face_id": {"$ref": "#/$defs/identifier"},
        "first_half_edge_id": {"$ref": "#/$defs/identifier"},
        "corner_ids": {"type": "array", "minItems": 3, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "degree": {"type": "integer", "minimum": 3, "maximum": 32},
        "boundary": {"type": "boolean"},
        "lineage": {"$ref": "#/$defs/element_lineage"}
      }
    },
    "loop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["loop_id", "face_id", "first_half_edge_id", "half_edge_ids", "boundary", "lineage"],
      "properties": {
        "loop_id": {"$ref": "#/$defs/identifier"},
        "face_id": {"$ref": "#/$defs/identifier"},
        "first_half_edge_id": {"$ref": "#/$defs/identifier"},
        "half_edge_ids": {"type": "array", "minItems": 3, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "boundary": {"type": "boolean"},
        "lineage": {"$ref": "#/$defs/element_lineage"}
      }
    },
    "ring": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ring_id", "kind", "edge_ids", "half_edge_ids", "closed", "boundary", "lineage"],
      "properties": {
        "ring_id": {"$ref": "#/$defs/identifier"},
        "kind": {"enum": ["edge_flow", "boundary", "hard_edge", "crease", "uv_seam"]},
        "edge_ids": {"type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "half_edge_ids": {"type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "closed": {"type": "boolean"},
        "boundary": {"type": "boolean"},
        "lineage": {"$ref": "#/$defs/element_lineage"}
      }
    }
  }
}
