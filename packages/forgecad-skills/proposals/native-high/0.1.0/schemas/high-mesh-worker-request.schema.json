{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/high-mesh-worker-request.schema.json",
  "title": "HighMeshWorkerRequest@1",
  "description": "Closed ForgeCAD Native High Worker request. The standalone worker consumes a candidate/current-head/hash-bound durable AuthoringMeshCanonical@1 payload and a non-destructive DetailGraph whose source elements use stable authoring IDs; it never writes Runtime state.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "operation", "source_authoring_mesh", "source_authoring_mesh_sha256", "detail_graph", "detail_graph_canonical_sha256", "budgets", "canonical_sha256"],
  "properties": {
    "schema_version": {"const": "HighMeshWorkerRequest@1"},
    "operation": {"const": "forgecad.production.high-mesh-prepare@1"},
    "source_authoring_mesh": {"$ref": "#/$defs/source_adapter"},
    "source_authoring_mesh_sha256": {"$ref": "#/$defs/sha256"},
    "detail_graph": {"$ref": "#/$defs/detail_graph"},
    "detail_graph_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_detail_nodes", "max_output_vertices", "max_output_triangles"],
      "properties": {
        "max_detail_nodes": {"type": "integer", "minimum": 1, "maximum": 256},
        "max_output_vertices": {"type": "integer", "minimum": 1, "maximum": 300000},
        "max_output_triangles": {"type": "integer", "minimum": 1, "maximum": 600000}
      }
    },
    "canonical_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},
    "vertex": {
      "type": "array",
      "prefixItems": [{"type": "number"}, {"type": "number"}, {"type": "number"}],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "triangle": {
      "type": "array",
      "prefixItems": [{"type": "integer", "minimum": 0}, {"type": "integer", "minimum": 0}, {"type": "integer", "minimum": 0}],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "authoring_part": {
      "type": "object",
      "additionalProperties": false,
      "required": ["part_id", "source_node_id", "material_zone_id", "vertices", "indices"],
      "properties": {
        "part_id": {"$ref": "#/$defs/id"},
        "source_node_id": {"$ref": "#/$defs/id"},
        "material_zone_id": {"$ref": "#/$defs/id"},
        "vertices": {"type": "array", "minItems": 1, "maxItems": 100000, "items": {"$ref": "#/$defs/vertex"}},
        "indices": {"type": "array", "minItems": 1, "maxItems": 200000, "items": {"$ref": "#/$defs/triangle"}}
      }
    },
    "source_adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "canonical_mesh", "candidate_id", "candidate_state_sha256", "head_candidate_id", "head_candidate_state_sha256", "source_mesh_sha256"],
      "properties": {
        "schema_version": {"const": "HighWorkerAuthoringMeshAdapter@1"},
        "canonical_mesh": {"$ref": "https://forgecad.local/contracts/authoring-mesh-canonical.schema.json"},
        "candidate_id": {"$ref": "#/$defs/id"},
        "candidate_state_sha256": {"$ref": "#/$defs/sha256"},
        "head_candidate_id": {"$ref": "#/$defs/id"},
        "head_candidate_state_sha256": {"$ref": "#/$defs/sha256"},
        "source_mesh_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "authoring_mesh": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "parts"],
      "properties": {
        "schema_version": {"const": "AuthoringMeshSource@1"},
        "parts": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"$ref": "#/$defs/authoring_part"}}
      }
    },
    "detail_node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_id", "kind", "parent_part_id"],
      "properties": {
        "node_id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["support_loop", "crease", "floating_detail"]},
        "parent_part_id": {"$ref": "#/$defs/id"},
        "parent_node_id": {"$ref": "#/$defs/id"},
        "source_edge": {"$ref": "#/$defs/id"},
        "width_m": {"type": "number", "exclusiveMinimum": 0, "maximum": 0.25},
        "count": {"type": "integer", "minimum": 1, "maximum": 3},
        "sharpness": {"type": "number", "minimum": 0, "maximum": 10},
        "center_m": {"$ref": "#/$defs/vertex"},
        "size_m": {"$ref": "#/$defs/vertex"}
      }
    },
    "detail_graph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "nodes"],
      "properties": {
        "schema_version": {"const": "DetailGraph@1"},
        "nodes": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/$defs/detail_node"}}
      }
    }
  }
}
