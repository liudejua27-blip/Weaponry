{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/native-high-durable-prepare-request.schema.json",
  "title": "NativeHighDurablePrepareRequest@1",
  "description": "Closed source-only Runtime prepare request. The caller supplies the candidate-bound stable-ID AuthoringMesh source and HighMeshWorkerRequest@1; Runtime alone produces and persists HighMeshArtifact, GLB and readback objects.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "project_id", "candidate_id", "candidate_state_sha256", "base_version_id",
    "source_authoring_mesh_id", "source_authoring_mesh_object_sha256", "source_authoring_mesh_sha256",
    "high_mesh_request", "high_mesh_request_sha256", "idempotency_key", "max_response_bytes",
    "source_only", "runtime_write_performed", "writer_policy", "canonicalization_policy", "input_sha256"
  ],
  "properties": {
    "schema_version": {"const": "NativeHighDurablePrepareRequest@1"},
    "project_id": {"$ref": "#/$defs/id"},
    "candidate_id": {"$ref": "#/$defs/id"},
    "candidate_state_sha256": {"$ref": "#/$defs/sha256"},
    "base_version_id": {"$ref": "#/$defs/nullable_id"},
    "source_authoring_mesh_id": {"$ref": "#/$defs/id"},
    "source_authoring_mesh_object_sha256": {"$ref": "#/$defs/sha256"},
    "source_authoring_mesh_sha256": {"$ref": "#/$defs/sha256"},
    "high_mesh_request": {"$ref": "https://forgecad.local/contracts/high-mesh-worker-request.schema.json"},
    "high_mesh_request_sha256": {"$ref": "#/$defs/sha256"},
    "idempotency_key": {"$ref": "#/$defs/id"},
    "max_response_bytes": {"const": 1048576},
    "source_only": {"const": true},
    "runtime_write_performed": {"const": false},
    "writer_policy": {"const": "forgecad-runtime-only-state-writer@1"},
    "canonicalization_policy": {"const": "canonical-json-sha256-excluding-canonical-sha256@1"},
    "input_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,128}$"},
    "nullable_id": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9_.:-]{1,128}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
