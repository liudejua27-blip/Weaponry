{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/skills/reference-to-typed-plan/0.1.0/input.schema.json",
  "title": "ReferenceToTypedPlanInput",
  "type": "object",
  "additionalProperties": false,
  "required": ["reference_id", "reference_sha256", "subject_class", "observations"],
  "properties": {
    "reference_id": {"type":"string","pattern":"^[A-Za-z0-9_.-]{1,128}$"},
    "reference_sha256": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "subject_class": {"enum":["hard-surface-object","humanoid-mechanical"]},
    "observations": {
      "type":"array","maxItems":128,
      "items":{"type":"object","additionalProperties":false,"required":["id","kind","region","confidence","claim"],"properties":{
        "id":{"type":"string","pattern":"^[A-Za-z0-9_.-]{1,128}$"},
        "kind":{"enum":["silhouette","proportion","detail","material","unknown"]},
        "region":{"type":"string","minLength":1,"maxLength":128},
        "confidence":{"type":"number","minimum":0,"maximum":1},
        "claim":{"type":"string","minLength":1,"maxLength":512}
      }}
    },
    "requested_views":{"type":"array","maxItems":8,"items":{"enum":["front","three-quarter","side","back","top","detail"]}}
  }
}
