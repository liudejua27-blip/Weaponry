{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://forgecad.local/contracts/appearance-program.schema.json",
  "title":"AppearanceProgram",
  "type":"object","additionalProperties":false,
  "required":["schema_version","project_id","geometry_program_sha256","material_zones","canonical_sha256"],
  "properties":{
    "schema_version":{"const":"AppearanceProgram@1"},
    "project_id":{"type":"string","pattern":"^[A-Za-z0-9_.-]{1,128}$"},
    "geometry_program_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "material_zones":{"type":"array","minItems":1,"maxItems":32,"items":{"type":"object","additionalProperties":false,"required":["zone_id","part_ids","base_color","metallic","roughness","emissive"],"properties":{"zone_id":{"type":"string","pattern":"^[A-Za-z0-9_.-]{1,128}$"},"part_ids":{"type":"array","minItems":1,"maxItems":64,"items":{"type":"string","pattern":"^[A-Za-z0-9_.-]{1,128}$"}},"base_color":{"type":"array","minItems":4,"maxItems":4,"items":{"type":"number","minimum":0,"maximum":1}},"metallic":{"type":"number","minimum":0,"maximum":1},"roughness":{"type":"number","exclusiveMinimum":0,"maximum":1},"emissive":{"type":"array","minItems":3,"maxItems":3,"items":{"type":"number","minimum":0,"maximum":1}}}}},
    "canonical_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}
  }
}
