{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgecad.local/contracts/geometry-program-v2.schema.json",
  "title": "GeometryProgramV2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "representation_plan_sha256",
    "operator_catalog_sha256",
    "units",
    "budgets",
    "nodes",
    "part_outputs",
    "canonical_sha256"
  ],
  "properties": {
    "schema_version": {"const": "GeometryProgram@2"},
    "project_id": {"$ref": "#/$defs/identifier"},
    "representation_plan_sha256": {"$ref": "#/$defs/sha256"},
    "operator_catalog_sha256": {"$ref": "#/$defs/sha256"},
    "units": {
      "type": "object",
      "additionalProperties": false,
      "required": ["length", "angle", "coordinate_system"],
      "properties": {
        "length": {"const": "meter"},
        "angle": {"const": "radian"},
        "coordinate_system": {"const": "right-handed-y-up"}
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_nodes",
        "max_triangles",
        "max_glb_bytes",
        "max_worker_memory_bytes",
        "max_runtime_ms"
      ],
      "properties": {
        "max_nodes": {"type": "integer", "minimum": 1, "maximum": 512},
        "max_triangles": {"type": "integer", "minimum": 1, "maximum": 250000},
        "max_glb_bytes": {"type": "integer", "minimum": 1, "maximum": 67108864},
        "max_worker_memory_bytes": {"type": "integer", "minimum": 1, "maximum": 536870912},
        "max_runtime_ms": {"type": "integer", "minimum": 1, "maximum": 10000}
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {"$ref": "#/$defs/geometry_node"}
    },
    "part_outputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {"$ref": "#/$defs/part_output"}
    },
    "canonical_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]{1,128}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "dimension_scalar": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 10
    },
    "radius_scalar": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 5
    },
    "coordinate_scalar": {
      "type": "number",
      "minimum": -10,
      "maximum": 10
    },
    "radian_scalar": {
      "type": "number",
      "minimum": -6.283185307179586,
      "maximum": 6.283185307179586
    },
    "dimension_vector": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/dimension_scalar"}
    },
    "radius_vector": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/radius_scalar"}
    },
    "coordinate_vector": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/coordinate_scalar"}
    },
    "radian_vector": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/radian_scalar"}
    },
    "geometry_node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_id", "operator_id", "inputs", "parameters"],
      "properties": {
        "node_id": {"$ref": "#/$defs/identifier"},
        "operator_id": {
          "enum": [
            "forgecad.geometry.primitive@2",
            "forgecad.geometry.profile-extrude@1",
            "forgecad.geometry.profile-loft@1",
            "forgecad.geometry.longitudinal-section-loft@1",
            "forgecad.geometry.subd-cage@1",
            "forgecad.geometry.subd-cage@2",
            "forgecad.geometry.authoring-mesh@1",
            "forgecad.geometry.surface-patch@1",
            "forgecad.geometry.surface-shell@1",
            "forgecad.geometry.revolve@1",
            "forgecad.geometry.tube-sweep@1",
            "forgecad.geometry.transform@2",
            "forgecad.geometry.mirror@1",
            "forgecad.geometry.array@1",
            "forgecad.geometry.bevel@1",
            "forgecad.geometry.bevel@2",
            "forgecad.geometry.normal-policy@1",
            "forgecad.geometry.panel@1",
            "forgecad.geometry.panel@2",
            "forgecad.geometry.vent-array@1",
            "forgecad.geometry.vent-array@2",
            "forgecad.geometry.recessed-channel@1",
            "forgecad.geometry.energy-core@1",
            "forgecad.geometry.joint-stack@1",
            "forgecad.geometry.boolean@1",
            "forgecad.geometry.part-output@1"
          ]
        },
        "inputs": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        },
        "parameters": {
          "oneOf": [
            {"$ref": "#/$defs/box_parameters"},
            {"$ref": "#/$defs/cylinder_parameters"},
            {"$ref": "#/$defs/ellipsoid_parameters"},
            {"$ref": "#/$defs/sphere_parameters"},
            {"$ref": "#/$defs/profile_extrude_parameters"},
            {"$ref": "#/$defs/profile_loft_parameters"},
            {"$ref": "#/$defs/longitudinal_section_loft_parameters"},
            {"$ref": "#/$defs/subd_cage_parameters"},
            {"$ref": "#/$defs/subd_cage_crease_parameters"},
            {"$ref": "#/$defs/authoring_mesh_parameters"},
            {"$ref": "#/$defs/surface_patch_parameters"},
            {"$ref": "#/$defs/surface_shell_parameters"},
            {"$ref": "#/$defs/revolve_parameters"},
            {"$ref": "#/$defs/tube_sweep_parameters"},
            {"$ref": "#/$defs/transform_parameters"},
            {"$ref": "#/$defs/mirror_parameters"},
            {"$ref": "#/$defs/array_parameters"},
            {"$ref": "#/$defs/bevel_parameters"},
            {"$ref": "#/$defs/bevel_v2_parameters"},
            {"$ref": "#/$defs/normal_policy_parameters"},
            {"$ref": "#/$defs/panel_parameters"},
            {"$ref": "#/$defs/panel_v2_parameters"},
            {"$ref": "#/$defs/vent_array_parameters"},
            {"$ref": "#/$defs/vent_array_v2_parameters"},
            {"$ref": "#/$defs/recessed_channel_parameters"},
            {"$ref": "#/$defs/energy_core_parameters"},
            {"$ref": "#/$defs/joint_stack_parameters"},
            {"$ref": "#/$defs/boolean_parameters"},
            {"$ref": "#/$defs/part_output_parameters"}
          ]
        }
      },
      "allOf": [
          {
            "if": {
              "properties": {
                "operator_id": {"const": "forgecad.geometry.boolean@1"}
              }
            },
            "then": {
              "properties": {
                "inputs": {"minItems": 2, "maxItems": 2}
              }
            }
          },
          {
            "if": {
              "properties": {
                "operator_id": {
                  "enum": [
                    "forgecad.geometry.transform@2",
                    "forgecad.geometry.mirror@1",
                    "forgecad.geometry.array@1",
                    "forgecad.geometry.bevel@1",
                    "forgecad.geometry.bevel@2",
                    "forgecad.geometry.normal-policy@1"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "inputs": {"minItems": 1, "maxItems": 1}
              }
            }
          },
          {
            "if": {
              "required": ["operator_id"],
              "properties": {
                "operator_id": {"const": "forgecad.geometry.bevel@2"}
              }
            },
            "then": {
              "required": ["parameters"],
              "properties": {
                "inputs": {"minItems": 1, "maxItems": 1},
                "parameters": {"$ref": "#/$defs/bevel_v2_parameters"}
              }
            }
          },
          {
            "if": {
              "properties": {
                "operator_id": {"const": "forgecad.geometry.panel@1"}
              }
            },
            "then": {
              "properties": {
                "inputs": {"maxItems": 0},
                "parameters": {"$ref": "#/$defs/panel_parameters"}
              }
            }
          },
          {
            "if": {
              "properties": {
                "operator_id": {"const": "forgecad.geometry.panel@2"}
              }
            },
            "then": {
              "properties": {
                "inputs": {"maxItems": 0},
                "parameters": {"$ref": "#/$defs/panel_v2_parameters"}
              }
            }
          },
          {
            "if": {
              "required": ["operator_id"],
              "properties": {
                "operator_id": {"const": "forgecad.geometry.vent-array@1"}
              }
            },
            "then": {
              "required": ["parameters"],
              "properties": {
                "inputs": {"maxItems": 0},
                "parameters": {"$ref": "#/$defs/vent_array_parameters"}
              }
            }
          },
          {
            "if": {
              "required": ["operator_id"],
              "properties": {
                "operator_id": {"const": "forgecad.geometry.vent-array@2"}
              }
            },
            "then": {
              "required": ["parameters"],
              "properties": {
                "inputs": {"maxItems": 0},
                "parameters": {"$ref": "#/$defs/vent_array_v2_parameters"}
              }
            }
          },
          {
            "if": {
              "required": ["operator_id"],
              "properties": {
                "operator_id": {"const": "forgecad.geometry.recessed-channel@1"}
              }
            },
            "then": {
              "required": ["parameters"],
              "properties": {
                "inputs": {"maxItems": 0},
                "parameters": {"$ref": "#/$defs/recessed_channel_parameters"}
              }
            }
          },
          {
            "if": {
              "required": ["operator_id"],
              "properties": {
                "operator_id": {"const": "forgecad.geometry.energy-core@1"}
              }
            },
            "then": {
              "required": ["parameters"],
              "properties": {
                "inputs": {"maxItems": 0},
                "parameters": {"$ref": "#/$defs/energy_core_parameters"}
              }
            }
          }
      ]
    },
    "base_primitive_parameters": {
      "type": "object",
      "properties": {
        "position_m": {"$ref": "#/$defs/coordinate_vector"},
        "rotation_rad": {"$ref": "#/$defs/radian_vector"}
      }
    },
    "box_parameters": {
      "allOf": [
        {"$ref": "#/$defs/base_primitive_parameters"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["shape", "size_m", "position_m", "rotation_rad"],
          "properties": {
            "shape": {"const": "box"},
            "size_m": {"$ref": "#/$defs/dimension_vector"},
            "position_m": {"$ref": "#/$defs/coordinate_vector"},
            "rotation_rad": {"$ref": "#/$defs/radian_vector"}
          }
        }
      ]
    },
    "cylinder_parameters": {
      "allOf": [
        {"$ref": "#/$defs/base_primitive_parameters"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["shape", "radius_m", "height_m", "radial_segments", "position_m", "rotation_rad"],
          "properties": {
            "shape": {"const": "cylinder"},
            "radius_m": {"$ref": "#/$defs/radius_scalar"},
            "height_m": {"$ref": "#/$defs/dimension_scalar"},
            "radial_segments": {"type": "integer", "minimum": 8, "maximum": 64},
            "position_m": {"$ref": "#/$defs/coordinate_vector"},
            "rotation_rad": {"$ref": "#/$defs/radian_vector"}
          }
        }
      ]
    },
    "ellipsoid_parameters": {
      "allOf": [
        {"$ref": "#/$defs/base_primitive_parameters"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["shape", "radii_m", "longitude_segments", "latitude_segments", "position_m", "rotation_rad"],
          "properties": {
            "shape": {"const": "ellipsoid"},
            "radii_m": {"$ref": "#/$defs/radius_vector"},
            "longitude_segments": {"type": "integer", "minimum": 8, "maximum": 64},
            "latitude_segments": {"type": "integer", "minimum": 4, "maximum": 64},
            "position_m": {"$ref": "#/$defs/coordinate_vector"},
            "rotation_rad": {"$ref": "#/$defs/radian_vector"}
          }
        }
      ]
    },
    "sphere_parameters": {
      "allOf": [
        {"$ref": "#/$defs/base_primitive_parameters"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["shape", "radius_m", "longitude_segments", "latitude_segments", "position_m", "rotation_rad"],
          "properties": {
            "shape": {"const": "sphere"},
            "radius_m": {"$ref": "#/$defs/radius_scalar"},
            "longitude_segments": {"type": "integer", "minimum": 8, "maximum": 64},
            "latitude_segments": {"type": "integer", "minimum": 4, "maximum": 64},
            "position_m": {"$ref": "#/$defs/coordinate_vector"},
            "rotation_rad": {"$ref": "#/$defs/radian_vector"}
          }
        }
      ]
    },
    "profile_point": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"$ref": "#/$defs/coordinate_scalar"}
    },
    "profile_points": {
      "type": "array",
      "minItems": 3,
      "maxItems": 64,
      "items": {"$ref": "#/$defs/profile_point"}
    },
    "path_point": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/coordinate_scalar"}
    },
    "path_points": {
      "type": "array",
      "minItems": 2,
      "maxItems": 128,
      "items": {"$ref": "#/$defs/path_point"}
    },
    "profile_extrude_parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shape", "profile", "depth_m", "position_m", "rotation_rad"],
      "properties": {
        "shape": {"const": "profile-extrude"},
        "profile": {"$ref": "#/$defs/profile_points"},
        "depth_m": {"$ref": "#/$defs/dimension_scalar"},
        "position_m": {"$ref": "#/$defs/coordinate_vector"},
        "rotation_rad": {"$ref": "#/$defs/radian_vector"}
      }
    },
    "loft_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["height_m", "points"],
      "properties": {
        "height_m": {"$ref": "#/$defs/coordinate_scalar"},
        "points": {"$ref": "#/$defs/profile_points"}
      }
    },
    "profile_loft_parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shape", "profiles", "position_m", "rotation_rad"],
      "properties": {
        "shape": {"const": "profile-loft"},
        "profiles": {
          "type": "array",
          "minItems": 2,
          "maxItems": 16,
          "items": {"$ref": "#/$defs/loft_profile"}
        },
        "position_m": {"$ref": "#/$defs/coordinate_vector"},
        "rotation_rad": {"$ref": "#/$defs/radian_vector"}
      }
    },
    "longitudinal_section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["station_m", "points"],
      "properties": {
        "station_m": {"$ref": "#/$defs/coordinate_scalar"},
        "points": {"$ref": "#/$defs/profile_points"}
      }
    },
    "longitudinal_section_loft_parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shape", "sections", "position_m", "rotation_rad"],
      "properties": {
        "shape": {"const": "longitudinal-section-loft"},
        "sections": {
          "type": "array",
          "minItems": 2,
          "maxItems": 16,
          "items": {"$ref": "#/$defs/longitudinal_section"}
        },
        "position_m": {"$ref": "#/$defs/coordinate_vector"},
        "rotation_rad": {"$ref": "#/$defs/radian_vector"}
      }
    },
    "surface_patch_control_point": {
      "$ref": "#/$defs/coordinate_vector"
    },
    "surface_patch_control_points": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "items": {"$ref": "#/$defs/surface_patch_control_point"}
    },
    "subd_cage_control_points": {
      "type": "array",
      "minItems": 4,
      "maxItems": 256,
      "items": {"$ref": "#/$defs/surface_patch_control_point"}
    },
    "subd_cage_parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shape", "control_points", "u_points", "v_points", "subdivision_levels", "position_m", "rotation_rad"],
      "properties": {
        "shape": {"const": "subd-cage"},
        "control_points": {"$ref": "#/$defs/subd_cage_control_points"},
        "u_points": {"type": "integer", "minimum": 2, "maximum": 16},
        "v_points": {"type": "integer", "minimum": 2, "maximum": 16},
        "subdivision_levels": {"type": "integer", "minimum": 0, "maximum": 2},
        "position_m": {"$ref": "#/$defs/coordinate_vector"},
        "rotation_rad": {"$ref": "#/$defs/radian_vector"}
      }
    },
    "subd_cage_crease_edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vertex_a", "vertex_b", "sharpness_levels"],
      "properties": {
        "vertex_a": {"type": "integer", "minimum": 0, "maximum": 255},
        "vertex_b": {"type": "integer", "minimum": 1, "maximum": 255},
        "sharpness_levels": {"type": "integer", "minimum": 1, "maximum": 2}
      }
    },
    "subd_cage_crease_control_points": {
      "type": "array",
      "minItems": 9,
      "maxItems": 256,
      "items": {
        "type": "array",
        "minItems": 3,
        "maxItems": 3,
        "items": {"$ref": "#/$defs/coordinate_scalar"}
      }
    },
    "subd_cage_crease_parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shape", "control_points", "u_points", "v_points", "subdivision_levels", "crease_method", "crease_edges", "position_m", "rotation_rad"],
      "properties": {
        "shape": {"const": "subd-cage"},
        "control_points": {"$ref": "#/$defs/subd_cage_crease_control_points"},
        "u_points": {"type": "integer", "minimum": 3, "maximum": 16},
        "v_points": {"type": "integer", "minimum": 3, "maximum": 16},
        "subdivision_levels": {"type": "integer", "minimum": 1, "maximum": 2},
        "crease_method": {"const": "uniform-integer-level-decay@1"},
        "crease_edges": {
          "description": "Must be lexicographically sorted by (vertex_a, vertex_b), unique, interior and adjacent; Worker rejects non-canonical order.",
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {"$ref": "#/$defs/subd_cage_crease_edge"}
        },
        "position_m": {"$ref": "#/$defs/coordinate_vector"},
        "rotation_rad": {"$ref": "#/$defs/radian_vector"}
      }
    },
    "authoring_mesh_vertex": {
      "type": "object",
      "additionalProperties": false,
      "required": ["element_id", "position_m"],
      "properties": {
        "element_id": {"$ref": "#/$defs/identifier"},
        "position_m": {"$ref": "#/$defs/coordinate_vector"}
      }
    },
    "authoring_mesh_edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["element_id", "vertex_ids"],
      "properties": {
        "element_id": {"$ref": "#/$defs/identifier"},
        "vertex_ids": {
          "description": "Two distinct vertex IDs in lexical order. Edge orientation is carried by each loop, not by this unordered pair.",
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"$ref": "#/$defs/identifier"}
        }
      }
    },
    "authoring_mesh_loop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["element_id", "face_id", "ordinal", "vertex_id", "edge_id", "edge_forward"],
      "properties": {
        "element_id": {"$ref": "#/$defs/identifier"},
        "face_id": {"$ref": "#/$defs/identifier"},
        "ordinal": {"type": "integer", "minimum": 0, "maximum": 3},
        "vertex_id": {"$ref": "#/$defs/identifier"},
        "edge_id": {"$ref": "#/$defs/identifier"},
        "edge_forward": {"type": "boolean"}
      }
    },
    "authoring_mesh_face": {
      "type": "object",
      "additionalProperties": false,
      "required": ["element_id", "loop_ids"],
      "properties": {
        "element_id": {"$ref": "#/$defs/identifier"},
        "loop_ids": {
          "description": "Three or four authored loop IDs in winding order; the first loop ID must be the lexical minimum for rotation-canonical input.",
          "type": "array",
          "minItems": 3,
          "maxItems": 4,
          "items": {"$ref": "#/$defs/identifier"}
        }
      }
    },
    "authoring_mesh_parameters": {
      "description": "Product-owned bounded authoring topology. This is not Blender/BMesh data and cannot contain scripts, paths, URLs, callbacks or runtime plugins.",
      "type": "object",
      "additionalProperties": false,
      "required": ["shape", "topology_policy", "vertices", "edges", "loops", "faces", "position_m", "rotation_rad"],
      "properties": {
        "shape": {"const": "authoring-mesh"},
        "topology_policy": {"const": "triangle-quad-manifold-with-boundary@1"},
        "vertices": {
          "type": "array",
          "minItems": 3,
          "maxItems": 1536,
          "items": {"$ref": "#/$defs/authoring_mesh_vertex"}
        },
        "edges": {
          "type": "array",
          "minItems": 3,
          "maxItems": 1536,
          "items": {"$ref": "#/$defs/authoring_mesh_edge"}
        },
        "loops": {
          "type": "array",
          "minItems": 3,
          "maxItems": 1536,
          "items": {"$ref": "#/$defs/authoring_mesh_loop"}
        },
        "faces": {
          "type": "array",
          "minItems": 1,
          "maxItems": 512,
          "items": {"$ref": "#/$defs/authoring_mesh_face"}
        },
        "position_m": {"$ref": "#/$defs/coordinate_vector"},
        "rotation_rad": {"$ref": "#/$defs/radian_vector"}
      }
    },
    "surface_patch_parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shape", "control_points", "u_segments", "v_segments", "position_m", "rotation_rad"],
      "properties": {
        "shape": {"const": "surface-patch"},
        "control_points": {"$ref": "#/$defs/surface_patch_control_points"},
        "u_segments": {"type": "integer", "minimum": 4, "maximum": 32},
        "v_segments": {"type": "integer", "minimum": 4, "maximum": 32},
        "position_m": {"$ref": "#/$defs/coordinate_vector"},
        "rotation_rad": {"$ref": "#/$defs/radian_vector"}
      }
    },
    "surface_shell_parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shape", "control_points", "u_segments", "v_segments", "thickness_m", "position_m", "rotation_rad"],
      "properties": {
        "shape": {"const": "surface-shell"},
        "control_points": {"$ref": "#/$defs/surface_patch_control_points"},
        "u_segments": {"type": "integer", "minimum": 4, "maximum": 32},
        "v_segments": {"type": "integer", "minimum": 4, "maximum": 32},
        "thickness_m": {"$ref": "#/$defs/dimension_scalar"},
        "position_m": {"$ref": "#/$defs/coordinate_vector"},
        "rotation_rad": {"$ref": "#/$defs/radian_vector"}
      }
    },
    "revolve_parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shape", "profile", "radial_segments", "position_m", "rotation_rad"],
      "properties": {
        "shape": {"const": "revolve"},
        "profile": {
          "type": "array",
          "minItems": 2,
          "maxItems": 64,
