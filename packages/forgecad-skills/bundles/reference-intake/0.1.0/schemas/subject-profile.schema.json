{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://forgecad.local/contracts/subject-profile.schema.json",
  "title":"SubjectProfile",
  "type":"object","additionalProperties":false,
  "required":["schema_version","project_id","reference_id","subject_class","claims","unknown_regions","canonical_sha256"],
  "properties":{
    "schema_version":{"const":"SubjectProfile@1"},
    "project_id":{"type":"string","pattern":"^[A-Za-z0-9_.-]{1,128}$"},
    "reference_id":{"type":"string","pattern":"^[A-Za-z0-9_.-]{1,128}$"},
    "subject_class":{"enum":["hard-surface-object","humanoid-mechanical"]},
    "claims":{"type":"array","maxItems":128,"items":{"type":"object","additionalProperties":false,"required":["claim_id","region","basis","confidence","text"],"properties":{"claim_id":{"type":"string","pattern":"^[A-Za-z0-9_.-]{1,128}$"},"region":{"type":"string","minLength":1,"maxLength":128},"basis":{"enum":["observed","inferred","unknown"]},"confidence":{"type":"number","minimum":0,"maximum":1},"text":{"type":"string","minLength":1,"maxLength":512}}}},
    "unknown_regions":{"type":"array","maxItems":32,"items":{"type":"string","minLength":1,"maxLength":128}},
    "canonical_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}
  }
}
