{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://forgecad.local/contracts/render-set.schema.json",
  "title":"RenderSet",
  "type":"object","additionalProperties":false,
  "required":["schema_version","render_set_id","candidate_id","passes","camera_hash","renderer_hash","pass_artifacts","canonical_sha256"],
  "properties":{"schema_version":{"const":"RenderSet@1"},"render_set_id":{"type":"string"},"candidate_id":{"type":"string"},"passes":{"type":"array","minItems":1,"maxItems":8,"uniqueItems":true,"items":{"enum":["beauty","silhouette","normal","part-id","material-id","depth","ao","wireframe"]}},"camera_hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},"renderer_hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},"pass_artifacts":{"type":"object","minProperties":1,"maxProperties":8,"additionalProperties":false,"properties":{"beauty":{"$ref":"#/$defs/pass_artifact"},"silhouette":{"$ref":"#/$defs/pass_artifact"},"normal":{"$ref":"#/$defs/pass_artifact"},"part-id":{"$ref":"#/$defs/pass_artifact"},"material-id":{"$ref":"#/$defs/pass_artifact"},"depth":{"$ref":"#/$defs/pass_artifact"},"ao":{"$ref":"#/$defs/pass_artifact"},"wireframe":{"$ref":"#/$defs/pass_artifact"}}},"canonical_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}},
  "$defs":{"pass_artifact":{"type":"object","additionalProperties":false,"required":["sha256","mime","size_bytes","width","height"],"properties":{"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"mime":{"const":"image/png"},"size_bytes":{"type":"integer","minimum":1,"maximum":67108864},"width":{"type":"integer","minimum":1,"maximum":4096},"height":{"type":"integer","minimum":1,"maximum":4096}}}}
}
