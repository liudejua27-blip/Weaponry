{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ForgeCAD Runtime",
  "version": "0.1.0",
  "identifier": "local.forgecad.runtime",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "ForgeCAD Runtime Viewer",
        "width": 1440,
        "height": 920,
        "minWidth": 1180,
        "minHeight": 760
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost; worker-src 'self' blob:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "hardenedRuntime": true,
      "files": {
        "Resources/forgecad-runtime": "target/release/forgecad-runtime",
        "Resources/forgecad-mcp": "target/release/forgecad-mcp",
        "Resources/forgecad-geometry-worker": "target/release/forgecad-geometry-worker",
        "Resources/forgecad-render-worker": "target/release/forgecad-render-worker"
      }
    }
  }
}
